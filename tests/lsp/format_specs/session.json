{
  "about": "Format holes with specs: hover, go to definition, references, renaming and semantic tokens on the value and on the `name$` width and precision inside the spec.",
  "steps": [
    { "open": "main.ln" },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "{total:>", 0, 2] },
      "expect": ["let total: i32"] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "{total:>", 0, 2] },
      "ranges": [["main.ln", "total =", 0, 0, 5]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", ">w$", 0, 1] },
      "expect": ["let w: usize"] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", ">w$", 0, 1] },
      "ranges": [["main.ln", "w: usize", 0, 0, 1]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", ".prec$", 0, 3] },
      "expect": ["let prec: usize"] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", ".prec$", 0, 3] },
      "ranges": [["main.ln", "prec: usize", 0, 0, 4]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "{ratio:e}", 0, 2] },
      "expect": ["let ratio: f64"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "{column()", 0, 2] },
      "expect": ["How wide a column is."] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "{column()", 0, 2] },
      "ranges": [["main.ln", "column(): usize", 0, 0, 6]] },
    { "request": "textDocument/references",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "w: usize", 0, 0], "context": { "includeDeclaration": true } },
      "ranges": [["main.ln", "w: usize", 0, 0, 1], ["main.ln", ">w$", 0, 1, 1], ["main.ln", "^w$", 0, 1, 1]],
      "count": ["\"range\":", 3] },
    { "request": "textDocument/rename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", ".prec$", 0, 1], "newName": "digits" },
      "count": ["\"newText\":\"digits\"", 2] },
    { "request": "textDocument/semanticTokens/full",
      "params": { "textDocument": { "uri": "$uri:main.ln" } },
      "tokens": [
        ["main.ln", "{total:>", 0, 1, "variable"],
        ["main.ln", ">w$", 0, 1, "variable"],
        ["main.ln", "^w$", 0, 1, "variable"],
        ["main.ln", ".prec$", 0, 1, "variable"],
        ["main.ln", "{ratio:e}", 0, 1, "variable"],
        ["main.ln", "{column()", 0, 1, "function"],
        ["main.ln", ":#010x}", 0, 0, "string"]
      ] }
  ]
}
