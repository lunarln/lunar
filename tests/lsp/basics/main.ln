/// A pair of values.
struct Pair::<T: Dull> {
    /// The first.
    pub a: T,
    b: T,
}

impl::<T: Dull> Pair::<T> {
    pub fn first(&self): T {
        return self.a;
    }
}

/// Adds two numbers.
fn add(a: i32, b: i32): i32 {
    return a + b;
}

enum Shape {
    Dot,
    Line { from: i32, to: i32 },
}

fn main() {
    let total = add(1, 2);
    let p = Pair { a: 1, b: 2 };
    let f = p.first();
    let mut items: [i32; -..+] = [];
    items.push(total + f);
    let s = Shape::Line { from: 1, to: 2 };
    match s {
        Shape::Line { from, .. } => println("{from}"),
        Shape::Dot => {}
    }
    println("{total} {items.len()} {p.b}");
    let oops: i32 = undefined_name;
}
