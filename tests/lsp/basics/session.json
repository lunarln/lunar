{
  "about": "Hover and go to definition on every kind of name in a program with an error: functions, locals, structs and their type parameters, methods, fields, std methods, keywords, expressions, enum variants and pattern bindings; nothing on unresolved names; std documents that do not exist, a request the server does not know, a document that is not open; a hover after the error is fixed.",
  "steps": [
    { "open": "main.ln" },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "add(1", 0, 0] },
      "expect": ["fn add(a: i32, b: i32): i32", "Adds two numbers."],
      "ranges": [["main.ln", "add(1", 0, 0, 3]] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "add(1", 0, 0] },
      "ranges": [["main.ln", "add(a", 0, 0, 3]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "add(a", 0, 1] },
      "expect": ["fn add(a: i32, b: i32): i32"] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "add(a", 0, 1] },
      "ranges": [["main.ln", "add(a", 0, 0, 3]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "total =", 0, 2] },
      "expect": ["// size = 4, align = 0x4\\nlet total: i32"] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "total =", 0, 2] },
      "ranges": [["main.ln", "total =", 0, 0, 5]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "Pair {", 0, 1] },
      "expect": ["struct Pair::<T: Dull> {\\n    pub a: T,\\n    b: T,\\n}", "A pair of values."] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "Pair {", 0, 1] },
      "ranges": [["main.ln", "Pair::<T: Dull> {", 0, 0, 4]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "T: Dull> {", 0, 0] },
      "expect": ["\"value\":\"```lunar\\nT: Dull\\n```\""] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "T: Dull> {", 0, 0] },
      "ranges": [["main.ln", "T: Dull> {", 0, 0, 1]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "first()", 0, 1] },
      "expect": ["main::Pair", "impl::<T: Dull> Pair::<T>\\npub fn first(&self): T"] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "first()", 0, 1] },
      "ranges": [["main.ln", "first(&self)", 0, 0, 5]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "pub a", 0, 4] },
      "expect": ["pub a: T", "The first."] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "p.b", 0, 2] },
      "expect": ["main::Pair", "b: T"] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "p.b", 0, 2] },
      "ranges": [["main.ln", "b: T,", 0, 0, 1]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "items.push", 0, 7] },
      "expect": ["core::slice", "pub fn push(&mut +self, kept value: T)"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "items.push", 0, 1] },
      "expect": ["let mut items: [i32; -..+]"] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "items.push", 0, 1] },
      "ranges": [["main.ln", "mut items", 0, 0, 9]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "println(\"{total}", 0, 3] },
      "expect": ["std::io", "pub fn println(args: FmtArgs)"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "return a", 0, 2] },
      "expect": ["Returns a value from a function."] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "return a", 0, 2] },
      "expect": ["null"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "a + b", 0, 2] },
      "expect": ["\"value\":\"```lunar\\ni32\\n```\""],
      "ranges": [["main.ln", "a + b", 0, 0, 5]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "Shape::Line {", 0, 8] },
      "expect": ["main::Shape", "Line { from: i32, to: i32 }"] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "Shape::Line {", 0, 8] },
      "ranges": [["main.ln", "Line { from: i32", 0, 0, 4]] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "from, ..", 0, 1] },
      "expect": ["let from: i32"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "Dot,", 0, 0] },
      "expect": ["main::Shape", "\\nDot\\n"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "match s", 0, 1] },
      "expect": ["Control flow based on pattern matching."] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "undefined_name", 0, 3] },
      "expect": ["null"] },
    { "request": "textDocument/definition",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "undefined_name", 0, 3] },
      "expect": ["null"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "impl::<T", 0, 0] },
      "expect": ["Implementations of functionality for a type"] },
    { "request": "lunar/stdSource", "params": { "uri": "lunar-std:no::such" },
      "error": true, "expect": ["no standard library module `no::such`"] },
    { "request": "lunar/stdSource", "params": { "uri": "file:///x.ln" },
      "error": true, "expect": ["not a `lunar-std:` URI"] },
    { "request": "lunar/noSuchRequest",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": { "line": 0, "character": 0 } },
      "error": true, "expect": ["-32601"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "file:///not/open.ln" }, "position": { "line": 0, "character": 0 } },
      "expect": ["null"] },
    { "change": "main.ln", "replace": ["undefined_name", "total"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "total =", 0, 2] },
      "expect": ["let total: i32"] }
  ]
}
