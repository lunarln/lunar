{
  "about": "Signature help: parameter modes as written (`&mut +T`, `kept`), the active parameter (after the receiver for method calls), documentation, nested calls, tuple variants, std functions, and no call.",
  "steps": [
    { "open": "main.ln" },
    { "change": "main.ln", "replace": ["    // here", "    twice(&mut out, \"a\", /*C*/"] },
    { "request": "textDocument/signatureHelp",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"fn twice(out: &mut +String, kept s: str, n: i32)\"", "\"activeParameter\":2", "Appends `s` twice.", "\"parameters\":[{\"label\":[9,26]},{\"label\":[28,39]},{\"label\":[41,47]}]"] },
    { "change": "main.ln", "replace": ["    twice(&mut out, \"a\", /*C*/", "    c.bump(1, /*C*/"] },
    { "request": "textDocument/signatureHelp",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"fn bump(&mut self, by: i32, times: i32)\"", "\"activeParameter\":2", "Adds `by`, `times` times."] },
    { "change": "main.ln", "replace": ["    c.bump(1, /*C*/", "    c.bump(Msg::Move(1, /*C*/"] },
    { "request": "textDocument/signatureHelp",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"Move(i32, i32)\"", "\"activeParameter\":1"] },
    { "change": "main.ln", "replace": ["    c.bump(Msg::Move(1, /*C*/", "    c.bump(add(1), /*C*/"] },
    { "request": "textDocument/signatureHelp",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["fn bump(", "\"activeParameter\":2"] },
    { "change": "main.ln", "replace": ["    c.bump(add(1), /*C*/", "    Counter::bump(/*C*/"] },
    { "request": "textDocument/signatureHelp",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["fn bump(", "\"activeParameter\":0"] },
    { "change": "main.ln", "replace": ["    Counter::bump(/*C*/", "    out.push_str(/*C*/"] },
    { "request": "textDocument/signatureHelp",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"fn push_str(&mut +self, s: str)\"", "\"activeParameter\":1"] },
    { "change": "main.ln", "replace": ["    out.push_str(/*C*/", "    let z = 1/*C*/;"] },
    { "request": "textDocument/signatureHelp",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["null"] }
  ]
}
