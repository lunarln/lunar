{
  "about": "References, highlights and renaming across two files of a crate: a trait method with its implementations, a field and a local that meet in a struct literal shorthand, names inside a macro's arguments and a format string, a type imported with `use`; what cannot be renamed.",
  "steps": [
    { "open": "main.ln" },
    { "open": "util.ln" },
    { "request": "textDocument/references",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "fn area", 0, 4], "context": { "includeDeclaration": true } },
      "ranges": [["main.ln", "area", 0, 0, 4], ["main.ln", "area", 1, 0, 4], ["main.ln", "area", 2, 0, 4], ["main.ln", "area", 3, 0, 4], ["main.ln", "area", 4, 0, 4], ["main.ln", "area", 5, 0, 4], ["main.ln", "area", 6, 0, 4]],
      "count": ["\"range\":", 7] },
    { "request": "textDocument/references",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "side", 0, 1], "context": { "includeDeclaration": true } },
      "ranges": [["main.ln", "side", 0, 0, 4], ["main.ln", "side", 1, 0, 4], ["main.ln", "side", 2, 0, 4], ["main.ln", "side", 3, 0, 4], ["main.ln", "side", 5, 0, 4]],
      "count": ["\"range\":", 5] },
    { "request": "textDocument/references",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "side", 4, 1], "context": { "includeDeclaration": true } },
      "ranges": [["main.ln", "side", 4, 0, 4], ["main.ln", "side", 5, 0, 4], ["main.ln", "side", 6, 0, 4], ["main.ln", "side", 7, 0, 4]],
      "count": ["\"range\":", 4] },
    { "request": "textDocument/references",
      "params": { "textDocument": { "uri": "$uri:util.ln" }, "position": ["$pos", "util.ln", "Stack", 0, 1], "context": { "includeDeclaration": true } },
      "ranges": [["util.ln", "Stack", 0, 0, 5], ["util.ln", "Stack", 2, 0, 5], ["util.ln", "Stack", 3, 0, 5], ["main.ln", "Stack", 0, 0, 5], ["main.ln", "Stack", 1, 0, 5]],
      "expect": ["main.ln\"", "util.ln\""] },
    { "request": "textDocument/references",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "helper(sq", 0, 2], "context": { "includeDeclaration": false } },
      "ranges": [["main.ln", "helper", 0, 0, 6], ["main.ln", "helper", 1, 0, 6]],
      "count": ["\"range\":", 2] },
    { "request": "textDocument/documentHighlight",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "let sq", 0, 5] },
      "count": ["\"kind\":", 3],
      "expect": ["\"kind\":3", "\"kind\":2"] },
    { "request": "textDocument/prepareRename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "sq.area", 0, 4] },
      "expect": ["\"placeholder\":\"area\""],
      "ranges": [["main.ln", "area", 4, 0, 4]] },
    { "request": "textDocument/rename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "fn area", 2, 4], "newName": "surface" },
      "count": ["\"newText\":\"surface\"", 7] },
    { "request": "textDocument/rename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "self.side", 0, 6], "newName": "edge" },
      "expect": ["\"newText\":\"edge: side\""],
      "count": ["\"newText\":\"edge\"", 4] },
    { "request": "textDocument/rename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "let side", 0, 5], "newName": "len" },
      "expect": ["\"newText\":\"side: len\""],
      "count": ["\"newText\":\"len\"", 3] },
    { "request": "textDocument/rename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "Stack::new", 0, 1], "newName": "Pile" },
      "expect": ["main.ln\":[", "util.ln\":["],
      "count": ["\"newText\":\"Pile\"", 6] },
    { "request": "textDocument/prepareRename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "println", 0, 2] },
      "error": true, "expect": ["standard library"] },
    { "request": "textDocument/prepareRename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "Some(v)", 0, 1] },
      "error": true, "expect": ["standard library"] },
    { "request": "textDocument/prepareRename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "self.side", 0, 1] },
      "error": true, "expect": ["keywords"] },
    { "request": "textDocument/prepareRename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "fn main", 0, 1] },
      "error": true },
    { "request": "textDocument/rename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "let sq", 0, 5], "newName": "1x" },
      "error": true, "expect": ["not a valid name"] },
    { "request": "textDocument/rename",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "let sq", 0, 5], "newName": "match" },
      "error": true }
  ]
}
