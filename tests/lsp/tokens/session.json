{
  "about": "Semantic tokens: what each name is (types, functions, methods, macros, locals, parameters, fields, variants, traits, modules), the declaration, mutable, readonly and defaultLibrary modifiers, names inside a macro's arguments and a format string, comments, strings and numbers; ranges and deltas.",
  "steps": [
    { "open": "main.ln" },
    { "request": "textDocument/semanticTokens/full",
      "params": { "textDocument": { "uri": "$uri:main.ln" } },
      "expect": ["\"resultId\":\"1\""],
      "tokens": [
        ["main.ln", "use", 0, 0, "keyword"],
        ["main.ln", "std", 0, 0, "namespace", ["defaultLibrary"]],
        ["main.ln", "/// A point.", 0, 0, "comment", ["documentation"]],
        ["main.ln", "Point {", 0, 0, "struct", ["declaration"]],
        ["main.ln", "x: i32", 0, 0, "property", ["declaration"]],
        ["main.ln", "i32", 0, 0, "type", ["defaultLibrary"]],
        ["main.ln", "Kind {", 0, 0, "enum", ["declaration"]],
        ["main.ln", "One,", 0, 0, "enumMember", ["declaration"]],
        ["main.ln", "Show {", 0, 0, "interface", ["declaration"]],
        ["main.ln", "show(&self)", 0, 0, "method", ["declaration"]],
        ["main.ln", "LIMIT: i32", 0, 0, "variable", ["declaration", "readonly"]],
        ["main.ln", "COUNT", 0, 0, "variable", ["declaration", "mutable"]],
        ["main.ln", "twice(", 0, 0, "macro", ["declaration"]],
        ["main.ln", "area", 0, 0, "function", ["declaration", "!defaultLibrary"]],
        ["main.ln", "T: Show", 0, 0, "typeParameter"],
        ["main.ln", "Show>", 0, 0, "interface", ["!declaration"]],
        ["main.ln", "p: &Point", 0, 0, "parameter", ["declaration", "!mutable"]],
        ["main.ln", "Point,", 0, 0, "struct", ["!declaration"]],
        ["main.ln", "n: i32", 0, 0, "parameter", ["declaration", "mutable"]],
        ["main.ln", "n += LIMIT", 0, 0, "parameter", ["mutable", "!declaration"]],
        ["main.ln", "LIMIT;", 0, 0, "variable", ["readonly"]],
        ["main.ln", "k =", 0, 0, "variable", ["declaration"]],
        ["main.ln", "Kind::One", 0, 0, "enum"],
        ["main.ln", "One;", 0, 0, "enumMember"],
        ["main.ln", "show()", 0, 0, "method"],
        ["main.ln", "// a comment", 0, 0, "comment"],
        ["main.ln", "twice!", 0, 0, "macro"],
        ["main.ln", "p.x)", 0, 0, "parameter"],
        ["main.ln", "x) +", 0, 0, "property"],
        ["main.ln", "println", 0, 0, "function", ["defaultLibrary"]],
        ["main.ln", "{total}", 0, 1, "variable"],
        ["main.ln", "fs::exists", 0, 0, "namespace", ["defaultLibrary"]],
        ["main.ln", "exists", 0, 0, "function", ["defaultLibrary"]],
        ["main.ln", "\"x\"", 0, 0, "string"],
        ["main.ln", "3;", 0, 0, "number"],
        ["main.ln", "return", 0, 0, "keyword"],
        ["main.ln", "self)", 0, 0, "keyword"]
      ] },
    { "request": "textDocument/semanticTokens/range",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "range": { "start": { "line": 22, "character": 0 }, "end": { "line": 23, "character": 0 } } },
      "absent": ["resultId"],
      "tokens": [["main.ln", "fn area", 0, 0, "keyword"], ["main.ln", "area", 0, 0, "function"]] },
    { "change": "main.ln", "replace": ["    // a comment\n", ""] },
    { "request": "textDocument/semanticTokens/full/delta",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "previousResultId": "1" },
      "expect": ["\"edits\":[{\"start\":", "\"resultId\":\"2\""] },
    { "request": "textDocument/semanticTokens/full/delta",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "previousResultId": "2" },
      "expect": ["\"edits\":[]", "\"resultId\":\"3\""] },
    { "request": "textDocument/semanticTokens/full/delta",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "previousResultId": "1" },
      "expect": ["\"data\":[", "\"resultId\":\"4\""] }
  ]
}
