/// Something with an area.
trait Shape {
    /// The area.
    fn area(&self): f64;
    fn grow(&mut self, by: f64);
}

struct Square {
    side: f64,
}

impl Shape for Square {
    fn area(&self): f64 {
        return self.side * self.side;
    }

    fn grow(&mut self, by: f64) {
        self.side += by;
    }
}

fn total(shapes: [dyn Shape; &]): f64 {
    let mut t = 0.0;
    for s in shapes {
        t += s.area();
    }
    return t;
}

fn main() {
    let mut sq = Square { side: 2.0 };
    let view = sq as dyn mut Shape;
    view.grow(1.0);
    let shared = sq as dyn Shape;
    println("{total([shared][..])}");
    // here
}
