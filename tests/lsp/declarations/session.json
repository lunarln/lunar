{
  "about": "Hovers print declarations from the syntax tree: type parameters with their bounds (at the declaration, at uses, an impl's in a method), functions without attributes, doc comments (not `////`, and across attributes), types with their layout, methods with their impl, trait methods with their trait.",
  "steps": [
    { "open": "main.ln" },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "T: Dull", 0, 0] },
      "expect": ["\"value\":\"```lunar\\nT: Dull + Ord\\n```\""] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "[T; &]", 0, 1] },
      "expect": ["\"value\":\"```lunar\\nT: Dull + Ord\\n```\""] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "): T {", 0, 3] },
      "expect": ["\"value\":\"```lunar\\nT: Dull + Ord\\n```\""] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "&mut U", 0, 5] },
      "expect": ["\"value\":\"```lunar\\nU\\n```\""] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "[B; -..+]", 0, 1] },
      "expect": ["\"value\":\"```lunar\\nB: Dull + Named\\n```\""] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "): A {", 0, 3] },
      "expect": ["\"value\":\"```lunar\\nA: Dull\\n```\""] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "largest", 0, 0] },
      "expect": ["pub fn largest::<T: Dull + Ord, U>(items: [T; &], extra: &mut U): T"],
      "absent": ["#["] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "adds", 0, 0] },
      "expect": ["fn adds()"],
      "absent": ["#["] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "largest_doc", 0, 0] },
      "expect": ["\\n\\n---\\n\\nThe largest item.\\nAssumes there is one.\""] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "Pair", 0, 0] },
      "expect": ["struct Pair::<A: Dull, B: Dull + Named> {\\n    pub a: A,\\n    b: [B; -..+],\\n}", "\\n\\n---\\n\\nTwo values.\""],
      "absent": ["Not documentation"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "pub a", 0, 4] },
      "expect": ["main::Pair", "pub a: A", "\\n\\n---\\n\\nThe first.\""] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "Dot", 0, 0] },
      "expect": ["main::Shape", "\\n\\n---\\n\\nA single point.\""] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "from:", 0, 0] },
      "expect": ["main::Shape::Line", "from: i32", "\\n\\n---\\n\\nFrom here.\""] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "Shape", 0, 0] },
      "expect": ["// size = 16 (0x10), align = 0x8\\nenum Shape {"],
      "absent": ["---"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "fn first", 0, 3] },
      "expect": ["impl::<A: Dull, B: Dull + Named> Pair::<A, B>\\npub fn first(&self): A"] },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "name", 0, 0] },
      "expect": ["trait Named\\nfn name(&self): str"] }
  ]
}
