{
  "about": "Completion: members by the receiver's type (fields, inherent and trait methods, autoslicing, privacy), paths, struct literals, locals in scope, keywords, snippets, docs, incomplete code, comments and strings, macro arguments, use paths.",
  "steps": [
    { "open": "main.ln" },
    { "request": "textDocument/hover",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "doubled", 0, 1] },
      "expect": ["let doubled: i32"] },
    { "change": "main.ln", "replace": ["        let doubled = self.len * 2;", "        let doubled = self.len * 2;\n        let extra = 1;\n        add(dou/*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"doubled\""] },
    { "request": "textDocument/signatureHelp",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"fn add(a: i32, b: i32): i32\"", "\"activeParameter\":0"] },
    { "change": "main.ln", "replace": ["\n        let extra = 1;\n        add(dou/*C*/", ""] },
    { "change": "main.ln", "replace": ["    // here", "    p./*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"x\"", "\"label\":\"y\"", "\"label\":\"secret\"", "\"label\":\"norm\"", "\"label\":\"grow\"", "\"label\":\"name\"", "\"detail\":\"pub fn norm(&self): i32\"", "The squared distance from the origin.", "\"newText\":\"norm()$0\"", "\"newText\":\"grow(${1:by})$0\"", "\"kind\":5", "\"kind\":2"],
      "absent": ["\"label\":\"total\"", "\"label\":\"new\"", "\"label\":\"let\""] },
    { "change": "main.ln", "replace": ["    p./*C*/", "    names./*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"push\"", "\"label\":\"pop\"", "\"label\":\"len\"", "\"label\":\"contains\"", "\"label\":\"truncate\""],
      "absent": ["\"label\":\"x\""] },
    { "change": "main.ln", "replace": ["    names./*C*/", "    s./*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"push_str\"", "\"label\":\"starts_with\"", "\"label\":\"as_str\""] },
    { "change": "main.ln", "replace": ["    s./*C*/", "    Point::/*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"new\"", "\"label\":\"norm\"", "\"newText\":\"new(${1:x}, ${2:y})$0\"", "Makes a point."],
      "absent": ["\"label\":\"secret\""] },
    { "change": "main.ln", "replace": ["    Point::/*C*/", "    Shape::/*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"Dot\"", "\"label\":\"Circle\"", "\"label\":\"Rect\"", "\"newText\":\"Circle($0)\"", "\"newText\":\"Rect { $0 }\"", "\"kind\":20"] },
    { "change": "main.ln", "replace": ["    Shape::/*C*/", "    std::fs::/*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"read_to_string\"", "\"label\":\"write\""],
      "absent": ["\"label\":\"total\""] },
    { "change": "main.ln", "replace": ["    std::fs::/*C*/", "    let r = Point { x: 1, /*C*/ };"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"y\"", "\"label\":\"secret\"", "\"newText\":\"y: $0\""],
      "absent": ["\"label\":\"x\"", "\"label\":\"norm\""] },
    { "change": "main.ln", "replace": ["    let r = Point { x: 1, /*C*/ };", "    /*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"p\"", "\"label\":\"total\"", "\"label\":\"names\"", "\"label\":\"add\"", "\"label\":\"Point\"", "\"label\":\"geo\"", "\"label\":\"std\"", "\"label\":\"println\"", "\"label\":\"assert_eq!\"", "\"label\":\"let\"", "\"label\":\"match\"", "\"label\":\"i32\"", "\"newText\":\"add(${1:a}, ${2:b})$0\"", "\"detail\":\"[str; -..+]\""],
      "absent": ["\"label\":\"inner\"", "\"label\":\"later\"", "\"label\":\"struct\"", "\"label\":\"Hash!\""] },
    { "change": "main.ln", "replace": ["    /*C*/", "    tot/*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"total\""],
      "absent": ["\"label\":\"names\""] },
    { "change": "main.ln", "replace": ["    tot/*C*/", "    q./*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"a\""],
      "absent": ["\"label\":\"b\""] },
    { "change": "main.ln", "replace": ["    q./*C*/", "    Point::new(1, 2)./*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"norm\"", "\"label\":\"x\""] },
    { "change": "main.ln", "replace": ["    Point::new(1, 2)./*C*/", "    let a = p./*C*/\n    let b = 3;"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"x\"", "\"label\":\"norm\""] },
    { "change": "main.ln", "replace": ["    let a = p./*C*/\n    let b = 3;", "    assert_eq!(p./*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"x\"", "\"label\":\"norm\""] },
    { "change": "main.ln", "replace": ["    assert_eq!(p./*C*/", "    // p.zz\n    let w = \"p.yy\";"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "p.zz", 0, 2] },
      "expect": ["\"items\":[]"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "p.yy", 0, 2] },
      "expect": ["\"items\":[]"] },
    { "change": "main.ln", "replace": ["fn describe::<T: Named>(t: &T): str {\n    return t.name();", "fn describe::<T: Named>(t: &T): str {\n    return t./*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"name\""],
      "absent": ["\"label\":\"norm\""] },
    { "change": "main.ln", "replace": ["return t./*C*/", "return t.name();"] },
    { "change": "main.ln", "replace": ["fn add(", "/*C*/\nfn add("] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"fn\"", "\"label\":\"struct\"", "\"label\":\"impl\"", "\"label\":\"use\""],
      "absent": ["\"label\":\"let\"", "\"label\":\"total\""] },
    { "change": "main.ln", "replace": ["/*C*/\nfn add(", "use std::/*C*/;\nfn add("] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"fs\"", "\"label\":\"io\"", "\"newText\":\"fs\""],
      "absent": ["\"label\":\"let\""] },
    { "change": "main.ln", "replace": ["use std::/*C*/;", "use std::{fs, i/*C*/};"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"io\""] },
    { "change": "main.ln", "replace": ["use std::{fs, i/*C*/};", "use crater::geo::/*C*/;"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"P\"", "\"label\":\"make\"", "\"newText\":\"make\""] },
    { "change": "main.ln", "replace": ["use crater::geo::/*C*/;", ""] },
    { "change": "main.ln", "replace": ["    let later = 1;\n}", "    let later = 1;\n}\n\nfn broken(arg: i32) {\n    let zed = 1;\n    if arg > 0 {\n        z/*C*/"] },
    { "request": "textDocument/completion",
      "params": { "textDocument": { "uri": "$uri:main.ln" }, "position": ["$pos", "main.ln", "/*C*/", 0, 0] },
      "expect": ["\"label\":\"zed\""] }
  ]
}
