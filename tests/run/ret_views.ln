// What a returned view points into is part of a function's signature: the
// parameters its `from` clause names, or without one, `&self` on a method,
// else every parameter it could point into. Only those arguments stay
// borrowed, so the others may be changed or moved while the result is in
// use.

// Points into `a` only.
fn first(a: &String, b: &String): str from a {
    if b.len() > 100 {
        return "long";
    }
    return a.as_str();
}

// The only parameter a view could come from: no clause needed.
fn tail(s: str, n: usize): str {
    return s[n..];
}

// A struct holding a view into `text` only.
struct Word {
    text: str,
    pos: usize,
}

fn word_at(text: &String, scratch: &mut String, pos: usize): Word from text {
    scratch.push_str("scanned ");
    let mut end = pos;
    while end < text.len() && text.as_bytes()[end] != 32 {
        end += 1;
    }
    return Word { text: text.as_str()[pos..end], pos };
}

// Recursion: into `a` only, whatever the depth.
fn skip(a: &String, b: &String, n: usize): str from a {
    if n == 0 {
        return a.as_str();
    }
    return skip(a, b, n - 1);
}

// Mutual recursion: `even` and `odd` both return views into `s` only.
fn even(s: &String, other: &String, n: usize): str from s {
    if n == 0 {
        return s.as_str();
    }
    return odd(s, other, n - 1);
}

fn odd(s: &String, other: &String, n: usize): str from s {
    if n == 0 {
        return s.as_str()[1..];
    }
    return even(s, other, n - 1);
}

// The value of a loop is what its `break` gives.
fn find(hay: &String, needle: &String): str from hay {
    let mut i: usize = 0;
    let v = loop {
        if i + needle.len() > hay.len() || hay.as_str()[i..i + needle.len()] == needle.as_str() {
            break hay.as_str()[i..];
        }
        i += 1;
    };
    return v;
}

// Views of nothing the caller passed.
fn kind(a: &String, b: &String): str from static {
    if a.len() > b.len() {
        return "longer";
    }
    return "not longer";
}

struct Doc {
    title: String,
    body: String,
}

impl Doc {
    // A method's result points into `self` unless it says otherwise.
    fn title_after(&self, prefix: &String): str {
        return self.title.as_str()[prefix.len()..];
    }

    // Into `other` only: `self` may change while the result is in use.
    fn other_title(&self, other: &Doc): str from other {
        return other.title.as_str();
    }

    fn retitle(&mut self, t: str) {
        self.title.clear();
        self.title.push_str(t);
    }
}

trait Label {
    fn label(&self, extra: &String): str from self, extra;
}

impl Label for Doc {
    // An implementation may point into less than the trait says, and a
    // call on a `Doc` goes by what it says.
    fn label(&self, extra: &String): str from self {
        if extra.len() == 0 {
            return "";
        }
        return self.body.as_str();
    }
}

// Through the trait, the result may point into both arguments.
fn label_of::<T: Label>(t: &T, extra: &String): str from t, extra {
    return t.label(extra);
}

// A closure that captures a borrowed parameter and returns a view of it.
fn suffix(s: &String, n: usize): str {
    let tail = |i: usize| s.as_str()[i..];
    return tail(n);
}

fn main() {
    let x = String::from("hello");
    let mut y = String::from("world");
    let v = first(&x, &y);
    y.clear();
    let moved = y;
    println("{v} {moved.len()}");

    let owner = String::from("ada grace");
    let mut holder = owner.as_str();
    let n = tail(holder, 4);
    holder = "";
    println("{n} {holder.len()}");

    let text = String::from("lunar views point");
    let mut scratch = String::new();
    let w = word_at(&text, &mut scratch, 6);
    scratch.clear();
    println("{w.text} at {w.pos}");

    let a = String::from("abc");
    let mut b = String::from("xyz");
    let s = skip(&a, &b, 3);
    let e = even(&a, &b, 5);
    b.push_str("!");
    b.clear();
    println("{s} {e}");

    let hay = String::from("find the needle here");
    let mut needle = String::from("needle");
    let f = find(&hay, &needle);
    needle.clear();
    println("{f}");

    let mut p = String::from("ab");
    let mut q = String::from("c");
    let k = kind(&p, &q);
    p.clear();
    q.clear();
    println("{k}");

    let mut doc = Doc { title: String::from("Re: views"), body: String::from("declared") };
    let other = Doc { title: String::from("other"), body: String::new() };
    let mut prefix = String::from("Re: ");
    let t = doc.title_after(&prefix);
    let l = doc.label(&prefix);
    prefix.clear();
    println("{t} {l}");
    let o = doc.other_title(&other);
    doc.retitle("new");
    println("{o} {doc.title}");

    let extra = String::from("x");
    let g = label_of(&doc, &extra);
    println("{g}");

    let word = String::from("closures");
    let c = suffix(&word, 5);
    println("{c}");

    // A closure whose result points into what it captured, not into its
    // argument.
    let mut count = String::from("1");
    let pick = |t: str| x.as_str()[t.len()..];
    let r = pick(count.as_str());
    count.clear();
    println("{r} {count.len()}");
}
