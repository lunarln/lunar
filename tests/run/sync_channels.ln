// std::sync::mpsc and mpmc: unbounded, bounded and rendezvous channels,
// owned messages, disconnection on either side, timeouts, iteration.

use std::sync::atomic::{AtomicU64, Ordering};
use std::sync::mpmc;
use std::sync::mpsc::{self, RecvTimeoutError, TryRecvError, TrySendError};
use std::thread;
use std::time::{Duration, Instant};

#[test]
fn one_sender() {
    let (tx, rx) = mpsc::channel::<u64>();
    let h = thread::spawn(move || {
        for i in 0..100 {
            tx.send(i).unwrap();
        }
    });
    let mut sum: u64 = 0;
    // The loop ends when the sender is gone.
    for v in rx {
        sum += v;
    }
    assert_eq!(sum, 4950);
    h.join().unwrap();
}

#[test]
fn many_senders_owned_messages() {
    let (tx, rx) = mpsc::channel::<String>();
    let mut g = thread::Group::<()>::new();
    for i in 0..4 {
        let t = tx.clone();
        g.spawn(move || {
            for j in 0..25 {
                t.send(core::fmt::format("{i}:{j}")).unwrap();
            }
        });
    }
    let _ = tx;
    let mut n = 0;
    let mut bytes: usize = 0;
    while let Ok(m) = rx.recv() {
        n += 1;
        bytes += m.len();
    }
    assert_eq!(n, 100);
    assert_eq!(bytes, 4 * (10 * 3 + 15 * 4));
    while let Some(r) = g.join_next() {
        r.unwrap();
    }
}

#[test]
fn messages_arrive_in_order() {
    let (tx, rx) = mpsc::channel::<u32>();
    for i in 0..1000 {
        tx.send(i).unwrap();
    }
    assert_eq!(rx.len(), 1000);
    for i in 0..1000 {
        assert_eq!(rx.recv(), Ok(i));
    }
}

#[test]
fn try_recv_and_disconnect() {
    let (tx, rx) = mpsc::channel::<u8>();
    assert_eq!(rx.try_recv(), Err(TryRecvError::Empty));
    tx.send(1).unwrap();
    assert_eq!(rx.try_recv(), Ok(1u8));
    let _ = tx;
    assert_eq!(rx.try_recv(), Err(TryRecvError::Disconnected));
    assert!(rx.recv().is_err());
}

#[test]
fn send_fails_without_receiver() {
    let (tx, rx) = mpsc::channel::<String>();
    assert!(!tx.is_disconnected());
    let _ = rx;
    assert!(tx.is_disconnected());
    match tx.send(String::from("lost")) {
        Ok(()) => panic("sent to nobody"),
        Err(e) => assert_eq!(e.value, String::from("lost")),
    }
}

#[test]
fn recv_timeout() {
    let (tx, rx) = mpsc::channel::<u32>();
    let start = Instant::now();
    assert_eq!(rx.recv_timeout(Duration::from_millis(20)), Err(RecvTimeoutError::Timeout));
    assert!(start.elapsed() >= Duration::from_millis(20));
    let h = thread::spawn(move || {
        thread::sleep(Duration::from_millis(10));
        tx.send(5).unwrap();
    });
    assert_eq!(rx.recv_timeout(Duration::from_secs(10)), Ok(5u32));
    h.join().unwrap();
    assert_eq!(rx.recv_timeout(Duration::from_millis(5)), Err(RecvTimeoutError::Disconnected));
}

#[test]
fn bounded_channel_blocks_when_full() {
    let (tx, rx) = mpsc::sync_channel::<u32>(2);
    tx.send(1).unwrap();
    tx.send(2).unwrap();
    match tx.try_send(3) {
        Err(TrySendError::Full(v)) => assert_eq!(v, 3u32),
        _ => panic("expected a full channel"),
    }
    let sent = AtomicU64::new(0);
    thread::scope(|s| {
        s.spawn(|| {
            for i in 3..10 {
                tx.send(i).unwrap();
                sent.fetch_add(1, Ordering::SeqCst);
            }
        });
        thread::sleep(Duration::from_millis(20));
        // The sender waits for room: at most the bound is queued.
        assert!(rx.len() <= 2);
        let mut got: u32 = 0;
        for _ in 0..9 {
            got += rx.recv().unwrap();
        }
        assert_eq!(got, 45);
    });
    assert_eq!(sent.load(Ordering::SeqCst), 7);
}

#[test]
fn rendezvous() {
    let (tx, rx) = mpsc::sync_channel::<u64>(0);
    let taken = AtomicU64::new(0);
    thread::scope(|s| {
        s.spawn(|| {
            for i in 0..5 {
                tx.send(i).unwrap();
                // The item was received before `send` returned.
                assert!(taken.load(Ordering::SeqCst) > i);
            }
        });
        for _ in 0..5 {
            thread::sleep(Duration::from_millis(2));
            let v = rx.recv().unwrap();
            taken.store(v + 1, Ordering::SeqCst);
        }
    });
}

#[test]
fn unreceived_messages_are_dropped() {
    let (tx, rx) = mpsc::channel::<String>();
    for i in 0..100 {
        tx.send(core::fmt::format("message {i}")).unwrap();
    }
    let _ = tx;
    let _ = rx;
}

#[test]
fn mpmc_work_queue() {
    let done = AtomicU64::new(0);
    let count = AtomicU64::new(0);
    thread::scope(|s| {
        // Made inside the scope's closure (which may only read what it
        // captures), so it can let its ends go to disconnect them.
        let (tx, rx) = mpmc::bounded::<u64>(8);
        for _ in 0..4 {
            let r = rx.clone();
            s.spawn_with(r, |r| {
                for job in r {
                    done.fetch_add(job, Ordering::Relaxed);
                    count.fetch_add(1, Ordering::Relaxed);
                }
            });
        }
        let _ = rx;
        for i in 1..1001 {
            tx.send(i).unwrap();
        }
        let _ = tx;
    });
    assert_eq!(done.load(Ordering::SeqCst), 500500);
    assert_eq!(count.load(Ordering::SeqCst), 1000);
}

#[test]
fn mpmc_disconnect_and_timeouts() {
    let (tx, rx) = mpmc::channel::<u32>();
    let rx2 = rx.clone();
    tx.send(1).unwrap();
    assert_eq!(rx2.recv(), Ok(1u32));
    let _ = rx;
    assert!(!tx.is_disconnected());
    let _ = rx2;
    assert!(tx.is_disconnected());
    assert!(tx.send(2).is_err());
    let (btx, brx) = mpmc::bounded::<u32>(1);
    btx.send(1).unwrap();
    assert!(btx.send_timeout(2, Duration::from_millis(10)).is_err());
    assert_eq!(brx.recv(), Ok(1u32));
    assert!(btx.send_timeout(3, Duration::from_millis(10)).is_ok());
    let tx2 = btx.clone();
    let _ = btx;
    assert!(!brx.is_disconnected());
    let _ = tx2;
    assert!(brx.is_disconnected());
    assert_eq!(brx.recv(), Ok(3u32));
    assert!(brx.recv().is_err());
}
