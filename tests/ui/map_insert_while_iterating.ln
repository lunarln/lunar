// error: borrow::shrink_while_borrowed
// Inserting may replace the map's table, which a loop over it still reads.
use core::collections::HashMap;

fn main() {
    let mut m: HashMap::<i32, i32> = HashMap::new();
    m.insert(1, 1);
    for (k, v) in m.iter() {
        m.insert(k + 10, v);
    }
    println("{m.len()}");
}
