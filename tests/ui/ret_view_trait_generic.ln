// error: borrow::escapes_via_return
// A trait method called on a generic receiver may be any implementation:
// its result may point into what the trait says, `scratch` too, even
// though the only implementation here returns a view into `self`.
trait Named {
    fn name(&self, scratch: &String): str from self, scratch;
}

struct Person {
    name: String,
}

impl Named for Person {
    fn name(&self, scratch: &String): str from self {
        return self.name.as_str();
    }
}

fn name_of::<T: Named>(t: &T, scratch: &String): str from t {
    return t.name(scratch);
}

fn main() {
    let p = Person { name: String::from("ada") };
    let mut scratch = String::from("tmp");
    let n = name_of(&p, &scratch);
    scratch.clear();
    println("{n}");
}
