// error: borrow::escapes_via_return
// Each call swaps the arguments, so the result may point into either, not
// only into `a` as declared.
fn alternate(a: &String, b: &String, n: usize): str from a {
    if n == 0 {
        return a.as_str();
    }
    return alternate(b, a, n - 1);
}

fn main() {
    let x = String::from("left");
    let mut y = String::from("right");
    let v = alternate(&x, &y, 3);
    y.clear();
    println("{v}");
}
