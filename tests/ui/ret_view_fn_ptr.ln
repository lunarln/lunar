// error: borrow::shrink_while_borrowed
// Called through a function pointer, the signature is unknown: the result
// may point into every argument, whatever `first` says.
fn first(a: &String, b: &String): str from a {
    return a.as_str();
}

fn main() {
    let x = String::from("hello");
    let mut y = String::from("world");
    let f: fn(&String, &String): str = first;
    let v = f(&x, &y);
    y.clear();
    println("{v}");
}
