// String interning: each distinct text gets a `Symbol`, so comparing names
// is comparing integers. The texts are stored once, end to end in one
// `String`.

use crater::hash::{Hash, Hasher, hash_of};

/// An interned text: an index into the `Interner` that made it.
pub struct Symbol {
    index: u32,
}

impl Symbol {
    pub fn index(self): usize {
        return self.index as usize;
    }
}

impl Eq for Symbol {
    fn eq(&self, other: &Self): bool {
        return self.index == other.index;
    }
}

impl Hash for Symbol {
    fn hash(&self, h: &mut Hasher) {
        h.write_u64(self.index as u64);
    }
}

impl Debug for Symbol {
    fn debug(&self, out: &mut String) {
        out.write("Symbol({self.index})");
    }
}

/// Where a symbol's text is in `Interner::text`.
struct Span {
    start: u32,
    len: u32,
}

/// Maps texts to symbols and back.
///
/// Every array in it only grows, so `intern` is `&mut +self`: texts from
/// `resolve` stay valid across later calls. (It keeps its own hash table,
/// grown in place, rather than a `HashMap`, whose `insert` replaces its
/// table when it grows.)
pub struct Interner {
    text: String,
    spans: [Span; ..+],
    /// Each symbol's hash.
    hashes: [u64; ..+],
    /// Open addressing: symbol index + 1 per slot (0: empty); a power of
    /// two in length, or empty.
    table: [u32; ..+],
}

impl Interner {
    pub fn new(): Interner {
        return Interner { text: String::new(), spans: [], hashes: [], table: [] };
    }

    /// The symbol for `s`, if it has been interned.
    pub fn get(&self, s: str): Option::<Symbol> {
        if self.table.len() == 0 {
            return None;
        }
        let h = hash_of(&s);
        let mask = self.table.len() - 1;
        let mut i = (h as usize) & mask;
        loop {
            let e = self.table[i];
            if e == 0 {
                return None;
            }
            let sym = Symbol { index: e - 1 };
            if self.hashes[sym.index as usize] == h && self.resolve(sym) == s {
                return Some(sym);
            }
            i = (i + 1) & mask;
        }
    }

    /// The symbol for `s`, interning it if it is new.
    pub fn intern(&mut +self, s: str): Symbol {
        if let Some(sym) = self.get(s) {
            return sym;
        }
        let index = self.spans.len() as u32;
        self.spans.push(Span { start: self.text.len() as u32, len: s.len() as u32 });
        self.text.push_str(s);
        self.hashes.push(hash_of(&s));
        if self.spans.len() * 4 > self.table.len() * 3 {
            self.grow();
        } else {
            self.place(index);
        }
        return Symbol { index };
    }

    /// Double the table (to 8 slots at first), in place, and put every
    /// symbol back.
    fn grow(&mut +self) {
        let n = self.table.len();
        let cap = if n == 0 { 8 } else { n * 2 };
        for i in 0..n {
            self.table[i] = 0;
        }
        while self.table.len() < cap {
            self.table.push(0);
        }
        for sym in 0..self.spans.len() {
            self.place(sym as u32);
        }
    }

    /// Put symbol `index` in the first free slot for its hash.
    fn place(&mut +self, index: u32) {
        let mask = self.table.len() - 1;
        let mut i = (self.hashes[index as usize] as usize) & mask;
        while self.table[i] != 0 {
            i = (i + 1) & mask;
        }
        self.table[i] = index + 1;
    }

    /// The text of a symbol this interner made.
    pub fn resolve(&self, sym: Symbol): str {
        let sp = self.spans[sym.index as usize];
        let start = sp.start as usize;
        return self.text[start..start + sp.len as usize];
    }

    /// The number of distinct texts.
    pub fn len(&self): usize {
        return self.spans.len();
    }
}
