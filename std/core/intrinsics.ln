// Compiler intrinsics. Their bodies are generated by the code generator.

#[intrinsic] pub fn size_of::<T>(): usize;
#[intrinsic] pub fn align_of::<T>(): usize;

// ----- slices -----
#[intrinsic] pub fn slice_len::<T: Light>(s: [T; &]): usize;
#[intrinsic] pub fn slice_ptr::<T: Light>(s: [T; &]): *T;
#[intrinsic] pub fn slice_mut_ptr::<T: Light>(s: [T; &mut]): *mut T;
#[intrinsic] pub unsafe fn slice_from_raw::<T: Light>(p: *T, len: usize): [T; &];
#[intrinsic] pub unsafe fn slice_mut_from_raw::<T: Light>(p: *mut T, len: usize): [T; &mut];

// ----- owning arrays -----
/// Append one element (grows the array's data stack in place).
#[intrinsic] pub fn arr_push::<T: Light>(a: &mut +[T; ..+], kept value: T);
/// Append a copy of every element of `s`.
#[intrinsic] pub fn arr_extend::<T: Light>(a: &mut +[T; ..+], kept s: [T; &]);
/// Make room for `extra` more elements without changing the length.
#[intrinsic] pub fn arr_reserve::<T: Light>(a: &mut +[T; ..+], extra: usize);
#[intrinsic] pub fn arr_cap::<T: Light>(a: &mut [T; ..+], count: usize);
#[intrinsic] pub fn string_cap(s: &mut String, bytes: usize);
/// Shrink to `len` elements (no-op if already shorter).
#[intrinsic] pub fn arr_truncate::<T: Light>(a: &mut [T; -..+], len: usize);
/// A frozen `[T]` holding a copy of `s`.
#[intrinsic] pub fn arr_from_slice::<T: Light>(s: [T; &]): [T];

// ----- strings -----
#[intrinsic] pub fn str_len(s: str): usize;
#[intrinsic] pub fn str_bytes(s: str): [u8; &];
#[intrinsic] pub unsafe fn str_from_bytes(b: [u8; &]): str;
#[intrinsic] pub fn string_new(): String;
#[intrinsic] pub fn string_push_str(s: &mut +String, t: str);
#[intrinsic] pub fn string_as_str(s: &String): str;
#[intrinsic] pub fn string_truncate(s: &mut String, len: usize);
#[intrinsic] pub fn fmt_write(args: FmtArgs, out: &mut +String);

// ----- raw pointers -----
#[intrinsic] pub unsafe fn ptr_read::<T>(p: *T): T;
#[intrinsic] pub unsafe fn ptr_write::<T>(p: *mut T, value: T);
#[intrinsic] pub fn ptr_offset::<T>(p: *T, n: isize): *T;
#[intrinsic] pub fn ptr_offset_mut::<T>(p: *mut T, n: isize): *mut T;
#[intrinsic] pub fn ptr_null::<T>(): *T;
#[intrinsic] pub fn ptr_null_mut::<T>(): *mut T;
/// Address of a mutable place (the argument is passed in-out).
#[intrinsic] pub fn addr_of_mut::<T>(place: &mut T): *mut T;

// ----- control -----
#[intrinsic] pub fn abort(): !;
#[intrinsic] pub unsafe fn unreachable(): !;

// ----- atomics -----
// `p` must be aligned and valid for the access. Orderings are LLVM's
// numbers (`std::sync::atomic::Ordering` maps to them): 2 relaxed,
// 4 acquire, 5 release, 6 acquire-release, 7 sequentially consistent; they
// must be constants at the call (anything else is sequentially
// consistent). `T` is an integer or a raw pointer.
/// The address of a borrowed place.
#[intrinsic] pub fn addr_of::<T>(place: &T): *T;
#[intrinsic] pub unsafe fn atomic_load::<T>(p: *T, order: u32): T;
#[intrinsic] pub unsafe fn atomic_store::<T>(p: *mut T, value: T, order: u32);
#[intrinsic] pub unsafe fn atomic_swap::<T>(p: *mut T, value: T, order: u32): T;
/// Store `new` if the value is `old`; returns the value before either way.
#[intrinsic] pub unsafe fn atomic_cas::<T>(p: *mut T, old: T, new: T, order: u32): T;
#[intrinsic] pub unsafe fn atomic_add::<T>(p: *mut T, value: T, order: u32): T;
#[intrinsic] pub unsafe fn atomic_sub::<T>(p: *mut T, value: T, order: u32): T;
#[intrinsic] pub unsafe fn atomic_and::<T>(p: *mut T, value: T, order: u32): T;
#[intrinsic] pub unsafe fn atomic_nand::<T>(p: *mut T, value: T, order: u32): T;
#[intrinsic] pub unsafe fn atomic_or::<T>(p: *mut T, value: T, order: u32): T;
#[intrinsic] pub unsafe fn atomic_xor::<T>(p: *mut T, value: T, order: u32): T;
#[intrinsic] pub unsafe fn atomic_max::<T>(p: *mut T, value: T, order: u32): T;
#[intrinsic] pub unsafe fn atomic_min::<T>(p: *mut T, value: T, order: u32): T;
#[intrinsic] pub fn atomic_fence(order: u32);
