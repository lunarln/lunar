/// Success (`Ok`) or failure (`Err`).
#[lang = "result"]
pub enum Result::<T, E> {
    Ok(T),
    Err(E),
}

impl::<T, E> Result::<T, E> {
    pub fn is_ok(&self): bool {
        return match self {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        };
    }

    pub fn is_err(&self): bool {
        return !self.is_ok();
    }
}

impl::<T: Dull, E: Dull> Result::<T, E> {
    pub fn unwrap(self): T {
        return match self {
            Result::Ok(v) => v,
            Result::Err(_) => panic("called `Result::unwrap()` on an `Err` value"),
        };
    }

    pub fn unwrap_or(self, default: T): T {
        return match self {
            Result::Ok(v) => v,
            Result::Err(_) => default,
        };
    }

    pub fn ok(self): Option::<T> {
        return match self {
            Result::Ok(v) => Some(v),
            Result::Err(_) => None,
        };
    }
}
