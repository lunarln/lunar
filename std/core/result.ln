/// Success (`Ok`) or failure (`Err`).
#[lang = "result"]
pub enum Result::<T, E> {
    Ok(T),
    Err(E),
}

impl::<T, E> Result::<T, E> {
    pub fn is_ok(&self): bool {
        return match self {
            Result::Ok(_) => true,
            Result::Err(_) => false,
        };
    }

    pub fn is_err(&self): bool {
        return !self.is_ok();
    }
}

impl::<T, E> Result::<T, E> {
    pub fn unwrap(self): T {
        return match self {
            Result::Ok(v) => v,
            Result::Err(_) => panic("called `Result::unwrap()` on an `Err` value"),
        };
    }

    pub fn unwrap_or(self, default: T): T {
        return match self {
            Result::Ok(v) => v,
            Result::Err(_) => default,
        };
    }

    pub fn ok(self): Option::<T> {
        return match self {
            Result::Ok(v) => Some(v),
            Result::Err(_) => None,
        };
    }
}

impl::<T: Eq + Light, E: Eq + Light> Eq for Result::<T, E> {
    fn eq(&self, other: &Result::<T, E>): bool {
        return match self {
            Result::Ok(a) => match other {
                Result::Ok(b) => a == b,
                Result::Err(_) => false,
            },
            Result::Err(a) => match other {
                Result::Ok(_) => false,
                Result::Err(b) => a == b,
            },
        };
    }
}

impl::<T: crater::fmt::Debug + Light, E: crater::fmt::Debug + Light> crater::fmt::Debug for Result::<T, E> {
    fn debug(&self, out: &mut +String) {
        match self {
            Result::Ok(v) => {
                out.push_str("Ok(");
                v.debug(out);
                out.push(')');
            }
            Result::Err(e) => {
                out.push_str("Err(");
                e.debug(out);
                out.push(')');
            }
        }
    }
}
