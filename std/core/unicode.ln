    (0x1E900, 0x1E921, 34, 0),
];

/// The simple lowercase mapping of the code point `c`.
pub fn to_lower(c: u32): u32 {
    if c < 128 {
        return if c >= 65 && c <= 90 { c + 32 } else { c };
    }
    // Mappings that do not go back the same way.
    let one_way = match c {
        // İ, ẞ, the Ohm, Kelvin and Angstrom signs
        0x130 => 0x69,
        0x1E9E => 0xDF,
        0x2126 => 0x3C9,
        0x212A => 0x6B,
        0x212B => 0xE5,
        // The titlecase digraphs Dž, Lj, Nj, Dz
        0x1C5 | 0x1C8 | 0x1CB | 0x1F2 => c + 1,
        _ => 0,
    };
    if one_way != 0 {
        return one_way;
    }
    for e in CASES {
        let (lo, hi, delta, kind) = e;
        if c >= lo && c <= hi {
            if kind == 0 {
                return ((c as i64) + (delta as i64)) as u32;
            }
            if (c - lo) % 2 == 0 {
                return c + 1;
            }
        }
    }
    return c;
}

/// The simple uppercase mapping of the code point `c`.
pub fn to_upper(c: u32): u32 {
    if c < 128 {
        return if c >= 97 && c <= 122 { c - 32 } else { c };
    }
    let one_way = match c {
        // µ, ı, ſ, ς and the Greek symbol forms
        0xB5 => 0x39C,
        0x131 => 0x49,
        0x17F => 0x53,
        0x3C2 => 0x3A3,
        0x3D0 => 0x392,
        0x3D1 => 0x398,
        0x3D5 => 0x3A6,
        0x3D6 => 0x3A0,
        0x3F0 => 0x39A,
        0x3F1 => 0x3A1,
        0x3F5 => 0x395,
        0x1E9B => 0x1E60,
        0x1FBE => 0x399,
        0x1C5 | 0x1C8 | 0x1CB | 0x1F2 => c - 1,
        _ => 0,
    };
    if one_way != 0 {
        return one_way;
    }
    let x = c as i64;
    for e in CASES {
        let (lo, hi, delta, kind) = e;
        if kind == 0 {
            let d = delta as i64;
            if x >= (lo as i64) + d && x <= (hi as i64) + d {
                return (x - d) as u32;
            }
        } else if c > lo && c <= hi + 1 && (c - lo) % 2 == 1 {
            return c - 1;
        }
    }
    return c;
}
