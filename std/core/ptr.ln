// `Dull` is implemented by the compiler for every type that is not a pointer
// or array and contains none. `Light` is implemented for every type that
// owns no array or string (Dull types, and views such as `str` and slices),
// and only Light types can be array or slice items. Neither can be
// implemented (or `!`implemented) manually.
#[lang = "dull"]
pub trait Dull: Light {}

#[lang = "light"]
pub trait Light {}

/// Whether a raw pointer is null.
pub fn is_null::<T>(p: *T): bool {
    return (p as usize) == 0;
}

pub fn null::<T>(): *T {
    return crater::intrinsics::ptr_null::<T>();
}

pub fn null_mut::<T>(): *mut T {
    return crater::intrinsics::ptr_null_mut::<T>();
}

/// `p` moved by `n` items.
pub fn offset::<T>(p: *T, n: isize): *T {
    return crater::intrinsics::ptr_offset(p, n);
}

/// `p` moved by `n` items.
pub fn offset_mut::<T>(p: *mut T, n: isize): *mut T {
    return crater::intrinsics::ptr_offset_mut(p, n);
}

/// The value at `p`.
pub unsafe fn read::<T>(p: *T): T {
    return unsafe { crater::intrinsics::ptr_read(p) };
}

/// Store `value` at `p`.
pub unsafe fn write::<T>(p: *mut T, value: T) {
    unsafe { crater::intrinsics::ptr_write(p, value) };
}
