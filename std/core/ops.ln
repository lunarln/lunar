// Operator traits. Primitive types implement them natively (with `Output`
// the type itself). Both operands have the type implementing the trait;
// `Output` is the type of the result: `a + b` is `<A as Add>::Output`.

#[lang = "add"] pub trait Add { type Output; fn add(&self, rhs: &Self): Self::Output; }
#[lang = "sub"] pub trait Sub { type Output; fn sub(&self, rhs: &Self): Self::Output; }
#[lang = "mul"] pub trait Mul { type Output; fn mul(&self, rhs: &Self): Self::Output; }
#[lang = "div"] pub trait Div { type Output; fn div(&self, rhs: &Self): Self::Output; }
#[lang = "rem"] pub trait Rem { type Output; fn rem(&self, rhs: &Self): Self::Output; }
#[lang = "neg"] pub trait Neg { type Output; fn neg(&self): Self::Output; }
#[lang = "not"] pub trait Not { type Output; fn not(&self): Self::Output; }
#[lang = "bitand"] pub trait BitAnd { type Output; fn bitand(&self, rhs: &Self): Self::Output; }
#[lang = "bitor"] pub trait BitOr { type Output; fn bitor(&self, rhs: &Self): Self::Output; }
#[lang = "bitxor"] pub trait BitXor { type Output; fn bitxor(&self, rhs: &Self): Self::Output; }
#[lang = "shl"] pub trait Shl { type Output; fn shl(&self, rhs: &Self): Self::Output; }
#[lang = "shr"] pub trait Shr { type Output; fn shr(&self, rhs: &Self): Self::Output; }

// Things that can be called: closures, functions and function pointers.
// `Sig` is a function pointer type, written with sugar in bounds:
// `F: Fn(i32): bool` is `F: Fn::<fn(i32): bool>`. Calls are built in, so
// the traits have no methods.

/// Can be called any number of times, and calling it changes nothing it
/// captured.
#[lang = "fn"] pub trait Fn::<Sig>: FnMut::<Sig> {}
/// Can be called any number of times; a call may change what it captured.
#[lang = "fn_mut"] pub trait FnMut::<Sig>: FnOnce::<Sig> {}
/// Can be called at least once; the call may consume what it captured.
#[lang = "fn_once"] pub trait FnOnce::<Sig> {}

/// A half-open range `start..end`.
#[lang = "range"]
pub struct Range::<T> {
    pub start: T,
    pub end: T,
}

impl::<T: crater::num::Int> Iterator for Range::<T> {
    type Item = T;

    fn next(&mut self): Option::<T> {
        if self.start < self.end {
            let v = self.start;
            self.start = self.start + T::one();
            return Some(v);
        }
        return None;
    }
}

impl::<T: crater::num::Int> Range::<T> {
    pub fn contains(self, x: T): bool {
        return x >= self.start && x < self.end;
    }

    pub fn is_empty(self): bool {
        return !(self.start < self.end);
    }
}
