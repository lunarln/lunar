// `String`: owned UTF-8 text. Laid out exactly like a `[u8; -..+]` living on
// its own data stack; `str` is the borrowed view.

use crater::intrinsics;

impl String {
    pub fn new(): String {
        return intrinsics::string_new();
    }

    /// This empty string, limited to `bytes` bytes: it reserves only the
    /// address space that needs, and growing past it is a fatal error.
    pub fn capped(mut self, bytes: usize): String {
        intrinsics::string_cap(&mut self, bytes);
        return self;
    }

    pub fn from(s: str): String {
        let mut out = intrinsics::string_new();
        intrinsics::string_push_str(&mut out, s);
        return out;
    }

    pub fn as_str(&self): str {
        return intrinsics::string_as_str(self);
    }

    pub fn as_bytes(&self): [u8; &] {
        return intrinsics::str_bytes(intrinsics::string_as_str(self));
    }

    /// Length in bytes.
    pub fn len(&self): usize {
        return intrinsics::str_len(intrinsics::string_as_str(self));
    }

    pub fn is_empty(&self): bool {
        return self.len() == 0;
    }

    pub fn push_str(&mut +self, s: str) {
        intrinsics::string_push_str(self, s);
    }

    /// Append a character, UTF-8 encoded.
    pub fn push(&mut +self, c: char) {
        let cp = c as u32;
        let mut buf: [u8; 4] = [0; 4];
        let n: usize = if cp < 128 {
            buf[0] = cp as u8;
            1
        } else if cp < 2048 {
            buf[0] = (192 | (cp >> 6)) as u8;
            buf[1] = (128 | (cp & 63)) as u8;
            2
        } else if cp < 65536 {
            buf[0] = (224 | (cp >> 12)) as u8;
            buf[1] = (128 | ((cp >> 6) & 63)) as u8;
            buf[2] = (128 | (cp & 63)) as u8;
            3
        } else {
            buf[0] = (240 | (cp >> 18)) as u8;
            buf[1] = (128 | ((cp >> 12) & 63)) as u8;
            buf[2] = (128 | ((cp >> 6) & 63)) as u8;
            buf[3] = (128 | (cp & 63)) as u8;
            4
        };
        intrinsics::string_push_str(self, unsafe { intrinsics::str_from_bytes(buf[..n]) });
    }

    /// Append formatted text: `s.write("x = {x}")`.
    pub fn write(&mut +self, args: FmtArgs) {
        intrinsics::fmt_write(args, self);
    }

    pub fn clear(&mut self) {
        intrinsics::string_truncate(self, 0);
    }

    /// Shorten to `len` bytes, which must be on a character boundary.
    pub fn truncate(&mut self, len: usize) {
        if len < self.len() {
            let b = self.as_bytes()[len];
            if b >= 128 && b < 192 {
                panic("String::truncate: {len} is not a char boundary");
            }
        }
        intrinsics::string_truncate(self, len);
    }

    /// Remove and return the last character.
    pub fn pop(&mut self): Option::<char> {
        let n = self.len();
        if n == 0 {
            return None;
        }
        let mut start = n - 1;
        while start > 0 && self.as_bytes()[start] >= 128 && self.as_bytes()[start] < 192 {
            start -= 1;
        }
        let c = self.as_str()[start..].chars().next();
        intrinsics::string_truncate(self, start);
        return c;
    }

    /// `bytes` as text, or `None` if they are not UTF-8.
    pub fn from_utf8(bytes: [u8; &]): Option::<String> {
        let s = str::from_utf8(bytes)?;
        return Some(String::from(s));
    }

    /// `bytes` as text, with U+FFFD for each byte that does not start a
    /// valid UTF-8 sequence.
    pub fn from_utf8_lossy(bytes: [u8; &]): String {
        let mut out = String::new();
        let mut start: usize = 0;
        while start < bytes.len() {
            match crater::str::utf8_error_at(bytes[start..]) {
                None => {
                    out.push_str(unsafe { intrinsics::str_from_bytes(bytes[start..]) });
                    return out;
                }
                Some(i) => {
                    out.push_str(unsafe { intrinsics::str_from_bytes(bytes[start..start + i]) });
                    out.push(crater::str::char_from_u32(0xFFFD));
                    start = start + i + 1;
                }
            }
        }
        return out;
    }

    fn check_boundary(&self, i: usize, what: str) {
        if !self.as_str().is_char_boundary(i) {
            panic("String::{what}: {i} is not a char boundary of a string of {self.len()} bytes");
        }
    }

    /// Insert `c` at byte `i` (a character boundary), moving what follows.
    pub fn insert(&mut self, i: usize, c: char) {
        let mut one = String::new();
        one.push(c);
        self.insert_str(i, one.as_str());
    }

    /// Insert `s` at byte `i` (a character boundary), moving what follows.
    pub fn insert_str(&mut self, i: usize, s: str) {
        self.check_boundary(i, "insert");
        let tail = String::from(self.as_str()[i..]);
        intrinsics::string_truncate(self, i);
        intrinsics::string_push_str(self, s);
        intrinsics::string_push_str(self, tail.as_str());
    }

    /// Remove and return the character at byte `i` (a character
    /// boundary), moving what follows.
    pub fn remove(&mut self, i: usize): char {
        self.check_boundary(i, "remove");
        let c = match self.as_str()[i..].chars().next() {
            Some(c) => c,
            None => panic("String::remove: {i} is the end of the string"),
        };
        let tail = String::from(self.as_str()[i + c.len_utf8()..]);
        intrinsics::string_truncate(self, i);
        intrinsics::string_push_str(self, tail.as_str());
        return c;
    }

    /// Keep only the characters for which `keep` is true.
    pub fn retain::<F: FnMut(char): bool>(&mut self, mut keep: F) {
        let mut out = String::new();
        for c in self.as_str().chars() {
            if keep(c) {
                out.push(c);
            }
        }
        intrinsics::string_truncate(self, 0);
        intrinsics::string_push_str(self, out.as_str());
    }

    /// Split off the text from byte `at` (a character boundary), leaving
    /// the text before it.
    pub fn split_off(&mut self, at: usize): String {
        self.check_boundary(at, "split_off");
        let tail = String::from(self.as_str()[at..]);
        intrinsics::string_truncate(self, at);
        return tail;
    }
}

impl Clone for String {
    fn clone(&self): String {
        return String::from(self.as_str());
    }
}

impl Eq for String {
    fn eq(&self, other: &String): bool {
        return self.as_str() == other.as_str();
    }
}

impl Ord for String {
    fn cmp(&self, other: &String): crater::cmp::Ordering {
        return self.as_str().cmp(&other.as_str());
    }
}
