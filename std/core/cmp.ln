#[lang = "ordering"]
pub enum Ordering {
    Less,
    Equal,
    Greater,
}

/// Equality, used by `==` and `!=`.
#[lang = "eq"]
pub trait Eq {
    fn eq(&self, other: &Self): bool;

    /// `!=`.
    fn ne(&self, other: &Self): bool {
        return !self.eq(other);
    }
}

/// Total ordering, used by `<`, `<=`, `>` and `>=`.
#[lang = "ord"]
pub trait Ord: Eq {
    fn cmp(&self, other: &Self): Ordering;

    fn lt(&self, other: &Self): bool {
        return match self.cmp(other) {
            Ordering::Less => true,
            _ => false,
        };
    }

    fn le(&self, other: &Self): bool {
        return match self.cmp(other) {
            Ordering::Greater => false,
            _ => true,
        };
    }

    fn gt(&self, other: &Self): bool {
        return match self.cmp(other) {
            Ordering::Greater => true,
            _ => false,
        };
    }

    fn ge(&self, other: &Self): bool {
        return match self.cmp(other) {
            Ordering::Less => false,
            _ => true,
        };
    }
}

impl Eq for Ordering {
    fn eq(&self, other: &Ordering): bool {
        return match (self, other) {
            (Ordering::Less, Ordering::Less) => true,
            (Ordering::Equal, Ordering::Equal) => true,
            (Ordering::Greater, Ordering::Greater) => true,
            _ => false,
        };
    }
}

impl::<A: Eq, B: Eq> Eq for (A, B) {
    fn eq(&self, other: &(A, B)): bool {
        return self.0 == other.0 && self.1 == other.1;
    }
}

impl::<A: Eq, B: Eq, C: Eq> Eq for (A, B, C) {
    fn eq(&self, other: &(A, B, C)): bool {
        return self.0 == other.0 && self.1 == other.1 && self.2 == other.2;
    }
}

impl crater::fmt::Display for Ordering {
    fn fmt(&self, out: &mut +String) {
        out.push_str(match self {
            Ordering::Less => "Less",
            Ordering::Equal => "Equal",
            Ordering::Greater => "Greater",
        });
    }
}

pub fn min::<T: Ord + Light>(a: T, b: T): T {
    if b < a { return b; }
    return a;
}

pub fn max::<T: Ord + Light>(a: T, b: T): T {
    if b > a { return b; }
    return a;
}

impl crater::fmt::Debug for Ordering {
    fn debug(&self, out: &mut +String) {
        self.fmt(out);
    }
}

/// `x` with its order turned around: `Reverse(a) < Reverse(b)` when
/// `a > b`. Pushing `Reverse(x)` into a `BinaryHeap` pops the smallest
/// first; sorting `Reverse`s sorts in descending order.
pub struct Reverse::<T>(pub T);

impl::<T: Eq> Eq for Reverse::<T> {
    fn eq(&self, other: &Reverse::<T>): bool {
        return self.0 == other.0;
    }
}

impl::<T: Ord> Ord for Reverse::<T> {
    fn cmp(&self, other: &Reverse::<T>): Ordering {
        return other.0.cmp(&self.0);
    }
}

impl::<T: crater::fmt::Debug> crater::fmt::Debug for Reverse::<T> {
    fn debug(&self, out: &mut +String) {
        out.push_str("Reverse(");
        self.0.debug(out);
        out.push(')');
    }
}

// ===================================================================== derives

/// `#[derive(Eq)]`: equal when every field is equal; for enums, the same
/// variant with equal fields (an enum's fields must also be `Dull`).
#[derive_macro]
pub macro Eq {
    ($(#[$m:meta])* $v:vis struct $n:ident $g:generics { $($(#[$fm:meta])* $fv:vis $f:ident: $ft:ty),* $(,)? }) => {
        impl $g.bound(Eq) Eq for $n $g.args {
            fn eq(&self, other: &Self): bool {
                return true $(&& self.$f == other.$f)*;
            }
        }
    },
    ($(#[$m:meta])* $v:vis struct $n:ident $g:generics ($($(#[$fm:meta])* $fv:vis $ft:ty),* $(,)?);) => {
        impl $g.bound(Eq) Eq for $n $g.args {
            fn eq(&self, other: &Self): bool {
                return true $(&& self.${index()} == other.${index()} ${ignore($ft)})*;
            }
        }
    },
    ($(#[$m:meta])* $v:vis struct $n:ident $g:generics;) => {
        impl $g.bound(Eq) Eq for $n $g.args {
            fn eq(&self, other: &Self): bool {
                return true;
            }
        }
    },
    ($(#[$m:meta])* $v:vis enum $n:ident $g:generics {
        $($(#[$vm:meta])* $var:ident $(($($vt:ty),* $(,)?))? $({$($vf:ident: $vft:ty),* $(,)?})?),* $(,)?
    }) => {
        impl $g.bound(Eq) Eq for $n $g.args {
            fn eq(&self, other: &Self): bool {
                return variant_index(self) == variant_index(other) && match self {
                    $(
                        $n::$var $(($(${concat(a, index())} ${ignore($vt)}),*))? $({$($vf: ${concat(a_, $vf)}),*})? => match other {
                            $n::$var $(($(${concat(b, index())} ${ignore($vt)}),*))? $({$($vf: ${concat(b_, $vf)}),*})? => {
                                true
                                $($(&& ${concat(a, index())} == ${concat(b, index())} ${ignore($vt)})*)?
                                $($(&& ${concat(a_, $vf)} == ${concat(b_, $vf)})*)?
                            }
                            _ => false,
                        },
                    )*
                };
            }
        }

        fn variant_index $g (x: &$n $g.args): usize {
            return match x {
                $($n::$var $((.. ${ignore($vt)}))? $({ .. ${ignore($vf)} })? => ${index()}),*
            };
        }
    },
}

/// `#[derive(Ord)]`: compares field by field in declaration order; enums
/// first by variant (in declaration order), then by fields. Needs `Eq` too.
#[derive_macro]
pub macro Ord {
    ($(#[$m:meta])* $v:vis struct $n:ident $g:generics { $($(#[$fm:meta])* $fv:vis $f:ident: $ft:ty),* $(,)? }) => {
        impl $g.bound(Ord) Ord for $n $g.args {
            fn cmp(&self, other: &Self): Ordering {
                $(
                    let c = self.$f.cmp(&other.$f);
                    if c != Ordering::Equal {
                        return c;
                    }
                )*
                return Ordering::Equal;
            }
        }
    },
    ($(#[$m:meta])* $v:vis struct $n:ident $g:generics ($($(#[$fm:meta])* $fv:vis $ft:ty),* $(,)?);) => {
        impl $g.bound(Ord) Ord for $n $g.args {
            fn cmp(&self, other: &Self): Ordering {
                $(
                    let c = self.${index()}.cmp(&other.${index()});
                    if c != Ordering::Equal {
                        return c;
                    }
                    ${ignore($ft)}
                )*
                return Ordering::Equal;
            }
        }
    },
    ($(#[$m:meta])* $v:vis struct $n:ident $g:generics;) => {
        impl $g.bound(Ord) Ord for $n $g.args {
            fn cmp(&self, other: &Self): Ordering {
                return Ordering::Equal;
            }
        }
    },
    ($(#[$m:meta])* $v:vis enum $n:ident $g:generics {
        $($(#[$vm:meta])* $var:ident $(($($vt:ty),* $(,)?))? $({$($vf:ident: $vft:ty),* $(,)?})?),* $(,)?
    }) => {
        impl $g.bound(Ord) Ord for $n $g.args {
            fn cmp(&self, other: &Self): Ordering {
                let (i, j) = (variant_index(self), variant_index(other));
                if i != j {
                    return i.cmp(&j);
                }
                return match self {
                    $(
                        $n::$var $(($(${concat(a, index())} ${ignore($vt)}),*))? $({$($vf: ${concat(a_, $vf)}),*})? => match other {
                            $n::$var $(($(${concat(b, index())} ${ignore($vt)}),*))? $({$($vf: ${concat(b_, $vf)}),*})? => {
                                $($(
                                    let c = ${concat(a, index())}.cmp(&${concat(b, index())});
                                    if c != Ordering::Equal {
                                        return c;
                                    }
                                    ${ignore($vt)}
                                )*)?
                                $($(
                                    let c = ${concat(a_, $vf)}.cmp(&${concat(b_, $vf)});
                                    if c != Ordering::Equal {
                                        return c;
                                    }
                                )*)?
                                Ordering::Equal
                            }
                            _ => Ordering::Equal,
                        },
                    )*
                };
            }
        }

        fn variant_index $g (x: &$n $g.args): usize {
            return match x {
                $($n::$var $((.. ${ignore($vt)}))? $({ .. ${ignore($vf)} })? => ${index()}),*
            };
        }
    },
}
