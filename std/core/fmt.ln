// Formatting. A string literal passed to a `FmtArgs` parameter is
// interpolated: `"x = {x}"` calls `Display::fmt` on `x`.

use crater::intrinsics;

/// Types that can be written into a `String` by format strings.
#[lang = "display"]
pub trait Display {
    fn fmt(&self, out: &mut +String);
}

/// Append formatted text to `out`.
pub fn write(out: &mut +String, args: FmtArgs) {
    intrinsics::fmt_write(args, out);
}

/// Format into a new `String`.
pub fn format(args: FmtArgs): String {
    let mut s = String::new();
    intrinsics::fmt_write(args, &mut s);
    return s;
}

/// Write the decimal digits of `value`.
pub fn write_u64(out: &mut +String, value: u64) {
    let mut buf: [u8; 20] = [0; 20];
    let mut i: usize = 20;
    let mut v = value;
    if v == 0 {
        out.push_str("0");
        return;
    }
    while v > 0 {
        i -= 1;
        buf[i] = (v % 10) as u8 + 48;
        v /= 10;
    }
    out.push_str(unsafe { intrinsics::str_from_bytes(buf[i..]) });
}

pub fn write_i64(out: &mut +String, value: i64) {
    if value < 0 {
        out.push_str("-");
        // Negate in u64 so that i64::MIN works.
        write_u64(out, (0 as u64).wrapping_sub(value as u64));
    } else {
        write_u64(out, value as u64);
    }
}

/// Write `value` in the given radix (2..=36) without a prefix.
pub fn write_radix(out: &mut +String, value: u64, radix: u64) {
    let mut buf: [u8; 64] = [0; 64];
    let mut i: usize = 64;
    let mut v = value;
    if v == 0 {
        out.push_str("0");
        return;
    }
    while v > 0 {
        i -= 1;
        let d = (v % radix) as u8;
        buf[i] = if d < 10 { d + 48 } else { d - 10 + 97 };
        v /= radix;
    }
    out.push_str(unsafe { intrinsics::str_from_bytes(buf[i..]) });
}

// ===================================================================== format specs
//
// A hole with a spec (`{x:>+10.3}`, `{n:#010x}`) is compiled to: remember
// where the value starts in `out`, write the value (with `Display`,
// `Debug`, `fmt_radix` or `std::fmt::fmt_float`), then `fmt_pad` it in
// place. A hole without one calls `Display::fmt` or `Debug::debug` alone.

/// `fmt_radix` flags: `X` rather than `x`, and `#` (the prefix).
const RADIX_UPPER: u32 = 1;
const RADIX_PREFIX: u32 = 2;

/// `{n:x}`, `{n:#X}`, `{n:o}`, `{n:b}`: the bits of an integer (negative
/// ones in two's complement of their own width, which the compiler has
/// zero-extended into `value`), in base 16, 8 or 2.
#[lang = "fmt_radix"]
fn fmt_radix(out: &mut +String, value: u64, radix: u64, flags: u32) {
    if flags & RADIX_PREFIX != 0 {
        out.push_str(if radix == 16 { "0x" } else if radix == 8 { "0o" } else { "0b" });
    }
    let mut buf: [u8; 64] = [0; 64];
    let mut i: usize = 64;
    let mut v = value;
    let letters: u8 = if flags & RADIX_UPPER != 0 { 65 } else { 97 };
    loop {
        i -= 1;
        let d = (v % radix) as u8;
        buf[i] = if d < 10 { d + 48 } else { d - 10 + letters };
        v /= radix;
        if v == 0 {
            break;
        }
    }
    out.push_str(unsafe { intrinsics::str_from_bytes(buf[i..]) });
}

/// `fmt_pad` flags. The alignment is resolved by the compiler: right for
/// numbers and left for the rest unless the spec says otherwise.
const PAD_WIDTH: u32 = 1;
const PAD_PLUS: u32 = 2;
const PAD_ZERO: u32 = 4;
const PAD_PREFIX: u32 = 8;
const PAD_TRUNCATE: u32 = 16;
const PAD_CENTER: u32 = 32;
const PAD_RIGHT: u32 = 64;

/// The number of characters in `b`, which is UTF-8.
fn char_count(b: [u8; &]): usize {
    let mut n: usize = 0;
    for c in b {
        if c & 0xC0 != 0x80 {
            n += 1;
        }
    }
    return n;
}

/// Reverse the bytes `lo..hi` at `p`.
unsafe fn reverse_bytes(p: *mut u8, lo: usize, hi: usize) {
    let mut i = lo;
    let mut j = hi;
    while i + 1 < j {
        j -= 1;
        let a = intrinsics::ptr_offset_mut(p, i as isize);
        let b = intrinsics::ptr_offset_mut(p, j as isize);
        unsafe {
            let t = intrinsics::ptr_read(a as *u8);
            intrinsics::ptr_write(a, intrinsics::ptr_read(b as *u8));
            intrinsics::ptr_write(b, t);
        }
        i += 1;
    }
}

/// Insert `n` copies of `c` into `out` at byte `at`, in place: they are
/// pushed at the end, then rotated into place.
fn insert_chars(out: &mut +String, at: usize, c: char, n: usize) {
    if n == 0 {
        return;
    }
    let old = out.len();
    for _ in 0..n {
        out.push(c);
    }
    let end = out.len();
    unsafe {
        let p = (intrinsics::slice_ptr(out.as_bytes()) as usize) as *mut u8;
        reverse_bytes(p, at, old);
        reverse_bytes(p, old, end);
        reverse_bytes(p, at, end);
    }
}

/// Finish a value written to `out` from byte `start` on, as its spec
/// says: keep `precision` characters of it (`PAD_TRUNCATE`, for strings),
/// put `+` before a number that has no sign (`PAD_PLUS`; not before `NaN`),
/// and pad it to `width` characters (`PAD_WIDTH`) with `fill` on the left,
/// both sides or the right, or (`PAD_ZERO`) with zeros after its sign and,
/// with `PAD_PREFIX`, its `0x`, `0o` or `0b`.
#[lang = "fmt_pad"]
fn fmt_pad(out: &mut +String, start: usize, width: usize, precision: usize, fill: u32, flags: u32) {
    if flags & PAD_TRUNCATE != 0 {
        let b = out.as_bytes();
        let mut n: usize = 0;
        let mut i = start;
        while i < b.len() {
            if b[i] & 0xC0 != 0x80 {
                if n == precision {
                    break;
                }
                n += 1;
            }
            i += 1;
        }
        // Only the value just written is cut, after anything the caller
        // can hold a view into: `out` still only grows as far as they can
        // tell (so this is not `truncate`, which a `+` parameter forbids).
        unsafe {
            let h = (intrinsics::addr_of(out) as usize) as *mut usize;
            intrinsics::ptr_write(intrinsics::ptr_offset_mut(h, 1), i);
        }
    }
    if flags & PAD_PLUS != 0 {
        let s = out.as_str()[start..];
        if !s.starts_with("-") && s != "NaN" {
            insert_chars(out, start, '+', 1);
        }
    }
    if flags & PAD_WIDTH == 0 {
        return;
    }
    let len = char_count(out.as_bytes()[start..]);
    if len >= width {
        return;
    }
    let pad = width - len;
    if flags & PAD_ZERO != 0 {
        let b = out.as_bytes();
        let mut at = start;
        if at < b.len() && (b[at] == b'+' || b[at] == b'-') {
            at += 1;
        }
        if flags & PAD_PREFIX != 0 {
            at += 2;
        }
        insert_chars(out, at, '0', pad);
        return;
    }
    let c = match char::from_u32(fill) {
        Some(c) => c,
        None => ' ',
    };
    let left = if flags & PAD_RIGHT != 0 { pad } else if flags & PAD_CENTER != 0 { pad / 2 } else { 0 };
    insert_chars(out, start, c, left);
    for _ in 0..pad - left {
        out.push(c);
    }
}

impl Display for u8 { fn fmt(&self, out: &mut +String) { write_u64(out, self as u64); } }
impl Display for u16 { fn fmt(&self, out: &mut +String) { write_u64(out, self as u64); } }
impl Display for u32 { fn fmt(&self, out: &mut +String) { write_u64(out, self as u64); } }
impl Display for u64 { fn fmt(&self, out: &mut +String) { write_u64(out, self); } }
impl Display for usize { fn fmt(&self, out: &mut +String) { write_u64(out, self as u64); } }
impl Display for i8 { fn fmt(&self, out: &mut +String) { write_i64(out, self as i64); } }
impl Display for i16 { fn fmt(&self, out: &mut +String) { write_i64(out, self as i64); } }
impl Display for i32 { fn fmt(&self, out: &mut +String) { write_i64(out, self as i64); } }
impl Display for i64 { fn fmt(&self, out: &mut +String) { write_i64(out, self); } }
impl Display for isize { fn fmt(&self, out: &mut +String) { write_i64(out, self as i64); } }

impl Display for bool {
    fn fmt(&self, out: &mut +String) {
        out.push_str(if self { "true" } else { "false" });
    }
}

impl Display for char {
    fn fmt(&self, out: &mut +String) {
        out.push(self);
    }
}

impl Display for str {
    fn fmt(&self, out: &mut +String) {
        out.push_str(self);
    }
}

impl Display for String {
    fn fmt(&self, out: &mut +String) {
        out.push_str(self.as_str());
    }
}

// ===================================================================== Debug

/// Types that can be shown for debugging, with `{x:?}`: values roughly as
/// they would be written in source, with strings quoted and escaped.
#[lang = "debug"]
pub trait Debug {
    fn debug(&self, out: &mut +String);
}

impl Debug for u8 { fn debug(&self, out: &mut +String) { write_u64(out, self as u64); } }
impl Debug for u16 { fn debug(&self, out: &mut +String) { write_u64(out, self as u64); } }
impl Debug for u32 { fn debug(&self, out: &mut +String) { write_u64(out, self as u64); } }
impl Debug for u64 { fn debug(&self, out: &mut +String) { write_u64(out, self); } }
impl Debug for usize { fn debug(&self, out: &mut +String) { write_u64(out, self as u64); } }
impl Debug for i8 { fn debug(&self, out: &mut +String) { write_i64(out, self as i64); } }
impl Debug for i16 { fn debug(&self, out: &mut +String) { write_i64(out, self as i64); } }
impl Debug for i32 { fn debug(&self, out: &mut +String) { write_i64(out, self as i64); } }
impl Debug for i64 { fn debug(&self, out: &mut +String) { write_i64(out, self); } }
impl Debug for isize { fn debug(&self, out: &mut +String) { write_i64(out, self as i64); } }

impl Debug for bool {
    fn debug(&self, out: &mut +String) {
        out.push_str(if self { "true" } else { "false" });
    }
}

impl Debug for char {
    fn debug(&self, out: &mut +String) {
        out.push('\'');
        escape_char(out, self, '\'');
        out.push('\'');
    }
}

impl Debug for str {
    fn debug(&self, out: &mut +String) {
        out.push('"');
        for c in self.chars() {
            escape_char(out, c, '"');
        }
        out.push('"');
    }
}

impl Debug for String {
    fn debug(&self, out: &mut +String) {
        self.as_str().debug(out);
    }
}

impl Debug for () {
    fn debug(&self, out: &mut +String) {
        out.push_str("()");
    }
}

impl::<A: Debug, B: Debug> Debug for (A, B) {
    fn debug(&self, out: &mut +String) {
        out.push('(');
        self.0.debug(out);
        out.push_str(", ");
        self.1.debug(out);
        out.push(')');
    }
}

impl::<A: Debug, B: Debug, C: Debug> Debug for (A, B, C) {
    fn debug(&self, out: &mut +String) {
        out.push('(');
        self.0.debug(out);
        out.push_str(", ");
        self.1.debug(out);
        out.push_str(", ");
        self.2.debug(out);
        out.push(')');
    }
}

/// `c` as it is written inside a quoted literal.
fn escape_char(out: &mut +String, c: char, quote: char) {
    if c == '\n' {
        out.push_str("\\n");
    } else if c == '\t' {
        out.push_str("\\t");
    } else if c == '\r' {
        out.push_str("\\r");
    } else if c == '\0' {
        out.push_str("\\0");
    } else if c == '\\' {
        out.push_str("\\\\");
    } else if c == quote {
        out.push('\\');
        out.push(c);
    } else {
        out.push(c);
    }
}

// ===================================================================== derives

/// `#[derive(Debug)]`: `Point { x: 1, y: 2 }`, `Pair(1, 2)`, `Unit`, and
/// for enums `Number(Int)`, `Line { from: 1, to: 2 }`, `Dot`. Every field
/// must implement `Debug`; an enum's fields must also be `Dull`.
#[derive_macro]
pub macro Debug {
    ($(#[$m:meta])* $v:vis struct $n:ident $g:generics { $(,)? }) => {
        impl $g.bound(Debug) Debug for $n $g.args {
            fn debug(&self, out: &mut +String) {
                out.push_str(${stringify($n)});
            }
        }
    },
    ($(#[$m:meta])* $v:vis struct $n:ident $g:generics { $($(#[$fm:meta])* $fv:vis $f:ident: $ft:ty),* $(,)? }) => {
        impl $g.bound(Debug) Debug for $n $g.args {
            fn debug(&self, out: &mut +String) {
                out.push_str(${stringify($n)});
                out.push_str(" { ");
                $(
                    if ${index()} > 0 {
                        out.push_str(", ");
                    }
                    out.push_str(${stringify($f)});
                    out.push_str(": ");
                    self.$f.debug(out);
                )*
                out.push_str(" }");
            }
        }
    },
    ($(#[$m:meta])* $v:vis struct $n:ident $g:generics ($($(#[$fm:meta])* $fv:vis $ft:ty),* $(,)?);) => {
        impl $g.bound(Debug) Debug for $n $g.args {
            fn debug(&self, out: &mut +String) {
                out.push_str(${stringify($n)});
                out.push('(');
                $(
                    if ${index()} > 0 {
                        out.push_str(", ");
                    }
                    self.${index()}.debug(out);
                    ${ignore($ft)}
                )*
                out.push(')');
            }
        }
    },
    ($(#[$m:meta])* $v:vis struct $n:ident $g:generics;) => {
        impl $g.bound(Debug) Debug for $n $g.args {
            fn debug(&self, out: &mut +String) {
                out.push_str(${stringify($n)});
            }
        }
    },
    ($(#[$m:meta])* $v:vis enum $n:ident $g:generics {
        $($(#[$vm:meta])* $var:ident $(($($vt:ty),* $(,)?))? $({$($vf:ident: $vft:ty),* $(,)?})?),* $(,)?
    }) => {
        impl $g.bound(Debug) Debug for $n $g.args {
            fn debug(&self, out: &mut +String) {
                match self {
                    $(
                        $n::$var $(($(${concat(a, index())} ${ignore($vt)}),*))? $({$($vf: ${concat(a_, $vf)}),*})? => {
                            out.push_str(${stringify($var)});
                            $(
                                out.push('(');
                                $(
                                    if ${index()} > 0 {
                                        out.push_str(", ");
                                    }
                                    ${concat(a, index())}.debug(out);
                                    ${ignore($vt)}
                                )*
                                out.push(')');
                            )?
                            $(
                                out.push_str(" { ");
                                $(
                                    if ${index()} > 0 {
                                        out.push_str(", ");
                                    }
                                    out.push_str(${stringify($vf)});
                                    out.push_str(": ");
                                    ${concat(a_, $vf)}.debug(out);
                                )*
                                out.push_str(" }");
                            )?
                        }
                    )*
                }
            }
        }
    },
}

/// `#[derive(Display)]`, for enums whose variants have no fields: each
/// shows as its name. How anything else is shown is a choice to make by
/// hand.
#[derive_macro]
pub macro Display {
    ($(#[$m:meta])* $v:vis enum $n:ident { $($(#[$vm:meta])* $var:ident),* $(,)? }) => {
        impl Display for $n {
            fn fmt(&self, out: &mut +String) {
                out.push_str(match self {
                    $($n::$var => ${stringify($var)}),*
                });
            }
        }
    },
    ($($rest:tt)*) => {
        ${error("`#[derive(Display)]` only works on enums whose variants have no fields; implement `Display` by hand to choose how this is shown")}
    },
}
