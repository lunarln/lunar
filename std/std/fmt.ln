// Float formatting: the shortest decimal representation that round-trips.

use core::fmt::Display;
use core::intrinsics;

extern "C" {
    fn sprintf(buf: *mut u8, fmt: *u8, ...): i32;
    fn strtod(s: *u8, end: *mut *mut u8): f64;
}

fn write_f64(out: &mut +String, v: f64) {
    if v != v {
        out.push_str("NaN");
        return;
    }
    if v > 1.7976931348623157e308 {
        out.push_str("inf");
        return;
    }
    if v < -1.7976931348623157e308 {
        out.push_str("-inf");
        return;
    }
    let mut buf: [u8; 64] = [0; 64];
    let mut prec: i32 = 1;
    let mut n: i32 = 0;
    while prec <= 17 {
        unsafe {
            n = sprintf(buf.as_mut_ptr(),"%.*g\0".as_bytes().as_ptr(), prec, v);
            let back = strtod(buf.as_ptr(), intrinsics::ptr_null_mut::<*mut u8>());
            if back == v {
                break;
            }
        }
        prec += 1;
    }
    let s = unsafe { intrinsics::str_from_bytes(buf[..n as usize]) };
    out.push_str(s);
}

/// Parse a decimal number such as `1.5`, `-2e10` or `0.1` (all of `s`:
/// digits, a sign, a `.` and an exponent, without spaces), correctly
/// rounded to the nearest `f64`. `None` if `s` is not one.
pub fn parse_f64(s: str): Option::<f64> {
    if s.len() == 0 {
        return None;
    }
    // `strtod` also takes spaces, hexadecimal, `inf` and `nan`.
    for b in s.as_bytes() {
        let ok = (b >= b'0' && b <= b'9') || b == b'+' || b == b'-' || b == b'.' || b == b'e' || b == b'E';
        if !ok {
            return None;
        }
    }
    let mut c = String::from(s);
    c.push('\0');
    let start = c.as_bytes().as_ptr();
    let mut end: *mut u8 = intrinsics::ptr_null_mut::<u8>();
    let v = unsafe { strtod(start, intrinsics::addr_of_mut(&mut end)) };
    if (end as usize) - (start as usize) != s.len() {
        return None;
    }
    return Some(v);
}

impl core::str::FromStr for f64 {
    type Err = core::num::ParseError;

    /// A decimal number (as `parse_f64`), or `inf`, `infinity` or `NaN` in
    /// any case, with an optional sign.
    fn from_str(s: str): Result::<f64, core::num::ParseError> {
        if s.is_empty() {
            return Err(core::num::ParseError::new(core::num::ParseErrorKind::Empty));
        }
        if let Some(v) = parse_f64(s) {
            return Ok(v);
        }
        let (neg, word) = if s.starts_with("-") { (true, s[1..]) } else if s.starts_with("+") { (false, s[1..]) } else { (false, s) };
        let inf = 1.7976931348623157e308 * 10.0;
        if word.eq_ignore_ascii_case("inf") || word.eq_ignore_ascii_case("infinity") {
            return Ok(if neg { -inf } else { inf });
        }
        if word.eq_ignore_ascii_case("nan") {
            return Ok(inf - inf);
        }
        return Err(core::num::ParseError::new(core::num::ParseErrorKind::Invalid));
    }
}

impl core::str::FromStr for f32 {
    type Err = core::num::ParseError;

    fn from_str(s: str): Result::<f32, core::num::ParseError> {
        let v = s.parse::<f64>()?;
        return Ok(v as f32);
    }
}

impl Display for f64 {
    fn fmt(&self, out: &mut +String) {
        write_f64(out, self);
    }
}

impl Display for f32 {
    fn fmt(&self, out: &mut +String) {
        write_f64(out, self as f64);
    }
}

impl core::fmt::Debug for f64 {
    fn debug(&self, out: &mut +String) {
        write_f64(out, self);
    }
}

impl core::fmt::Debug for f32 {
    fn debug(&self, out: &mut +String) {
        write_f64(out, self as f64);
    }
}
