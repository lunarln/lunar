// The Lunar runtime.
//
// Data stacks: every owning array (`[T]`, `[T; ..+]`, `[T; -..+]`, `String`)
// lives on its own data stack, a slot of address space whose pages are
// committed as the array grows. Growing never moves existing elements, so
// views into an array stay valid while it grows.
//
// Slots are powers of two from 64 KiB to 1 TiB. An array gets a 1 GiB slot
// by default; `capped(n)` picks the smallest slot that holds exactly n
// elements, and arrays that never grow (`[T]`) get one sized to fit.
//
// All slots come from one region reserved once, at startup. Taking and
// returning a slot never calls the operating system: fresh slots are
// carved off the region with a bump pointer, and freed slots go on a free
// list per size, threaded through their headers. On Linux and macOS the
// region is mapped readable and writable up front and the kernel supplies
// pages on first touch, so after startup allocation makes no system calls
// at all. On Windows (and Unix systems that refuse to overcommit) memory
// must be committed explicitly, which happens only when a slot grows past
// the most it has ever held.
//
// Threads: the free lists, the bump pointer and the retained-memory count
// are shared by every thread and guarded by one spin lock, held only while
// a slot is taken off or put on a list (a few loads and stores; never
// across a system call except when a freed slot gives memory back). A
// waiting thread spins briefly, then yields its time slice. Growing an
// array touches only its own slot, which belongs to one thread at a time.
//
// Layout of a data stack: [header: 64 bytes][elements...]. The array handle
// `{ ptr, len, cap }` points at the first element.

use crater::sys;
use core::intrinsics;

/// Slot sizes are `1 << order`.
const MIN_ORDER: usize = 16;
const DEFAULT_ORDER: usize = 30;
const MAX_ORDER: usize = 40;
/// The region all slots come from is the largest power of two the system
/// grants, from REGION_MAX (64 TiB) down to REGION_MIN.
const REGION_MAX: usize = 70368744177664;
const REGION_MIN: usize = 17179869184;
/// Commits happen in whole pages.
const PAGE: usize = 4096;
const HEADER: usize = 64;
/// Committed bytes (including the header) a free slot always keeps.
const KEEP: usize = 65536;
/// Free slots may hold this much more committed memory in total; beyond
/// it, a freed slot's memory past KEEP goes back to the system.
const RETAIN_BUDGET: usize = 67108864;
const MAX_USIZE: usize = 18446744073709551615;

/// Byte offsets of `Header` fields that are read on their own.
const CLOSE_AT: usize = 32;
const HANDLE_AT: usize = 40;
const REFS_AT: usize = 56;

/// Atomic orderings (LLVM's numbers, as `core::intrinsics` takes them).
const RELAXED: u32 = 2;
const ACQUIRE: u32 = 4;
const RELEASE: u32 = 5;

static mut REGION: usize = 0;
static mut REGION_END: usize = 0;
/// Next never-used address in the region.
static mut BUMP: usize = 0;
/// Most recently freed slot of each order (its base address), or 0.
static mut FREE: [usize; 41] = [0; 41];
/// Committed bytes past KEEP held by free slots.
static mut RETAINED: usize = 0;
/// Guards `BUMP`, `FREE` and `RETAINED`: 1 while a thread holds it.
static mut ALLOC_LOCK: u32 = 0;

pub static mut ARGC: i32 = 0;
pub static mut ARGV: usize = 0;

/// The in-memory form of every owning array handle.
struct RawArr {
    ptr: *mut u8,
    len: usize,
    cap: usize,
}

/// Header at the start of each data stack.
struct Header {
    /// Bytes committed after the header (the most the slot has held).
    committed: usize,
    /// Next free slot of the same order while this one is free.
    next: usize,
    /// The slot is `1 << order` bytes.
    order: usize,
    /// The most bytes of elements the array may hold: its cap, or the whole
    /// slot after the header.
    limit: usize,
    /// What to do when the array is freed: 0 nothing; `HANDLE_FILE` or
    /// `HANDLE_SOCKET`: close the handle that is its first element (see
    /// `OwnedHandle`); `FLUSH_FILE` or `FLUSH_SOCKET`: write its first
    /// `pending` bytes to `handle`; `BLOCK`: count down `refs`, and at
    /// zero call the function in `handle` on the first element (see
    /// `block_new`).
    close: usize,
    handle: i64,
    pending: usize,
    /// References to a `BLOCK` (changed atomically).
    refs: usize,
}

#[lang = "rt_init"]
fn rt_init(argc: i32, argv: usize) {
    unsafe {
        ARGC = argc;
        ARGV = argv;
        // The main thread is thread 1.
        THREAD_ID = next_thread_id();
    }
    reserve_region();
}

fn reserve_region() {
    unsafe {
        let mut size = REGION_MAX;
        loop {
            let base = sys::reserve(size);
            if (base as usize) != 0 {
                REGION = base as usize;
                REGION_END = REGION + size;
                BUMP = REGION;
                return;
            }
            size = size / 2;
            if size < REGION_MIN {
                sys::write(2, "fatal: could not reserve address space for data stacks\n".as_bytes());
                sys::exit(134);
            }
        }
    }
}

fn too_many_arrays(): ! {
    // No formatting here: building a String would need a free slot.
    sys::write(2, "fatal: out of address space for data stacks (too many or too large arrays alive)\n".as_bytes());
    sys::exit(134);
}

fn alloc_lock() {
    unsafe {
        let p = intrinsics::addr_of_mut(&mut ALLOC_LOCK);
        if intrinsics::atomic_swap(p, 1, ACQUIRE) == 0 {
            return;
        }
        let mut spins: u32 = 0;
        loop {
            if intrinsics::atomic_load(p as *u32, RELAXED) == 0 && intrinsics::atomic_swap(p, 1, ACQUIRE) == 0 {
                return;
            }
            spins += 1;
            if spins >= 64 {
                sys::yield_now();
            }
        }
    }
}

fn alloc_unlock() {
    unsafe {
        let p = intrinsics::addr_of_mut(&mut ALLOC_LOCK);
        intrinsics::atomic_store(p, 0, RELEASE);
    }
}

/// A slot of `1 << order` bytes for a new data stack, with its first page
/// committed and its header set to allow the whole slot.
fn acquire(order: usize): *mut u8 {
    unsafe {
        let slot = 1 << order;
        if REGION == 0 {
            // Allocation before `rt_init` (not expected, but harmless).
            reserve_region();
        }
        alloc_lock();
        if FREE[order] != 0 {
            let base = FREE[order] as *mut u8;
            let h = base as *mut Header;
            let mut header = intrinsics::ptr_read(h);
            FREE[order] = header.next;
            RETAINED -= extra(header.committed);
            alloc_unlock();
            header.next = 0;
            header.limit = slot - HEADER;
            header.close = 0;
            header.refs = 0;
            intrinsics::ptr_write(h, header);
            return base;
        }
        // Slots are aligned to their size.
        let start = (BUMP + slot - 1) / slot * slot;
        if start > REGION_END || REGION_END - start < slot {
            alloc_unlock();
            too_many_arrays();
        }
        BUMP = start + slot;
        alloc_unlock();
        let base = start as *mut u8;
        sys::commit(base, PAGE);
        intrinsics::ptr_write(base as *mut Header, Header { committed: PAGE - HEADER, next: 0, order, limit: slot - HEADER, close: 0, handle: 0, pending: 0, refs: 0 });
        return base;
    }
}

/// Committed bytes of a slot beyond what every free slot keeps.
fn extra(committed: usize): usize {
    let total = committed + HEADER;
    if total > KEEP { total - KEEP } else { 0 }
}

fn stack_overflow(): ! {
    sys::write(2, "fatal: data stack overflow (an array grew past its cap or reservation)\n".as_bytes());
    sys::exit(134);
}

/// The smallest order whose slot holds `need` bytes (header included).
fn order_for(need: usize): usize {
    let mut order = MIN_ORDER;
    while (1 << order) < need {
        order += 1;
    }
    return order;
}

/// Give the empty array behind `handle` a slot that holds exactly `count`
/// elements of `elem_size` bytes (the smallest slot that fits). Backs
/// `capped(n)` and arrays that never grow.
#[lang = "ds_cap"]
fn ds_cap(handle: *mut RawArr, elem_size: usize, count: usize) {
    unsafe {
        let mut a = intrinsics::ptr_read(handle);
        if elem_size == 0 {
            return;
        }
        if a.ptr as usize != 0 {
            sys::write(2, "fatal: `capped` called on an array that already has elements; cap it while it is empty\n".as_bytes());
            sys::exit(134);
        }
        // `count * elem_size + HEADER` must fit the largest slot (no wrap).
        let max_slot = 1 << MAX_ORDER;
        if count > (max_slot - HEADER) / elem_size {
            stack_overflow();
        }
        let base = acquire(order_for(count * elem_size + HEADER));
        let h = base as *mut Header;
        let mut header = intrinsics::ptr_read(h);
        header.limit = count * elem_size;
        intrinsics::ptr_write(h, header);
        a.ptr = intrinsics::ptr_offset_mut(base, HEADER as isize);
        a.cap = 0;
        intrinsics::ptr_write(handle, a);
    }
}

/// Make sure the slot at `base` has at least `need` bytes committed after
/// its header (`need` fits the slot).
fn commit_to(base: *mut u8, need: usize) {
    unsafe {
        let h = base as *mut Header;
        let mut header = intrinsics::ptr_read(h);
        if need <= header.committed {
            return;
        }
        let mut want = header.committed * 2;
        if want < need {
            want = need;
        }
        // Whole pages, including the header; doubling may overshoot the
        // slot, but `need` itself fits.
        let slot = 1 << header.order;
        let mut total = (want + HEADER + PAGE - 1) / PAGE * PAGE;
        if total > slot {
            total = slot;
        }
        // Only the new pages: the slot's first `old` bytes are committed.
        let old = header.committed + HEADER;
        sys::commit(intrinsics::ptr_offset_mut(base, old as isize), total - old);
        header.committed = total - HEADER;
        intrinsics::ptr_write(h, header);
    }
}

/// Grow the array behind `handle` so it can hold `len + additional`
/// elements of `elem_size` bytes.
///
/// The size computation must not wrap even in release builds (where `+` and
/// `*` wrap): `additional` comes straight from user code (`reserve`,
/// `[v; n]`), and a wrapped byte count would hand out too little memory.
#[lang = "ds_grow"]
fn ds_grow(handle: *mut RawArr, elem_size: usize, additional: usize) {
    unsafe {
        let mut a = intrinsics::ptr_read(handle);
        if elem_size == 0 {
            // Zero-sized items need no memory; any length fits.
            a.cap = MAX_USIZE;
            intrinsics::ptr_write(handle, a);
            return;
        }
        if a.ptr as usize == 0 {
            let base = acquire(DEFAULT_ORDER);
            a.ptr = intrinsics::ptr_offset_mut(base, HEADER as isize);
        }
        let base = intrinsics::ptr_offset_mut(a.ptr, 0 - (HEADER as isize));
        let h = base as *mut Header;
        let limit = intrinsics::ptr_read(h).limit;
        // `a.len * elem_size <= limit`, so this cannot wrap.
        if additional > limit / elem_size - a.len {
            stack_overflow();
        }
        commit_to(base, (a.len + additional) * elem_size);
        // Capacity never exceeds the cap.
        let mut usable = intrinsics::ptr_read(h).committed;
        if usable > limit {
            usable = limit;
        }
        a.cap = usable / elem_size;
        intrinsics::ptr_write(handle, a);
    }
}

/// Release the data stack whose first element is at `ptr`.
#[lang = "ds_free"]
fn ds_free(ptr: *mut u8) {
    if ptr as usize == 0 {
        return;
    }
    unsafe {
        let base = intrinsics::ptr_offset_mut(ptr, 0 - (HEADER as isize));
        let h = base as *mut Header;
        // A block's other fields do not change while it is shared, but its
        // count does: read what it is on its own.
        let close = intrinsics::ptr_read(((base as usize) + CLOSE_AT) as *usize);
        if close == BLOCK {
            let refs = ((base as usize) + REFS_AT) as *mut usize;
            if intrinsics::atomic_sub(refs, 1, RELEASE) != 1 {
                return;
            }
            // Everything the other owners did happens before the drop.
            intrinsics::atomic_fence(ACQUIRE);
            let drop = intrinsics::ptr_read(((base as usize) + HANDLE_AT) as *fn(*mut u8));
            drop(ptr);
        }
        let mut header = intrinsics::ptr_read(h);
        if close == BLOCK {
            header.close = 0;
        } else if header.close >= FLUSH_FILE {
            flush_pending(header.close, header.handle, ptr as *u8, header.pending);
            header.close = 0;
        } else if header.close != 0 {
            sys::close_handle(header.close, intrinsics::ptr_read(ptr as *i64));
            header.close = 0;
        }
        // Keep the memory for the next array that takes this slot, unless
        // free slots already hold too much.
        let e = extra(header.committed);
        alloc_lock();
        if RETAINED + e > RETAIN_BUDGET {
            sys::decommit(intrinsics::ptr_offset_mut(base, KEEP as isize), e);
            header.committed = KEEP - HEADER;
        } else {
            RETAINED += e;
        }
        header.next = FREE[header.order];
        intrinsics::ptr_write(h, header);
        FREE[header.order] = base as usize;
        alloc_unlock();
    }
}

// ===================================================================== panics

/// Panic raised by compiler-inserted checks.
#[lang = "panic_str"]
fn panic_str(msg: str, file: str, line: u32, col: u32): ! {
    let mut loc = String::from(file);
    loc.write(":{line}:{col}");
    panicked(String::from(msg), loc);
}

#[lang = "panic_bounds"]
fn panic_bounds(index: usize, len: usize, file: str, line: u32, col: u32): ! {
    let mut loc = String::from(file);
    loc.write(":{line}:{col}");
    let mut msg = String::new();
    msg.write("index out of bounds: the length is {len} but the index is {index}");
    panicked(msg, loc);
}

/// Whether this thread is already panicking (a panic while it records the
/// first one ends the process).
#[thread_local]
static mut PANICKING: bool = false;

/// End the program after a panic with `msg` at `loc` (a `file:line:col`,
/// or empty), or, on a thread started by `std::thread`, end that thread:
/// it records the panic for whoever joins it, poisons the locks it holds,
/// and exits on the spot (no unwinding: what it owns stays allocated).
pub fn panicked(msg: String, loc: String): ! {
    let current = unsafe { CURRENT };
    let again = unsafe { PANICKING };
    if current == 0 || again {
        let mut s = String::from("panicked");
        if again && current != 0 {
            s = String::from("thread panicked while panicking");
        }
        if loc.len() > 0 {
            s.write(" at {loc}");
        }
        s.write(": {msg}\n");
        sys::write(2, s.as_bytes());
        if again && current != 0 {
            sys::exit(134);
        }
        sys::exit(101);
    }
    unsafe {
        PANICKING = true;
    }
    crater::thread::exit_panicked(current, msg, loc);
}

// ===================================================================== threads

/// The `std::thread` record of the running thread (the address of its
/// shared state), or 0 on the main thread.
#[thread_local]
static mut CURRENT: usize = 0;

/// The running thread's id (see `thread_id`); 0 until asked.
#[thread_local]
static mut THREAD_ID: u64 = 0;

/// The last thread id handed out (the main thread's is 1).
static mut LAST_ID: u64 = 0;

/// Called first on a thread `std::thread` starts: `record` is its shared
/// state, `id` its id.
pub fn enter_thread(record: usize, id: u64) {
    unsafe {
        CURRENT = record;
        THREAD_ID = id;
    }
}

/// The `std::thread` record of the running thread, or 0 on the main thread.
pub fn current_record(): usize {
    return unsafe { CURRENT };
}

/// A new thread id: 1 for the first (the main thread asks for its own
/// lazily, so it may get another), then counting up.
pub fn next_thread_id(): u64 {
    return unsafe { intrinsics::atomic_add(intrinsics::addr_of_mut(&mut LAST_ID), 1, RELAXED) } + 1;
}

/// The running thread's id, unique for the life of the process.
pub fn thread_id(): u64 {
    unsafe {
        if THREAD_ID == 0 {
            THREAD_ID = next_thread_id();
        }
        return THREAD_ID;
    }
}

// ===================================================================== blocks

/// `OwnedHandle` kinds: a file (or pipe or directory) handle.
pub const HANDLE_FILE: usize = 1;
/// `OwnedHandle` kinds: a socket.
pub const HANDLE_SOCKET: usize = 2;
/// `set_flush` targets: a file handle (also a pipe or a console).
pub const FLUSH_FILE: usize = 3;
/// `set_flush` targets: a socket.
pub const FLUSH_SOCKET: usize = 4;
/// A block of memory with a reference count and a drop function (see
/// `block_new`).
const BLOCK: usize = 5;

/// A block of at least `bytes` bytes (64-byte aligned) whose first byte is
/// at `as_ptr()` of the returned array, owned by the array like any data
/// stack, with a reference count of 1. Freeing the array counts the
/// references down; the last one calls `drop` on the first byte, then
/// releases the memory. `block_retain` adds a reference, and `block_dup`
/// makes another array that owns one: this is how `std::sync::Shared` and
/// the channels share a value between threads, and how they run code when
/// the last owner goes away (Lunar has no destructors).
///
/// The array itself stays empty (`len` 0); the block is only reached
/// through its pointer. Each block takes at least a 64 KiB slot of address
/// space.
pub fn block_new(bytes: usize, drop: fn(*mut u8)): [u8; ..+] {
    let size = if bytes == 0 { 1 } else { bytes };
    let mut cell: [u8; ..+] = [].capped(size);
    let first = cell[..].as_ptr() as usize;
    unsafe {
        let base = first - HEADER;
        commit_to(base as *mut u8, size);
        intrinsics::ptr_write((base + HANDLE_AT) as *mut fn(*mut u8), drop);
        intrinsics::ptr_write((base + REFS_AT) as *mut usize, 1);
        intrinsics::ptr_write((base + CLOSE_AT) as *mut usize, BLOCK);
    }
    return cell;
}

/// Add a reference to the block whose first byte is at `first`.
pub fn block_retain(first: *u8) {
    unsafe {
        let refs = ((first as usize) - HEADER + REFS_AT) as *mut usize;
        intrinsics::atomic_add(refs, 1, RELAXED);
    }
}

/// Another owner of the block `cell` owns (it holds a new reference).
pub fn block_dup(cell: &[u8; ..+]): [u8; ..+] {
    block_retain(cell[..].as_ptr());
    return unsafe { intrinsics::ptr_read(intrinsics::addr_of(cell)) };
}

/// Drop a reference to the block at `first` that no array owns (taken
/// with `block_retain`), as freeing an owning array would.
pub fn block_release(first: *mut u8) {
    ds_free(first);
}

/// Replace the function the last reference to the block at `first` calls.
pub fn block_set_drop(first: *u8, drop: fn(*mut u8)) {
    unsafe {
        intrinsics::ptr_write(((first as usize) - HEADER + HANDLE_AT) as *mut fn(*mut u8), drop);
    }
}

/// How many references the block at `first` has right now.
pub fn block_refs(first: *u8): usize {
    return unsafe { intrinsics::atomic_load(((first as usize) - HEADER + REFS_AT) as *usize, ACQUIRE) };
}

// ===================================================================== owned handles

/// Make freeing the byte array whose first element is at `first` (an
/// array that already has its data stack, such as one made by `capped`)
/// write its first `pending` bytes (see `set_pending`) to `handle`, a
/// `FLUSH_FILE` or `FLUSH_SOCKET`; `kind` 0 turns that off. This is how a
/// `BufWriter` flushes when it is freed. Failures are ignored.
pub fn set_flush(first: *u8, kind: usize, handle: i64) {
    unsafe {
        let h = ((first as usize) - HEADER) as *mut Header;
        let mut header = intrinsics::ptr_read(h as *Header);
        header.close = kind;
        header.handle = handle;
        header.pending = 0;
        intrinsics::ptr_write(h, header);
    }
}

/// How many bytes of the array at `first` freeing it writes (see
/// `set_flush`).
pub fn set_pending(first: *u8, pending: usize) {
    unsafe {
        let h = ((first as usize) - HEADER) as *mut Header;
        let mut header = intrinsics::ptr_read(h as *Header);
        header.pending = pending;
        intrinsics::ptr_write(h, header);
    }
}

/// Write `n` bytes at `p` to `handle`, as far as it goes.
fn flush_pending(kind: usize, handle: i64, p: *u8, n: usize) {
    let bytes = unsafe { intrinsics::slice_from_raw(p, n) };
    let mut off: usize = 0;
    while off < n {
        let w = if kind == FLUSH_SOCKET { sys::sock_send(handle, bytes[off..]) } else { sys::handle_write(handle, bytes[off..]) };
        if w <= 0 {
            return;
        }
        off += w as usize;
    }
}

/// An operating system handle (a file descriptor, a Windows `HANDLE` or
/// `SOCKET`) with one owner, closed when its owner is freed.
///
/// Lunar has no destructors yet, so the handle lives as the only element
/// of a small owning array, and the array's data stack header records what
/// kind of handle it is. Freeing the array (when its owner goes out of
/// scope, is replaced or is moved into a call that frees it) closes the
/// handle. Owning an array also makes every type holding an `OwnedHandle`
/// move instead of copy, so two values never close the same handle. Each
/// one takes a 64 KiB slot of address space (one page of memory).
pub struct OwnedHandle {
    cell: [i64; ..+],
}

impl OwnedHandle {
    /// Own `raw`, a handle of `kind` (`HANDLE_FILE` or `HANDLE_SOCKET`).
    pub fn new(raw: i64, kind: usize): OwnedHandle {
        let mut cell: [i64; ..+] = [].capped(1);
        cell.push(raw);
        set_close(cell[..].as_ptr(), kind);
        return OwnedHandle { cell };
    }

    /// The handle, still owned by this value.
    pub fn raw(&self): i64 {
        return self.cell[0];
    }

    /// Close the handle now; false if the operating system reports a
    /// failure (see `sys::last_error`).
    pub fn close(self): bool {
        let raw = self.cell[0];
        let kind = set_close(self.cell[..].as_ptr(), 0);
        return sys::close_handle(kind, raw);
    }

    /// Give up ownership: the handle is no longer closed with this value.
    pub fn into_raw(self): i64 {
        set_close(self.cell[..].as_ptr(), 0);
        return self.cell[0];
    }
}

/// Set what freeing the data stack of the array whose first element is at
/// `first` closes; returns what it was set to.
fn set_close(first: *i64, kind: usize): usize {
    unsafe {
        let h = ((first as usize) - HEADER) as *mut Header;
        let mut header = intrinsics::ptr_read(h as *Header);
        let old = header.close;
        header.close = kind;
        intrinsics::ptr_write(h, header);
        return old;
    }
}
