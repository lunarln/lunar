use crater::rt;

/// Number of command line arguments (including the program name).
pub fn arg_count(): usize {
    return unsafe { rt::ARGC } as usize;
}

/// Command line argument `i`, or `None` if out of range.
pub fn arg(i: usize): Option::<str> {
    if i >= arg_count() {
        return None;
    }
    unsafe {
        let argv = rt::ARGV as **u8;
        let p = core::intrinsics::ptr_read(core::intrinsics::ptr_offset(argv, i as isize));
        let mut n: usize = 0;
        while core::intrinsics::ptr_read(core::intrinsics::ptr_offset(p, n as isize)) != 0 {
            n += 1;
        }
        return Some(core::intrinsics::str_from_bytes(core::intrinsics::slice_from_raw(p, n)));
    }
}

/// The command line arguments, the program name first:
/// `for a in env::args() { ... }`. Each is a view of the arguments the
/// program was started with, which live as long as it does.
pub fn args(): Args {
    return Args { next: 0 };
}

/// The command line arguments (`env::args`).
pub struct Args {
    next: usize,
}

impl Args {
    /// How many are left.
    pub fn len(&self): usize {
        let n = arg_count();
        return if self.next < n { n - self.next } else { 0 };
    }

    pub fn is_empty(&self): bool {
        return self.len() == 0;
    }
}

impl Iterator for Args {
    type Item = str;

    fn next(&mut self): Option::<str> {
        let a = arg(self.next)?;
        self.next += 1;
        return Some(a);
    }
}

/// The environment variables, as a snapshot taken now:
/// `let vars = env::vars(); for v in vars.iter() { println("{v.0}={v.1}"); }`.
/// On Unix it is the environment the program started with; variables
/// whose names or values are not UTF-8 are left out.
pub fn vars(): Vars {
    let mut block = String::new();
    crater::sys::env_block(&mut block);
    return Vars { block };
}

/// A snapshot of the environment (`env::vars`): every `NAME=value`, each
/// followed by a NUL.
pub struct Vars {
    block: String,
}

impl Vars {
    /// Each name and value.
    pub fn iter(&self): impl Iterator::<Item = (str, str)> {
        return VarsIter { rest: self.block.as_str() };
    }

    /// How many variables there are.
    pub fn len(&self): usize {
        let mut n: usize = 0;
        for b in self.block.as_bytes() {
            if b == 0 {
                n += 1;
            }
        }
        return n;
    }

    /// The value of `name` in the snapshot (names are case-insensitive on
    /// Windows).
    pub fn get(&self, name: str): Option::<str> {
        let mut it = VarsIter { rest: self.block.as_str() };
        loop {
            let (k, v) = it.next()?;
            if k == name || (WINDOWS && k.eq_ignore_ascii_case(name)) {
                return Some(v);
            }
        }
    }
}

#[cfg(windows)]
const WINDOWS: bool = true;
#[cfg(not(windows))]
const WINDOWS: bool = false;

struct VarsIter {
    rest: str,
}

impl Iterator for VarsIter {
    type Item = (str, str);

    fn next(&mut self): Option::<(str, str)> via self {
        loop {
            let (entry, rest) = self.rest.split_once("\0")?;
            self.rest = rest;
            // The name is not empty, so the `=` after it is not first.
            if entry.len() > 1 {
                if let Some(i) = entry[1..].find("=") {
                    return Some((entry[..i + 1], entry[i + 2..]));
                }
            }
        }
    }
}

/// The environment variable `name`, if it is set.
pub fn var(name: str): Option::<String> {
    let c = core::ffi::c_string(name);
    let p = crater::sys::env(c.as_ptr());
    if core::ptr::is_null(p) {
        return None;
    }
    return Some(String::from(unsafe { core::ffi::c_str(p) }));
}

/// `env!("NAME")`: a compile-time variable as a `str` literal, read when
/// the program is compiled, not when it runs. `LUNAR_PKG_NAME` and
/// `LUNAR_PKG_VERSION` are the name and version of the package being built
/// (from its `lunar.toml`); any other name is read from the compiler's
/// environment. An undefined variable is `err(macro::error)`.
pub macro env {
    ($name:lit $(,)?) => {
        ${env($name)}
    },
}

/// The path of the running executable.
pub fn current_exe(): Result::<String, crater::io::Error> {
    let mut out = String::new();
    if !crater::sys::current_exe(&mut out) {
        return Err(crater::io::Error::last_os_error());
    }
    return Ok(out);
}

/// The current directory.
pub fn current_dir(): Result::<String, crater::io::Error> {
    let mut out = String::new();
    if !crater::sys::current_dir(&mut out) {
        return Err(crater::io::Error::last_os_error());
    }
    return Ok(out);
}

/// The directory for temporary files (on Unix `$TMPDIR`, or `/tmp`).
pub fn temp_dir(): String {
    let mut out = String::new();
    crater::sys::temp_dir(&mut out);
    return out;
}
