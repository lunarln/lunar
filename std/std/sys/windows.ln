// Windows implementation (kernel32, with ws2_32 for sockets and bcrypt
// for random bytes).

use core::intrinsics;
use super::{FileStat, RawAddr, encode_addr, decode_addr, get_u32, put_u16, put_u32, put_u64, AF_INET6};

extern "C" {
    fn GetStdHandle(n: u32): *mut u8;
    fn WriteFile(h: *mut u8, buf: *u8, n: u32, written: *mut u32, overlapped: *mut u8): i32;
    fn ReadFile(h: *mut u8, buf: *mut u8, n: u32, got: *mut u32, overlapped: *mut u8): i32;
    fn VirtualAlloc(addr: *mut u8, size: usize, kind: u32, protect: u32): *mut u8;
    fn VirtualFree(addr: *mut u8, size: usize, kind: u32): i32;
    fn ExitProcess(code: u32): !;
    fn CreateFileW(name: *u16, access: u32, share: u32, security: *mut u8, disposition: u32, flags: u32, template: *mut u8): *mut u8;
    fn CloseHandle(h: *mut u8): i32;
    fn DeleteFileW(name: *u16): i32;
    fn GetLastError(): u32;
    fn GetConsoleMode(h: *mut u8, mode: *mut u32): i32;
    fn SetConsoleMode(h: *mut u8, mode: u32): i32;
    fn GetFileInformationByHandleEx(h: *mut u8, class: i32, info: *mut u8, size: u32): i32;
}

// The C runtime (libcmt), for process spawning and the environment.
extern "C" {
    fn _spawnvp(mode: i32, file: *u8, argv: **u8): isize;
    fn getenv(name: *u8): *u8;
}

/// Run the program `argv[0]` (searched for on `PATH`) with the
/// NUL-terminated arguments `argv` (ending in a null pointer), and wait
/// for it: its exit code, or -1 if it could not be started.
pub fn spawn_wait(argv: [*u8; &]): i32 {
    // _P_WAIT = 0
    let r = unsafe { _spawnvp(0, intrinsics::ptr_read(argv.as_ptr()), argv.as_ptr()) };
    return r as i32;
}

/// The environment variable `name` (NUL-terminated), or null.
pub fn env(name: *u8): *u8 {
    return unsafe { getenv(name) };
}

const GENERIC_READ: u32 = 2147483648;
const GENERIC_WRITE: u32 = 1073741824;
const FILE_SHARE_READ_WRITE: u32 = 3;
const CREATE_ALWAYS: u32 = 2;
const OPEN_EXISTING: u32 = 3;
const FILE_ATTRIBUTE_NORMAL: u32 = 128;

const ERROR_FILE_NOT_FOUND: i32 = 2;
const ERROR_PATH_NOT_FOUND: i32 = 3;
const ERROR_ACCESS_DENIED: i32 = 5;
const ERROR_INVALID_NAME: i32 = 123;

pub fn last_error(): i32 {
    return unsafe { GetLastError() } as i32;
}

pub fn error_kind(code: i32): crater::io::ErrorKind {
    use crater::io::ErrorKind;
    return match code {
        // ERROR_FILE_NOT_FOUND, ERROR_PATH_NOT_FOUND, ERROR_INVALID_DRIVE
        2 | 3 | 15 => ErrorKind::NotFound,
        // ERROR_ACCESS_DENIED, ERROR_PRIVILEGE_NOT_HELD, WSAEACCES
        5 | 1314 | 10013 => ErrorKind::PermissionDenied,
        // ERROR_FILE_EXISTS, ERROR_ALREADY_EXISTS
        80 | 183 => ErrorKind::AlreadyExists,
        // ERROR_INVALID_PARAMETER, ERROR_INVALID_NAME, WSAEINVAL
        87 | 123 | 10022 => ErrorKind::InvalidInput,
        // ERROR_BROKEN_PIPE, ERROR_NO_DATA
        109 | 232 => ErrorKind::BrokenPipe,
        // ERROR_NOT_SUPPORTED, ERROR_CALL_NOT_IMPLEMENTED, WSAEAFNOSUPPORT, WSAEOPNOTSUPP
        50 | 120 | 10047 | 10045 => ErrorKind::Unsupported,
        // ERROR_DIR_NOT_EMPTY
        145 => ErrorKind::DirectoryNotEmpty,
        // ERROR_DIRECTORY (a directory name was expected)
        267 => ErrorKind::NotADirectory,
        // WAIT_TIMEOUT, ERROR_TIMEOUT, WSAETIMEDOUT
        258 | 1460 | 10060 => ErrorKind::TimedOut,
        // ERROR_OPERATION_ABORTED, WSAEINTR
        995 | 10004 => ErrorKind::Interrupted,
        10035 => ErrorKind::WouldBlock,
        10048 => ErrorKind::AddrInUse,
        10049 => ErrorKind::AddrNotAvailable,
        10053 => ErrorKind::ConnectionAborted,
        10054 => ErrorKind::ConnectionReset,
        10057 => ErrorKind::NotConnected,
        10061 => ErrorKind::ConnectionRefused,
        _ => ErrorKind::Other,
    };
}

/// Open `path` for reading, or create or truncate it for writing. Returns
/// the handle, or -1 (see `last_error`).
pub fn open_file(path: str, write: bool): isize {
    let w = wide(path);
    let access = if write { GENERIC_WRITE } else { GENERIC_READ };
    let disposition = if write { CREATE_ALWAYS } else { OPEN_EXISTING };
    let h = unsafe {
        CreateFileW(w[..].as_ptr(), access, FILE_SHARE_READ_WRITE, core::ptr::null_mut(), disposition, FILE_ATTRIBUTE_NORMAL, core::ptr::null_mut())
    };
    // INVALID_HANDLE_VALUE is (HANDLE)-1.
    if (h as usize) == 18446744073709551615 {
        return -1;
    }
    return (h as usize) as isize;
}

/// Read into `buf`: the number of bytes read, 0 at the end, or -1.
pub fn read_file(h: isize, buf: [u8; &mut]): isize {
    let mut got: u32 = 0;
    let mut n = buf.len();
    if n > 1073741824 {
        n = 1073741824;
    }
    let ok = unsafe { ReadFile((h as usize) as *mut u8, buf.as_mut_ptr(), n as u32, intrinsics::addr_of_mut(&mut got), core::ptr::null_mut()) };
    if ok == 0 {
        return -1;
    }
    return got as isize;
}

/// Write all of `bytes`; false on failure.
pub fn write_file(h: isize, bytes: [u8; &]): bool {
    let mut off: usize = 0;
    while off < bytes.len() {
        let mut written: u32 = 0;
        let mut chunk = bytes.len() - off;
        if chunk > 1073741824 {
            chunk = 1073741824;
        }
        let ok = unsafe {
            WriteFile((h as usize) as *mut u8, intrinsics::ptr_offset(bytes.as_ptr(), off as isize), chunk as u32, intrinsics::addr_of_mut(&mut written), core::ptr::null_mut())
        };
        if ok == 0 {
            return false;
        }
        off += written as usize;
    }
    return true;
}

pub fn close_file(h: isize) {
    unsafe {
        CloseHandle((h as usize) as *mut u8);
    }
}

/// Delete the file at `path`; false on failure.
pub fn remove_file(path: str): bool {
    let w = wide(path);
    return unsafe { DeleteFileW(w[..].as_ptr()) } != 0;
}

/// `path` as NUL-terminated UTF-16.
fn wide(path: str): [u16; -..+] {
    let mut w: [u16; -..+] = [];
    // In a verbatim path (`\\?\C:\...`) Windows takes no `/` for `\`.
    let verbatim = path.starts_with("\\\\?\\") || path.starts_with("//?/") || path.starts_with("\\\\?/") || path.starts_with("//?\\");
    for c in path.chars() {
        let cp = c as u32;
        if verbatim && c == '/' {
            w.push(92);
        } else if cp < 65536 {
            w.push(cp as u16);
        } else {
            let v = cp - 65536;
            w.push((55296 | (v >> 10)) as u16);
            w.push((56320 | (v & 1023)) as u16);
        }
    }
    w.push(0);
    return w;
}

const MEM_COMMIT: u32 = 4096;
const MEM_RESERVE: u32 = 8192;
const MEM_DECOMMIT: u32 = 16384;
const MEM_RELEASE: u32 = 32768;
const PAGE_NOACCESS: u32 = 1;
const PAGE_READWRITE: u32 = 4;

fn handle(fd: i32): *mut u8 {
    // STD_INPUT_HANDLE = -10, STD_OUTPUT_HANDLE = -11, STD_ERROR_HANDLE = -12
    let n: u32 = if fd == 0 { 4294967286 } else if fd == 1 { 4294967285 } else { 4294967284 };
    return unsafe { GetStdHandle(n) };
}

pub fn write(fd: i32, bytes: [u8; &]) {
    let h = handle(fd);
    let mut off: usize = 0;
    while off < bytes.len() {
        let mut written: u32 = 0;
        let mut chunk = bytes.len() - off;
        if chunk > 1073741824 {
            chunk = 1073741824;
        }
        let ok = unsafe {
            WriteFile(h, intrinsics::ptr_offset(bytes.as_ptr(), off as isize), chunk as u32, intrinsics::addr_of_mut(&mut written), core::ptr::null_mut())
        };
        if ok == 0 || written == 0 {
            return;
        }
        off += written as usize;
    }
}

/// Whether `fd` is a terminal: a console, or the pipe of an MSYS or
/// Cygwin terminal (such as Git Bash's mintty).
pub fn is_terminal(fd: i32): bool {
    let h = handle(fd);
    let mut mode: u32 = 0;
    if unsafe { GetConsoleMode(h, intrinsics::addr_of_mut(&mut mode)) } != 0 {
        return true;
    }
    return is_msys_pty(h);
}

/// Whether ANSI escape codes written to `fd` show as colors: it is a
/// console that interprets them (switched on here with
/// `ENABLE_VIRTUAL_TERMINAL_PROCESSING`, for consoles that do not by
/// default), or an MSYS or Cygwin terminal.
pub fn enable_ansi(fd: i32): bool {
    let h = handle(fd);
    let mut mode: u32 = 0;
    if unsafe { GetConsoleMode(h, intrinsics::addr_of_mut(&mut mode)) } == 0 {
        return is_msys_pty(h);
    }
    // ENABLE_VIRTUAL_TERMINAL_PROCESSING
    if (mode & 4) != 0 {
        return true;
    }
    return unsafe { SetConsoleMode(h, mode | 4) } != 0;
}

/// Whether `h` is the pipe an MSYS or Cygwin terminal connects programs
/// to: its name has `msys-` or `cygwin-`, and `-pty` (as Rust's
/// `is_terminal` checks).
fn is_msys_pty(h: *mut u8): bool {
    // FILE_NAME_INFO: the name's length in bytes (a u32), then the name
    // in UTF-16.
    let mut info: [u16; 520] = [0; 520];
    // FileNameInfo = 2
    let p = (intrinsics::addr_of_mut(&mut info) as usize) as *mut u8;
    let ok = unsafe { GetFileInformationByHandleEx(h, 2, p, 1040) };
    if ok == 0 {
        return false;
    }
    let mut n = ((info[0] as usize) | ((info[1] as usize) << 16)) / 2;
    if n > 518 {
        n = 518;
    }
    let mut name = String::new();
    for i in 0..n {
        let c = info[i + 2];
        name.push(if c < 128 { c as u8 as char } else { '?' });
    }
    let s = name.as_str();
    return (s.contains("msys-") || s.contains("cygwin-")) && s.contains("-pty");
}

extern "C" {
    fn PeekNamedPipe(h: *mut u8, buf: *mut u8, size: u32, got: *mut u32, avail: *mut u32, left: *mut u32): i32;
}

/// Write all of `bytes` to `fd`; false on failure.
pub fn write_all(fd: i32, bytes: [u8; &]): bool {
    return write_file((handle(fd) as usize) as isize, bytes);
}

/// Whether reading `fd` now would not block: it is a pipe with bytes
/// waiting (consoles and files cannot tell, and are false).
pub fn input_available(fd: i32): bool {
    let mut avail: u32 = 0;
    let ok = unsafe {
        PeekNamedPipe(handle(fd), core::ptr::null_mut(), 0, core::ptr::null_mut(), intrinsics::addr_of_mut(&mut avail), core::ptr::null_mut())
    };
    return ok != 0 && avail > 0;
}


pub fn read(fd: i32, buf: [u8; &mut]): isize {
    let h = handle(fd);
    let mut got: u32 = 0;
    let ok = unsafe { ReadFile(h, buf.as_mut_ptr(), buf.len() as u32, intrinsics::addr_of_mut(&mut got), core::ptr::null_mut()) };
    if ok == 0 {
        return -1;
    }
    return got as isize;
}

pub fn exit(code: i32): ! {
    unsafe { ExitProcess(code as u32) }
}

pub fn reserve(size: usize): *mut u8 {
    return unsafe { VirtualAlloc(core::ptr::null_mut(), size, MEM_RESERVE, PAGE_NOACCESS) };
}

pub fn commit(base: *mut u8, size: usize) {
    let p = unsafe { VirtualAlloc(base, size, MEM_COMMIT, PAGE_READWRITE) };
    if (p as usize) == 0 {
        write(2, "fatal: out of memory (could not commit data stack pages)\n".as_bytes());
        exit(134);
    }
}

pub fn decommit(base: *mut u8, size: usize) {
    unsafe {
        VirtualFree(base, size, MEM_DECOMMIT);
    }
}

pub fn release(base: *mut u8, size: usize) {
    let _ = size;
    unsafe {
        VirtualFree(base, 0, MEM_RELEASE);
    }
}

// ===================================================================== directories, paths, processes

extern "C" {
    fn CreateDirectoryW(name: *u16, security: *mut u8): i32;
    fn RemoveDirectoryW(name: *u16): i32;
    fn GetFileAttributesW(name: *u16): u32;
    fn SetFileAttributesW(name: *u16, attributes: u32): i32;
    fn FindFirstFileW(name: *u16, data: *mut u8): *mut u8;
    fn FindNextFileW(h: *mut u8, data: *mut u8): i32;
    fn FindClose(h: *mut u8): i32;
    fn GetCurrentDirectoryW(n: u32, buf: *mut u16): u32;
    fn GetFinalPathNameByHandleW(h: *mut u8, buf: *mut u16, n: u32, flags: u32): u32;
    fn GetModuleFileNameW(module: *mut u8, buf: *mut u16, n: u32): u32;
    fn GetTempPathW(n: u32, buf: *mut u16): u32;
    fn GetCurrentProcessId(): u32;
    fn GetCurrentProcess(): *mut u8;
    fn DuplicateHandle(from_process: *mut u8, h: *mut u8, to_process: *mut u8, out: *mut usize, access: u32, inherit: i32, options: u32): i32;
    fn CreateProcessW(app: *u16, cmd: *mut u16, pattr: *mut u8, tattr: *mut u8, inherit: i32, flags: u32, env: *mut u8, dir: *u16, si: *mut u8, pi: *mut u8): i32;
    fn WaitForSingleObject(h: *mut u8, ms: u32): u32;
    fn GetExitCodeProcess(h: *mut u8, code: *mut u32): i32;
}

const FILE_ATTRIBUTE_READONLY: u32 = 1;
const FILE_ATTRIBUTE_DIRECTORY: u32 = 16;
const FILE_ATTRIBUTE_REPARSE_POINT: u32 = 1024;
const INVALID_FILE_ATTRIBUTES: u32 = 4294967295;

/// Create the directory `path`; false on failure.
pub fn create_dir(path: str): bool {
    let w = wide(path);
    return unsafe { CreateDirectoryW(w[..].as_ptr(), core::ptr::null_mut()) } != 0;
}

/// Remove the empty directory `path`; false on failure.
pub fn remove_dir(path: str): bool {
    let w = wide(path);
    return unsafe { RemoveDirectoryW(w[..].as_ptr()) } != 0;
}

/// What is at `path`: 0 nothing (or nothing accessible), 1 a file, 2 a
/// directory (following links).
pub fn file_kind(path: str): i32 {
    let w = wide(path);
    let a = unsafe { GetFileAttributesW(w[..].as_ptr()) };
    if a == INVALID_FILE_ATTRIBUTES {
        return 0;
    }
    return if (a & FILE_ATTRIBUTE_DIRECTORY) != 0 { 2 } else { 1 };
}

/// Whether `path` is a link (a reparse point), which `remove_dir_all`
/// removes without following.
pub fn is_link(path: str): bool {
    let w = wide(path);
    let a = unsafe { GetFileAttributesW(w[..].as_ptr()) };
    return a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_REPARSE_POINT) != 0;
}

/// Clear the read-only attribute of `path` (git makes its objects
/// read-only, and `DeleteFileW` refuses read-only files).
pub fn make_writable(path: str) {
    let w = wide(path);
    let a = unsafe { GetFileAttributesW(w[..].as_ptr()) };
    if a != INVALID_FILE_ATTRIBUTES && (a & FILE_ATTRIBUTE_READONLY) != 0 {
        unsafe {
            SetFileAttributesW(w[..].as_ptr(), a - FILE_ATTRIBUTE_READONLY);
        }
    }
}

/// The names in the directory `path` (without `.` and `..`), each
/// followed by a NUL, onto `out`; false on failure.
pub fn read_dir(path: str, out: &mut +String): bool {
    let mut pattern = String::from(path);
    if !path.ends_with("/") && !path.ends_with("\\") {
        pattern.push('\\');
    }
    pattern.push('*');
    let w = wide(pattern.as_str());
    // WIN32_FIND_DATAW (592 bytes); the name, in UTF-16, is at byte 44.
    let mut data: [u32; 160] = [0; 160];
    let p = (intrinsics::addr_of_mut(&mut data) as usize) as *mut u8;
    let h = unsafe { FindFirstFileW(w[..].as_ptr(), p) };
    if (h as usize) == 18446744073709551615 {
        return false;
    }
    loop {
        let mut units: [u16; 260] = [0; 260];
        let mut n: usize = 0;
        while n < 260 {
            let word = data[11 + n / 2];
            let u = if n % 2 == 0 { word & 65535 } else { word >> 16 };
            if u == 0 {
                break;
            }
            units[n] = u as u16;
            n += 1;
        }
        let mut name = String::new();
        from_wide(units[..n], &mut name);
        if name.as_str() != "." && name.as_str() != ".." {
            out.push_str(name.as_str());
            out.push('\0');
        }
        if unsafe { FindNextFileW(h, p) } == 0 {
            break;
        }
    }
    unsafe {
        FindClose(h);
    }
    return true;
}

/// The current directory, onto `out`; false on failure.
pub fn current_dir(out: &mut +String): bool {
    let mut size: u32 = 512;
    loop {
        let mut buf = zeroed_wide(size as usize);
        let n = unsafe { GetCurrentDirectoryW(size, mut_ptr(buf[..])) };
        if n == 0 {
            return false;
        }
        if n < size {
            from_wide(buf[..n as usize], out);
            return true;
        }
        size = n + 1;
    }
}

/// The absolute path of `path` with every link resolved, onto `out`
/// (without the `\\?\` prefix Windows gives it); false on failure.
pub fn canonicalize(path: str, out: &mut +String): bool {
    let w = wide(path);
    // FILE_FLAG_BACKUP_SEMANTICS (0x02000000) opens directories too.
    let h = unsafe { CreateFileW(w[..].as_ptr(), 0, 7, core::ptr::null_mut(), OPEN_EXISTING, 33554432, core::ptr::null_mut()) };
    if (h as usize) == 18446744073709551615 {
        return false;
    }
    let mut size: u32 = 512;
    let mut ok = false;
    let mut full = String::new();
    loop {
        let mut buf = zeroed_wide(size as usize);
        let n = unsafe { GetFinalPathNameByHandleW(h, mut_ptr(buf[..]), size, 0) };
        if n == 0 {
            break;
        }
        if n < size {
            from_wide(buf[..n as usize], &mut full);
            ok = true;
            break;
        }
        size = n + 1;
    }
    unsafe {
        CloseHandle(h);
    }
    if !ok {
        return false;
    }
    let f = full.as_str();
    if f.starts_with("\\\\?\\UNC\\") {
        out.push_str("\\\\");
        out.push_str(f[8..]);
    } else if f.starts_with("\\\\?\\") {
        out.push_str(f[4..]);
    } else {
        out.push_str(f);
    }
    return true;
}

/// The path of the running executable, onto `out`; false on failure.
pub fn current_exe(out: &mut +String): bool {
    let mut size: u32 = 512;
    loop {
        let mut buf = zeroed_wide(size as usize);
        let n = unsafe { GetModuleFileNameW(core::ptr::null_mut(), mut_ptr(buf[..]), size) };
        if n == 0 {
            return false;
        }
        if n < size {
            from_wide(buf[..n as usize], out);
            return true;
        }
        size = size * 2;
    }
}

/// The directory for temporary files, onto `out`.
pub fn temp_dir(out: &mut +String) {
    let mut buf = zeroed_wide(1024);
    let n = unsafe { GetTempPathW(1024, mut_ptr(buf[..])) };
    if n == 0 || n >= 1024 {
        out.push_str("C:\\Windows\\Temp");
        return;
    }
    let mut s = String::new();
    from_wide(buf[..n as usize], &mut s);
    let t = s.as_str();
    // Without the trailing `\`.
    if t.ends_with("\\") && t.len() > 3 {
        out.push_str(t[..t.len() - 1]);
    } else {
        out.push_str(t);
    }
}

pub fn process_id(): u32 {
    return unsafe { GetCurrentProcessId() };
}

extern "C" {
    fn CreatePipe(read: *mut usize, write: *mut usize, sa: *mut u8, size: u32): i32;
    fn SetHandleInformation(h: *mut u8, mask: u32, flags: u32): i32;
    fn GetEnvironmentStringsW(): *mut u16;
    fn FreeEnvironmentStringsW(block: *mut u16): i32;
}

/// A child's standard stream: this process's (`STDIO_INHERIT`), a file
/// (`STDIO_FILE`: read for input, created or truncated for output), a pipe
/// to this process (`STDIO_PIPE`) or nothing (`STDIO_NULL`).
pub const STDIO_INHERIT: i32 = 0;
pub const STDIO_FILE: i32 = 1;
pub const STDIO_PIPE: i32 = 2;
pub const STDIO_NULL: i32 = 3;

/// A started process (its handle) and this process's ends of the pipes to
/// its standard input, output and error (-1 where there is none).
pub struct Started {
    pub process: isize,
    pub stdin: isize,
    pub stdout: isize,
    pub stderr: isize,
}

/// Start `args[0]` (searched for on `PATH`) with the arguments
/// `args[1..]`, in the directory `dir` (unless empty), with the changes
/// `env` to this process's environment (`NAME=value` sets a variable,
/// `NAME` removes it). `modes[k]` and `paths[k]` say where its standard
/// input (k = 0), output (1) and error (2) go. The error is a Windows
/// error code.
pub fn start(args: [str; &], dir: str, env: [str; &], modes: [i32; &], paths: [str; &]): Result::<Started, i32> {
    let mut cmd = String::new();
    for i in 0..args.len() {
        if i > 0 {
            cmd.push(' ');
        }
        quote_arg(&mut cmd, args[i]);
    }
    let mut wcmd = wide(cmd.as_str());
    // SECURITY_ATTRIBUTES with bInheritHandle set: the child's handles.
    let mut sa: [u64; 3] = [24, 0, 1];
    let sap = (intrinsics::addr_of_mut(&mut sa) as usize) as *mut u8;
    let me = unsafe { GetCurrentProcess() };
    let mut handles: [usize; 3] = [0, 0, 0];
    let mut opened: [bool; 3] = [false, false, false];
    let mut mine: [isize; 3] = [-1, -1, -1];
    for k in 0..3 {
        let m = modes[k];
        if m == STDIO_FILE || m == STDIO_NULL {
            let w = wide(if m == STDIO_NULL { "NUL" } else { paths[k] });
            let access = if k == 0 { GENERIC_READ } else { GENERIC_WRITE };
            let disposition = if k == 0 { OPEN_EXISTING } else { CREATE_ALWAYS };
            let h = unsafe { CreateFileW(w[..].as_ptr(), access, FILE_SHARE_READ_WRITE, sap, disposition, FILE_ATTRIBUTE_NORMAL, core::ptr::null_mut()) };
            if (h as usize) == 18446744073709551615 {
                let e = last_error();
                close_handles(handles[..], opened[..]);
                close_mine(mine[..]);
                return Err(e);
            }
            handles[k] = h as usize;
            opened[k] = true;
        } else if m == STDIO_PIPE {
            let mut r: usize = 0;
            let mut w: usize = 0;
            if unsafe { CreatePipe(intrinsics::addr_of_mut(&mut r), intrinsics::addr_of_mut(&mut w), sap, 0) } == 0 {
                let e = last_error();
                close_handles(handles[..], opened[..]);
                close_mine(mine[..]);
                return Err(e);
            }
            let theirs = if k == 0 { r } else { w };
            let ours = if k == 0 { w } else { r };
            // Our end stays here: HANDLE_FLAG_INHERIT = 1.
            unsafe {
                SetHandleInformation(ours as *mut u8, 1, 0);
            }
            handles[k] = theirs;
            opened[k] = true;
            mine[k] = ours as isize;
        } else {
            // This process's own handle, duplicated for the child to inherit.
            let mut dup: usize = 0;
            // DUPLICATE_SAME_ACCESS = 2
            if unsafe { DuplicateHandle(me, handle(k as i32), me, intrinsics::addr_of_mut(&mut dup), 0, 1, 2) } != 0 {
                handles[k] = dup;
                opened[k] = true;
            }
        }
    }
    // The child's environment: ours, less the variables `env` changes,
    // plus those it sets.
    let mut block: [u16; ..+] = [];
    if env.len() > 0 {
        let p = unsafe { GetEnvironmentStringsW() };
        let mut i: usize = 0;
        loop {
            let mut n: usize = 0;
            while unsafe { intrinsics::ptr_read(intrinsics::ptr_offset(p as *u16, (i + n) as isize)) } != 0 {
                n += 1;
            }
            if n == 0 {
                break;
            }
            let mut entry = String::new();
            from_wide(unsafe { intrinsics::slice_from_raw(intrinsics::ptr_offset(p as *u16, i as isize), n) }, &mut entry);
            if !env_changes(entry.as_str(), env) {
                block.extend(wide(entry.as_str())[..]);
            }
            i += n + 1;
        }
        unsafe {
            FreeEnvironmentStringsW(p);
        }
        for e in env {
            if e.contains("=") {
                block.extend(wide(e)[..]);
            }
        }
        block.push(0);
    }
    let wdir = wide(dir);
    // STARTUPINFOW (104 bytes): `cb`; `dwFlags` = STARTF_USESTDHANDLES at
    // byte 60; the three handles at bytes 80, 88 and 96.
    let mut si: [u64; 13] = [0; 13];
    si[0] = 104;
    si[7] = 1099511627776;
    si[10] = handles[0] as u64;
    si[11] = handles[1] as u64;
    si[12] = handles[2] as u64;
    let mut pi: [u64; 3] = [0; 3];
    let sip = (intrinsics::addr_of_mut(&mut si) as usize) as *mut u8;
    let pip = (intrinsics::addr_of_mut(&mut pi) as usize) as *mut u8;
    // CREATE_UNICODE_ENVIRONMENT = 1024
    let flags: u32 = if env.len() > 0 { 1024 } else { 0 };
    let envp = if env.len() > 0 { (block[..].as_ptr() as usize) as *mut u8 } else { core::ptr::null_mut() };
    let dirp = if dir.len() > 0 { wdir[..].as_ptr() } else { core::ptr::null() };
    let ok = unsafe { CreateProcessW(core::ptr::null(), mut_ptr(wcmd[..]), core::ptr::null_mut(), core::ptr::null_mut(), 1, flags, envp, dirp, sip, pip) };
    let err = last_error();
    close_handles(handles[..], opened[..]);
    if ok == 0 {
        close_mine(mine[..]);
        return Err(err);
    }
    unsafe {
        CloseHandle((pi[1] as usize) as *mut u8);
    }
    return Ok(Started { process: (pi[0] as usize) as isize, stdin: mine[0], stdout: mine[1], stderr: mine[2] });
}

/// Wait for a started process: its exit code (`0..=u32::MAX`).
pub fn wait(process: isize): i64 {
    let h = (process as usize) as *mut u8;
    let mut code: u32 = 0;
    unsafe {
        WaitForSingleObject(h, 4294967295);
        GetExitCodeProcess(h, intrinsics::addr_of_mut(&mut code));
        CloseHandle(h);
    }
    return code as i64;
}

/// Run `args[0]` (searched for on `PATH`) with the arguments `args[1..]`
/// and wait for it. Its standard output and error go to the files
/// `out_path` and `err_path`, created for it, or, where empty, where this
/// process's go. The result is the exit code (`0..=u32::MAX`), or, if it
/// could not be started, `-1 - the error code`.
pub fn spawn(args: [str; &], out_path: str, err_path: str): i64 {
    let modes = [STDIO_INHERIT, if out_path.len() > 0 { STDIO_FILE } else { STDIO_INHERIT }, if err_path.len() > 0 { STDIO_FILE } else { STDIO_INHERIT }];
    let paths = ["", out_path, err_path];
    let none: [str; 0] = [];
    return match start(args, "", none[..], modes[..], paths[..]) {
        Ok(s) => wait(s.process),
        Err(e) => -1 - (e as i64),
    };
}

/// Whether the environment entry `entry` (`NAME=value`) is of a variable
/// that `env` sets or removes. Names are compared without case.
fn env_changes(entry: str, env: [str; &]): bool {
    let name = env_name(entry);
    for e in env {
        let other = env_name(e);
        if other.len() == name.len() {
            let mut same = true;
            let (a, b) = (name.as_bytes(), other.as_bytes());
            for i in 0..a.len() {
                if ascii_lower(a[i]) != ascii_lower(b[i]) {
                    same = false;
                    break;
                }
            }
            if same {
                return true;
            }
        }
    }
    return false;
}

/// The name in `NAME=value` (or `NAME`); a leading `=` is part of it, as in
/// the `=C:=C:\dir` entries Windows keeps.
fn env_name(e: str): str {
    let b = e.as_bytes();
    for i in 1..b.len() {
        if b[i] == b'=' {
            return e[..i];
        }
    }
    return e;
}

fn ascii_lower(c: u8): u8 {
    return if c >= b'A' && c <= b'Z' { c + 32 } else { c };
}

fn close_mine(hs: [isize; &]) {
    for h in hs {
        if h != -1 {
            close_file(h);
        }
    }
}

fn close_handles(handles: [usize; &], opened: [bool; &]) {
    for k in 0..handles.len() {
        if opened[k] {
            unsafe {
                CloseHandle(handles[k] as *mut u8);
            }
        }
    }
}

/// `a`, quoted for a Windows command line if it needs to be (MSVC rules:
/// backslashes before a quote are doubled, and the quote escaped).
fn quote_arg(text: &mut +String, a: str) {
    if a.len() > 0 && !a.contains(" ") && !a.contains("\t") && !a.contains("\"") {
        text.push_str(a);
        return;
    }
    text.push('"');
    let mut backslashes: usize = 0;
    for c in a.chars() {
        if c == '\\' {
            backslashes += 1;
            continue;
        }
        let n = if c == '"' { backslashes * 2 + 1 } else { backslashes };
        for _ in 0..n {
            text.push('\\');
        }
        backslashes = 0;
        text.push(c);
    }
    for _ in 0..backslashes * 2 {
        text.push('\\');
    }
    text.push('"');
}

/// The address of `b`'s first unit, for C to write to.
fn mut_ptr(b: [u16; &mut]): *mut u16 {
    return b.as_mut_ptr();
}

/// `n` zeroed UTF-16 units.
fn zeroed_wide(n: usize): [u16; -..+] {
    let mut w: [u16; -..+] = [];
    for _ in 0..n {
        w.push(0);
    }
    return w;
}

/// UTF-16 `w` as UTF-8 onto `out` (an unpaired surrogate becomes U+FFFD).
fn from_wide(w: [u16; &], out: &mut +String) {
    let mut i: usize = 0;
    while i < w.len() {
        let u = w[i] as u32;
        let mut cp = u;
        if u >= 55296 && u < 56320 && i + 1 < w.len() && (w[i + 1] as u32) >= 56320 && (w[i + 1] as u32) < 57344 {
            cp = 65536 + ((u - 55296) << 10) + ((w[i + 1] as u32) - 56320);
            i += 1;
        } else if u >= 55296 && u < 57344 {
            cp = 65533;
        }
        out.push(core::str::char_from_u32(cp));
        i += 1;
    }
}

// ===================================================================== files by handle

extern "C" {
    fn SetFilePointerEx(h: *mut u8, distance: i64, new_pos: *mut i64, method: u32): i32;
    fn FlushFileBuffers(h: *mut u8): i32;
    fn SetFileInformationByHandle(h: *mut u8, class: i32, info: *mut u8, size: u32): i32;
    fn GetFileInformationByHandle(h: *mut u8, info: *mut u8): i32;
    fn GetFileAttributesExW(name: *u16, level: i32, info: *mut u8): i32;
    fn MoveFileExW(from: *u16, to: *u16, flags: u32): i32;
    fn CreateHardLinkW(link: *u16, target: *u16, security: *mut u8): i32;
    fn CreateSymbolicLinkW(link: *u16, target: *u16, flags: u32): u8;
}

/// `INVALID_HANDLE_VALUE` and `INVALID_SOCKET`: all bits set.
const INVALID: usize = 18446744073709551615;
/// `FILE_FLAG_BACKUP_SEMANTICS`, which lets `CreateFileW` open directories.
const BACKUP_SEMANTICS: u32 = 33554432;

fn raw_handle(h: i64): *mut u8 {
    return (h as usize) as *mut u8;
}

/// The address of `b`'s first byte, for C to write to.
fn bytes_ptr(b: [u8; &mut]): *mut u8 {
    return b.as_mut_ptr();
}

/// The handle of standard input (`fd` 0), output (1) or error (2).
pub fn std_handle(fd: i32): i64 {
    return (handle(fd) as usize) as i64;
}

/// Open `path` as `OpenOptions` describe (validated by `fs`). The handle,
/// or -1.
pub fn open_options(path: str, read: bool, write: bool, append: bool, truncate: bool, create: bool, create_new: bool): i64 {
    let w = wide(path);
    let mut access: u32 = 0;
    if read {
        access = access | GENERIC_READ;
    }
    if append {
        // FILE_GENERIC_WRITE without FILE_WRITE_DATA: every write goes to
        // the end.
        access = access | 1179924;
    } else if write {
        access = access | GENERIC_WRITE;
    }
    // CREATE_NEW 1, CREATE_ALWAYS 2, OPEN_EXISTING 3, OPEN_ALWAYS 4,
    // TRUNCATE_EXISTING 5
    let disposition: u32 = if create_new { 1 } else if create && truncate { 2 } else if create { 4 } else if truncate { 5 } else { 3 };
    // Share read, write and delete, as other systems do.
    let h = unsafe { CreateFileW(w[..].as_ptr(), access, 7, core::ptr::null_mut(), disposition, FILE_ATTRIBUTE_NORMAL, core::ptr::null_mut()) };
    if (h as usize) == INVALID {
        return -1;
    }
    return (h as usize) as i64;
}

/// Read into `buf`: the number of bytes read, 0 at the end (or when the
/// other end of a pipe has closed), or -1.
pub fn handle_read(h: i64, buf: [u8; &mut]): isize {
    let mut got: u32 = 0;
    let mut n = buf.len();
    if n > 1073741824 {
        n = 1073741824;
    }
    let ok = unsafe { ReadFile(raw_handle(h), buf.as_mut_ptr(), n as u32, intrinsics::addr_of_mut(&mut got), core::ptr::null_mut()) };
    if ok == 0 {
        // ERROR_BROKEN_PIPE: the writer is gone, which is the end.
        if last_error() == 109 {
            return 0;
        }
        return -1;
    }
    return got as isize;
}

/// Write some of `bytes`: how many, or -1.
pub fn handle_write(h: i64, bytes: [u8; &]): isize {
    let mut written: u32 = 0;
    let mut n = bytes.len();
    if n > 1073741824 {
        n = 1073741824;
    }
    let ok = unsafe { WriteFile(raw_handle(h), bytes.as_ptr(), n as u32, intrinsics::addr_of_mut(&mut written), core::ptr::null_mut()) };
    if ok == 0 {
        return -1;
    }
    return written as isize;
}

/// Move the file position (`whence`: 0 from the start, 1 from the current
/// position, 2 from the end); the new position, or -1.
pub fn seek(h: i64, offset: i64, whence: i32): i64 {
    let mut pos: i64 = 0;
    if unsafe { SetFilePointerEx(raw_handle(h), offset, intrinsics::addr_of_mut(&mut pos), whence as u32) } == 0 {
        return -1;
    }
    return pos;
}

/// Write the file's data and metadata to the device.
pub fn sync(h: i64): bool {
    return unsafe { FlushFileBuffers(raw_handle(h)) } != 0;
}

/// Truncate or extend the file to `len` bytes.
pub fn set_len(h: i64, len: u64): bool {
    let mut end: u64 = len;
    // FileEndOfFileInfo = 6
    let p = (intrinsics::addr_of_mut(&mut end) as usize) as *mut u8;
    return unsafe { SetFileInformationByHandle(raw_handle(h), 6, p, 8) } != 0;
}

/// Close a handle of `kind` (`rt::HANDLE_FILE` or `rt::HANDLE_SOCKET`).
pub fn close_handle(kind: usize, h: i64): bool {
    if kind == crater::rt::HANDLE_SOCKET {
        return unsafe { closesocket(h as u64) } == 0;
    }
    return unsafe { CloseHandle(raw_handle(h)) } != 0;
}

/// A `FILETIME` (two `u32`s) as one count of 100 ns ticks since 1601.
fn ticks(lo: u32, hi: u32): u64 {
    return (lo as u64) | ((hi as u64) << 32);
}

/// 100 ns ticks since 1601 as seconds and nanoseconds since 1970.
fn filetime(t: u64): (i64, u32) {
    return ((t / 10000000) as i64 - 11644473600, ((t % 10000000) * 100) as u32);
}

/// Fill `out` from a file's attributes, times (as ticks) and size.
fn fill_stat(out: &mut FileStat, attrs: u32, created: u64, accessed: u64, written: u64, len: u64, link: bool) {
    out.len = len;
    out.kind = if link { 3 } else if (attrs & FILE_ATTRIBUTE_DIRECTORY) != 0 { 2 } else { 1 };
    out.readonly = (attrs & FILE_ATTRIBUTE_READONLY) != 0;
    let (ms, mns) = filetime(written);
    out.modified_s = ms;
    out.modified_ns = mns;
    let (a_s, a_ns) = filetime(accessed);
    out.accessed_s = a_s;
    out.accessed_ns = a_ns;
    let (cs, cns) = filetime(created);
    out.has_created = true;
    out.created_s = cs;
    out.created_ns = cns;
}

/// What the open handle `h` is.
pub fn fstat(h: i64, out: &mut FileStat): bool {
    // BY_HANDLE_FILE_INFORMATION: attributes, three FILETIMEs (creation,
    // access, write), the volume, then the size (high, low).
    let mut info: [u32; 13] = [0; 13];
    let p = (intrinsics::addr_of_mut(&mut info) as usize) as *mut u8;
    if unsafe { GetFileInformationByHandle(raw_handle(h), p) } == 0 {
        return false;
    }
    fill_stat(out, info[0], ticks(info[1], info[2]), ticks(info[3], info[4]), ticks(info[5], info[6]), ticks(info[9], info[8]), false);
    return true;
}

/// What is at `path`, following a link there if `follow`.
pub fn stat(path: str, follow: bool, out: &mut FileStat): bool {
    let w = wide(path);
    if follow {
        // Opening the path follows links; access 0 needs no permissions.
        let h = unsafe { CreateFileW(w[..].as_ptr(), 0, 7, core::ptr::null_mut(), OPEN_EXISTING, BACKUP_SEMANTICS, core::ptr::null_mut()) };
        if (h as usize) != INVALID {
            let ok = fstat((h as usize) as i64, out);
            unsafe {
                CloseHandle(h);
            }
            return ok;
        }
        // ERROR_SHARING_VIOLATION (such as a page file): fall back to the
        // attributes.
        if last_error() != 32 {
            return false;
        }
    }
    // WIN32_FILE_ATTRIBUTE_DATA: attributes, three FILETIMEs, size (high,
    // low).
    let mut data: [u32; 9] = [0; 9];
    let p = (intrinsics::addr_of_mut(&mut data) as usize) as *mut u8;
    if unsafe { GetFileAttributesExW(w[..].as_ptr(), 0, p) } == 0 {
        return false;
    }
    let link = !follow && (data[0] & FILE_ATTRIBUTE_REPARSE_POINT) != 0 && is_symlink_tag(w[..]);
    fill_stat(out, data[0], ticks(data[1], data[2]), ticks(data[3], data[4]), ticks(data[5], data[6]), ticks(data[8], data[7]), link);
    return true;
}

/// Whether the reparse point `w` is a symbolic link or a junction (not
/// one of the other kinds, such as cloud placeholders).
fn is_symlink_tag(w: [u16; &]): bool {
    // WIN32_FIND_DATAW: the reparse tag is `dwReserved0`, at byte 36.
    let mut data: [u32; 160] = [0; 160];
    let p = (intrinsics::addr_of_mut(&mut data) as usize) as *mut u8;
    let h = unsafe { FindFirstFileW(w.as_ptr(), p) };
    if (h as usize) == INVALID {
        return true;
    }
    unsafe {
        FindClose(h);
    }
    // IO_REPARSE_TAG_SYMLINK, IO_REPARSE_TAG_MOUNT_POINT
    return data[9] == 2684354572 || data[9] == 2684354563;
}

/// Rename `from` to `to`, replacing a file at `to`.
pub fn rename(from: str, to: str): bool {
    let a = wide(from);
    let b = wide(to);
    // MOVEFILE_REPLACE_EXISTING
    return unsafe { MoveFileExW(a[..].as_ptr(), b[..].as_ptr(), 1) } != 0;
}

/// Make `dst` another name for the file `src`.
pub fn hard_link(src: str, dst: str): bool {
    let a = wide(src);
    let b = wide(dst);
    return unsafe { CreateHardLinkW(b[..].as_ptr(), a[..].as_ptr(), core::ptr::null_mut()) } != 0;
}

/// Make `dst` a symbolic link to `src` (a directory if `dir`). Without
/// Developer Mode this needs administrator rights.
pub fn symlink(src: str, dst: str, dir: bool): bool {
    // Windows follows only `\` in link targets.
    let mut target = String::new();
    for c in src.chars() {
        target.push(if c == '/' { '\\' } else { c });
    }
    let a = wide(target.as_str());
    let b = wide(dst);
    // SYMBOLIC_LINK_FLAG_DIRECTORY 1, _ALLOW_UNPRIVILEGED_CREATE 2
    let flags: u32 = if dir { 3 } else { 2 };
    return unsafe { CreateSymbolicLinkW(b[..].as_ptr(), a[..].as_ptr(), flags) } != 0;
}

/// Set or clear the read-only attribute of `path`.
pub fn set_readonly(path: str, readonly: bool): bool {
    let w = wide(path);
    let a = unsafe { GetFileAttributesW(w[..].as_ptr()) };
    if a == INVALID_FILE_ATTRIBUTES {
        return false;
    }
    let mut b = if readonly { a | FILE_ATTRIBUTE_READONLY } else { a & (4294967295 - FILE_ATTRIBUTE_READONLY) };
    if b == 0 {
        b = FILE_ATTRIBUTE_NORMAL;
    }
    return unsafe { SetFileAttributesW(w[..].as_ptr(), b) } != 0;
}

// ===================================================================== time

extern "C" {
    fn QueryPerformanceCounter(count: *mut i64): i32;
    fn QueryPerformanceFrequency(freq: *mut i64): i32;
    fn GetSystemTimePreciseAsFileTime(t: *mut u64);
    fn Sleep(ms: u32);
}

/// Performance counter ticks per second (fixed at boot), once read.
static mut COUNTER_HZ: u64 = 0;

/// Nanoseconds on a clock that never goes back, from some fixed point.
pub fn monotonic_ns(): u64 {
    let mut c: i64 = 0;
    // Threads may read it for the first time together: each stores the
    // same value, atomically.
    let mut hz = unsafe { intrinsics::atomic_load(intrinsics::addr_of_mut(&mut COUNTER_HZ) as *u64, 2) };
    unsafe {
        QueryPerformanceCounter(intrinsics::addr_of_mut(&mut c));
        if hz == 0 {
            let mut f: i64 = 0;
            QueryPerformanceFrequency(intrinsics::addr_of_mut(&mut f));
            hz = f as u64;
            intrinsics::atomic_store(intrinsics::addr_of_mut(&mut COUNTER_HZ), hz, 2);
        }
    }
    let t = c as u64;
    // `t * 1e9 / hz` without overflowing.
    return (t / hz) * 1000000000 + (t % hz) * 1000000000 / hz;
}

/// The time of day: seconds and nanoseconds since 1970-01-01 UTC.
pub fn system_time(): (i64, u32) {
    let mut t: u64 = 0;
    unsafe {
        GetSystemTimePreciseAsFileTime(intrinsics::addr_of_mut(&mut t));
    }
    return filetime(t);
}

/// Sleep at least `ns` nanoseconds (Windows sleeps in milliseconds).
pub fn sleep_ns(ns: u64) {
    let mut ms = ns / 1000000;
    if ns % 1000000 != 0 {
        ms += 1;
    }
    while ms > 0 {
        let chunk: u64 = if ms > 4294967294 { 4294967294 } else { ms };
        unsafe {
            Sleep(chunk as u32);
        }
        ms -= chunk;
    }
}

// ===================================================================== randomness and the environment

#[link(name = "bcrypt")]
extern "C" {
    fn BCryptGenRandom(alg: *mut u8, buf: *mut u8, len: u32, flags: u32): i32;
}

/// Fill `buf` with random bytes from the operating system.
pub fn random_fill(buf: [u8; &mut]): bool {
    let mut off: usize = 0;
    while off < buf.len() {
        let mut n = buf.len() - off;
        if n > 1073741824 {
            n = 1073741824;
        }
        // BCRYPT_USE_SYSTEM_PREFERRED_RNG = 2
        let r = unsafe { BCryptGenRandom(core::ptr::null_mut(), bytes_ptr(buf[off..]), n as u32, 2) };
        if r != 0 {
            return false;
        }
        off += n;
    }
    return true;
}

/// Every environment variable as `NAME=value` and a NUL, onto `out`.
pub fn env_block(out: &mut +String) {
    let block = unsafe { GetEnvironmentStringsW() };
    if core::ptr::is_null(block as *u16) {
        return;
    }
    let p = block as *u16;
    let mut i: isize = 0;
    loop {
        let start = i;
        while unsafe { intrinsics::ptr_read(intrinsics::ptr_offset(p, i)) } != 0 {
            i += 1;
        }
        // An empty entry ends the block.
        if i == start {
            break;
        }
        let entry = unsafe { intrinsics::slice_from_raw(intrinsics::ptr_offset(p, start), (i - start) as usize) };
        // `=C:=C:\dir` entries are the current directories of drives, not
        // variables.
        if entry[0] != 61 {
            from_wide(entry, out);
            out.push('\0');
        }
        i += 1;
    }
    unsafe {
        FreeEnvironmentStringsW(block);
    }
}

// ===================================================================== sockets

#[link(name = "ws2_32")]
extern "C" {
    fn WSAStartup(version: u16, data: *mut u8): i32;
    fn WSAGetLastError(): i32;
    fn WSASocketW(af: i32, kind: i32, protocol: i32, info: *mut u8, group: u32, flags: u32): u64;
    fn closesocket(s: u64): i32;
    #[link_name = "bind"]
    fn ws_bind(s: u64, addr: *u8, len: i32): i32;
    #[link_name = "listen"]
    fn ws_listen(s: u64, backlog: i32): i32;
    #[link_name = "accept"]
    fn ws_accept(s: u64, addr: *mut u8, len: *mut i32): u64;
    #[link_name = "connect"]
    fn ws_connect(s: u64, addr: *u8, len: i32): i32;
    #[link_name = "recv"]
    fn ws_recv(s: u64, buf: *mut u8, len: i32, flags: i32): i32;
    #[link_name = "send"]
    fn ws_send(s: u64, buf: *u8, len: i32, flags: i32): i32;
    #[link_name = "recvfrom"]
    fn ws_recvfrom(s: u64, buf: *mut u8, len: i32, flags: i32, from: *mut u8, from_len: *mut i32): i32;
    #[link_name = "sendto"]
    fn ws_sendto(s: u64, buf: *u8, len: i32, flags: i32, to: *u8, to_len: i32): i32;
    #[link_name = "shutdown"]
    fn ws_shutdown(s: u64, how: i32): i32;
    fn setsockopt(s: u64, level: i32, name: i32, value: *u8, len: i32): i32;
    fn getsockopt(s: u64, level: i32, name: i32, value: *mut u8, len: *mut i32): i32;
    fn getsockname(s: u64, addr: *mut u8, len: *mut i32): i32;
    fn getpeername(s: u64, addr: *mut u8, len: *mut i32): i32;
    fn ioctlsocket(s: u64, cmd: i32, arg: *mut u32): i32;
    fn WSAPoll(fds: *mut u8, n: u32, timeout: i32): i32;
    fn GetAddrInfoW(node: *u16, service: *u16, hints: *u8, result: *mut *mut u8): i32;
    fn FreeAddrInfoW(info: *mut u8);
}

/// Whether `WSAStartup` has run (1). Winsock is started the first time a
/// socket is made or a name looked up, and stays up until exit. Threads
/// may get here together; `WSAStartup` counts its calls, so running it
/// twice does no harm.
static mut WINSOCK_READY: u32 = 0;

fn net_init() {
    // Acquire: what `WSAStartup` did is seen once the flag is.
    if unsafe { intrinsics::atomic_load(intrinsics::addr_of_mut(&mut WINSOCK_READY) as *u32, 4) } != 0 {
        return;
    }
    // WSADATA is 408 bytes on 64-bit Windows.
    let mut data: [u64; 51] = [0; 51];
    let p = (intrinsics::addr_of_mut(&mut data) as usize) as *mut u8;
    unsafe {
        // Version 2.2
        WSAStartup(514, p);
        intrinsics::atomic_store(intrinsics::addr_of_mut(&mut WINSOCK_READY), 1, 5);
    }
}

/// The error code of the last failed socket call.
pub fn net_error(): i32 {
    return unsafe { WSAGetLastError() };
}

const SOL_SOCKET: i32 = 65535;

/// A new TCP (`stream`) or UDP socket for IPv4 or IPv6, not inherited by
/// child processes; -1 on failure.
pub fn socket(v6: bool, stream: bool): i64 {
    net_init();
    let af = if v6 { AF_INET6 } else { 2 };
    let (kind, protocol) = if stream { (1, 6) } else { (2, 17) };
    // WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT
    let s = unsafe { WSASocketW(af, kind, protocol, core::ptr::null_mut(), 0, 129) };
    if (s as usize) == INVALID {
        return -1;
    }
    return s as i64;
}

pub fn sock_bind(s: i64, a: RawAddr): bool {
    let mut buf: [u8; 32] = [0; 32];
    let n = encode_addr(a, buf[..]);
    return unsafe { ws_bind(s as u64, buf[..].as_ptr(), n) } == 0;
}

pub fn sock_listen(s: i64, backlog: i32): bool {
    return unsafe { ws_listen(s as u64, backlog) } == 0;
}

/// Accept a connection: the new socket (or -1), and its peer in `peer`.
pub fn sock_accept(s: i64, peer: &mut RawAddr): i64 {
    let mut buf: [u8; 128] = [0; 128];
    let mut len: i32 = 128;
    let r = unsafe { ws_accept(s as u64, bytes_ptr(buf[..]), intrinsics::addr_of_mut(&mut len)) };
    if (r as usize) == INVALID {
        return -1;
    }
    unsafe {
        // Not inherited by child processes (HANDLE_FLAG_INHERIT = 1).
        SetHandleInformation((r as usize) as *mut u8, 1, 0);
    }
    peer = decode_addr(buf[..len as usize]);
    return r as i64;
}

pub fn sock_connect(s: i64, a: RawAddr): bool {
    let mut buf: [u8; 32] = [0; 32];
    let n = encode_addr(a, buf[..]);
    return unsafe { ws_connect(s as u64, buf[..].as_ptr(), n) } == 0;
}

fn clamp_len(n: usize): i32 {
    if n > 1073741824 {
        return 1073741824;
    }
    return n as i32;
}

/// Receive into `buf` (leaving the data queued if `peek`): bytes, 0 when
/// the peer has shut down, or -1.
pub fn sock_recv(s: i64, buf: [u8; &mut], peek: bool): isize {
    // MSG_PEEK = 2
    let r = unsafe { ws_recv(s as u64, buf.as_mut_ptr(), clamp_len(buf.len()), if peek { 2 } else { 0 }) };
    if r < 0 && net_error() == 10058 {
        // WSAESHUTDOWN: this side was shut down for reading.
        return 0;
    }
    return r as isize;
}

pub fn sock_send(s: i64, bytes: [u8; &]): isize {
    return unsafe { ws_send(s as u64, bytes.as_ptr(), clamp_len(bytes.len()), 0) } as isize;
}

pub fn sock_recv_from(s: i64, buf: [u8; &mut], peek: bool, from: &mut RawAddr): isize {
    let mut abuf: [u8; 128] = [0; 128];
    let mut len: i32 = 128;
    let r = unsafe { ws_recvfrom(s as u64, buf.as_mut_ptr(), clamp_len(buf.len()), if peek { 2 } else { 0 }, bytes_ptr(abuf[..]), intrinsics::addr_of_mut(&mut len)) };
    if r >= 0 {
        from = decode_addr(abuf[..len as usize]);
    }
    return r as isize;
}

pub fn sock_send_to(s: i64, bytes: [u8; &], to: RawAddr): isize {
    let mut abuf: [u8; 32] = [0; 32];
    let n = encode_addr(to, abuf[..]);
    return unsafe { ws_sendto(s as u64, bytes.as_ptr(), clamp_len(bytes.len()), 0, abuf[..].as_ptr(), n) } as isize;
}

/// Shut down reading (0), writing (1) or both (2).
pub fn sock_shutdown(s: i64, how: i32): bool {
    return unsafe { ws_shutdown(s as u64, how) } == 0;
}

/// The socket's own address, or its peer's.
pub fn sock_name(s: i64, peer: bool, out: &mut RawAddr): bool {
    let mut buf: [u8; 128] = [0; 128];
    let mut len: i32 = 128;
    let p = bytes_ptr(buf[..]);
    let r = if peer {
        unsafe { getpeername(s as u64, p, intrinsics::addr_of_mut(&mut len)) }
    } else {
        unsafe { getsockname(s as u64, p, intrinsics::addr_of_mut(&mut len)) }
    };
    if r != 0 {
        return false;
    }
    out = decode_addr(buf[..len as usize]);
    return true;
}

pub fn sock_set_nonblocking(s: i64, on: bool): bool {
    let mut arg: u32 = if on { 1 } else { 0 };
    // FIONBIO
    return unsafe { ioctlsocket(s as u64, -2147195266, intrinsics::addr_of_mut(&mut arg)) } == 0;
}

/// Set the receive (or, if `write`, send) timeout in milliseconds; 0 waits
/// forever.
pub fn sock_set_timeout(s: i64, write: bool, ms: u64): bool {
    let v: u32 = if ms > 4294967294 { 4294967294 } else { ms as u32 };
    let mut b: [u8; 4] = [0; 4];
    put_u32(b[..], 0, v);
    // SO_SNDTIMEO 0x1005, SO_RCVTIMEO 0x1006
    let name = if write { 4101 } else { 4102 };
    return unsafe { setsockopt(s as u64, SOL_SOCKET, name, b[..].as_ptr(), 4) } == 0;
}

/// The receive (or send) timeout in milliseconds (0: none), or -1.
pub fn sock_timeout(s: i64, write: bool): i64 {
    let mut b: [u8; 8] = [0; 8];
    let mut len: i32 = 8;
    let name = if write { 4101 } else { 4102 };
    if unsafe { getsockopt(s as u64, SOL_SOCKET, name, bytes_ptr(b[..]), intrinsics::addr_of_mut(&mut len)) } != 0 {
        return -1;
    }
    return get_u32(b[..], 0) as i64;
}

/// The level and name of a `FLAG_*` option.
fn flag_option(flag: i32): (i32, i32) {
    return match flag {
        // IPPROTO_TCP, TCP_NODELAY
        1 => (6, 1),
        // SO_BROADCAST
        2 => (SOL_SOCKET, 32),
        // SO_REUSEADDR
        3 => (SOL_SOCKET, 4),
        // IPPROTO_IPV6, IPV6_V6ONLY
        _ => (41, 27),
    };
}

pub fn sock_set_flag(s: i64, flag: i32, on: bool): bool {
    let (level, name) = flag_option(flag);
    let mut b: [u8; 4] = [0; 4];
    b[0] = if on { 1 } else { 0 };
    return unsafe { setsockopt(s as u64, level, name, b[..].as_ptr(), 4) } == 0;
}

/// A `FLAG_*` option: 1 on, 0 off, -1 on failure.
pub fn sock_flag(s: i64, flag: i32): i32 {
    let (level, name) = flag_option(flag);
    let mut b: [u8; 4] = [0; 4];
    let mut len: i32 = 4;
    if unsafe { getsockopt(s as u64, level, name, bytes_ptr(b[..]), intrinsics::addr_of_mut(&mut len)) } != 0 {
        return -1;
    }
    return if b[0] != 0 { 1 } else { 0 };
}

/// The pending error of the socket (`SO_ERROR`), 0 if none, -1 on failure.
pub fn sock_error(s: i64): i32 {
    let mut b: [u8; 4] = [0; 4];
    let mut len: i32 = 4;
    // SO_ERROR = 0x1007
    if unsafe { getsockopt(s as u64, SOL_SOCKET, 4103, bytes_ptr(b[..]), intrinsics::addr_of_mut(&mut len)) } != 0 {
        return -1;
    }
    return get_u32(b[..], 0) as i32;
}

/// Wait up to `ms` milliseconds (-1: forever) for the socket to be
/// readable (or writable, if `write`): 1 ready, 0 timed out, -1 failed.
pub fn sock_poll(s: i64, write: bool, ms: i32): i32 {
    // WSAPOLLFD: the socket, then `events` and `revents` (i16 each).
    let mut fd: [u8; 16] = [0; 16];
    put_u64(fd[..], 0, s as u64);
    // POLLWRNORM 0x10; POLLRDNORM | POLLRDBAND 0x300
    put_u16(fd[..], 8, if write { 16 } else { 768 });
    let r = unsafe { WSAPoll(bytes_ptr(fd[..]), 1, ms) };
    if r < 0 {
        return -1;
    }
    return if r > 0 { 1 } else { 0 };
}

/// Look up the addresses of `host` onto `out`: 0, or the `getaddrinfo`
/// error.
pub fn lookup(host: str, out: &mut +[RawAddr; ..+]): i32 {
    net_init();
    let w = wide(host);
    // ADDRINFOW hints: only stream sockets, so each address comes once.
    let mut hints: [u8; 48] = [0; 48];
    put_u32(hints[..], 8, 1);
    let mut res: *mut u8 = core::ptr::null_mut();
    let r = unsafe { GetAddrInfoW(w[..].as_ptr(), core::ptr::null(), hints[..].as_ptr(), intrinsics::addr_of_mut(&mut res)) };
    if r != 0 {
        return r;
    }
    // ADDRINFOW: ai_addrlen at byte 16, ai_addr at 32, ai_next at 40.
    let mut p = res as *u8;
    while !core::ptr::is_null(p) {
        unsafe {
            let len = intrinsics::ptr_read(intrinsics::ptr_offset(p, 16) as *usize);
            let addr = intrinsics::ptr_read(intrinsics::ptr_offset(p, 32) as **u8);
            if !core::ptr::is_null(addr) {
                out.push(decode_addr(intrinsics::slice_from_raw(addr, len)));
            }
            p = intrinsics::ptr_read(intrinsics::ptr_offset(p, 40) as **u8);
        }
    }
    unsafe {
        FreeAddrInfoW(res);
    }
    return 0;
}

// ===================================================================== threads and waiting

extern "C" {
    fn CreateThread(attrs: *mut u8, stack: usize, start: fn(*mut u8): usize, arg: *mut u8, flags: u32, id: *mut u32): *mut u8;
    fn ExitThread(code: u32): !;
    fn SwitchToThread(): i32;
    fn GetActiveProcessorCount(group: u16): u32;
}

#[link(name = "synchronization")]
extern "C" {
    fn WaitOnAddress(addr: *u8, compare: *u8, size: usize, ms: u32): i32;
    fn WakeByAddressSingle(addr: *u8);
    fn WakeByAddressAll(addr: *u8);
}

/// Start a thread running `entry(arg)` with a stack of `stack` bytes
/// (reserved; 0 for the default), detached: nothing joins it, it ends when
/// `entry` returns or calls `thread_exit`. False if it could not be
/// started (see `last_error`).
pub fn thread_spawn(entry: fn(*mut u8): usize, arg: *mut u8, stack: usize): bool {
    // STACK_SIZE_PARAM_IS_A_RESERVATION
    let h = unsafe { CreateThread(core::ptr::null_mut(), stack, entry, arg, 65536, core::ptr::null_mut()) };
    if core::ptr::is_null(h as *u8) {
        return false;
    }
    unsafe {
        CloseHandle(h);
    }
    return true;
}

/// End the calling thread now.
pub fn thread_exit(): ! {
    unsafe { ExitThread(0) }
}

/// Let another thread run.
pub fn yield_now() {
    unsafe {
        SwitchToThread();
    }
}

/// How many processors the program may run on.
pub fn cpu_count(): usize {
    // ALL_PROCESSOR_GROUPS
    let n = unsafe { GetActiveProcessorCount(65535) };
    return if n == 0 { 1 } else { n as usize };
}

/// Wait while the `u32` at `addr` is `expected`, for at most `timeout_ns`
/// (`u64::MAX`: no limit). False if the time ran out; true otherwise,
/// which may also be a spurious wakeup.
pub fn futex_wait(addr: *u32, expected: u32, timeout_ns: u64): bool {
    let mut ms: u32 = 4294967295;
    if timeout_ns != 18446744073709551615 {
        let mut m = timeout_ns / 1000000;
        if timeout_ns % 1000000 != 0 {
            m += 1;
        }
        // INFINITE is 0xFFFFFFFF: stay just below it.
        ms = if m > 4294967294 { 4294967294 } else { m as u32 };
    }
    let cmp = expected;
    let ok = unsafe { WaitOnAddress(addr as *u8, (intrinsics::addr_of(&cmp) as usize) as *u8, 4, ms) };
    // ERROR_TIMEOUT
    return ok != 0 || last_error() != 1460;
}

/// Wake one thread (or every thread) waiting at `addr`.
pub fn futex_wake(addr: *u32, all: bool) {
    unsafe {
        if all {
            WakeByAddressAll(addr as *u8);
        } else {
            WakeByAddressSingle(addr as *u8);
        }
    }
}
