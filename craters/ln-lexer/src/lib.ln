// Lexer for the Lunar programming language, written in Lunar: a port of
// the Rust `ln-lexer` crate (crates/ln-lexer), with the same tokens, error
// ranges and conflict markers, checked against it by
// crates/ln-driver/tests/selfhost.rs.
//
// Tokens carry no payload; consumers slice the source text with the
// token's byte range. `>` is never fused with a following `>`/`=` here (so
// generic argument lists like `A::<B::<C>>` lex cleanly); the parser
// re-joins adjacent `>` tokens into `>>`, `>=` and `>>=` where an operator
// is expected.

/// Classification of a numeric literal.
pub enum NumKind {
    Int,
    Float,
}

pub enum Token {
    // ----- delimiters -----
    LParen,
    RParen,
    LBracket,
    RBracket,
    LBrace,
    RBrace,

    // ----- punctuation -----
    LAngle,
    RAngle,
    Le,
    Shl,
    ShlEq,
    PathSep,
    Colon,
    Semi,
    Comma,
    Dot,
    DotDot,
    DotDotEq,
    DotDotDot,
    EqEq,
    BangEq,
    Eq,
    FatArrow,
    Arrow,
    Bang,
    AmpAmp,
    Amp,
    AmpEq,
    PipePipe,
    Pipe,
    PipeEq,
    Caret,
    CaretEq,
    Plus,
    PlusEq,
    Minus,
    MinusEq,
    Star,
    StarEq,
    Slash,
    SlashEq,
    Percent,
    PercentEq,
    Tilde,
    Question,
    Hash,
    At,
    /// `$`: a macro metavariable (`$x:expr`) or repetition (`$(...)*`).
    Dollar,
    Placeholder,

    // ----- keywords -----
    As,
    Break,
    Const,
    Continue,
    Crater,
    Else,
    Enum,
    Extern,
    False,
    Fn,
    For,
    If,
    Impl,
    In,
    Let,
    Loop,
    Macro,
    Match,
    Mod,
    Mut,
    Pub,
    Return,
    SelfValue,
    SelfType,
    Static,
    Struct,
    Super,
    Trait,
    True,
    Type,
    Unsafe,
    Use,
    While,

    // ----- literals & identifiers -----
    Ident,
    Number(NumKind),
    Str,
    Char,
    /// `b'a'`: a `u8`.
    Byte,
    /// `/// text`: documentation for the item that follows. Exactly three
    /// slashes; `////` is an ordinary comment. The parser attaches it to the
    /// next item as `#[doc = "text"]`.
    DocComment,
    /// Never produced: block comments are skipped (or reported as errors
    /// when unterminated). Kept so the set of tokens matches `ln-lexer`.
    BlockComment,
}

/// A byte range in the source: `start..end`.
pub struct Range {
    pub start: usize,
    pub end: usize,
}

/// A lexed token and its byte range in the source.
pub struct Spanned {
    pub token: Token,
    pub range: Range,
}

/// A character sequence the lexer could not understand.
pub struct LexError {
    pub range: Range,
    pub kind: LexErrorKind,
}

pub enum LexErrorKind {
    /// Characters that start no token (or a malformed literal).
    Invalid,
    /// A `/*` comment without its closing `*/`; the range runs to the end.
    UnterminatedComment,
}

/// Lex a whole source file.
pub fn lex(src: str): ([Spanned; -..+], [LexError; -..+]) {
    let b = src.as_bytes();
    let mut toks: [Spanned; -..+] = [];
    let mut errs: [LexError; -..+] = [];
    let mut i: usize = 0;
    while i < b.len() {
        let c = b[i];
        // Whitespace: `[ \t\r\n\f]+`.
        if c == b' ' || c == b'\t' || c == b'\r' || c == b'\n' || c == b'\x0c' {
            i += 1;
            continue;
        }
        // Line comments; `///` (exactly three slashes) is documentation.
        if c == b'/' && at(b, i + 1) == b'/' {
            let start = i;
            while i < b.len() && b[i] != b'\n' {
                i += 1;
            }
            if at(b, start + 2) == b'/' && at(b, start + 3) != b'/' {
                toks.push(Spanned { token: Token::DocComment, range: Range { start, end: i } });
            }
            continue;
        }
        // Nested `/* ... */` comments. An unterminated comment is an error
        // covering the rest of the input.
        if c == b'/' && at(b, i + 1) == b'*' {
            match block_comment_end(b, i + 2) {
                Some(end) => {
                    i = end;
                }
                None => {
                    errs.push(LexError { range: Range { start: i, end: b.len() }, kind: LexErrorKind::UnterminatedComment });
                    i = b.len();
                }
            }
            continue;
        }
        let (token, end) = token_at(src, i);
        match token {
            Some(t) => toks.push(Spanned { token: t, range: Range { start: i, end } }),
            None => invalid(&mut errs, i, end),
        }
        i = end;
    }
    return (toks, errs);
}

/// Record invalid text. Runs of adjacent bad characters merge into one error.
fn invalid(errs: &mut [LexError; -..+], start: usize, end: usize) {
    let n = errs.len();
    if n > 0 && errs[n - 1].range.end == start {
        match errs[n - 1].kind {
            LexErrorKind::Invalid => {
                errs[n - 1].range.end = end;
                return;
            }
            LexErrorKind::UnterminatedComment => {}
        }
    }
    errs.push(LexError { range: Range { start, end }, kind: LexErrorKind::Invalid });
}

/// The end of a nested `/* ... */` comment whose body starts at `from`.
fn block_comment_end(b: [u8; &], from: usize): Option::<usize> {
    let mut depth: usize = 1;
    let mut i = from;
    while i < b.len() {
        if b[i] == b'/' && at(b, i + 1) == b'*' {
            depth += 1;
            i += 2;
        } else if b[i] == b'*' && at(b, i + 1) == b'/' {
            depth -= 1;
            i += 2;
            if depth == 0 {
                return Some(i);
            }
        } else {
            i += 1;
        }
    }
    return None;
}

/// The token starting at `i` and where it ends. Invalid text has no token
/// and ends where lexing gave up, which is the range `ln-lexer` reports.
fn token_at(src: str, i: usize): (Option::<Token>, usize) {
    let b = src.as_bytes();
    let c = b[i];
    if is_ident_start(c) {
        // `b'x'` is a byte literal; a malformed one is the identifier `b`
        // followed by whatever comes next.
        if c == b'b' && at(b, i + 1) == b'\'' {
            match quoted_char_end(b, i + 1) {
                Ok(end) => {
                    return (Some(Token::Byte), end);
                }
                Err(_) => {}
            }
        }
        let mut j = i + 1;
        while j < b.len() && is_ident_continue(b[j]) {
            j += 1;
        }
        return (Some(word(src[i..j])), j);
    }
    if is_digit(c) {
        let (kind, end) = lex_number(b, i);
        return (Some(Token::Number(kind)), end);
    }
    if c == b'"' {
        return match string_end(b, i) {
            Ok(end) => (Some(Token::Str), end),
            Err(end) => (None, end),
        };
    }
    if c == b'\'' {
        return match quoted_char_end(b, i) {
            Ok(end) => (Some(Token::Char), end),
            Err(end) => (None, end),
        };
    }
    return punct(b, i);
}

/// Punctuation at `i`, the longest that matches (`<<=` before `<<` before `<`).
fn punct(b: [u8; &], i: usize): (Option::<Token>, usize) {
    let c = b[i];
    let next = at(b, i + 1);
    let one = i + 1;
    let two = i + 2;
    return match c {
        b'(' => tok(Token::LParen, one),
        b')' => tok(Token::RParen, one),
        b'[' => tok(Token::LBracket, one),
        b']' => tok(Token::RBracket, one),
        b'{' => tok(Token::LBrace, one),
        b'}' => tok(Token::RBrace, one),
        b'<' => {
            if next == b'=' {
                tok(Token::Le, two)
            } else if next == b'<' {
                if at(b, i + 2) == b'=' { tok(Token::ShlEq, i + 3) } else { tok(Token::Shl, two) }
            } else {
                tok(Token::LAngle, one)
            }
        }
        b'>' => tok(Token::RAngle, one),
        b':' => if next == b':' { tok(Token::PathSep, two) } else { tok(Token::Colon, one) },
        b';' => tok(Token::Semi, one),
        b',' => tok(Token::Comma, one),
        b'.' => {
            if next != b'.' {
                tok(Token::Dot, one)
            } else if at(b, i + 2) == b'=' {
                tok(Token::DotDotEq, i + 3)
            } else if at(b, i + 2) == b'.' {
                tok(Token::DotDotDot, i + 3)
            } else {
                tok(Token::DotDot, two)
            }
        }
        b'=' => {
            if next == b'=' {
                tok(Token::EqEq, two)
            } else if next == b'>' {
                tok(Token::FatArrow, two)
            } else {
                tok(Token::Eq, one)
            }
        }
        b'!' => or_eq(next, i, Token::Bang, Token::BangEq),
        b'-' => if next == b'>' { tok(Token::Arrow, two) } else { or_eq(next, i, Token::Minus, Token::MinusEq) },
        b'&' => if next == b'&' { tok(Token::AmpAmp, two) } else { or_eq(next, i, Token::Amp, Token::AmpEq) },
        b'|' => if next == b'|' { tok(Token::PipePipe, two) } else { or_eq(next, i, Token::Pipe, Token::PipeEq) },
        b'^' => or_eq(next, i, Token::Caret, Token::CaretEq),
        b'+' => or_eq(next, i, Token::Plus, Token::PlusEq),
        b'*' => or_eq(next, i, Token::Star, Token::StarEq),
        b'/' => or_eq(next, i, Token::Slash, Token::SlashEq),
        b'%' => or_eq(next, i, Token::Percent, Token::PercentEq),
        b'~' => tok(Token::Tilde, one),
        b'?' => tok(Token::Question, one),
        b'#' => tok(Token::Hash, one),
        b'@' => tok(Token::At, one),
        b'$' => tok(Token::Dollar, one),
        _ => (None, i + char_len(c)),
    };
}

fn tok(t: Token, end: usize): (Option::<Token>, usize) {
    return (Some(t), end);
}

/// `x` at `i`, or `x=` if `next` is `=`.
fn or_eq(next: u8, i: usize, plain: Token, eq: Token): (Option::<Token>, usize) {
    if next == b'=' {
        return (Some(eq), i + 2);
    }
    return (Some(plain), i + 1);
}

/// A keyword, `_`, or an identifier.
fn word(s: str): Token {
    return match s {
        "_" => Token::Placeholder,
        "as" => Token::As,
        "break" => Token::Break,
        "const" => Token::Const,
        "continue" => Token::Continue,
        "crater" => Token::Crater,
        "else" => Token::Else,
        "enum" => Token::Enum,
        "extern" => Token::Extern,
        "false" => Token::False,
        "fn" => Token::Fn,
        "for" => Token::For,
        "if" => Token::If,
        "impl" => Token::Impl,
        "in" => Token::In,
        "let" => Token::Let,
        "loop" => Token::Loop,
        "macro" => Token::Macro,
        "match" => Token::Match,
        "mod" => Token::Mod,
        "mut" => Token::Mut,
        "pub" => Token::Pub,
        "return" => Token::Return,
        "self" => Token::SelfValue,
        "Self" => Token::SelfType,
        "static" => Token::Static,
        "struct" => Token::Struct,
        "super" => Token::Super,
        "trait" => Token::Trait,
        "true" => Token::True,
        "type" => Token::Type,
        "unsafe" => Token::Unsafe,
        "use" => Token::Use,
        "while" => Token::While,
        _ => Token::Ident,
    };
}

/// Consume a number starting at `i`: its kind and end. Handles `0x`/`0o`/
/// `0b` prefixes, fractions (but not `1..2` or `1.method()`), exponents and
/// type suffixes such as `10u8` / `1.5f32`.
fn lex_number(b: [u8; &], i: usize): (NumKind, usize) {
    let first = b[i];
    let n = b.len();
    let mut j = i + 1;
    let mut kind = NumKind::Int;
    let radix = at(b, i + 1);
    if first == b'0' && i + 2 < n && (radix == b'x' || radix == b'o' || radix == b'b') && is_hex(b[i + 2]) {
        j = i + 2;
        while j < n && (is_hex(b[j]) || b[j] == b'_') {
            j += 1;
        }
    } else {
        while j < n && is_digit_or_sep(b[j]) {
            j += 1;
        }
        // Fraction: `1.` / `1.5` but not `1..2` or `1.foo`.
        if j < n && b[j] == b'.' {
            let next = at(b, j + 1);
            if next != b'.' && !is_ident_start(next) {
                kind = NumKind::Float;
                j += 1;
                while j < n && is_digit_or_sep(b[j]) {
                    j += 1;
                }
            }
        }
        // Exponent.
        if j < n && (b[j] == b'e' || b[j] == b'E') {
            let mut k = j + 1;
            if k < n && (b[k] == b'+' || b[k] == b'-') {
                k += 1;
            }
            if k < n && is_digit(b[k]) {
                kind = NumKind::Float;
                j = k;
                while j < n && is_digit_or_sep(b[j]) {
                    j += 1;
                }
            }
        }
    }
    // Suffix.
    if j < n && is_ident_start(b[j]) {
        let s = j;
        while j < n && is_ident_continue(b[j]) {
            j += 1;
        }
        if b[s] == b'f' && !(first == b'0' && radix == b'x') {
            kind = NumKind::Float;
        }
    }
    return (kind, j);
}

/// The end of the string literal starting at `i`, or where it gave up.
fn string_end(b: [u8; &], i: usize): Result::<usize, usize> {
    let mut j = i + 1;
    while j < b.len() {
        let c = b[j];
        if c == b'"' {
            return Ok(j + 1);
        }
        if c == b'\\' {
            j += 1;
            if j >= b.len() {
                return Err(j);
            }
            j += char_len(b[j]);
        } else {
            j += char_len(c);
        }
    }
    return Err(b.len());
}

/// The end of the quoted character at `q` (`'a'`, `'\n'`, `'\u{41}'`), or
/// where it gave up: one character, or a backslash and anything up to the
/// closing quote on the same line.
fn quoted_char_end(b: [u8; &], q: usize): Result::<usize, usize> {
    let n = b.len();
    let mut j = q + 1;
    if j >= n {
        return Err(j);
    }
    let c = b[j];
    if c == b'\\' {
        j += 1;
        if j >= n || b[j] == b'\n' {
            return Err(j);
        }
        j += char_len(b[j]);
        while j < n && b[j] != b'\'' && b[j] != b'\n' {
            j += char_len(b[j]);
        }
    } else {
        if c == b'\'' || c == b'\n' {
            return Err(j);
        }
        j += char_len(c);
    }
    if j < n && b[j] == b'\'' {
        return Ok(j + 1);
    }
    return Err(j);
}

/// The byte at `i`, or 0 past the end.
fn at(b: [u8; &], i: usize): u8 {
    if i < b.len() { b[i] } else { 0 }
}

/// The length of the UTF-8 character starting with byte `c`.
fn char_len(c: u8): usize {
    if c < 0x80 {
        1
    } else if c < 0xE0 {
        2
    } else if c < 0xF0 {
        3
    } else {
        4
    }
}

fn is_ident_start(c: u8): bool {
    return (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || c == b'_';
}

fn is_ident_continue(c: u8): bool {
    return is_ident_start(c) || is_digit(c);
}

fn is_digit(c: u8): bool {
    return c >= b'0' && c <= b'9';
}

fn is_digit_or_sep(c: u8): bool {
    return is_digit(c) || c == b'_';
}

fn is_hex(c: u8): bool {
    return is_digit(c) || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F');
}

// ===================================================================== conflict markers

/// A version control conflict region left in a file by an unfinished merge
/// or rebase. Each field is the byte range of a marker line (without its
/// newline).
pub struct Conflict {
    /// `<<<<<<< ours`
    pub start: Range,
    /// `||||||| base` (diff3 style), if present.
    pub base: Option::<Range>,
    /// `=======`
    pub mid: Option::<Range>,
    /// `>>>>>>> theirs`
    pub end: Option::<Range>,
}

/// Which conflict marker, if any, the line `b` is.
fn marker_at(b: [u8; &]): Option::<u8> {
    if b.len() < 7 {
        return None;
    }
    let c = b[0];
    if c != b'<' && c != b'|' && c != b'=' && c != b'>' {
        return None;
    }
    let mut k: usize = 1;
    while k < 7 {
        if b[k] != c {
            return None;
        }
        k += 1;
    }
    // Exactly seven marker characters, then the end of the line or a space
    // (`<<<<<<< HEAD`). `=======` stands alone.
    if b.len() == 7 || b[7] == b'\r' {
        return Some(c);
    }
    if (b[7] == b' ' || b[7] == b'\t') && c != b'=' {
        return Some(c);
    }
    return None;
}

/// Find conflict markers (`<<<<<<<`, `|||||||`, `=======`, `>>>>>>>` at
/// the start of a line). Checked before lexing so that a half-merged file
/// gets one clear error instead of a cascade of syntax errors.
pub fn conflict_markers(src: str): [Conflict; -..+] {
    let b = src.as_bytes();
    let mut out: [Conflict; -..+] = [];
    let mut open = false;
    let mut cur = Conflict { start: Range { start: 0, end: 0 }, base: None, mid: None, end: None };
    let mut pos: usize = 0;
    while pos < b.len() {
        // The line, through its `\n` if it has one.
        let mut line_end = pos;
        while line_end < b.len() && b[line_end] != b'\n' {
            line_end += 1;
        }
        if line_end < b.len() {
            line_end += 1;
        }
        // Its text, without trailing `\n`s and `\r`s.
        let mut text_end = line_end;
        while text_end > pos && (b[text_end - 1] == b'\n' || b[text_end - 1] == b'\r') {
            text_end -= 1;
        }
        let range = Range { start: pos, end: text_end };
        pos = line_end;
        let m = match marker_at(b[range.start..range.end]) {
            Some(m) => m,
            None => 0,
        };
        if m == 0 {
            continue;
        }
        if m == b'<' {
            if open {
                out.push(cur);
            }
            cur = Conflict { start: range, base: None, mid: None, end: None };
            open = true;
        } else if !open {
            // A stray marker outside a `<<<<<<<` region: report it alone.
            out.push(Conflict { start: range, base: None, mid: None, end: None });
        } else if m == b'>' {
            cur.end = Some(range);
            out.push(cur);
            open = false;
        } else if cur.mid.is_none() {
            if m == b'|' {
                cur.base = Some(range);
            } else {
                cur.mid = Some(range);
            }
        }
    }
    if open {
        out.push(cur);
    }
    return out;
}

// ===================================================================== token names

impl Token {
    /// Human-readable description used in "expected X" diagnostics.
    pub fn describe(self): str {
        return match self {
            Token::LParen => "`(`",
            Token::RParen => "`)`",
            Token::LBracket => "`[`",
            Token::RBracket => "`]`",
            Token::LBrace => "`{`",
            Token::RBrace => "`}`",
            Token::LAngle => "`<`",
            Token::RAngle => "`>`",
            Token::Le => "`<=`",
            Token::Shl => "`<<`",
            Token::ShlEq => "`<<=`",
            Token::PathSep => "`::`",
            Token::Colon => "`:`",
            Token::Semi => "`;`",
            Token::Comma => "`,`",
            Token::Dot => "`.`",
            Token::DotDot => "`..`",
            Token::DotDotEq => "`..=`",
            Token::DotDotDot => "`...`",
            Token::EqEq => "`==`",
            Token::BangEq => "`!=`",
            Token::Eq => "`=`",
            Token::FatArrow => "`=>`",
            Token::Arrow => "`->`",
            Token::Bang => "`!`",
            Token::AmpAmp => "`&&`",
            Token::Amp => "`&`",
            Token::AmpEq => "`&=`",
            Token::PipePipe => "`||`",
            Token::Pipe => "`|`",
            Token::PipeEq => "`|=`",
            Token::Caret => "`^`",
            Token::CaretEq => "`^=`",
            Token::Plus => "`+`",
            Token::PlusEq => "`+=`",
            Token::Minus => "`-`",
            Token::MinusEq => "`-=`",
            Token::Star => "`*`",
            Token::StarEq => "`*=`",
            Token::Slash => "`/`",
            Token::SlashEq => "`/=`",
            Token::Percent => "`%`",
            Token::PercentEq => "`%=`",
            Token::Tilde => "`~`",
            Token::Question => "`?`",
            Token::Hash => "`#`",
            Token::At => "`@`",
            Token::Dollar => "`$`",
            Token::Placeholder => "`_`",
            Token::As => "`as`",
            Token::Break => "`break`",
            Token::Const => "`const`",
            Token::Continue => "`continue`",
            Token::Crater => "`crater`",
            Token::Else => "`else`",
            Token::Enum => "`enum`",
            Token::Extern => "`extern`",
            Token::False => "`false`",
            Token::Fn => "`fn`",
            Token::For => "`for`",
            Token::If => "`if`",
            Token::Impl => "`impl`",
            Token::In => "`in`",
            Token::Let => "`let`",
            Token::Loop => "`loop`",
            Token::Macro => "`macro`",
            Token::Match => "`match`",
            Token::Mod => "`mod`",
            Token::Mut => "`mut`",
            Token::Pub => "`pub`",
            Token::Return => "`return`",
            Token::SelfValue => "`self`",
            Token::SelfType => "`Self`",
            Token::Static => "`static`",
            Token::Struct => "`struct`",
            Token::Super => "`super`",
            Token::Trait => "`trait`",
            Token::True => "`true`",
            Token::Type => "`type`",
            Token::Unsafe => "`unsafe`",
            Token::Use => "`use`",
            Token::While => "`while`",
            Token::Ident => "identifier",
            Token::Number(NumKind::Int) => "integer literal",
            Token::Number(NumKind::Float) => "float literal",
            Token::Str => "string literal",
            Token::Char => "character literal",
            Token::Byte => "byte literal",
            Token::DocComment => "doc comment",
            Token::BlockComment => "comment",
        };
    }

    /// Whether this token is a keyword that may also appear as a path segment.
    pub fn is_path_keyword(self): bool {
        return match self {
            Token::Crater | Token::SelfValue | Token::SelfType | Token::Super => true,
            _ => false,
        };
    }

    /// The token's name as `ln-lexer` prints it (Rust's `Debug` form).
    pub fn name(self): str {
        return match self {
            Token::LParen => "LParen",
            Token::RParen => "RParen",
            Token::LBracket => "LBracket",
