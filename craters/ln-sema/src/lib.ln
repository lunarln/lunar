// Semantic analysis for Lunar, written in Lunar: a port of the Rust
// `ln-sema` crate (crates/ln-sema). Name resolution, type checking, traits,
// the `Dull` and `Light` auto traits, unsafe checking, and move/borrow
// checking, producing a typed IR (`thir`) for code generation.
//
// The data model (`ty`, `defs`, `thir`, `program`, `diag`) is shared by the
// passes; see craters/README.md for the state of the port.

pub mod ty;
pub mod defs;
pub mod thir;
pub mod diag;
pub mod codes;
pub mod program;
pub mod render;
// The passes. `sema`, `lower`, `resolve`, `expand`, `traits` and
// `borrowck` are stubs here (replaced by their ports at merge).
pub mod sema;
mod lower;
mod resolve;
mod expand;
pub mod traits;
pub mod borrowck;
pub mod typeck;
