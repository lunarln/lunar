// Semantic analysis for Lunar, written in Lunar: a port of the Rust
// `ln-sema` crate (crates/ln-sema). Name resolution, type checking, traits,
// the `Dull` and `Light` auto traits, unsafe checking, and move/borrow
// checking, producing a typed IR (`thir`) for code generation.
//
// The data model (`ty`, `defs`, `thir`, `program`, `diag`) is shared by the
// passes; see craters/README.md for the state of the port. The front end
// (`sema`, `loader`, `collect`, `resolve`, `expand`, `lower`) loads the
// craters, names every item, expands macros and lowers signatures.

pub mod ty;
pub mod defs;
pub mod thir;
pub mod diag;
pub mod codes;
pub mod program;
pub mod highlight;
pub mod render;
pub mod sema;
pub mod loader;
pub mod collect;
pub mod resolve;
pub mod expand;
pub mod lower;
pub mod traits;
pub mod assoc;
pub mod objects;
pub mod layout;
pub mod borrowck;
pub mod typeck;
pub mod query;
#[cfg(test)]
mod tests;
