// Move and borrow checking on THIR: a port of crates/ln-sema/src/borrowck.rs.
//
// * **Moves**: a forward dataflow over "maybe moved" paths reports uses of
//   moved values and moves out of borrowed parameters.
// * **Views**: slices, `str` and other pointy non-owning values have *roots*:
//   the locals whose storage they point into. Roots are computed
//   flow-insensitively, then checked when a view is stored into a longer
//   lived local, returned, or written through a parameter.
// * **Invalidation**: lending an owner in-out (to a `&mut` parameter, or
//   to a closure that changes what it captured), replacing it, or moving it
//   *invalidates* its root: the callee may shrink, clear or replace it. A
//   backward liveness analysis reports any view of that root that is still
//   used afterwards. A `&mut +T` parameter promises to only grow its
//   argument, so lending to one invalidates nothing; inside the function,
//   such a parameter may itself only be grown.
// * **Results**: which arguments a call's result may point into comes from
//   the called function's signature (its `from` clause, or what leaving it
//   out means), and each function's returns are checked against its own.
//   A closure's comes from its body (`infer_closure_ret_points`, before
//   any body is checked): the roots of the values it returns, mapped back
//   to its parameters. Through a function pointer, the result may point
//   into every argument.
//
// The checks are the Rust ones; only the representation differs, because
// array items and map values must be Light:
//
// * A set of roots (`BTreeSet<Root>`) is a `Roots`: an array kept sorted in
//   the same order (`root_key`).
// * The roots of every local (`HashMap<LocalId, Roots>`) are one sorted
//   array of (local, root) pairs, each packed into a `u64`.
// * A set of live locals (`BTreeSet<LocalId>`) is a bit set (`LiveSet`);
//   the sets kept per loop live end to end in one array.
// * A moved path (`(LocalId, Vec<usize>)`) is interned (`MovePath`); the
//   move states kept per loop live end to end in one array.
// * The checker's state is owned (`Cx`, `Moves`); the program is passed to
//   every method (`p: &mut +Program`: interning types and texts only grows
//   it), and diagnostics go to `p.diags`.
// * `visit_children(thir, e, out)` pushes the children of `e` onto `out`
//   (Rust calls a closure on each).

use core::arena::{Id, List};
use core::collections::HashMap;
use core::intern::Symbol;
use crater::codes;
use crater::defs::{DefId, Param, Pred, RetFrom};
use crater::diag::{Diags, is_dummy};
use crater::program::Program;
use crater::thir::*;
use crater::traits::MethodImpl;
use crater::ty::{ArrKind, DYN_MUT, Ty, TyKind, TyList};
use ln_ast::{ParamMode, Span};

#[derive(Eq, Debug)]
enum Root {
    /// The storage a local owns (an owner's elements, a fixed array).
    Local(LocalId),
    /// The local variable itself: a closure that borrows a capture points
    /// at it.
    Slot(LocalId),
    /// Whatever the argument of parameter `.0` points into: the caller's
    /// data, which outlives the call. Tracked so that storing it into an
    /// in-out argument can be checked against `kept`.
    Arg(LocalId),
    /// A statement-scoped temporary.
    Temp,
}

/// The order of roots (by variant, then local), as a number below 2^34.
fn root_key(r: Root): u64 {
    return match r {
        Root::Local(l) => l.index as u64,
        Root::Slot(l) => (1u64 << 32) | l.index as u64,
        Root::Arg(l) => (2u64 << 32) | l.index as u64,
        Root::Temp => 3u64 << 32,
    };
}

fn root_from_key(k: u64): Root {
    let l = LocalId { index: (k & 4294967295) as u32 };
    return match k >> 32 {
        0 => Root::Local(l),
        1 => Root::Slot(l),
        2 => Root::Arg(l),
        _ => Root::Temp,
    };
}

/// The local a root is about, for `Local`, `Slot` and `Arg`.
fn root_local(r: Root): Option::<LocalId> {
    return match r {
        Root::Local(l) => Some(l),
        Root::Slot(l) => Some(l),
        Root::Arg(l) => Some(l),
        Root::Temp => None,
    };
}

/// The local of a `Local` or `Arg` root.
fn local_or_arg(r: Root): Option::<LocalId> {
    return match r {
        Root::Local(l) => Some(l),
        Root::Arg(l) => Some(l),
        _ => None,
    };
}

/// A set of roots, sorted by `root_key`.
type Roots = [Root; -..+];

/// Add `r` to `rs`; whether it was not there yet.
fn roots_insert(rs: &mut Roots, r: Root): bool {
    let k = root_key(r);
    let mut lo: usize = 0;
    let mut hi = rs.len();
    while lo < hi {
        let mid = (lo + hi) / 2;
        let mk = root_key(rs[mid]);
        if mk == k {
            return false;
        }
        if mk < k {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    rs.insert(lo, r);
    return true;
}

fn roots_extend(rs: &mut Roots, src: [Root; &]) {
    for r in src {
        roots_insert(rs, r);
    }
}

fn roots_contains(rs: [Root; &], r: Root): bool {
    for x in rs {
        if x == r {
            return true;
        }
    }
    return false;
}

/// A set of locals, one bit each.
type LiveSet = [u64; -..+];

fn ls_insert(s: &mut LiveSet, l: LocalId) {
    let w = l.index() / 64;
    s[w] = s[w] | (1u64 << (l.index % 64) as u64);
}

fn ls_remove(s: &mut LiveSet, l: LocalId) {
    let w = l.index() / 64;
    s[w] = s[w] & !(1u64 << (l.index % 64) as u64);
}

fn ls_contains(s: [u64; &], l: LocalId): bool {
    return (s[l.index() / 64] >> (l.index % 64) as u64) & 1 == 1;
}

/// `a` becomes the union of `a` and `b`.
fn ls_union(a: &mut LiveSet, b: [u64; &]) {
    for i in 0..b.len() {
        a[i] = a[i] | b[i];
    }
}

fn ls_subset(a: [u64; &], b: [u64; &]): bool {
    for i in 0..a.len() {
        if a[i] & !b[i] != 0 {
            return false;
        }
    }
    return true;
}

/// The packed (local, root) pair of `Cx::roots`.
fn pair_key(l: LocalId, r: Root): u64 {
    return ((l.index as u64) << 34) | root_key(r);
}

/// Sort `a` and drop repeated values.
fn sort_dedup(a: &mut [u64; -..+]) {
    a.sort();
    let mut w: usize = 0;
    for i in 0..a.len() {
        if w == 0 || a[i] != a[w - 1] {
            a[w] = a[i];
            w += 1;
        }
    }
    a.truncate(w);
}

/// The base of a field or index place.
fn proj_base(k: ExprKind): Option::<Id::<Expr>> {
    return match k {
        ExprKind::Field { base, .. } => Some(base),
        ExprKind::Index { base, .. } => Some(base),
        _ => None,
    };
}

/// An interned diagnostic text.
fn say(p: &mut +Program, args: FmtArgs): Symbol {
    let mut s = String::new();
    s.write(args);
    return p.sym(s.as_str());
}

// ========================================================================= lints

/// The local a place is rooted at (through fields and indexes).
fn lint_root(p: &Program, e: Id::<Expr>): Option::<LocalId> {
    return match p.thir.expr(e).kind {
        ExprKind::Local(l) => Some(l),
        ExprKind::Field { base, .. } => lint_root(p, base),
        ExprKind::Index { base, .. } => lint_root(p, base),
        _ => None,
    };
}

fn note_mutated(p: &Program, e: Id::<Expr>, mutated: &mut [bool; ..+]) {
    if let Some(l) = lint_root(p, e) {
        mutated[l.index()] = true;
    }
}

fn lint_walk(p: &Program, e: Id::<Expr>, used: &mut [bool; ..+], mutated: &mut [bool; ..+]) {
    match p.thir.expr(e).kind {
        ExprKind::Local(l) => {
            used[l.index()] = true;
        }
        // Assigning to a variable is not a use of it (`x = 2;`,
        // `x += 1;`), as in Rust: only reads count. Writing into a part
        // of it (`a[i] = v`, `s.f = v`) does count, as in Rust.
        ExprKind::Assign { place, value } => {
            lint_assign(p, place, value, used, mutated);
            return;
        }
        ExprKind::AssignOp { place, value, .. } => {
            lint_assign(p, place, value, used, mutated);
            return;
        }
        ExprKind::Call { args, callee } => {
            for a in p.thir.args.list(args) {
                if let Arg::InOut(x) = a {
                    note_mutated(p, x, mutated);
                }
            }
            if let Callee::Value { callee: f, kind: ClosureKind::FnMut } = callee {
                note_mutated(p, f, mutated);
            }
        }
        // A closure that changes a capture changes the variable (if it
        // borrowed it) or needs it `mut` to change its own copy.
        ExprKind::Closure { def, captures } => {
            if let Some(c) = p.closures.get(def) {
                let caps = p.captures.list(c.captures);
                let n = if captures.len() < caps.len() { captures.len() } else { caps.len() };
                for i in 0..n {
                    let a = p.thir.args.list(captures)[i];
                    let x = a.expr();
                    let place = match p.thir.expr(x).kind {
                        ExprKind::Read { place, .. } => place,
                        _ => x,
                    };
                    if caps[i].mode == ParamMode::InOut {
                        note_mutated(p, place, mutated);
                    }
                }
            }
        }
        ExprKind::Slice { base, mutable: true, .. } => note_mutated(p, base, mutated),
        ExprKind::Coerce { kind: Coercion::ToSlice { mutable: true }, expr: base } => note_mutated(p, base, mutated),
        ExprKind::Coerce { kind: Coercion::ToDyn { mutable: true }, expr: base } => note_mutated(p, base, mutated),
        _ => {}
    }
    let mut kids: [Id::<Expr>; ..+] = [];
    visit_children(&p.thir, e, &mut kids);
    for c in kids {
        lint_walk(p, c, used, mutated);
    }
}

fn lint_assign(p: &Program, place: Id::<Expr>, value: Id::<Expr>, used: &mut [bool; ..+], mutated: &mut [bool; ..+]) {
    note_mutated(p, place, mutated);
    let is_local = match p.thir.expr(place).kind {
        ExprKind::Local(_) => true,
        _ => false,
    };
    if !is_local {
        lint_walk(p, place, used, mutated);
    }
    lint_walk(p, value, used, mutated);
}

/// Warn about unused variables and needless `mut` (into `out`, whose
/// texts are interned in `p`; move them over with `Diags::push_from`).
pub fn lint(p: &mut +Program, body: Body, out: &mut +Diags) {
    let n = body.locals.len();
    let mut used: [bool; ..+] = [false; n];
    let mut mutated: [bool; ..+] = [false; n];
    let mut top: [Id::<Expr>; ..+] = [];
    visit_block(&p.thir, body.block, &mut top);
    for e in top {
        lint_walk(p, e, &mut used, &mut mutated);
    }
    // `mut x: T` is the function's own copy. Changing it without ever reading
    // it back almost always means the caller's variable was meant to change
    // (`x: &mut T`, which was spelled `mut x: T` before parameters took
    // ownership by default).
    for i in 0..n {
        let l = p.thir.locals.list(body.locals)[i];
        let owned = match l.kind {
            LocalKind::Param { owned, .. } => owned,
            _ => false,
        };
        let name = p.text(l.name);
        if !owned || !l.mutable || name.starts_with("_") || is_dummy(l.span) {
            continue;
        }
        if mutated[i] && !used[i] {
            let m = say(p, "parameter `{name}` is changed, but the new value is never used");
            out.warning(codes::lint::MUT_PARAM_NOT_READ(), l.span, m);
            out.label(say(p, "this is the function's own copy"));
            out.note(say(p, "changes to a `mut` parameter do not reach the caller"));
            out.help(say(p, "to change the caller's variable, take it in-out: `{name}: &mut ...`"));
            out.finish();
        } else if !mutated[i] {
            let m = say(p, "parameter `{name}` does not need to be mutable");
            out.warning(codes::lint::UNUSED_MUT(), l.span, m);
            out.label(say(p, "never mutated"));
            out.help(say(p, "remove the `mut`"));
            if let Some(ms) = p.mut_before(l.span, name) {
                out.suggest(ms, say(p, ""), say(p, "Remove the `mut`"));
            }
            out.finish();
        }
    }
    for i in 0..n {
        let l = p.thir.locals.list(body.locals)[i];
        let name = p.text(l.name);
        if l.kind != LocalKind::Let || name.starts_with("_") || name.starts_with("<") || is_dummy(l.span) {
            continue;
        }
        if !used[i] {
            if mutated[i] {
                let m = say(p, "variable `{name}` is assigned to, but never read");
                out.warning(codes::lint::UNUSED_VARIABLE(), l.span, m);
                out.label(say(p, "assigned to but never read"));
            } else {
                let m = say(p, "unused variable `{name}`");
                out.warning(codes::lint::UNUSED_VARIABLE(), l.span, m);
                out.label(say(p, "never used"));
            }
            out.help(say(p, "if this is intentional, prefix it with an underscore: `_{name}`"));
            let ns = p.name_span(l.span, name);
            out.suggest(Span::new(ns.lo, ns.lo), say(p, "_"), say(p, "Prefix `{name}` with an underscore"));
            out.finish();
        } else if l.mutable && !mutated[i] {
            let m = say(p, "variable `{name}` does not need to be mutable");
            out.warning(codes::lint::UNUSED_MUT(), l.span, m);
            out.label(say(p, "never mutated"));
            out.help(say(p, "remove the `mut`"));
            if let Some(ms) = p.mut_before(l.span, name) {
                out.suggest(ms, say(p, ""), say(p, "Remove the `mut`"));
            }
            out.finish();
        }
    }
    unreachable_block(p, body.block, out);
}

/// Whether evaluating `e` never finishes normally (`return`, `break`,
/// `continue`, a call returning `!`, a `loop` without `break`, or a block,
/// `if` or `match` all of whose paths do one of those).
fn diverges(p: &Program, e: Id::<Expr>): bool {
    let x = p.thir.expr(e);
    return match x.kind {
        ExprKind::Coerce { kind: Coercion::NeverToAny, expr } => diverges(p, expr),
        _ => p.types.is_never(x.ty),
    };
}

/// `lint::unreachable`: warn once per block, at the first statement (or the
/// tail) after one that always diverges. Code after that point is not
/// searched further, so one mistake gives one warning.
fn unreachable_block(p: &mut +Program, b: Id::<Block>, out: &mut +Diags) {
    let blk = p.thir.block(b);
    let n = blk.stmts.len();
    for i in 0..n {
        let e = match p.thir.stmts.list(blk.stmts)[i] {
            Stmt::Let { init: Some(e), .. } => e,
            Stmt::Expr(e) => e,
            Stmt::Let { init: None, .. } => continue,
        };
        unreachable_expr(p, e, out);
        if !diverges(p, e) {
            continue;
        }
        let mut next: Option::<(Span, str)> = None;
        if i + 1 < n {
            next = match p.thir.stmts.list(blk.stmts)[i + 1] {
                Stmt::Let { span, .. } => Some((span, "statement")),
                Stmt::Expr(x) => Some((p.thir.expr(x).span, "statement")),
            };
        } else if let Some(t) = blk.tail {
            next = Some((p.thir.expr(t).span, "expression"));
        }
        let es = p.thir.expr(e).span;
        if let Some(nx) = next {
            let (span, what) = nx;
            if !is_dummy(span) && !is_dummy(es) {
                let m = say(p, "unreachable {what}");
                out.warning(codes::lint::UNREACHABLE(), span, m);
                out.label(say(p, "this {what} can never run"));
                out.secondary(es, say(p, "any code following this expression is unreachable, because it never finishes"));
                out.finish();
            }
        }
        return;
    }
    if let Some(t) = blk.tail {
        unreachable_expr(p, t, out);
    }
}

fn unreachable_expr(p: &mut +Program, e: Id::<Expr>, out: &mut +Diags) {
    match p.thir.expr(e).kind {
        ExprKind::Block(b) => unreachable_block(p, b, out),
        ExprKind::Loop { body, .. } => unreachable_block(p, body, out),
        ExprKind::While { cond, body, .. } => {
            unreachable_expr(p, cond, out);
            unreachable_block(p, body, out);
        }
        ExprKind::ForRange { start, end, body, .. } => {
            unreachable_expr(p, start, out);
            unreachable_expr(p, end, out);
            unreachable_block(p, body, out);
        }
        ExprKind::ForArray { array, body, .. } => {
            unreachable_expr(p, array, out);
            unreachable_block(p, body, out);
        }
        _ => {
            let mut kids: [Id::<Expr>; ..+] = [];
            visit_children(&p.thir, e, &mut kids);
            for c in kids {
                unreachable_expr(p, c, out);
            }
        }
    }
}

// ========================================================================= what results point into

/// Which parameters the value a function returns may point into: bit `i`
/// of `into` if into parameter `i`'s own storage (and wherever its views
/// point), bit `i` of `through` if only where its views point. Parameters
/// from the 64th on always count as `into`. A named function's comes from
/// its signature (`Program::ret_from`, all `into`); a closure's is inferred
/// from its body (`infer_closure_ret_points`).
pub struct RetPoints {
    pub into: u64,
    pub through: u64,
}

impl RetPoints {
    /// Into nothing.
    pub fn none(): RetPoints {
        return RetPoints { into: 0, through: 0 };
    }

    /// Into every parameter: what is assumed of a body the checker cannot
    /// follow.
    pub fn all(): RetPoints {
        return RetPoints { into: !0u64, through: !0u64 };
    }

    pub fn is_all(self): bool {
        return self.into == !0u64 && self.through == !0u64;
    }

    /// How far the result may point into parameter `i`: 0 not at all, 1
    /// where its views point, 2 into its storage too.
    pub fn level(self, i: usize): u8 {
        if i >= 64 || (self.into >> (i as u64)) & 1 == 1 {
            return 2;
        }
        if (self.through >> (i as u64)) & 1 == 1 {
            return 1;
        }
        return 0;
    }
}

/// Infer the `RetPoints` of the closure bodies `bodies` (with their bounds,
/// `envs`) into `p.ret_points`. A closure may return what another closure
/// it calls returns, so this goes from nothing up to a fixed point.
pub fn infer_closure_ret_points(p: &mut Program, bodies: [Body; &], envs: [List::<Pred>; &]) {
    for b in bodies {
        p.ret_points.insert(b.def, RetPoints::none());
    }
    loop {
        let mut changed = false;
        for m in 0..bodies.len() {
            let new = body_ret_points(p, bodies[m], envs[m]);
            let old = p.ret_points.get(bodies[m].def).unwrap();
            let merged = RetPoints { into: old.into | new.into, through: old.through | new.through };
            if merged.into != old.into || merged.through != old.through {
                p.ret_points.insert(bodies[m].def, merged);
                changed = true;
            }
        }
        if !changed {
            break;
        }
    }
}

/// What the value closure `body` returns may point into, given the
/// `RetPoints` known so far.
fn body_ret_points(p: &mut +Program, body: Body, env_list: List::<Pred>): RetPoints {
    let env = p.preds.list(env_list).to_grow();
    let mut cx = new_cx(p, body, env[..]);
    if !cx.has_view(p, p.fn_data(body.def).sig.ret) {
        return RetPoints::none();
    }
    // A view made from a raw pointer points into nothing the checker
    // knows of.
    let mut top: [Id::<Expr>; ..+] = [];
    visit_block(&p.thir, body.block, &mut top);
    for e in top {
        if uses_raw_pointers(p, e) {
            return RetPoints::all();
        }
    }
    cx.compute_roots(p);
    let roots = cx.returned_roots(p);
    let mut rp = RetPoints::none();
    for r in roots {
        let mut into = true;
        let l = match r {
            Root::Arg(x) => {
                into = false;
                x
            }
            Root::Local(x) => x,
            Root::Slot(x) => x,
            Root::Temp => continue,
        };
        if let LocalKind::Param { index, .. } = cx.local(p, l).kind {
            if index < 64 {
                if into {
                    rp.into = rp.into | (1u64 << index as u64);
                } else {
                    rp.through = rp.through | (1u64 << index as u64);
                }
            }
        }
    }
    return rp;
}

/// Whether `e` or an expression inside it is a raw pointer.
fn uses_raw_pointers(p: &Program, e: Id::<Expr>): bool {
    if let TyKind::Ptr(..) = p.types.kind(p.thir.expr(e).ty) {
        return true;
    }
    let mut kids: [Id::<Expr>; ..+] = [];
    visit_children(&p.thir, e, &mut kids);
    for c in kids {
        if uses_raw_pointers(p, c) {
            return true;
        }
    }
    return false;
}

/// Whether `t` names a type without generic parameters, `impl Trait` or
/// unknowns, so its impls can be looked up.
fn is_concrete(p: &Program, t: Ty): bool {
    return !p.types.any(t, &|k| match k {
        TyKind::Param(..) | TyKind::Opaque(..) | TyKind::Proj(..) | TyKind::Infer(_) | TyKind::Error => true,
        _ => false,
    });
}

/// What says where a call's result points: the signature of a named
/// function or of a trait method (on a concrete type, its impl's, or the
/// trait's default; otherwise the trait's declaration), or the body of a
/// closure called where its type is known.
fn callee_def(p: &mut +Program, c: Callee): Option::<DefId> {
    return match c {
        Callee::Fn { def, .. } => Some(def),
        Callee::Intrinsic { def, .. } => Some(def),
        Callee::Trait { trait_ref, self_ty, method, method_args } => {
            let mut concrete = is_concrete(p, self_ty);
            for t in p.types.list(trait_ref.args) {
                concrete = concrete && is_concrete(p, t);
            }
            if concrete {
                if let Some(MethodImpl::Fn { def, .. }) = p.resolve_method(trait_ref, self_ty, method, method_args) {
                    return Some(def);
                }
            }
            trait_method(p, trait_ref.trait_id, method)
        }
        Callee::Value { callee: f, .. } => match p.types.kind(p.thir.expr(f).ty) {
            TyKind::Closure(def, _) => Some(def),
            _ => None,
        },
        Callee::Indirect(_) => None,
    };
}

/// `` `a` ``, `` `a` and `b` ``, `` `a`, `b` and `c` ``.
pub fn quoted_list(names: [str; &]): String {
    let mut out = String::new();
    for i in 0..names.len() {
        if i > 0 {
            out.push_str(if i + 1 == names.len() { " and " } else { ", " });
        }
        out.write("`{names[i]}`");
    }
    return out;
}

/// The names of the parameters of `def` in `set` (see `RetFrom`).
pub fn from_names(p: &Program, def: DefId, set: u64): [str; ..+] {
    let mut out: [str; ..+] = [];
    let ps = p.params.list(p.fn_data(def).sig.params);
    for i in 0..ps.len() {
        if i < 64 && (set >> (i as u64)) & 1 == 1 {
            out.push(p.text(ps[i].name));
        }
    }
    return out;
}

/// Whether values of `t` point into storage they do not own, where the
/// generic parameters have the bounds `env`.
pub fn ty_has_view(p: &mut +Program, env: [Pred; &], t: Ty, depth: u32): bool {
    if depth > 32 {
        return false;
    }
    return match p.types.kind(t) {
        TyKind::Str | TyKind::FmtArgs | TyKind::Dyn(..) => true,
        TyKind::Array(e, k) => k.is_slice() || ty_has_view(p, env, e, depth + 1),
        TyKind::Tuple(ts) => any_view(p, env, ts, depth + 1),
        TyKind::Adt(d, args) => {
            let fs = p.adt_field_tys(d, args);
            any_view(p, env, fs, depth + 1)
        }
        TyKind::Grow(t) => ty_has_view(p, env, t, depth + 1),
        TyKind::Closure(d, args) => {
            let Some(c) = p.closures.get(d) else { return false; };
            for i in 0..c.captures.len() {
                let cap = p.captures.list(c.captures)[i];
                if cap.by_ref {
                    return true;
                }
                let ct = p.types.subst(cap.ty, args);
                if ty_has_view(p, env, ct, depth + 1) {
                    return true;
                }
            }
            false
        }
        // Generic values may be instantiated with views, and `impl Trait`
        // may stand for one, unless bounded by `Dull`.
        TyKind::Param(..) | TyKind::Opaque(..) => !p.is_dull(t, env) && !p.is_detached(t, env),
        // `T::Item`: what it stands for, or like a generic parameter.
        TyKind::Proj(..) => {
            let n = p.normalize(t, env);
            if n != t {
                return ty_has_view(p, env, n, depth + 1);
            }
            !p.is_dull(t, env) && !p.is_detached(t, env)
        }
        _ => false,
    };
}

fn any_view(p: &mut +Program, env: [Pred; &], l: TyList, depth: u32): bool {
    for i in 0..l.len() {
        if ty_has_view(p, env, p.types.at(l, i), depth) {
            return true;
        }
    }
    return false;
}

// ========================================================================= check

/// A checker for `body`, where each parameter that can hold a view points
/// into its caller's data.
fn new_cx(p: &mut +Program, body: Body, env: [Pred; &]): Cx {
    let mut cx = Cx {
        body,
        env,
        roots: [],
        reported: HashMap::new(),
        loop_exit: HashMap::new(),
        loop_head: HashMap::new(),
        saved_sets: [],
        words: (body.locals.len() + 63) / 64,
        held: [],
        from: None,
    };
    for i in 0..body.params.len() {
        let l = p.thir.local_ids.list(body.params)[i];
        if cx.has_view(p, cx.local(p, l).ty) {
            cx.roots.push(pair_key(l, Root::Arg(l)));
        }
    }
    sort_dedup(&mut cx.roots);
    return cx;
}

/// Check `body`, whose generic parameters have the bounds `env`. Errors go
/// to `p.diags`.
pub fn check(p: &mut +Program, body: Body, env: [Pred; &]) {
    let mut cx = new_cx(p, body, env);
    cx.compute_roots(p);
    cx.from = cx.declared_from(p);
    cx.check_views_block(p, body.block);
    if let Some(t) = p.thir.block(body.block).tail {
        cx.check_escape(p, t, p.thir.expr(t).span);
    }
    let mut mv = Moves { loop_states: HashMap::new(), saved: [], paths: [], proj: [] };
    let mut st = MoveState { reachable: true, paths: [] };
    mv.block(&mut cx, p, body.block, &mut st);
    let after = cx.ls_new();
    let _ = cx.live_block(p, body.block, after);
}

struct Cx {
    body: Body,
    env: [Pred; &],
    /// The roots of every local: `pair_key(local, root)`, sorted, without
    /// repeats.
    roots: [u64; -..+],
    reported: HashMap::<(Span, u32), bool>,
    /// Where the live sets of each loop are in `saved_sets`.
    loop_exit: HashMap::<LoopId, usize>,
    loop_head: HashMap::<LoopId, usize>,
    saved_sets: [u64; ..+],
    /// The length of a `LiveSet`.
    words: usize,
    /// Roots of the other arguments of the call being checked.
    held: Roots,
    /// For a named function, what its signature says its result points
    /// into, to check what it returns against.
    from: Option::<FromCheck>,
}

/// A named function's `from` (declared or left out), checked against the
/// values its body returns.
struct FromCheck {
    declared: RetFrom,
    /// The declared parameters and every one a returned value points into.
    wanted: u64,
}

impl Cx {
    fn local(&self, p: &Program, l: LocalId): Local {
        return p.thir.local(self.body, l);
    }

    /// Whether this is the first report of kind `k` at `span`.
    fn report(&mut self, span: Span, k: u32): bool {
        return self.reported.insert((span, k), true).is_none();
    }

    /// The roots of local `l`.
    fn local_roots(&self, l: LocalId): Roots {
        let base = (l.index as u64) << 34;
        let mut lo: usize = 0;
        let mut hi = self.roots.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.roots[mid] < base {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        let mut r: Roots = [];
        while lo < self.roots.len() && (self.roots[lo] >> 34) == l.index as u64 {
            r.push(root_from_key(self.roots[lo] & 17179869183));
            lo += 1;
        }
        return r;
    }

    /// Whether local `l` has root `r`.
    fn local_has_root(&self, l: LocalId, r: Root): bool {
        let k = pair_key(l, r);
        let mut lo: usize = 0;
        let mut hi = self.roots.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            let x = self.roots[mid];
            if x == k {
                return true;
            }
            if x < k {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        return false;
    }

    /// Whether values of `t` point into storage they do not own.
    fn has_view(&self, p: &mut +Program, t: Ty): bool {
        return ty_has_view(p, self.env, t, 0);
    }

    /// Whether a value of `t` has storage a view could point into: an owned
    /// array or string, or an inline array, anywhere inside it. A value
    /// without (a number, a `str`, an iterator holding only views) can only
    /// be pointed *through*.
    fn has_storage(&self, p: &mut +Program, t: Ty, depth: u32): bool {
        if depth > 32 {
            return true;
        }
        return match p.types.kind(t) {
            TyKind::String => true,
            // Owning and inline arrays are storage; a slice only points.
            TyKind::Array(_, k) => !k.is_slice(),
            TyKind::Tuple(ts) => self.any_storage(p, ts, depth + 1),
            TyKind::Adt(d, args) => {
                let fs = p.adt_field_tys(d, args);
                self.any_storage(p, fs, depth + 1)
            }
            TyKind::Grow(t) => self.has_storage(p, t, depth + 1),
            TyKind::Closure(d, args) => {
                let Some(c) = p.closures.get(d) else { return true; };
                for i in 0..c.captures.len() {
                    let cap = p.captures.list(c.captures)[i];
                    if !cap.by_ref {
                        let ct = p.types.subst(cap.ty, args);
                        if self.has_storage(p, ct, depth + 1) {
                            return true;
                        }
                    }
                }
                false
            }
            // `impl Trait`: look at the type behind it once its function is
            // checked (like an auto trait, this is not part of the bounds).
            TyKind::Opaque(d, i, args) => {
                let concrete = match p.opaques.get((d, i)) {
                    Some(o) => o.concrete,
                    None => None,
                };
                match concrete {
                    Some(c) => {
                        let ct = p.types.subst(c, args);
                        self.has_storage(p, ct, depth + 1)
                    }
                    None => !p.is_dull(t, self.env),
                }
            }
            // Dull types hold no arrays; anything else generic might.
            TyKind::Param(..) | TyKind::Proj(..) | TyKind::Infer(_) => !p.is_dull(t, self.env),
            _ => false,
        };
    }

    fn any_storage(&self, p: &mut +Program, l: TyList, depth: u32): bool {
        for i in 0..l.len() {
            if self.has_storage(p, p.types.at(l, i), depth) {
                return true;
            }
        }
        return false;
    }

    /// Whether a declared type (in a signature) can hold a view by itself,
    /// not counting the function's generic parameters: their values are
    /// the caller's, copied in and out.
    fn has_own_view(&self, p: &mut +Program, t: Ty, depth: u32): bool {
        if depth > 32 {
            return true;
        }
        return match p.types.kind(t) {
            TyKind::Str | TyKind::FmtArgs | TyKind::Dyn(..) => true,
            TyKind::Array(e, k) => k.is_slice() || self.has_own_view(p, e, depth + 1),
            TyKind::Tuple(ts) => self.any_own_view(p, ts, depth + 1),
            TyKind::Adt(d, args) => {
                let fs = p.adt_field_tys(d, args);
                self.any_own_view(p, fs, depth + 1)
            }
            TyKind::Grow(t) => self.has_own_view(p, t, depth + 1),
            TyKind::Param(..) | TyKind::Proj(..) => false,
            TyKind::Closure(..) | TyKind::Opaque(..) => true,
            _ => false,
        };
    }

    fn any_own_view(&self, p: &mut +Program, l: TyList, depth: u32): bool {
        for i in 0..l.len() {
            if self.has_own_view(p, p.types.at(l, i), depth) {
                return true;
            }
        }
        return false;
    }

    // ===================================================================== roots

    fn place_root(&self, p: &Program, e: Id::<Expr>): Option::<Root> {
        return match p.thir.expr(e).kind {
            ExprKind::Local(l) => Some(Root::Local(l)),
            ExprKind::Field { base, .. } => self.place_root(p, base),
            ExprKind::Index { base, .. } => self.place_root(p, base),
            ExprKind::Temp(_) => Some(Root::Temp),
            _ => None,
        };
    }

    fn is_view_container(&self, p: &Program, t: Ty): bool {
        let slice = match p.types.kind(p.types.strip_grow(t)) {
            TyKind::Array(_, k) => k.is_slice(),
            _ => false,
        };
        return slice || p.types.kind(t) == TyKind::Str;
    }

    /// Roots of a borrow of `place` (slicing it, passing an owner handle).
    fn borrow_roots(&self, p: &mut +Program, place: Id::<Expr>): Roots {
        let pe = p.thir.expr(place);
        // Slicing a view stored in a field (`self.rest[i..]`): the data lives
        // wherever that view points, not in the struct holding it.
        if let ExprKind::Field { .. } = pe.kind {
            if self.is_view_container(p, pe.ty) {
                return self.value_roots_of_place(p, place);
            }
        }
        let mut r: Roots = [];
        match pe.kind {
            ExprKind::Local(l) => {
                let lt = self.local(p, l).ty;
                if self.is_view_container(p, lt) {
                    // Slicing a slice: the data lives wherever the slice points.
                    return self.local_roots(l);
                }
                // The data lives in `l` (unless it has no storage of its
                // own, like an iterator holding only a `str`); if it
                // holds views (an array of `str`), the borrow also
                // reaches what they point into.
                if self.has_storage(p, lt, 0) {
                    roots_insert(&mut r, Root::Local(l));
                }
                if self.has_view(p, lt) {
                    let lr = self.local_roots(l);
                    roots_extend(&mut r, lr[..]);
                }
            }
            ExprKind::Field { base, .. } => return self.borrow_roots_of_base(p, base),
            ExprKind::Index { base, .. } => return self.borrow_roots_of_base(p, base),
            ExprKind::Temp(inner) => {
                r = self.value_roots(p, inner);
                // Slicing a temporary view (`s.as_bytes()[0..2]`) points
                // wherever that view points; only a temporary owner or
                // fixed array holds the data itself.
                if !self.is_view_container(p, pe.ty) {
                    roots_insert(&mut r, Root::Temp);
                }
            }
            _ => {}
        }
        return r;
    }

    /// Roots of a `dyn` made from `place` (`x as dyn T`). It points at the
    /// place itself: at a local variable like a closure borrowing it
    /// (`Slot`, so only moving the variable ends it), into the caller's
    /// value behind a borrowed parameter, or into an owner's items, or
    /// where a slice or `str` points; and at whatever the value there
    /// points into.
    fn dyn_roots(&self, p: &mut +Program, place: Id::<Expr>): Roots {
        let pe = p.thir.expr(place);
        let mut r: Roots = [];
        match pe.kind {
            ExprKind::Local(l) => {
                let local = self.local(p, l);
                roots_insert(&mut r, Root::Slot(l));
                if self.has_view(p, local.ty) {
                    let lr = self.local_roots(l);
                    roots_extend(&mut r, lr[..]);
                }
            }
            ExprKind::Field { .. } | ExprKind::Index { .. } => {
                let Some(base) = proj_base(pe.kind) else { return r; };
                let bt = p.types.strip_grow(p.thir.expr(base).ty);
                if self.is_view_container(p, bt) {
                    return self.value_roots_of_place(p, base);
                }
                let owner_items = match p.types.kind(bt) {
                    TyKind::Array(_, k) => k.is_owner(),
                    _ => false,
                };
                if owner_items {
                    return self.borrow_roots(p, base);
                }
                return self.dyn_roots(p, base);
            }
            ExprKind::Temp(inner) => {
                r = self.value_roots(p, inner);
                roots_insert(&mut r, Root::Temp);
            }
            _ => {}
        }
        return r;
    }

    /// Whether a value of `t` may hold a `dyn mut`, through which a call
    /// may shrink or replace what it views.
    fn may_hold_dyn_mut(&self, p: &mut +Program, t: Ty, depth: u32): bool {
        if depth > 32 {
            return true;
        }
        return match p.types.kind(t) {
            TyKind::Dyn(_, _, flags) => flags & DYN_MUT != 0,
            TyKind::Array(e, _) => self.may_hold_dyn_mut(p, e, depth + 1),
            TyKind::Grow(e) => self.may_hold_dyn_mut(p, e, depth + 1),
            TyKind::Tuple(ts) => self.any_dyn_mut(p, ts, depth + 1),
            TyKind::Adt(d, args) => {
                let fs = p.adt_field_tys(d, args);
                self.any_dyn_mut(p, fs, depth + 1)
            }
            TyKind::Closure(d, args) => {
                let Some(c) = p.closures.get(d) else { return false; };
                for i in 0..c.captures.len() {
                    let cap = p.captures.list(c.captures)[i];
                    let ct = p.types.subst(cap.ty, args);
                    if self.may_hold_dyn_mut(p, ct, depth + 1) {
                        return true;
                    }
                }
                false
            }
            _ => false,
        };
    }

    /// Whether values of `t` may hold views other than `dyn`s (which point
    /// at variables, not into their storage).
    fn has_non_dyn_view(&self, p: &mut +Program, t: Ty, depth: u32): bool {
        if depth > 32 {
            return true;
        }
        return match p.types.kind(t) {
            TyKind::Dyn(..) => false,
            TyKind::Array(e, k) => k.is_slice() || self.has_non_dyn_view(p, e, depth + 1),
            TyKind::Tuple(ts) => {
                for i in 0..ts.len() {
                    if self.has_non_dyn_view(p, p.types.at(ts, i), depth + 1) {
                        return true;
                    }
                }
                false
            }
            TyKind::Adt(d, args) => {
                let fs = p.adt_field_tys(d, args);
                for i in 0..fs.len() {
                    if self.has_non_dyn_view(p, p.types.at(fs, i), depth + 1) {
                        return true;
                    }
                }
                false
            }
            TyKind::Grow(e) => self.has_non_dyn_view(p, e, depth + 1),
            _ => self.has_view(p, t),
        };
    }

    fn any_dyn_mut(&self, p: &mut +Program, l: TyList, depth: u32): bool {
        for i in 0..l.len() {
            if self.may_hold_dyn_mut(p, p.types.at(l, i), depth) {
                return true;
            }
        }
        return false;
    }

    /// The owners a `dyn mut` with roots `roots` may shrink or replace
    /// when a method is called through it: the variables it points at
    /// (`Slot`, for a borrowed parameter the caller's value), and the
    /// caller's values behind parameters whose views it came from (`Arg`).
    /// An owner's items (`Local`) are Light, so changing one shrinks
    /// nothing.
    fn dyn_mut_owners(&self, p: &mut +Program, roots: [Root; &]): [LocalId; ..+] {
        let mut out: [LocalId; ..+] = [];
        for r in roots {
            let l = match r {
                Root::Slot(x) => x,
                Root::Arg(x) => x,
                Root::Local(_) => continue,
                Root::Temp => continue,
            };
            let lt = p.types.strip_grow(self.local(p, l).ty);
            if !out[..].contains(l) && p.could_own(lt, self.env) {
                out.push(l);
            }
        }
        return out;
    }

    /// A `dyn mut` with roots `roots` stored inside local `l`: an error if
    /// it views `l` itself, since a call through it could then shrink `l`
    /// where nothing tracks it (code holding `l` keeps its views).
    fn check_views_itself(&mut self, p: &mut +Program, roots: [Root; &], l: LocalId, span: Span) {
        if !roots_contains(roots, Root::Slot(l)) && !roots_contains(roots, Root::Local(l)) {
            return;
        }
        if !self.report(span, 11) {
            return;
        }
        let n = p.text(self.local(p, l).name);
        let m = say(p, "cannot store a `dyn mut` that views `{n}` inside `{n}` itself");
        p.diags.error(codes::borrow::VIEWS_ITSELF(), span, m);
        p.diags.note(say(p, "a method called through it could shrink or replace `{n}` while views into `{n}` are in use"));
        p.diags.help(say(p, "keep the `dyn mut` in a variable of its own, next to `{n}`"));
        p.diags.finish();
    }

    /// Where a call may store views through a `dyn mut` with roots
    /// `roots` (into the value it views): the variable it points at, or
    /// what it points into.
    fn dyn_mut_store_targets(&self, roots: [Root; &], out: &mut [Root; -..+]) {
        for r in roots {
            match r {
                Root::Slot(x) => out.push(Root::Local(x)),
                Root::Local(x) => out.push(Root::Local(x)),
                Root::Arg(x) => out.push(Root::Arg(x)),
                Root::Temp => {}
            }
        }
    }

    /// `borrow_roots` of a field or element of `base`.
    fn borrow_roots_of_base(&self, p: &mut +Program, base: Id::<Expr>): Roots {
        if self.is_view_container(p, p.thir.expr(base).ty) {
            return self.value_roots_of_place(p, base);
        }
        return self.borrow_roots(p, base);
    }

    /// Roots of the value currently stored in `place`.
    fn value_roots_of_place(&self, p: &mut +Program, place: Id::<Expr>): Roots {
        let mut r: Roots = [];
        match self.place_root(p, place) {
            Some(Root::Local(l)) => return self.local_roots(l),
            Some(Root::Temp) => match p.thir.expr(place).kind {
                ExprKind::Temp(inner) => return self.value_roots(p, inner),
                _ => {
                    r.push(Root::Temp);
                }
            },
            _ => {}
        }
        return r;
    }

    fn value_roots(&self, p: &mut +Program, e: Id::<Expr>): Roots {
        let ex = p.thir.expr(e);
        let mut r: Roots = [];
        if !self.has_view(p, ex.ty) {
            return r;
        }
        match ex.kind {
            ExprKind::Read { place, .. } => return self.value_roots_of_place(p, place),
            ExprKind::Slice { base, .. } => return self.borrow_roots(p, base),
            ExprKind::Coerce { kind: Coercion::ToSlice { .. }, expr } => return self.borrow_roots(p, expr),
            ExprKind::Coerce { kind: Coercion::StringToStr, expr } => return self.borrow_roots(p, expr),
            ExprKind::Coerce { kind: Coercion::ToDyn { .. }, expr } => return self.dyn_roots(p, expr),
            ExprKind::Coerce { expr, .. } => return self.value_roots(p, expr),
            ExprKind::Call { args, callee } => {
                // What the body of the callee says its result points into;
                // without one, into every argument.
                let points = self.callee_ret_points(p, callee);
                // What a closure returns may point at what it captured.
                if let Callee::Value { callee: f, .. } = callee {
                    let fr = if p.thir.is_place(f) { self.value_roots_of_place(p, f) } else { self.value_roots(p, f) };
                    let cdef = match p.types.kind(p.thir.expr(f).ty) {
                        TyKind::Closure(d, _) => Some(d),
                        _ => None,
                    };
                    match (cdef, points) {
                        (Some(d), Some(rp)) => {
                            let cr = self.closure_result_roots(p, f, fr[..], d, rp);
                            roots_extend(&mut r, cr[..]);
                        }
                        _ => roots_extend(&mut r, fr[..]),
                    }
                }
                let offset = self.captures_before_args(p, callee);
                let copies_only = self.copies_only(p, callee);
                // A `dyn` in the result may view a lent argument itself.
                let views_args = p.types.any(ex.ty, &|k| match k {
                    TyKind::Dyn(..) => true,
                    _ => false,
                });
                let mut dyn_r: Roots = [];
                for i in 0..args.len() {
                    let a = p.thir.args.list(args)[i];
                    let mut level: u8 = 2;
                    if let Some(rp) = points {
                        level = rp.level(i + offset);
                    }
                    if copies_only && level > 1 {
                        level = 1;
                    }
                    let ar = self.result_roots_from_arg(p, a, level);
                    roots_extend(&mut r, ar[..]);
                    if views_args && level > 1 {
                        let lent = match a {
                            Arg::InOut(x) => Some(x),
                            Arg::Value(v) => match p.thir.expr(v).kind {
                                ExprKind::Read { place, mode: ReadMode::Borrow } => Some(place),
                                _ => None,
                            },
                        };
                        if let Some(x) = lent {
                            let dr = self.dyn_roots(p, x);
                            roots_extend(&mut dyn_r, dr[..]);
                        }
                    }
                }
                // A result that cannot be a closure, but comes from one that
                // borrows a variable (called here or by the callee), may be
                // a view into that variable.
                // (Only closures make such views, maybe behind a `dyn`; a
                // `dyn` itself points at a variable, not into it.)
                let mut closures = match callee {
                    Callee::Value { .. } => true,
                    _ => false,
                };
                for i in 0..args.len() {
                    let at = p.thir.expr(p.thir.args.list(args)[i].expr()).ty;
                    if self.may_hold_closure(p, at, 0) || p.types.any(at, &|k| match k {
                        TyKind::Dyn(..) => true,
                        _ => false,
                    }) {
                        closures = true;
                    }
                }
                let into = !views_args || self.has_non_dyn_view(p, ex.ty, 0);
                if closures && into && !self.may_hold_closure(p, ex.ty, 0) {
                    let mut slots: [LocalId; ..+] = [];
                    for x in r[..] {
                        if let Root::Slot(l) = x {
                            slots.push(l);
                        }
                    }
                    for l in slots {
                        if self.has_storage(p, self.local(p, l).ty, 0) {
                            roots_insert(&mut r, Root::Local(l));
                        }
                    }
                }
                roots_extend(&mut r, dyn_r[..]);
            }
            // A loop's value is what its `break`s give.
            ExprKind::Loop { body, id } => {
                let mut top: [Id::<Expr>; ..+] = [];
                visit_block(&p.thir, body, &mut top);
                for x in top {
                    self.break_roots(p, x, id, &mut r);
                }
            }
            ExprKind::ArrayRepeat { value, .. } => return self.value_roots(p, value),
            ExprKind::Tuple(es) => self.list_value_roots(p, es, &mut r),
            ExprKind::Array(es) => self.list_value_roots(p, es, &mut r),
            ExprKind::Adt { fields, .. } => {
                for i in 0..fields.len() {
                    let f = p.thir.field_exprs.list(fields)[i];
                    let fr = self.value_roots(p, f.expr);
                    roots_extend(&mut r, fr[..]);
                }
            }
            // A borrowing closure points at the variables it borrows (and at
            // whatever they point into); one that took a value holds that
            // value's roots.
            ExprKind::Closure { captures, .. } => {
                for i in 0..captures.len() {
                    let a = p.thir.args.list(captures)[i];
                    let x = a.expr();
                    if p.thir.is_place(x) {
                        match self.place_root(p, x) {
                            Some(Root::Local(l)) => {
                                roots_insert(&mut r, Root::Slot(l));
                            }
                            Some(other) => {
                                roots_insert(&mut r, other);
                            }
                            None => {}
                        }
                        if self.has_view(p, p.thir.expr(x).ty) {
                            let xr = self.value_roots_of_place(p, x);
                            roots_extend(&mut r, xr[..]);
                        }
                    } else if let Arg::Value(v) = a {
                        let vr = self.value_roots(p, v);
                        roots_extend(&mut r, vr[..]);
                    }
                }
            }
            ExprKind::Block(b) => {
                if let Some(t) = p.thir.block(b).tail {
                    return self.value_roots(p, t);
                }
            }
            ExprKind::If { then, else_, .. } => {
                r = self.value_roots(p, then);
                if let Some(x) = else_ {
                    let xr = self.value_roots(p, x);
                    roots_extend(&mut r, xr[..]);
                }
            }
            ExprKind::Match { arms, .. } => {
                for i in 0..arms.len() {
                    let a = p.thir.arms.list(arms)[i];
                    let ar = self.value_roots(p, a.body);
                    roots_extend(&mut r, ar[..]);
                }
            }
            ExprKind::FmtArgs(pieces) => {
                for i in 0..pieces.len() {
                    if let FmtPiece::Arg(x, _) = p.thir.fmt_pieces.list(pieces)[i] {
                        let xr = self.arg_roots(p, x);
                        roots_extend(&mut r, xr[..]);
                    }
                }
            }
            _ => {}
        }
        return r;
    }

    /// The union of the `value_roots` of `es`, into `r`.
    fn list_value_roots(&self, p: &mut +Program, es: List::<Id::<Expr>>, r: &mut Roots) {
        for i in 0..es.len() {
            let x = p.thir.expr_ids.list(es)[i];
            let xr = self.value_roots(p, x);
            roots_extend(r, xr[..]);
        }
    }

    /// The roots of every value the body being checked returns: its tail
    /// and its `return`s.
    fn returned_roots(&self, p: &mut +Program): Roots {
        let mut roots: Roots = [];
        if let Some(t) = p.thir.block(self.body.block).tail {
            let tr = self.value_roots(p, t);
            roots_extend(&mut roots, tr[..]);
        }
        let mut top: [Id::<Expr>; ..+] = [];
        visit_block(&p.thir, self.body.block, &mut top);
        for e in top {
            self.return_roots(p, e, &mut roots);
        }
        return roots;
    }

    /// The roots of the values `return`ed in `e`, into `out`.
    fn return_roots(&self, p: &mut +Program, e: Id::<Expr>, out: &mut Roots) {
        if let ExprKind::Return(Some(v)) = p.thir.expr(e).kind {
            let vr = self.value_roots(p, v);
            roots_extend(out, vr[..]);
        }
        let mut kids: [Id::<Expr>; ..+] = [];
        visit_children(&p.thir, e, &mut kids);
        for c in kids {
            self.return_roots(p, c, out);
        }
    }

    /// The roots of the values `break` gives loop `id` in `e`, into `out`.
    fn break_roots(&self, p: &mut +Program, e: Id::<Expr>, id: LoopId, out: &mut Roots) {
        if let ExprKind::Break { id: b, value: Some(v) } = p.thir.expr(e).kind {
            if b == id {
                let vr = self.value_roots(p, v);
                roots_extend(out, vr[..]);
            }
        }
        let mut kids: [Id::<Expr>; ..+] = [];
        visit_children(&p.thir, e, &mut kids);
        for c in kids {
            self.break_roots(p, c, id, out);
        }
    }

    /// What a call's result points into, when known: what the signature of
    /// the function called says, or the body of the closure called.
    fn callee_ret_points(&self, p: &mut +Program, c: Callee): Option::<RetPoints> {
        let Some(def) = callee_def(p, c) else { return None; };
        if let Some(rf) = p.ret_from.get(def) {
            return Some(RetPoints { into: rf.set, through: 0 });
        }
        return p.ret_points.get(def);
    }

    /// How many parameters of the called function come before the call's
    /// arguments: a closure's captures.
    fn captures_before_args(&self, p: &Program, c: Callee): usize {
        if let Callee::Value { callee: f, .. } = c {
            if let TyKind::Closure(d, _) = p.types.kind(p.thir.expr(f).ty) {
                if let Some(info) = p.closures.get(d) {
                    return info.captures.len();
                }
            }
        }
        return 0;
    }

    /// A plain function whose declared return type has no view of its own
    /// (`pop(&mut self): Option::<T>`) cannot point into its arguments'
    /// storage: it can only hand back copies of items, which point where
    /// the items point. Trait methods stay conservative: an implementation
    /// may return views into itself.
    fn copies_only(&self, p: &mut +Program, c: Callee): bool {
        return match c {
            Callee::Fn { def, .. } => !self.has_own_view(p, p.fn_data(def).sig.ret, 0),
            Callee::Intrinsic { def, .. } => !self.has_own_view(p, p.fn_data(def).sig.ret, 0),
            _ => false,
        };
    }

    /// The roots a call's result gains from argument `a`, if it may point
    /// into it as far as `level` (see `RetPoints::level`).
    fn result_roots_from_arg(&self, p: &mut +Program, a: Arg, level: u8): Roots {
        if level == 0 {
            let r: Roots = [];
            return r;
        }
        return match a {
            Arg::InOut(x) => if level == 1 { self.value_roots_of_place(p, x) } else { self.borrow_roots(p, x) },
            Arg::Value(v) => match p.thir.expr(v).kind {
                ExprKind::Read { place, mode: ReadMode::Borrow } if level == 1 => self.value_roots_of_place(p, place),
                _ => self.arg_roots(p, v),
            },
        };
    }

    /// What calling closure `def`, the value `f` with roots `fr`, returns
    /// from its captures, given what its body returns (`rp`): nothing if
    /// it returns none of them. A view of a capture it borrowed points
    /// into that variable (not at it, unless the result may be a closure
    /// itself), and a view into a capture it holds points into `f`.
    fn closure_result_roots(&self, p: &mut +Program, f: Id::<Expr>, fr: [Root; &], def: DefId, rp: RetPoints): Roots {
        let mut r: Roots = [];
        let Some(info) = p.closures.get(def) else {
            roots_extend(&mut r, fr);
            return r;
        };
        let mut any = false;
        let mut into_borrowed = false;
        let mut into_held = false;
        for i in 0..info.captures.len() {
            let level = rp.level(i);
            if level > 0 {
                any = true;
            }
            if level > 1 {
                if p.captures.list(info.captures)[i].by_ref {
                    into_borrowed = true;
                } else {
                    into_held = true;
                }
            }
        }
        if !any {
            return r;
        }
        let closures = self.may_hold_closure(p, p.fn_data(def).sig.ret, 0);
        for x in fr {
            match x {
                Root::Slot(l) => {
                    if closures {
                        roots_insert(&mut r, Root::Slot(l));
                    }
                    if into_borrowed && self.has_storage(p, self.local(p, l).ty, 0) {
                        roots_insert(&mut r, Root::Local(l));
                    }
                }
                _ => {
                    roots_insert(&mut r, x);
                }
            }
        }
        if into_held {
            let held = match self.place_root(p, f) {
                Some(x) => x,
                None => Root::Temp,
            };
            roots_insert(&mut r, held);
        }
        return r;
    }

    /// Whether a value of `t` may be or hold a closure.
    fn may_hold_closure(&self, p: &mut +Program, t: Ty, depth: u32): bool {
        if depth > 32 {
            return true;
        }
        return match p.types.kind(t) {
            TyKind::Closure(..) => true,
            TyKind::Array(e, _) => self.may_hold_closure(p, e, depth + 1),
            TyKind::Grow(e) => self.may_hold_closure(p, e, depth + 1),
            TyKind::Tuple(ts) => self.any_closure(p, ts, depth + 1),
            TyKind::Adt(d, args) => {
                let fs = p.adt_field_tys(d, args);
                self.any_closure(p, fs, depth + 1)
            }
            TyKind::Param(..) | TyKind::Opaque(..) | TyKind::Proj(..) | TyKind::Infer(_) => !p.is_dull(t, self.env),
            _ => false,
        };
    }

    fn any_closure(&self, p: &mut +Program, l: TyList, depth: u32): bool {
        for i in 0..l.len() {
            if self.may_hold_closure(p, p.types.at(l, i), depth) {
                return true;
            }
        }
        return false;
    }

    /// Why local `v` points into `root`, when that comes from what the
    /// signature of a function (or the body of a closure) says its result
    /// points into: `v` is bound to the result of a call, and an argument
    /// of it (or the closure called) points into `root`. That argument's
    /// span, and what was called.
    fn returned_into(&self, p: &mut +Program, v: LocalId, root: LocalId): Option::<(Span, Symbol)> {
        let mut found = false;
        let mut cause: Option::<(Span, Symbol)> = None;
        self.find_let_block(p, self.body.block, v, root, &mut found, &mut cause);
        return cause;
    }

    fn find_let_block(&self, p: &mut +Program, b: Id::<Block>, v: LocalId, root: LocalId, found: &mut bool, cause: &mut Option::<(Span, Symbol)>) {
        let blk = p.thir.block(b);
        for i in 0..blk.stmts.len() {
            if found {
                return;
            }
            match p.thir.stmts.list(blk.stmts)[i] {
                Stmt::Let { pat, init: Some(init), .. } => {
                    let mut binds: [LocalId; ..+] = [];
                    pat_bindings(&p.thir, pat, &mut binds);
                    let mut binds_v = false;
                    for l in binds {
                        if l == v {
                            binds_v = true;
                        }
                    }
                    if binds_v {
                        found = true;
                        cause = self.call_cause(p, init, root);
                        return;
                    }
                    self.find_let_expr(p, init, v, root, found, cause);
                }
                Stmt::Let { .. } => {}
                Stmt::Expr(e) => self.find_let_expr(p, e, v, root, found, cause),
            }
        }
        if !found {
            if let Some(t) = blk.tail {
                self.find_let_expr(p, t, v, root, found, cause);
            }
        }
    }

    fn find_let_expr(&self, p: &mut +Program, e: Id::<Expr>, v: LocalId, root: LocalId, found: &mut bool, cause: &mut Option::<(Span, Symbol)>) {
        match p.thir.expr(e).kind {
            ExprKind::Block(b) => self.find_let_block(p, b, v, root, found, cause),
            ExprKind::Loop { body, .. } => self.find_let_block(p, body, v, root, found, cause),
            ExprKind::While { body, .. } => self.find_let_block(p, body, v, root, found, cause),
            ExprKind::ForRange { body, .. } => self.find_let_block(p, body, v, root, found, cause),
            ExprKind::ForArray { body, .. } => self.find_let_block(p, body, v, root, found, cause),
            _ => {
                let mut kids: [Id::<Expr>; ..+] = [];
                visit_children(&p.thir, e, &mut kids);
                for c in kids {
                    if !found {
                        self.find_let_expr(p, c, v, root, found, cause);
                    }
                }
            }
        }
    }

    /// For `returned_into`: the argument of the call `init` (if it is one,
    /// with a known result) whose roots give `root`.
    fn call_cause(&self, p: &mut +Program, init: Id::<Expr>, root: LocalId): Option::<(Span, Symbol)> {
        let mut e = init;
        while let ExprKind::Coerce { expr, .. } = p.thir.expr(e).kind {
            e = expr;
        }
        let ExprKind::Call { callee, args } = p.thir.expr(e).kind else { return None; };
        let Some(rp) = self.callee_ret_points(p, callee) else { return None; };
        if rp.is_all() {
            return None;
        }
        let name = match callee {
            Callee::Fn { def, .. } => p.defs[def.index()].name,
            Callee::Trait { method, .. } => method,
            Callee::Value { callee: f, .. } => match p.thir.expr(f).kind {
                ExprKind::Local(l) => self.local(p, l).name,
                _ => return None,
            },
            Callee::Intrinsic { .. } => return None,
            Callee::Indirect(_) => return None,
        };
        // A closure: from what it captured, the closure itself.
        if let Callee::Value { callee: f, .. } = callee {
            if let TyKind::Closure(d, _) = p.types.kind(p.thir.expr(f).ty) {
                let fr = if p.thir.is_place(f) { self.value_roots_of_place(p, f) } else { self.value_roots(p, f) };
                let cr = self.closure_result_roots(p, f, fr[..], d, rp);
                if roots_contains(cr[..], Root::Local(root)) {
                    return Some((p.thir.expr(f).span, name));
                }
            }
        }
        let offset = self.captures_before_args(p, callee);
        let copies_only = self.copies_only(p, callee);
        for i in 0..args.len() {
            let a = p.thir.args.list(args)[i];
            let mut level = rp.level(i + offset);
            if copies_only && level > 1 {
                level = 1;
            }
            let ar = self.result_roots_from_arg(p, a, level);
            if roots_contains(ar[..], Root::Local(root)) {
                return Some((p.thir.expr(a.expr()).span, name));
            }
        }
        return None;
    }

    /// Which parameters of what is called are `kept`, when known: its
    /// parameters.
    fn callee_kept(&self, p: &Program, c: Callee): Option::<List::<Param>> {
        let def = match c {
            Callee::Fn { def, .. } => def,
            Callee::Intrinsic { def, .. } => def,
            Callee::Trait { trait_ref, method, .. } => {
                let Some(m) = trait_method(p, trait_ref.trait_id, method) else { return None; };
                m
            }
            Callee::Indirect(_) => return None,
            Callee::Value { .. } => return None,
        };
        return Some(p.fn_data(def).sig.params);
    }

    /// The storage a write into `place` changes: the root local, or, for a
    /// write through a slice (`s[i] = v`), whatever the slice points into
    /// (an owner `Local`, or a parameter's data `Arg`). A slice variable
    /// `lent` in-out may be both reassigned and written through.
    fn write_targets(&self, p: &mut +Program, place: Id::<Expr>, lent: bool): [Root; -..+] {
        let mut out: [Root; -..+] = [];
        let Some(Root::Local(l)) = self.place_root(p, place) else { return out; };
        let mut through: Roots = [];
        if self.write_through(p, place, &mut through) {
            out.extend(through[..]);
        } else {
            out.push(Root::Local(l));
        }
        let is_local = match p.thir.expr(place).kind {
            ExprKind::Local(_) => true,
            _ => false,
        };
        if lent && is_local && self.is_view_container(p, self.local(p, l).ty) {
            let lr = self.local_roots(l);
            out.extend(lr[..]);
        }
        let mut kept: [Root; -..+] = [];
        for r in out {
            if local_or_arg(r).is_some() {
                kept.push(r);
            }
        }
        return kept;
    }

    /// For `write_targets`: the roots a write into `e` changes through a
    /// slice it goes through (into `out`), if it goes through one.
    fn write_through(&self, p: &mut +Program, e: Id::<Expr>, out: &mut Roots): bool {
        let Some(base) = proj_base(p.thir.expr(e).kind) else { return false; };
        if self.is_view_container(p, p.thir.expr(base).ty) {
            let br = self.value_roots_of_place(p, base);
            roots_extend(out, br[..]);
            return true;
        }
        return self.write_through(p, base, out);
    }

    /// What a call may store where: a view from a `kept` argument may end up
    /// in any in-out argument that can hold one (`h.set(s)` doing
    /// `self.rest = s`, or `push` onto an array of views), or be written
    /// through a mutable slice argument (`s.fill(v)`); a closure may store
    /// any argument or capture into what it borrowed. Pairs of a target (a
    /// `Local`, or a parameter's data `Arg`) and a root it may gain, grouped
    /// by target.
    fn call_flows(&self, p: &mut +Program, callee: Callee, args: List::<Arg>): [(Root, Root); -..+] {
        let mut flows: [(Root, Root); -..+] = [];
        let mut targets: [Root; -..+] = [];
        for i in 0..args.len() {
            match p.thir.args.list(args)[i] {
                Arg::InOut(x) => {
                    if self.has_view(p, p.thir.expr(x).ty) {
                        let wt = self.write_targets(p, x, true);
                        targets.extend(wt[..]);
                    }
                    // Through a `dyn mut`, into the value it views.
                    if self.may_hold_dyn_mut(p, p.thir.expr(x).ty, 0) {
                        let xr = self.value_roots_of_place(p, x);
                        self.dyn_mut_store_targets(xr[..], &mut targets);
                    }
                }
                Arg::Value(v) => {
                    let mutable_views = match p.types.kind(p.thir.expr(v).ty) {
                        TyKind::Array(el, ArrKind::SliceMut) => self.has_view(p, el),
                        _ => false,
                    };
                    if mutable_views {
                        for r in self.value_roots(p, v) {
                            if local_or_arg(r).is_some() {
                                targets.push(r);
                            }
                        }
                    }
                    if self.may_hold_dyn_mut(p, p.thir.expr(v).ty, 0) {
                        let vr = self.arg_roots(p, v);
                        self.dyn_mut_store_targets(vr[..], &mut targets);
                    }
                }
            }
        }
        let mut given: Roots = [];
        if let Callee::Value { callee: f, .. } = callee {
            let fr = if p.thir.is_place(f) { self.value_roots_of_place(p, f) } else { self.value_roots(p, f) };
            for r in fr {
                match r {
                    Root::Slot(l) => {
                        if self.has_view(p, self.local(p, l).ty) {
                            targets.push(Root::Local(l));
                        }
                    }
                    // A view the closure captured by value.
                    _ => {
                        roots_insert(&mut given, r);
                    }
                }
            }
        }
        if targets.len() == 0 {
            return flows;
        }
        let kept = self.callee_kept(p, callee);
        for i in 0..args.len() {
            if let Some(ps) = kept {
                if i < ps.len() && !p.params.list(ps)[i].kept {
                    continue;
                }
            }
            match p.thir.args.list(args)[i] {
                Arg::Value(v) => {
                    let vr = self.arg_roots(p, v);
                    roots_extend(&mut given, vr[..]);
                }
                Arg::InOut(x) => {
                    if self.has_view(p, p.thir.expr(x).ty) {
                        let xr = self.value_roots_of_place(p, x);
                        roots_extend(&mut given, xr[..]);
                    }
                }
            }
        }
        let mut seen: Roots = [];
        for t in targets {
            if !roots_insert(&mut seen, t) {
                continue;
            }
            let Some(l) = local_or_arg(t) else { continue; };
            for r in given[..] {
                if root_local(r) != Some(l) {
                    flows.push((t, r));
                }
            }
        }
        return flows;
    }

    /// Check storing a view with `roots` into `target` (from
    /// `write_targets` or `call_flows`).
    fn check_store_into(&mut self, p: &mut +Program, target: Root, roots: [Root; &], span: Span) {
        match target {
            Root::Local(l) => {
                let borrowed = match self.local(p, l).kind {
                    LocalKind::Param { owned, .. } => !owned,
                    _ => false,
                };
                if borrowed {
                    self.check_store_into_param(p, l, roots, span);
                } else {
                    self.check_store(p, l, roots, span);
                }
            }
            Root::Arg(x) => self.check_store_into_param(p, x, roots, span),
            Root::Slot(_) => {}
            Root::Temp => {}
        }
    }

    /// Whether local `l` is a parameter declared `kept`.
    fn is_kept_param(&self, p: &Program, l: LocalId): bool {
        return match self.local(p, l).kind {
            LocalKind::Param { index, .. } => {
                let ps = p.fn_params(self.body.def);
                (index as usize) < ps.len() && ps[index as usize].kept
            }
            _ => false,
        };
    }

    /// Whether local `l` is a parameter the function does not own.
    fn is_borrowed_param(&self, p: &Program, l: LocalId): bool {
        return match self.local(p, l).kind {
            LocalKind::Param { owned, .. } => !owned,
            _ => false,
        };
    }

    /// Storing a view with `roots` into in-out parameter `dest` hands it to
    /// the caller: allowed for what `dest` already pointed into and for
    /// `kept` parameters' data, never for this function's own locals.
    fn check_store_into_param(&mut self, p: &mut +Program, dest: LocalId, roots: [Root; &], span: Span) {
        for r in roots {
            let mut l: Option::<LocalId> = None;
            let mut of_param = false;
            match r {
                Root::Local(x) => {
                    l = Some(x);
                    of_param = self.is_borrowed_param(p, x);
                }
                Root::Slot(x) => {
                    l = Some(x);
                    of_param = self.is_borrowed_param(p, x);
                }
                Root::Arg(x) => {
                    l = Some(x);
                    of_param = true;
                }
                Root::Temp => {}
            }
            let fine = match l {
                Some(x) => x == dest || (of_param && self.is_kept_param(p, x)),
                None => false,
            };
            if fine {
                continue;
            }
            if !self.report(span, 9) {
                return;
            }
            let dn = p.text(self.local(p, dest).name);
            match l {
                Some(x) if of_param => {
                    let lx = self.local(p, x);
                    let n = p.text(lx.name);
                    let m = say(p, "a view from parameter `{n}` may be stored into parameter `{dn}`");
                    p.diags.error(codes::borrow::ESCAPES_VIA_PARAM(), span, m);
                    p.diags.secondary(lx.span, say(p, "`{n}` is not declared `kept`, so callers do not expect `{dn}` to point into it"));
                    p.diags.help(say(p, "declare it `kept {n}: ...`"));
                    p.diags.suggest(Span::new(lx.span.lo, lx.span.lo), say(p, "kept "), say(p, "Declare `{n}` `kept`"));
                }
                _ => {
                    // `std::thread::Scope`: a thread of the scope would
                    // borrow a variable of the closure that started it.
                    let dt = p.types.strip_grow(self.local(p, dest).ty);
                    let is_scope = match p.types.kind(dt) {
                        TyKind::Adt(d, _) => p.is_lang(d, "thread_scope"),
                        _ => false,
                    };
                    if is_scope {
                        let mut what = String::from("a temporary value");
                        if let Some(x) = l {
                            what = String::from("`");
                            what.push_str(p.text(self.local(p, x).name));
                            what.push('`');
                        }
                        let m = say(p, "a scoped thread cannot borrow {what}: it is freed before the thread finishes");
                        p.diags.error(codes::borrow::SCOPED_THREAD_BORROW(), span, m);
                        if let Some(x) = l {
                            p.diags.secondary(self.local(p, x).span, say(p, "declared inside the closure given to `thread::scope`, which returns before the scope waits for its threads"));
                        }
                        p.diags.help(say(p, "declare it before `thread::scope`, or move it into the thread with a `move` closure"));
                    } else {
                        let m = say(p, "cannot store a view of a local value into parameter `{dn}`");
                        p.diags.error(codes::borrow::ESCAPES_VIA_PARAM(), span, m);
                        p.diags.note(say(p, "the caller's data may outlive the value being viewed"));
                    }
                }
            }
            p.diags.finish();
            return;
        }
    }

    /// Roots contributed by a by-value argument: a borrowed owner handle (or
    /// fixed array) points into its owner.
    fn arg_roots(&self, p: &mut +Program, v: Id::<Expr>): Roots {
        if let ExprKind::Read { place, mode: ReadMode::Borrow } = p.thir.expr(v).kind {
            if p.has_owner(p.thir.expr(place).ty) {
                return self.borrow_roots(p, place);
            }
        }
        return self.value_roots(p, v);
    }

    fn compute_roots(&mut self, p: &mut +Program) {
        for _ in 0..16 {
            let mut assigns: [u64; -..+] = [];
            self.collect_assigns_block(p, self.body.block, &mut assigns);
            let before = self.roots.len();
            self.roots.extend(assigns[..]);
            sort_dedup(&mut self.roots);
            if self.roots.len() == before {
                break;
            }
        }
    }

    fn collect_assigns_block(&self, p: &mut +Program, b: Id::<Block>, out: &mut [u64; -..+]) {
        let blk = p.thir.block(b);
        for i in 0..blk.stmts.len() {
            match p.thir.stmts.list(blk.stmts)[i] {
                Stmt::Let { pat, init: Some(init), .. } => {
                    let r = self.value_roots(p, init);
                    if r.len() > 0 {
                        let mut binds: [LocalId; ..+] = [];
                        pat_bindings(&p.thir, pat, &mut binds);
                        for l in binds {
                            for x in r[..] {
                                out.push(pair_key(l, x));
                            }
                        }
                    }
                    self.collect_assigns(p, init, out);
                }
                Stmt::Let { .. } => {}
                Stmt::Expr(e) => self.collect_assigns(p, e, out),
            }
        }
        if let Some(t) = blk.tail {
            self.collect_assigns(p, t, out);
        }
    }

    fn collect_assigns(&self, p: &mut +Program, e: Id::<Expr>, out: &mut [u64; -..+]) {
        let kind = p.thir.expr(e).kind;
        match kind {
            ExprKind::Assign { place, value } => {
                let r = self.value_roots(p, value);
                if r.len() > 0 {
                    // Into the variable, or through a slice into what it views.
                    for t in self.write_targets(p, place, false) {
                        if let Root::Local(l) = t {
                            for x in r[..] {
                                if x != Root::Local(l) {
                                    out.push(pair_key(l, x));
                                }
                            }
                        }
                    }
                }
            }
            ExprKind::Call { callee, args } => {
                for f in self.call_flows(p, callee, args) {
                    let (t, r) = f;
                    if let Root::Local(l) = t {
                        out.push(pair_key(l, r));
                    }
                }
            }
            ExprKind::Match { scrut, arms } => {
                // Bindings inside arms view whatever the scrutinee views.
                let r = if self.has_view(p, p.thir.expr(scrut).ty) { self.value_roots_of_place(p, scrut) } else { [] };
                if r.len() > 0 {
                    for i in 0..arms.len() {
                        let a = p.thir.arms.list(arms)[i];
                        let mut binds: [LocalId; ..+] = [];
                        pat_bindings(&p.thir, a.pat, &mut binds);
                        for l in binds {
                            if self.has_view(p, self.local(p, l).ty) {
                                for x in r[..] {
                                    out.push(pair_key(l, x));
                                }
                            }
                        }
                    }
                }
            }
            _ => {}
        }
        match kind {
            ExprKind::Block(b) => self.collect_assigns_block(p, b, out),
            ExprKind::Loop { body, .. } => self.collect_assigns_block(p, body, out),
            ExprKind::While { body, cond, .. } => {
                self.collect_assigns(p, cond, out);
                self.collect_assigns_block(p, body, out);
            }
            ExprKind::ForRange { body, .. } => self.collect_assigns_block(p, body, out),
            ExprKind::ForArray { body, .. } => self.collect_assigns_block(p, body, out),
            _ => {
                let mut kids: [Id::<Expr>; ..+] = [];
                visit_children(&p.thir, e, &mut kids);
                for c in kids {
                    self.collect_assigns(p, c, out);
                }
            }
        }
    }

    // ===================================================================== view checks

    fn root_name(&self, p: &Program, r: Root): String {
        let mut s = String::new();
        match r {
            Root::Local(l) => s.write("`{p.text(self.local(p, l).name)}`"),
            Root::Slot(l) => s.write("`{p.text(self.local(p, l).name)}`"),
            Root::Arg(l) => s.write("what `{p.text(self.local(p, l).name)}` points into"),
            Root::Temp => s.push_str("a temporary value"),
        }
        return s;
    }

    /// Storing a view with `roots` into local `dest`.
    fn check_store(&mut self, p: &mut +Program, dest: LocalId, roots: [Root; &], span: Span) {
        let dl = self.local(p, dest);
        let dd = dl.depth;
        let dname = p.text(dl.name);
        for r in roots {
            match r {
                Root::Temp => {
                    if !self.report(span, 4294967295) {
                        continue;
                    }
                    let m = say(p, "`{dname}` would point into a temporary value that is freed at the end of this statement");
                    p.diags.error(codes::borrow::OUTLIVES_ROOT(), span, m);
                    p.diags.help(say(p, "bind the value to a variable first so it lives long enough"));
                    p.diags.finish();
                }
                Root::Local(l) => self.check_store_root(p, l, dd, dname, span),
                Root::Slot(l) => self.check_store_root(p, l, dd, dname, span),
                // The caller's data outlives every local.
                Root::Arg(_) => {}
            }
        }
    }

    /// `check_store` of root local `l` into a local at depth `dd` named
    /// `dname`.
    fn check_store_root(&mut self, p: &mut +Program, l: LocalId, dd: u32, dname: str, span: Span) {
        let rl = self.local(p, l);
        let is_param = match rl.kind {
            LocalKind::Param { .. } => true,
            _ => false,
        };
        if rl.depth > dd && !is_param {
            if !self.report(span, l.index) {
                return;
            }
            let rn = p.text(rl.name);
            let m = say(p, "`{rn}` does not live long enough");
            p.diags.error(codes::borrow::OUTLIVES_ROOT(), span, m);
            p.diags.label(say(p, "`{dname}` would keep pointing into `{rn}` after `{rn}` goes out of scope"));
            p.diags.secondary(rl.span, say(p, "`{rn}` is declared in an inner scope here"));
            p.diags.finish();
        }
    }

    /// A value leaving the function (return / tail).
    fn check_escape(&mut self, p: &mut +Program, v: Id::<Expr>, span: Span) {
        let roots = self.value_roots(p, v);
        let vt = p.thir.expr(v).ty;
        let no_closure = !p.types.any(vt, &|k| match k {
            TyKind::Closure(..) | TyKind::Param(..) | TyKind::Opaque(..) | TyKind::Proj(..) => true,
            _ => false,
        });
        for r in roots {
            let ok = match r {
                Root::Local(l) => match self.local(p, l).kind {
                    // A view into a borrowed (or in-out) owner points into the
                    // caller's value; an owned parameter is freed on return.
                    LocalKind::Param { owned, .. } => !owned,
                    _ => false,
                },
                Root::Arg(_) => true,
                // A `dyn` of a borrowed parameter points at the caller's
                // value.
                Root::Slot(l) => no_closure && self.is_borrowed_param(p, l),
                Root::Temp => false,
            };
            if ok {
                continue;
            }
            if let Root::Slot(l) = r {
                if no_closure && self.report(span, 7) {
                    let n = p.text(self.local(p, l).name);
                    let m = say(p, "cannot return a view of `{n}`, which is freed when the function returns");
                    p.diags.error(codes::borrow::ESCAPES_FUNCTION(), span, m);
                    p.diags.help(say(p, "view a value the caller lent instead (a parameter `{n}: &T`), or return the value itself"));
                    p.diags.finish();
                    continue;
                }
                if self.report(span, 7) {
                    let n = p.text(self.local(p, l).name);
                    let m = say(p, "cannot return a closure that borrows `{n}`, which is freed when the function returns");
                    p.diags.error(codes::borrow::ESCAPES_FUNCTION(), span, m);
                    p.diags.help(say(p, "make it a `move` closure, so it takes `{n}` with it"));
                    p.diags.finish();
                    continue;
                }
            }
            if !ok && self.report(span, 7) {
                let n = self.root_name(p, r);
                let m = say(p, "cannot return a view of {n}, which is freed when the function returns");
                p.diags.error(codes::borrow::ESCAPES_FUNCTION(), span, m);
                if let Root::Local(l) = r {
                    let local = self.local(p, l);
                    if let LocalKind::Param { owned, .. } = local.kind {
                        if owned && p.has_owner(local.ty) {
                            p.diags.note(say(p, "this function takes ownership of {n}, so it is freed when the function returns"));
                            p.diags.help(say(p, "borrow the parameter instead (`: &T`), or return the owner itself"));
                        } else {
                            p.diags.note(say(p, "{n} has a Dull type, so it is passed as a copy owned by this function"));
                            p.diags.help(say(p, "take a slice parameter or an in-out parameter (`: &mut T`) instead"));
                        }
                    }
                }
                p.diags.finish();
            }
        }
        self.check_from(p, v);
    }

    /// For a named function, what its signature says its result points
    /// into, and what its returned values do.
    fn declared_from(&self, p: &mut +Program): Option::<FromCheck> {
        let Some(declared) = p.ret_from.get(self.body.def) else { return None; };
        let mut wanted = declared.set;
        let roots = self.returned_roots(p);
        for r in roots {
            if let Some((i, _)) = self.returned_param(p, r) {
                if i < 64 {
                    wanted = wanted | (1u64 << i as u64);
                }
            }
        }
        return Some(FromCheck { declared, wanted });
    }

    /// The parameter (index and local) a returned value with root `r`
    /// points into: a borrowed parameter's own data, or where a
    /// parameter's views point.
    fn returned_param(&self, p: &Program, r: Root): Option::<(u32, LocalId)> {
        let (l, arg) = match r {
            Root::Local(x) => (x, false),
            Root::Arg(x) => (x, true),
            // A `dyn` of a borrowed parameter.
            Root::Slot(x) => (x, false),
            Root::Temp => return None,
        };
        if let LocalKind::Param { index, owned, .. } = self.local(p, l).kind {
            if !owned || arg {
                return Some((index, l));
            }
        }
        return None;
    }

    /// A value `v` leaving a named function may only point into the
    /// parameters its signature names (`from`). Reported at the branch of
    /// an `if` or `match` (or the tail of a block) that returns it.
    fn check_from(&mut self, p: &mut +Program, v: Id::<Expr>) {
        let Some(fc) = self.from else { return; };
        match p.thir.expr(v).kind {
            ExprKind::Block(b) => {
                if let Some(t) = p.thir.block(b).tail {
                    self.check_from(p, t);
                }
            }
            ExprKind::If { then, else_, .. } => {
                self.check_from(p, then);
                if let Some(x) = else_ {
                    self.check_from(p, x);
                }
            }
            ExprKind::Match { arms, .. } => {
                for i in 0..arms.len() {
                    let a = p.thir.arms.list(arms)[i];
                    self.check_from(p, a.body);
                }
            }
            _ => {
                let span = p.thir.expr(v).span;
                let roots = self.value_roots(p, v);
                for r in roots {
                    let Some((i, l)) = self.returned_param(p, r) else { continue; };
                    if i >= 64 || (fc.declared.set >> i as u64) & 1 == 1 {
                        continue;
                    }
                    if !self.report(span, 10) {
                        return;
                    }
                    let def = self.body.def;
                    let fname = p.text(p.defs[def.index()].name);
                    let n = p.text(self.local(p, l).name);
                    let m = say(p, "`{fname}` returns a view from `{n}`, but its signature does not say so");
                    p.diags.error(codes::borrow::ESCAPES_VIA_RETURN(), span, m);
                    let sig = p.fn_data(def).sig;
                    let ps = p.params.list(sig.params);
                    let self_first = ps.len() > 0 && ps[0].is_self;
                    let names = from_names(p, def, fc.declared.set);
                    let only = quoted_list(names[..]);
                    if !is_dummy(fc.declared.span) && fc.declared.set == 0 {
                        let t = say(p, "the result is declared to point into no parameter");
                        p.diags.secondary(fc.declared.span, t);
                    } else if !is_dummy(fc.declared.span) {
                        let t = say(p, "the result is declared to point only into {only}");
                        p.diags.secondary(fc.declared.span, t);
                    } else if self_first && fc.declared.set == 1 {
                        let t = say(p, "without a `from` clause, a method's result points only into `self`");
                        p.diags.secondary(sig.ret_span, t);
                    } else if fc.declared.set == 0 {
                        let t = say(p, "without a `from` clause, the result points into no parameter");
                        p.diags.secondary(sig.ret_span, t);
                    } else {
                        let t = say(p, "without a `from` clause, the result points only into {only}");
                        p.diags.secondary(sig.ret_span, t);
                    }
                    let wanted = from_names(p, def, fc.wanted);
                    let mut w = String::new();
                    for j in 0..wanted.len() {
                        if j > 0 {
                            w.push_str(", ");
                        }
                        w.push_str(wanted[j]);
                    }
                    p.diags.help(say(p, "say every parameter the result may point into: `from {w}`"));
                    if !is_dummy(fc.declared.span) {
                        p.diags.suggest(fc.declared.span, say(p, "{w}"), say(p, "Declare `from {w}`"));
                    } else if !is_dummy(sig.ret_span) {
                        p.diags.suggest(Span::new(sig.ret_span.hi, sig.ret_span.hi), say(p, " from {w}"), say(p, "Declare `from {w}`"));
                    }
                    p.diags.finish();
                    return;
                }
            }
        }
    }

    fn check_views_block(&mut self, p: &mut +Program, b: Id::<Block>) {
        let blk = p.thir.block(b);
        for i in 0..blk.stmts.len() {
            match p.thir.stmts.list(blk.stmts)[i] {
                Stmt::Let { pat, init: Some(init), .. } => {
                    self.check_views(p, init);
                    let ie = p.thir.expr(init);
                    if self.has_view(p, ie.ty) {
                        let roots = self.value_roots(p, init);
                        let mut binds: [LocalId; ..+] = [];
                        pat_bindings(&p.thir, pat, &mut binds);
                        for l in binds {
                            self.check_store(p, l, roots[..], ie.span);
                        }
                    }
                }
                Stmt::Let { .. } => {}
                Stmt::Expr(e) => self.check_views(p, e),
            }
        }
        if let Some(t) = blk.tail {
            self.check_views(p, t);
        }
    }

    fn check_children(&mut self, p: &mut +Program, e: Id::<Expr>) {
        let mut kids: [Id::<Expr>; ..+] = [];
        visit_children(&p.thir, e, &mut kids);
        for c in kids {
            self.check_views(p, c);
        }
    }

    fn check_views(&mut self, p: &mut +Program, e: Id::<Expr>) {
        let ex = p.thir.expr(e);
        match ex.kind {
            ExprKind::Assign { place, value } => {
                self.check_views(p, place);
                self.check_views(p, value);
                let ve = p.thir.expr(value);
                if self.has_view(p, ve.ty) {
                    let roots = self.value_roots(p, value);
                    let is_static = match p.thir.expr(place).kind {
                        ExprKind::Static(_) => true,
                        _ => false,
                    };
                    if is_static {
                        if roots.len() > 0 {
                            let m = say(p, "cannot store a view of a local value into a static");
                            p.diags.error(codes::borrow::ESCAPES_FUNCTION(), ve.span, m);
                            p.diags.finish();
                        }
                    } else {
                        let dyn_mut = self.may_hold_dyn_mut(p, ve.ty, 0);
                        for t in self.write_targets(p, place, false) {
                            if dyn_mut {
                                if let Some(l) = local_or_arg(t) {
                                    self.check_views_itself(p, roots[..], l, ve.span);
                                }
                            }
                            let mut r: Roots = [];
                            for x in roots[..] {
                                let same = match (local_or_arg(x), local_or_arg(t)) {
                                    (Some(a), Some(b)) => a == b,
                                    _ => false,
                                };
                                if !same {
                                    r.push(x);
                                }
                            }
                            self.check_store_into(p, t, r[..], ve.span);
                        }
                    }
                }
            }
            ExprKind::Call { callee, args } => {
                self.check_children(p, e);
                // A `dyn mut` handed to a call that may keep it, in a value
                // it views and the call changes.
                let kept = self.callee_kept(p, callee);
                for i in 0..args.len() {
                    let a = p.thir.args.list(args)[i];
                    if let Some(ps) = kept {
                        if i < ps.len() && !p.params.list(ps)[i].kept {
                            continue;
                        }
                    }
                    let at = p.thir.expr(a.expr()).ty;
                    if !self.may_hold_dyn_mut(p, at, 0) {
                        continue;
                    }
                    let ar = match a {
                        Arg::InOut(x) => self.value_roots_of_place(p, x),
                        Arg::Value(v) => self.arg_roots(p, v),
                    };
                    for j in 0..args.len() {
                        if j == i {
                            continue;
                        }
                        let mut into: [LocalId; ..+] = [];
                        match p.thir.args.list(args)[j] {
                            Arg::InOut(x) => {
                                if let Some(Root::Local(l)) = self.place_root(p, x) {
                                    into.push(l);
                                }
                            }
                            Arg::Value(v) => {
                                if self.may_hold_dyn_mut(p, p.thir.expr(v).ty, 0) {
                                    for r in self.arg_roots(p, v) {
                                        match r {
                                            Root::Slot(l) => into.push(l),
                                            Root::Local(l) => into.push(l),
                                            _ => {}
                                        }
                                    }
                                }
                            }
                        }
                        for l in into {
                            self.check_views_itself(p, ar[..], l, ex.span);
                        }
                    }
                }
                let flows = self.call_flows(p, callee, args);
                let mut i: usize = 0;
                while i < flows.len() {
                    let (t, _) = flows[i];
                    let mut roots: Roots = [];
                    while i < flows.len() && flows[i].0 == t {
                        roots_insert(&mut roots, flows[i].1);
                        i += 1;
                    }
                    self.check_store_into(p, t, roots[..], ex.span);
                }
            }
            ExprKind::Return(Some(v)) => {
                self.check_views(p, v);
                self.check_escape(p, v, p.thir.expr(v).span);
            }
            ExprKind::Block(b) => self.check_views_block(p, b),
            ExprKind::Loop { body, .. } => self.check_views_block(p, body),
            ExprKind::While { cond, body, .. } => {
                self.check_views(p, cond);
                self.check_views_block(p, body);
            }
            ExprKind::ForRange { start, end, body, .. } => {
                self.check_views(p, start);
                self.check_views(p, end);
                self.check_views_block(p, body);
            }
            ExprKind::ForArray { array, body, .. } => {
                self.check_views(p, array);
                self.check_views_block(p, body);
            }
            _ => self.check_children(p, e),
        }
    }

    fn place_through_view(&self, p: &Program, place: Id::<Expr>): bool {
        let Some(base) = proj_base(p.thir.expr(place).kind) else { return false; };
        return self.is_view_container(p, p.thir.expr(base).ty) || self.place_through_view(p, base);
    }

    // ===================================================================== liveness & invalidation

    /// The empty set of locals.
    fn ls_new(&self): LiveSet {
        return [0u64; self.words];
    }

    /// Keep `s` at `at` in `saved_sets` (or at a new place); where it is.
    fn store_set(&mut self, at: Option::<usize>, s: [u64; &]): usize {
        return match at {
            Some(o) => {
                for i in 0..self.words {
                    self.saved_sets[o + i] = s[i];
                }
                o
            }
            None => {
                let o = self.saved_sets.len();
                self.saved_sets.extend(s);
                o
            }
        };
    }

    /// The set kept at `at`, or the empty set.
    fn load_set(&self, at: Option::<usize>): LiveSet {
        return match at {
            Some(o) => self.saved_sets[o..o + self.words].to_grow(),
            None => self.ls_new(),
        };
    }

    fn set_loop_exit(&mut self, id: LoopId, s: [u64; &]) {
        let o = self.store_set(self.loop_exit.get(id), s);
        self.loop_exit.insert(id, o);
    }

    fn set_loop_head(&mut self, id: LoopId, s: [u64; &]) {
        let o = self.store_set(self.loop_head.get(id), s);
        self.loop_head.insert(id, o);
    }

    fn live_block(&mut self, p: &mut +Program, b: Id::<Block>, after: LiveSet): LiveSet {
        let blk = p.thir.block(b);
        let mut live = after;
        if let Some(t) = blk.tail {
            live = self.live(p, t, live);
        }
        let mut i = blk.stmts.len();
        while i > 0 {
            i -= 1;
            match p.thir.stmts.list(blk.stmts)[i] {
                Stmt::Let { pat, init, .. } => {
                    let mut binds: [LocalId; ..+] = [];
                    pat_bindings(&p.thir, pat, &mut binds);
                    for l in binds {
                        ls_remove(&mut live, l);
                    }
                    if let Some(x) = init {
                        live = self.live(p, x, live);
                    }
                }
                Stmt::Expr(e) => {
                    live = self.live(p, e, live);
                }
            }
        }
        return live;
    }

    fn use_place(&mut self, p: &mut +Program, place: Id::<Expr>, live: LiveSet): LiveSet {
        let mut live = live;
        return match p.thir.expr(place).kind {
            ExprKind::Local(l) => {
                ls_insert(&mut live, l);
                live
            }
            ExprKind::Field { base, .. } => self.use_place(p, base, live),
            ExprKind::Index { base, index } => {
                let live = self.live(p, index, live);
                self.use_place(p, base, live)
            }
            ExprKind::Deref(x) => self.live(p, x, live),
            ExprKind::Temp(inner) => self.live(p, inner, live),
            _ => live,
        };
    }

    /// Remove the locals pattern `pat` binds from `live`: they are given
    /// new values where it matches.
    fn kill_bindings(&self, p: &Program, pat: Id::<Pat>, live: &mut LiveSet) {
        let mut binds: [LocalId; ..+] = [];
        pat_bindings(&p.thir, pat, &mut binds);
        for l in binds {
            ls_remove(live, l);
        }
    }

    /// Report views of `root` that are live after an invalidating event.
    fn invalidate(&mut self, p: &mut +Program, root: LocalId, live_after: [u64; &], span: Span, what: str) {
        let rname = p.text(self.local(p, root).name);
        // A closure borrowing the variable itself only minds it being moved:
        // replacing or shrinking it changes what the closure sees.
        let mut violators: [LocalId; ..+] = [];
        for i in 0..self.body.locals.len() {
            let x = LocalId::new(i);
            if x == root || !ls_contains(live_after, x) {
                continue;
            }
            if self.local_has_root(x, Root::Local(root)) || (what == "move" && self.local_has_root(x, Root::Slot(root))) {
                violators.push(x);
            }
        }
        for v in violators {
            if !self.report(span, v.index) {
                continue;
            }
            let vl = self.local(p, v);
            let vn = p.text(vl.name);
            let help = if what == "shrink" {
                say(p, "finish using `{vn}` before this point, or take a new slice afterwards; if this call only grows `{rname}`, declare that parameter `&mut +`")
            } else {
                say(p, "finish using `{vn}` before this point, or take a new slice afterwards")
            };
            let code = if what == "shrink" {
                codes::borrow::SHRINK_WHILE_BORROWED()
            } else if what == "move" {
                codes::borrow::MOVE_WHILE_BORROWED()
            } else {
                codes::borrow::ASSIGN_WHILE_BORROWED()
            };
            let verb = if what == "shrink" { "may be shrunk or replaced" } else if what == "move" { "is moved" } else { "is replaced" };
            let m = say(p, "`{rname}` {verb} here while `{vn}` still points into it");
            p.diags.error(code, span, m);
            p.diags.secondary(vl.span, say(p, "`{vn}` borrows from `{rname}` and is used later"));
            if let Some(c) = self.returned_into(p, v, root) {
                let (arg, callee) = c;
                let cn = p.text(callee);
                p.diags.secondary(arg, say(p, "the value returned by `{cn}` points into `{rname}`"));
            }
            p.diags.help(help);
            p.diags.finish();
        }
        let held_conflict = roots_contains(self.held[..], Root::Local(root));
        if held_conflict && what == "shrink" && self.report(span, 4294967294) {
            let m = say(p, "`{rname}` may be shrunk or replaced here while another argument of this call points into it");
            p.diags.error(codes::borrow::SHRINK_WHILE_BORROWED(), span, m);
            p.diags.finish();
        }
    }

    /// `place` (an owner) is about to be lent where it may be shrunk or
    /// replaced (`what`): its root local, to invalidate. A `&mut +`
    /// parameter may only grow, so that is an error.
    fn may_shrink(&mut self, p: &mut +Program, place: Id::<Expr>, span: Span, what: str): Option::<LocalId> {
        let Some(Root::Local(root)) = self.place_root(p, place) else { return None; };
        if self.place_through_view(p, place) {
            return None;
        }
        self.check_grow_only(p, root, span, what);
        return Some(root);
    }

    /// Report shrinking or replacing (`what`) local `l` if it is a `&mut +`
    /// parameter.
    fn check_grow_only(&mut self, p: &mut +Program, l: LocalId, span: Span, what: str) {
        let local = self.local(p, l);
        let grow = match local.kind {
            LocalKind::Param { grow, .. } => grow,
            _ => false,
        };
        if grow && self.report(span, 1u32 << 29) {
            let n = p.text(local.name);
            let m = say(p, "`{n}` may only grow, but {what}");
            p.diags.error(codes::borrow::GROW_ONLY(), span, m);
            p.diags.secondary(local.span, say(p, "`{n}` is declared `&mut +`, so callers keep their views into it across the call"));
            p.diags.help(say(p, "only grow `{n}` (with `&mut +` methods such as `push`), or drop the `+` so it may be shrunk"));
            p.diags.finish();
        }
    }

    /// The parameter types of what is called, when known.
    fn callee_params(&self, p: &mut +Program, c: Callee): Option::<TyList> {
        return match c {
            Callee::Fn { def, .. } => Some(param_tys(p, def)),
            Callee::Intrinsic { def, .. } => Some(param_tys(p, def)),
            Callee::Trait { trait_ref, method, .. } => match trait_method(p, trait_ref.trait_id, method) {
                Some(m) => Some(param_tys(p, m)),
                None => None,
            },
            Callee::Indirect(f) => match p.types.kind(p.thir.expr(f).ty) {
                TyKind::FnPtr(ps, _, _) => Some(ps),
                _ => None,
            },
            Callee::Value { .. } => None,
        };
    }

    /// Whether a value of type `t` may hold a closure that changes what it
    /// captured when called (conservatively yes, unless it is known to be
    /// an `Fn` closure or cannot hold a closure at all).
    fn may_change_captures(&self, p: &mut +Program, t: Ty): bool {
        return match p.types.kind(t) {
            TyKind::Closure(d, _) => match p.closures.get(d) {
                Some(c) => c.kind != ClosureKind::Fn || self.may_hold_dyn_mut(p, t, 0),
                None => true,
            },
            _ => self.may_hold_closure(p, t, 0),
        };
    }

    /// Whether argument `i` of a call through `callee` is the receiver of
    /// a method called through a `dyn`'s vtable that only reads (`&self`)
    /// or grows (`&mut +self`) the value viewed.
    fn dyn_call_keeps(&self, p: &mut +Program, callee: Callee, i: usize): bool {
        if i != 0 {
            return false;
        }
        let Callee::Trait { trait_ref, self_ty, method, .. } = callee else { return false; };
        let TyKind::Dyn(..) = p.types.kind(self_ty) else { return false; };
        let Some(m) = p.trait_method_def(trait_ref.trait_id, method) else { return false; };
        if !p.dyn_dispatchable(m) {
            return false;
        }
        return !p.method_takes_inout_self(m) || p.method_takes_grow_self(m);
    }

    /// A call may shrink or replace, through a `dyn mut` with roots
    /// `roots`, the owners it views.
    fn invalidate_dyn_mut(&mut self, p: &mut +Program, roots: [Root; &], after: [u64; &], span: Span) {
        for l in self.dyn_mut_owners(p, roots) {
            self.check_grow_only(p, l, span, "a method called through a `dyn mut` that views it may shrink or replace it");
            self.invalidate(p, l, after, span, "shrink");
        }
    }

    /// Calling (or handing on) a closure whose roots are `roots` may shrink
    /// or replace the owners it borrowed in-out.
    fn invalidate_captures(&mut self, p: &mut +Program, roots: [Root; &], after: [u64; &], span: Span) {
        let mut slots: [LocalId; ..+] = [];
        for r in roots {
            if let Root::Slot(l) = r {
                if p.has_owner(self.local(p, l).ty) {
                    slots.push(l);
                }
            }
        }
        for l in slots {
            self.check_grow_only(p, l, span, "a closure that may shrink or replace it is called here");
            self.invalidate(p, l, after, span, "shrink");
        }
    }

    fn live(&mut self, p: &mut +Program, e: Id::<Expr>, after: LiveSet): LiveSet {
        let ex = p.thir.expr(e);
        return match ex.kind {
            ExprKind::Local(_) => self.use_place(p, e, after),
            ExprKind::Field { .. } => self.use_place(p, e, after),
            ExprKind::Index { .. } => self.use_place(p, e, after),
            ExprKind::Deref(_) => self.use_place(p, e, after),
            ExprKind::Temp(_) => self.use_place(p, e, after),
            ExprKind::Static(_) => self.use_place(p, e, after),
            ExprKind::Read { place, mode } => {
                if mode == ReadMode::Move && p.has_owner(p.thir.expr(place).ty) {
                    if let Some(Root::Local(r)) = self.place_root(p, place) {
                        self.invalidate(p, r, after[..], ex.span, "move");
                    }
                }
                self.use_place(p, place, after)
            }
            ExprKind::Continue { id } => self.load_set(self.loop_head.get(id)),
            ExprKind::Lit(_) | ExprKind::AssocConst { .. } | ExprKind::FnRef { .. } | ExprKind::Error => after,
            ExprKind::DynConst { base, .. } => self.live(p, base, after),
            ExprKind::Call { callee, args } => self.live_call(p, ex, callee, args, after),
            ExprKind::Closure { captures, .. } => {
                let mut l = after;
                let mut i = captures.len();
                while i > 0 {
                    i -= 1;
                    l = match p.thir.args.list(captures)[i] {
                        Arg::InOut(x) => self.use_place(p, x, l),
                        Arg::Value(v) => if p.thir.is_place(v) { self.use_place(p, v, l) } else { self.live(p, v, l) },
                    };
                }
                l
            }
            ExprKind::Assign { place, value } => {
                let mut live = after.clone();
                let pe = p.thir.expr(place);
                if p.has_owner(pe.ty) {
                    if let Some(Root::Local(r)) = self.place_root(p, place) {
                        if !self.place_through_view(p, place) {
                            self.check_grow_only(p, r, ex.span, "this replaces part of it");
                            self.invalidate(p, r, after[..], ex.span, "assign");
                        }
                    }
                }
                if let ExprKind::Local(l) = pe.kind {
                    ls_remove(&mut live, l);
                } else {
                    live = self.use_place(p, place, live);
                }
                self.live(p, value, live)
            }
            ExprKind::AssignOp { place, value, .. } => {
                let live = self.use_place(p, place, after);
                self.live(p, value, live)
            }
            ExprKind::Unary(_, x) => self.live(p, x, after),
            ExprKind::Cast(x) => self.live(p, x, after),
            ExprKind::Coerce { expr, .. } => self.live(p, expr, after),
            ExprKind::Binary(_, a, b) => {
                let l = self.live(p, b, after);
                self.live(p, a, l)
            }
            ExprKind::Logical { lhs, rhs, .. } => {
                let mut l = self.live(p, rhs, after.clone());
                ls_union(&mut l, after[..]);
                self.live(p, lhs, l)
            }
            ExprKind::Tuple(es) => self.live_list(p, es, after),
            ExprKind::Array(es) => self.live_list(p, es, after),
            ExprKind::Adt { fields, .. } => {
                let mut l = after;
                let mut i = fields.len();
                while i > 0 {
                    i -= 1;
                    l = self.live(p, p.thir.field_exprs.list(fields)[i].expr, l);
                }
                l
            }
            ExprKind::ArrayRepeat { value, count } => {
                let l = self.live(p, count, after);
                self.live(p, value, l)
            }
            ExprKind::Slice { base, start, end, .. } => {
                let mut l = after;
                if let Some(x) = end {
                    l = self.live(p, x, l);
                }
                if let Some(x) = start {
                    l = self.live(p, x, l);
                }
                self.use_place(p, base, l)
            }
            ExprKind::Block(b) => self.live_block(p, b, after),
            ExprKind::If { cond, then, else_ } => {
                let mut l = self.live(p, then, after.clone());
                match else_ {
                    Some(x) => {
                        let xl = self.live(p, x, after);
                        ls_union(&mut l, xl[..]);
                    }
                    None => ls_union(&mut l, after[..]),
                }
                self.live(p, cond, l)
            }
            ExprKind::Match { scrut, arms } => {
                let mut l = self.ls_new();
                for i in 0..arms.len() {
                    let a = p.thir.arms.list(arms)[i];
                    let mut x = self.live(p, a.body, after.clone());
                    if let Some(g) = a.guard {
                        x = self.live(p, g, x);
                    }
                    // The arm's bindings get their values here, after the
                    // scrutinee: what they held before is dead (as for
                    // `let`). Otherwise a binding of `while let`, `for` or
                    // `let .. else` in a loop would look live at the call
                    // that makes its value, and around the loop.
                    self.kill_bindings(p, a.pat, &mut x);
                    ls_union(&mut l, x[..]);
                }
                self.use_place(p, scrut, l)
            }
            ExprKind::Loop { body, id } => {
                self.set_loop_exit(id, after[..]);
                let mut head = self.ls_new();
                for _ in 0..8 {
                    self.set_loop_head(id, head[..]);
                    let new = self.live_block(p, body, head.clone());
                    if ls_subset(new[..], head[..]) {
                        break;
                    }
                    ls_union(&mut head, new[..]);
                }
                head
            }
            ExprKind::While { cond, body, id } => {
                self.set_loop_exit(id, after[..]);
                let mut head = after.clone();
                for _ in 0..8 {
                    self.set_loop_head(id, head[..]);
                    let mut b = self.live_block(p, body, head.clone());
                    ls_union(&mut b, after[..]);
                    let new = self.live(p, cond, b);
                    if ls_subset(new[..], head[..]) {
                        break;
                    }
                    ls_union(&mut head, new[..]);
                }
                head
            }
            ExprKind::ForRange { start, end, body, id, .. } => {
                self.set_loop_exit(id, after[..]);
                let mut head = self.live(p, end, after.clone());
                for _ in 0..8 {
                    self.set_loop_head(id, head[..]);
                    let mut b = self.live_block(p, body, head.clone());
                    ls_union(&mut b, after[..]);
                    let new = self.live(p, end, b);
                    if ls_subset(new[..], head[..]) {
                        break;
                    }
                    ls_union(&mut head, new[..]);
                }
                self.live(p, start, head)
            }
            ExprKind::ForArray { pat, array, body, id, .. } => {
                self.set_loop_exit(id, after[..]);
                let mut head = self.use_place(p, array, after.clone());
                for _ in 0..8 {
                    self.set_loop_head(id, head[..]);
                    let mut b = self.live_block(p, body, head.clone());
                    // Each pass binds the pattern afresh.
                    self.kill_bindings(p, pat, &mut b);
                    ls_union(&mut b, after[..]);
                    let new = self.use_place(p, array, b);
                    if ls_subset(new[..], head[..]) {
                        break;
                    }
                    ls_union(&mut head, new[..]);
                }
                head
            }
            ExprKind::Break { id, value } => {
                let exit = self.load_set(self.loop_exit.get(id));
                match value {
                    Some(v) => self.live(p, v, exit),
                    None => exit,
                }
            }
            ExprKind::Return(v) => match v {
                Some(v) => {
                    let empty = self.ls_new();
                    self.live(p, v, empty)
                }
                None => self.ls_new(),
            },
            ExprKind::FmtArgs(pieces) => {
                let mut l = after;
                let mut i = pieces.len();
                while i > 0 {
                    i -= 1;
                    if let FmtPiece::Arg(x, _) = p.thir.fmt_pieces.list(pieces)[i] {
                        l = self.live(p, x, l);
                    }
                }
                l
            }
        };
    }

    /// `live` of the expressions `es`, last first.
    fn live_list(&mut self, p: &mut +Program, es: List::<Id::<Expr>>, after: LiveSet): LiveSet {
        let mut l = after;
        let mut i = es.len();
        while i > 0 {
            i -= 1;
            l = self.live(p, p.thir.expr_ids.list(es)[i], l);
        }
        return l;
    }

    /// `live` of a call `ex`.
    fn live_call(&mut self, p: &mut +Program, ex: Expr, callee: Callee, args: List::<Arg>, after: LiveSet): LiveSet {
        let params = self.callee_params(p, callee);
        // The roots of each argument, tagged with its index.
        let mut arg_roots: [(u32, Root); -..+] = [];
        for i in 0..args.len() {
            let rs = match p.thir.args.list(args)[i] {
                Arg::InOut(x) => self.borrow_roots(p, x),
                Arg::Value(v) => self.arg_roots(p, v),
            };
            for r in rs {
                arg_roots.push((i as u32, r));
            }
        }
        for i in 0..args.len() {
            let a = p.thir.args.list(args)[i];
            // Lent in-out to a parameter that is not `+`: the callee
            // may shrink or replace it.
            let grows = match params {
                Some(ps) => {
                    if i < ps.len() {
                        match p.types.kind(p.types.at(ps, i)) {
                            TyKind::Grow(_) => true,
                            _ => false,
                        }
                    } else {
                        false
                    }
                }
                None => false,
            };
            if let Arg::InOut(x) = a {
                let xe = p.thir.expr(x);
                if !grows && p.has_owner(xe.ty) {
                    if let Some(root) = self.may_shrink(p, x, xe.span, "this call may shrink or replace it") {
                        self.held.clear();
                        for ar in arg_roots[..] {
                            let (j, r) = ar;
                            if j as usize != i {
                                roots_insert(&mut self.held, r);
                            }
                        }
                        self.invalidate(p, root, after[..], xe.span, "shrink");
                        self.held.clear();
                    }
                }
            }
            // A closure that changes what it borrowed may be called
            // by the callee.
            let ty = p.thir.expr(a.expr()).ty;
            if self.may_change_captures(p, ty) {
                let mut roots: Roots = [];
                for ar in arg_roots[..] {
                    let (j, r) = ar;
                    if j as usize == i {
                        roots_insert(&mut roots, r);
                    }
                }
                self.invalidate_captures(p, roots[..], after[..], ex.span);
            }
            // So may a method called through a `dyn mut` (unless it only
            // reads or grows what the `dyn` views).
            if self.may_hold_dyn_mut(p, ty, 0) && !self.dyn_call_keeps(p, callee, i) {
                let mut roots: Roots = [];
                self.held.clear();
                for ar in arg_roots[..] {
                    let (j, r) = ar;
                    if j as usize == i {
                        roots_insert(&mut roots, r);
                    } else {
                        roots_insert(&mut self.held, r);
                    }
                }
                self.invalidate_dyn_mut(p, roots[..], after[..], ex.span);
                self.held.clear();
            }
        }
        if let Callee::Value { callee: f, kind } = callee {
            let ft = p.thir.expr(f).ty;
            let through_dyn = self.may_hold_dyn_mut(p, ft, 0);
            if kind != ClosureKind::Fn || through_dyn {
                let roots = if p.thir.is_place(f) { self.value_roots_of_place(p, f) } else { self.value_roots(p, f) };
                self.invalidate_captures(p, roots[..], after[..], ex.span);
                if through_dyn {
                    self.invalidate_dyn_mut(p, roots[..], after[..], ex.span);
                }
            }
        }
        let mut live = after;
        let mut i = args.len();
        while i > 0 {
            i -= 1;
            live = match p.thir.args.list(args)[i] {
                Arg::InOut(x) => self.use_place(p, x, live),
                Arg::Value(v) => self.live(p, v, live),
            };
        }
        match callee {
            Callee::Indirect(f) => {
                live = self.live(p, f, live);
            }
            Callee::Value { callee: f, .. } => {
                live = if p.thir.is_place(f) { self.use_place(p, f, live) } else { self.live(p, f, live) };
            }
            _ => {}
        }
        return live;
    }
}

/// The method `method` of trait `trait_id`.
fn trait_method(p: &Program, trait_id: DefId, method: Symbol): Option::<DefId> {
    let t = p.trait_data(trait_id);
    for m in p.trait_methods.list(t.methods) {
        if m.name == method {
            return Some(m.def);
        }
    }
    return None;
}

/// The parameter types of function `def`.
fn param_tys(p: &mut +Program, def: DefId): TyList {
    let mut tys: [Ty; ..+] = [];
    for q in p.fn_params(def) {
        tys.push(q.ty);
    }
    return p.types.mk_list(tys[..]);
}

/// The locals bound by pattern `pat`, onto `out`.
pub fn pat_bindings(thir: &Thir, pat: Id::<Pat>, out: &mut +[LocalId; ..+]) {
    match thir.pat(pat).kind {
        PatKind::Binding { local, sub, .. } => {
            out.push(local);
            if let Some(s) = sub {
                pat_bindings(thir, s, out);
            }
        }
        PatKind::Tuple(ps) => {
            for q in thir.pat_ids.list(ps) {
                pat_bindings(thir, q, out);
            }
        }
        // Every alternative binds the same variables.
        PatKind::Or(ps) => {
            if ps.len() > 0 {
                pat_bindings(thir, thir.pat_ids.list(ps)[0], out);
            }
        }
        PatKind::Adt { fields, .. } => {
            for f in thir.field_pats.list(fields) {
                pat_bindings(thir, f.pat, out);
            }
        }
        _ => {}
    }
}

/// Push each direct child expression of `e` onto `out`.
pub fn visit_children(thir: &Thir, e: Id::<Expr>, out: &mut +[Id::<Expr>; ..+]) {
    match thir.expr(e).kind {
        ExprKind::Local(_) | ExprKind::Static(_) | ExprKind::Lit(_) | ExprKind::AssocConst { .. } | ExprKind::FnRef { .. } | ExprKind::Continue { .. } | ExprKind::Error => {}
        ExprKind::DynConst { base, .. } => out.push(base),
        ExprKind::Field { base, .. } => out.push(base),
        ExprKind::Index { base, index } => {
            out.push(base);
            out.push(index);
        }
        ExprKind::Deref(x) => out.push(x),
        ExprKind::Temp(x) => out.push(x),
        ExprKind::Unary(_, x) => out.push(x),
        ExprKind::Cast(x) => out.push(x),
        ExprKind::Coerce { expr, .. } => out.push(expr),
        ExprKind::Read { place, .. } => out.push(place),
        ExprKind::Call { callee, args } => {
            match callee {
                Callee::Indirect(c) => out.push(c),
                Callee::Value { callee: c, .. } => out.push(c),
                _ => {}
            }
            for a in thir.args.list(args) {
                out.push(a.expr());
            }
        }
        ExprKind::Closure { captures, .. } => {
            for a in thir.args.list(captures) {
                out.push(a.expr());
            }
        }
        ExprKind::Binary(_, a, b) => {
            out.push(a);
            out.push(b);
        }
        ExprKind::Logical { lhs, rhs, .. } => {
            out.push(lhs);
            out.push(rhs);
        }
        ExprKind::Assign { place, value } => {
            out.push(place);
            out.push(value);
        }
        ExprKind::AssignOp { place, value, .. } => {
            out.push(place);
            out.push(value);
        }
        ExprKind::Tuple(es) => out.extend(thir.expr_ids.list(es)),
        ExprKind::Array(es) => out.extend(thir.expr_ids.list(es)),
        ExprKind::Adt { fields, .. } => {
            for f in thir.field_exprs.list(fields) {
                out.push(f.expr);
            }
        }
        ExprKind::ArrayRepeat { value, count } => {
            out.push(value);
            out.push(count);
        }
        ExprKind::Slice { base, start, end, .. } => {
            out.push(base);
            if let Some(x) = start {
                out.push(x);
            }
            if let Some(x) = end {
                out.push(x);
            }
        }
        ExprKind::Block(b) => visit_block(thir, b, out),
        ExprKind::Loop { body, .. } => visit_block(thir, body, out),
        ExprKind::If { cond, then, else_ } => {
            out.push(cond);
            out.push(then);
            if let Some(x) = else_ {
                out.push(x);
            }
        }
        ExprKind::Match { scrut, arms } => {
            out.push(scrut);
            for a in thir.arms.list(arms) {
                if let Some(g) = a.guard {
                    out.push(g);
                }
                out.push(a.body);
            }
        }
        ExprKind::While { cond, body, .. } => {
            out.push(cond);
            visit_block(thir, body, out);
        }
        ExprKind::ForRange { start, end, body, .. } => {
            out.push(start);
            out.push(end);
            visit_block(thir, body, out);
        }
        ExprKind::ForArray { array, body, .. } => {
            out.push(array);
            visit_block(thir, body, out);
        }
        ExprKind::Break { value, .. } => {
            if let Some(x) = value {
                out.push(x);
            }
        }
        ExprKind::Return(value) => {
            if let Some(x) = value {
                out.push(x);
            }
        }
        ExprKind::FmtArgs(pieces) => {
            for q in thir.fmt_pieces.list(pieces) {
                if let FmtPiece::Arg(x, _) = q {
                    out.push(x);
                }
            }
        }
    }
}

/// Push the expressions of block `b` (its statements' and its tail) onto
/// `out`.
pub fn visit_block(thir: &Thir, b: Id::<Block>, out: &mut +[Id::<Expr>; ..+]) {
    let blk = thir.block(b);
    for s in thir.stmts.list(blk.stmts) {
        match s {
            Stmt::Let { init: Some(i), .. } => out.push(i),
            Stmt::Let { .. } => {}
            Stmt::Expr(e) => out.push(e),
        }
    }
    if let Some(t) = blk.tail {
        out.push(t);
    }
}

// ========================================================================= moves

/// A moved place: a local and its field projections (`variant * 1000 +
/// field` each), interned in `Moves` so equal paths are equal values.
#[derive(Eq)]
struct MovePath {
    local: LocalId,
    start: u32,
    len: u32,
}

/// The paths that may have been moved at a point; not `reachable` after
/// `return`, `break` and `continue` (Rust: `None`).
#[derive(Clone)]
struct MoveState {
    reachable: bool,
    paths: [MovePath; -..+],
}

fn unreachable_state(): MoveState {
    return MoveState { reachable: false, paths: [] };
}

/// A `MoveState` kept in `Moves::saved`.
struct SavedState {
    reachable: bool,
    start: u32,
    len: u32,
}

fn unreachable_saved(): SavedState {
    return SavedState { reachable: false, start: 0, len: 0 };
}

fn join(a: &mut MoveState, b: &MoveState) {
    if !b.reachable {
        return;
    }
    if !a.reachable {
        a.reachable = true;
        a.paths = b.paths.clone();
        return;
    }
    for x in b.paths[..] {
        if !a.paths[..].contains(x) {
            a.paths.push(x);
        }
    }
}

/// What a loop body does, run by `Moves::looped`.
enum LoopBody {
    Block(Id::<Block>),
    /// A `while` loop: its body, then its condition.
    While(Id::<Block>, Id::<Expr>),
    /// A `for` loop over an array: bind its pattern, then its body.
    ForArray(Id::<Pat>, Id::<Block>),
}

struct Moves {
    /// Per loop: (state at `continue`s, state at `break`s).
    loop_states: HashMap::<LoopId, (SavedState, SavedState)>,
    saved: [MovePath; ..+],
    /// Every path, interned.
    paths: [MovePath; ..+],
    proj: [u32; ..+],
}

impl Moves {
    fn intern(&mut self, l: LocalId, projs: [u32; &]): MovePath {
        for q in self.paths[..] {
            if q.local == l && q.len as usize == projs.len() {
                let s = q.start as usize;
                if self.proj[s..s + projs.len()] == projs {
                    return q;
                }
            }
        }
        let q = MovePath { local: l, start: self.proj.len() as u32, len: projs.len() as u32 };
        self.proj.extend(projs);
        self.paths.push(q);
        return q;
    }

    /// Whether `a` is a prefix of `b`.
    fn is_prefix(&self, a: MovePath, b: MovePath): bool {
        if a.local != b.local || a.len > b.len {
            return false;
        }
        let sa = a.start as usize;
        let sb = b.start as usize;
        let n = a.len as usize;
        return self.proj[sa..sa + n] == self.proj[sb..sb + n];
    }

    fn save(&mut self, s: &MoveState): SavedState {
        let start = self.saved.len() as u32;
        self.saved.extend(s.paths[..]);
        return SavedState { reachable: s.reachable, start, len: s.paths.len() as u32 };
    }

    fn load(&self, s: SavedState): MoveState {
        let a = s.start as usize;
        return MoveState { reachable: s.reachable, paths: self.saved[a..a + s.len as usize].to_grow() };
    }

    fn path_of(&mut self, p: &Program, e: Id::<Expr>): Option::<MovePath> {
        let mut projs: [u32; -..+] = [];
        let mut cur = e;
        loop {
            match p.thir.expr(cur).kind {
                ExprKind::Local(l) => {
                    projs.reverse();
                    return Some(self.intern(l, projs[..]));
                }
                ExprKind::Field { base, field, variant } => {
                    projs.push(variant * 1000 + field);
                    cur = base;
                }
                _ => return None,
            }
        }
    }

    fn check_use(&mut self, cx: &mut Cx, p: &mut +Program, place: Id::<Expr>, st: &MoveState, span: Span) {
        if !st.reachable {
            return;
        }
        let path = match self.path_of(p, place) {
            Some(x) => x,
            None => match cx.place_root(p, place) {
                Some(Root::Local(l)) => self.intern(l, []),
                _ => return,
            },
        };
        let mut moved = false;
        for mp in st.paths[..] {
            if mp.local == path.local && (self.is_prefix(path, mp) || self.is_prefix(mp, path)) {
                moved = true;
            }
        }
        if moved && cx.report(span, 1u32 << 30) {
            let n = p.text(cx.local(p, path.local).name);
            let m = say(p, "use of moved value `{n}`");
            p.diags.error(codes::borrow::USE_AFTER_MOVE(), span, m);
            p.diags.note(say(p, "`{n}` owns its data, so binding, assigning, returning or passing it to a parameter that takes ownership moves it"));
            p.diags.help(say(p, "move it only once, or `.clone()` it before moving"));
            p.diags.finish();
        }
    }

    fn read(&mut self, cx: &mut Cx, p: &mut +Program, place: Id::<Expr>, mode: ReadMode, st: &mut MoveState, span: Span) {
        self.place_inner(cx, p, place, st);
        self.read_evaluated(cx, p, place, mode, st, span);
    }

    /// `read`, for a place whose inner expressions (indexes, temporaries)
    /// were already evaluated: a match moving out of its scrutinee must not
    /// evaluate `take(o)` in `take(o)?` a second time.
    fn read_evaluated(&mut self, cx: &mut Cx, p: &mut +Program, place: Id::<Expr>, mode: ReadMode, st: &mut MoveState, span: Span) {
        self.check_use(cx, p, place, st, span);
        if mode != ReadMode::Move {
            return;
        }
        match cx.place_root(p, place) {
            Some(Root::Local(l)) => {
                let local = cx.local(p, l);
                if let LocalKind::Param { owned: false, inout, .. } = local.kind {
                    let n = p.text(local.name);
                    let borrow = if inout { "&mut " } else { "&" };
                    let mut take = String::new();
                    if n == "self" {
                        take.write("`self` rather than `{borrow}self`");
                    } else {
                        let ty = p.ty_str(p.types.strip_grow(local.ty));
                        take.write("`{n}: {ty}` rather than `{n}: {borrow}{ty}`");
                    }
                    if cx.report(span, 3u32 << 28) {
                        let m = say(p, "cannot move out of parameter `{n}`");
                        p.diags.error(codes::borrow::MOVE_OUT_OF_BORROW(), span, m);
                        p.diags.note(say(p, "this parameter is borrowed from the caller, so its owned data cannot be taken"));
                        p.diags.help(say(p, "take ownership instead ({take}), or use `.clone()` to make an owned copy"));
                        p.diags.finish();
                    }
                    return;
                }
                let is_index = match p.thir.expr(place).kind {
                    ExprKind::Index { .. } => true,
                    _ => false,
                };
                if cx.place_through_view(p, place) || is_index {
                    if cx.report(span, 5u32 << 27) {
                        let m = say(p, "cannot move an owned value out of an array element");
                        p.diags.error(codes::borrow::MOVE_OUT_OF_BORROW(), span, m);
                        p.diags.finish();
                    }
                } else if st.reachable {
                    if let Some(q) = self.path_of(p, place) {
                        if !st.paths[..].contains(q) {
                            st.paths.push(q);
                        }
                    }
                }
            }
            Some(_) => {}
            None => {
                if cx.report(span, 6u32 << 27) {
                    let m = say(p, "cannot move an owned value out of a static or through a pointer");
                    p.diags.error(codes::borrow::MOVE_OUT_OF_BORROW(), span, m);
                    p.diags.finish();
                }
            }
        }
    }

    /// Visit sub-expressions inside a place (index expressions, temps).
    fn place_inner(&mut self, cx: &mut Cx, p: &mut +Program, place: Id::<Expr>, st: &mut MoveState) {
        match p.thir.expr(place).kind {
            ExprKind::Field { base, .. } => self.place_inner(cx, p, base, st),
            ExprKind::Index { base, index } => {
                self.place_inner(cx, p, base, st);
                self.expr(cx, p, index, st);
            }
            ExprKind::Deref(x) => self.expr(cx, p, x, st),
            ExprKind::Temp(inner) => self.expr(cx, p, inner, st),
            _ => {}
        }
    }

    /// Variables bound by `pat` are freshly initialized (in a loop, the
    /// previous iteration may have moved them).
    fn bind(&mut self, p: &Program, pat: Id::<Pat>, st: &mut MoveState) {
        if !st.reachable {
            return;
        }
        let mut binds: [LocalId; ..+] = [];
        pat_bindings(&p.thir, pat, &mut binds);
        let mut keep: [MovePath; -..+] = [];
        for q in st.paths[..] {
            if !binds[..].contains(q.local) {
                keep.push(q);
            }
        }
        st.paths = keep;
    }

    fn block(&mut self, cx: &mut Cx, p: &mut +Program, b: Id::<Block>, st: &mut MoveState) {
        let blk = p.thir.block(b);
        for i in 0..blk.stmts.len() {
            match p.thir.stmts.list(blk.stmts)[i] {
                Stmt::Let { pat, init, .. } => {
                    if let Some(x) = init {
                        self.expr(cx, p, x, st);
                    }
                    self.bind(p, pat, st);
                }
                Stmt::Expr(e) => self.expr(cx, p, e, st),
            }
        }
        if let Some(t) = blk.tail {
            self.expr(cx, p, t, st);
        }
    }

    fn pat_moves(&mut self, cx: &mut Cx, p: &mut +Program, scrut: Id::<Expr>, pat: Id::<Pat>, st: &mut MoveState) {
        if pat_has_move(&p.thir, pat) {
            // The scrutinee was evaluated before the arms.
            self.read_evaluated(cx, p, scrut, ReadMode::Move, st, p.thir.pat(pat).span);
        }
    }

    fn exprs(&mut self, cx: &mut Cx, p: &mut +Program, es: List::<Id::<Expr>>, st: &mut MoveState) {
        for i in 0..es.len() {
            self.expr(cx, p, p.thir.expr_ids.list(es)[i], st);
        }
    }

    fn expr(&mut self, cx: &mut Cx, p: &mut +Program, e: Id::<Expr>, st: &mut MoveState) {
        let ex = p.thir.expr(e);
        match ex.kind {
            ExprKind::Read { place, mode } => self.read(cx, p, place, mode, st, ex.span),
            ExprKind::Local(_) | ExprKind::Field { .. } | ExprKind::Index { .. } | ExprKind::Deref(_) | ExprKind::Temp(_) | ExprKind::Static(_) => {
                self.place_inner(cx, p, e, st);
                self.check_use(cx, p, e, st, ex.span);
            }
            ExprKind::Call { callee, args } => {
                match callee {
                    Callee::Indirect(f) => self.expr(cx, p, f, st),
                    Callee::Value { callee: f, .. } => self.expr(cx, p, f, st),
                    _ => {}
                }
                for i in 0..args.len() {
                    match p.thir.args.list(args)[i] {
                        Arg::Value(v) => self.expr(cx, p, v, st),
                        Arg::InOut(x) => {
                            self.place_inner(cx, p, x, st);
                            self.check_use(cx, p, x, st, p.thir.expr(x).span);
                        }
                    }
                }
            }
            ExprKind::Assign { place, value } => {
                self.expr(cx, p, value, st);
                self.place_inner(cx, p, place, st);
                if let Some(path) = self.path_of(p, place) {
                    if st.reachable {
                        let mut keep: [MovePath; -..+] = [];
                        for q in st.paths[..] {
                            if !self.is_prefix(path, q) {
                                keep.push(q);
                            }
                        }
                        st.paths = keep;
                    }
                }
            }
            ExprKind::AssignOp { place, value, .. } => {
                self.expr(cx, p, value, st);
                self.place_inner(cx, p, place, st);
                self.check_use(cx, p, place, st, p.thir.expr(place).span);
            }
            ExprKind::Slice { base, start, end, .. } => {
                self.place_inner(cx, p, base, st);
                self.check_use(cx, p, base, st, ex.span);
                if let Some(x) = start {
                    self.expr(cx, p, x, st);
                }
                if let Some(x) = end {
                    self.expr(cx, p, x, st);
                }
            }
            ExprKind::Coerce { kind: Coercion::ToSlice { .. }, expr } => {
                self.place_inner(cx, p, expr, st);
                self.check_use(cx, p, expr, st, ex.span);
            }
            ExprKind::Coerce { kind: Coercion::StringToStr, expr } => {
                self.place_inner(cx, p, expr, st);
                self.check_use(cx, p, expr, st, ex.span);
            }
            ExprKind::Coerce { kind: Coercion::ToDyn { .. }, expr } => {
                self.place_inner(cx, p, expr, st);
                self.check_use(cx, p, expr, st, ex.span);
            }
            ExprKind::Coerce { expr, .. } => self.expr(cx, p, expr, st),
            ExprKind::Unary(_, x) => self.expr(cx, p, x, st),
            ExprKind::Cast(x) => self.expr(cx, p, x, st),
            ExprKind::Binary(_, a, b) => {
                self.expr(cx, p, a, st);
                self.expr(cx, p, b, st);
            }
            ExprKind::Logical { lhs, rhs, .. } => {
                self.expr(cx, p, lhs, st);
                let mut s2 = st.clone();
                self.expr(cx, p, rhs, &mut s2);
                join(st, &s2);
            }
            ExprKind::Tuple(es) => self.exprs(cx, p, es, st),
            ExprKind::Array(es) => self.exprs(cx, p, es, st),
            ExprKind::Adt { fields, .. } => {
                for i in 0..fields.len() {
                    self.expr(cx, p, p.thir.field_exprs.list(fields)[i].expr, st);
                }
            }
            ExprKind::ArrayRepeat { value, count } => {
                self.expr(cx, p, value, st);
                self.expr(cx, p, count, st);
            }
            ExprKind::FmtArgs(pieces) => {
                for i in 0..pieces.len() {
                    if let FmtPiece::Arg(x, _) = p.thir.fmt_pieces.list(pieces)[i] {
                        self.expr(cx, p, x, st);
                    }
                }
            }
            ExprKind::If { cond, then, else_ } => {
                self.expr(cx, p, cond, st);
                let mut a = st.clone();
                self.expr(cx, p, then, &mut a);
                let mut b = st.clone();
                if let Some(x) = else_ {
                    self.expr(cx, p, x, &mut b);
                }
                st = a;
                join(st, &b);
            }
            ExprKind::Match { scrut, arms } => {
                self.place_inner(cx, p, scrut, st);
                self.check_use(cx, p, scrut, st, p.thir.expr(scrut).span);
                let mut out = unreachable_state();
                for i in 0..arms.len() {
                    let a = p.thir.arms.list(arms)[i];
                    let mut s = st.clone();
                    self.pat_moves(cx, p, scrut, a.pat, &mut s);
                    self.bind(p, a.pat, &mut s);
                    if let Some(g) = a.guard {
                        self.expr(cx, p, g, &mut s);
                    }
                    self.expr(cx, p, a.body, &mut s);
                    join(&mut out, &s);
                }
                st = out;
            }
            ExprKind::Block(b) => self.block(cx, p, b, st),
            ExprKind::Loop { body, id } => self.looped(cx, p, id, st, LoopBody::Block(body), false),
            ExprKind::While { cond, body, id } => {
                self.expr(cx, p, cond, st);
                self.looped(cx, p, id, st, LoopBody::While(body, cond), true);
            }
            ExprKind::ForRange { start, end, body, id, .. } => {
                self.expr(cx, p, start, st);
                self.expr(cx, p, end, st);
                self.looped(cx, p, id, st, LoopBody::Block(body), true);
            }
            ExprKind::ForArray { pat, array, body, id, .. } => {
                self.place_inner(cx, p, array, st);
                self.check_use(cx, p, array, st, p.thir.expr(array).span);
                self.looped(cx, p, id, st, LoopBody::ForArray(pat, body), true);
            }
            ExprKind::Break { id, value } => {
                if let Some(v) = value {
                    self.expr(cx, p, v, st);
                }
                let (cont, brk) = match self.loop_states.get(id) {
                    Some(e) => e,
                    None => (unreachable_saved(), unreachable_saved()),
                };
                let mut b = self.load(brk);
                join(&mut b, st);
                let brk = self.save(&b);
                self.loop_states.insert(id, (cont, brk));
                st.reachable = false;
                st.paths.clear();
            }
            ExprKind::Continue { id } => {
                let (cont, brk) = match self.loop_states.get(id) {
                    Some(e) => e,
                    None => (unreachable_saved(), unreachable_saved()),
                };
                let mut c = self.load(cont);
                join(&mut c, st);
                let cont = self.save(&c);
                self.loop_states.insert(id, (cont, brk));
                st.reachable = false;
                st.paths.clear();
            }
            ExprKind::Return(v) => {
                if let Some(v) = v {
                    self.expr(cx, p, v, st);
                }
                st.reachable = false;
                st.paths.clear();
            }
            ExprKind::Closure { captures, .. } => {
                for i in 0..captures.len() {
                    let a = p.thir.args.list(captures)[i];
                    let x = a.expr();
                    let by_value_expr = match a {
                        Arg::Value(v) => !p.thir.is_place(v),
                        Arg::InOut(_) => false,
                    };
                    if by_value_expr {
                        self.expr(cx, p, x, st);
                    } else {
                        self.place_inner(cx, p, x, st);
                        self.check_use(cx, p, x, st, p.thir.expr(x).span);
                    }
                }
            }
            ExprKind::Lit(_) | ExprKind::AssocConst { .. } | ExprKind::FnRef { .. } | ExprKind::Error => {}
            ExprKind::DynConst { base, .. } => self.expr(cx, p, base, st),
        }
    }

    fn run_body(&mut self, cx: &mut Cx, p: &mut +Program, body: LoopBody, s: &mut MoveState) {
        match body {
            LoopBody::Block(b) => self.block(cx, p, b, s),
            LoopBody::While(b, cond) => {
                self.block(cx, p, b, s);
                self.expr(cx, p, cond, s);
            }
            LoopBody::ForArray(pat, b) => {
                self.bind(p, pat, s);
                self.block(cx, p, b, s);
            }
        }
    }

    /// Run a loop body twice so moves in one iteration are seen by the next.
    fn looped(&mut self, cx: &mut Cx, p: &mut +Program, id: LoopId, st: &mut MoveState, body: LoopBody, may_skip: bool) {
        let mut s = st.clone();
        self.run_body(cx, p, body, &mut s);
        let mut head = st.clone();
        join(&mut head, &s);
        if let Some(e) = self.loop_states.get(id) {
            let (cont, _) = e;
            let c = self.load(cont);
            join(&mut head, &c);
        }
        let mut s2 = head.clone();
        self.run_body(cx, p, body, &mut s2);
        let breaks = match self.loop_states.remove(id) {
            Some(e) => {
                let (_, b) = e;
                self.load(b)
            }
            None => unreachable_state(),
        };
        let mut exit = if may_skip { head } else { unreachable_state() };
        if may_skip {
            join(&mut exit, &s2);
        }
        join(&mut exit, &breaks);
        st = exit;
    }
}

/// Whether `pat` binds something by move.
fn pat_has_move(thir: &Thir, pat: Id::<Pat>): bool {
    return match thir.pat(pat).kind {
        PatKind::Binding { mode, sub, .. } => {
            if mode == ReadMode::Move {
                return true;
            }
            match sub {
                Some(s) => pat_has_move(thir, s),
                None => false,
            }
        }
        PatKind::Tuple(ps) => {
            for q in thir.pat_ids.list(ps) {
                if pat_has_move(thir, q) {
                    return true;
                }
            }
            false
        }
        PatKind::Or(ps) => {
            for q in thir.pat_ids.list(ps) {
                if pat_has_move(thir, q) {
                    return true;
                }
            }
            false
        }
        PatKind::Adt { fields, .. } => {
            for f in thir.field_pats.list(fields) {
                if pat_has_move(thir, f.pat) {
                    return true;
                }
            }
            false
        }
        _ => false,
    };
}
