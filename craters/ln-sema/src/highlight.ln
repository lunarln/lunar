// Syntax highlighting of Lunar source, for the code diagnostics quote: a
// style for each byte, from `ln_lexer`'s tokens. The colors are soft
// tones of the 256-color palette, so that labels (drawn in bold, in the
// basic red, yellow and blue) stand out against them; plain identifiers
// and punctuation keep the terminal's own color, which reads on dark and
// light backgrounds alike.
//
// `classify` says what each token (and comment) is, from the lexer alone;
// the language server's semantic tokens start from it too.

use ln_ariadne::{Color, Highlighter, Style};
use ln_lexer::{Spanned, Token, lex};

/// What the lexer alone tells of a stretch of source.
#[derive(Eq, Debug)]
pub enum TokenClass {
    Plain,
    Keyword,
    /// Capitalized names, primitive types and path segments (`a` in
    /// `a::b`).
    Type,
    /// `true` and `false`.
    Bool,
    Number,
    /// String, character and byte literals.
    String,
    Comment,
    DocComment,
    /// Macro invocations (`name!`) and metavariables (`$x`).
    Macro,
    /// Attributes, `#[...]`, but for the strings in them.
    Attribute,
}

/// A classified token or comment: `start..end` of the text.
pub struct Classified {
    pub start: usize,
    pub end: usize,
    pub class: TokenClass,
}

/// The tokens and comments of `text` with what they are, in order.
pub fn classify(text: str, out: &mut +[Classified; ..+]) {
    let b = text.as_bytes();
    let (toks, _) = lex(text);
    let n = toks.len();
    let mut classes: [TokenClass; -..+] = [];
    for i in 0..n {
        let t = toks[i];
        let mut c = match t.token {
            Token::Ident => ident_class(text, toks[..], i),
            Token::SelfType => TokenClass::Type,
            Token::True | Token::False => TokenClass::Bool,
            Token::Number(_) => TokenClass::Number,
            Token::Str | Token::Char | Token::Byte => TokenClass::String,
            Token::DocComment => TokenClass::DocComment,
            Token::Bang => if i > 0 && toks[i - 1].token == Token::Ident && toks[i - 1].range.end == t.range.start && is_macro_bang(toks[..], i) { TokenClass::Macro } else { TokenClass::Plain },
            Token::Dollar => if i + 1 < n && toks[i + 1].token == Token::Ident { TokenClass::Macro } else { TokenClass::Plain },
            _ => if is_keyword(t.token) { TokenClass::Keyword } else { TokenClass::Plain },
        };
        // `$name`: the name is part of the metavariable.
        if t.token == Token::Ident && i > 0 && toks[i - 1].token == Token::Dollar && toks[i - 1].range.end == t.range.start {
            c = TokenClass::Macro;
        }
        classes.push(c);
    }
    // Attributes, `#[...]` and `#![...]`, around the strings in them.
    let mut i: usize = 0;
    while i < n {
        if toks[i].token == Token::Hash {
            let mut j = i + 1;
            if j < n && toks[j].token == Token::Bang {
                j += 1;
            }
            if j < n && toks[j].token == Token::LBracket {
                let mut depth: usize = 0;
                let mut k = j;
                while k < n {
                    let t = toks[k].token;
                    if t == Token::LBracket {
                        depth += 1;
                    } else if t == Token::RBracket {
                        depth -= 1;
                        if depth == 0 {
                            break;
                        }
                    }
                    k += 1;
                }
                let last = if k < n { k } else { n - 1 };
                for m in i..last + 1 {
                    if toks[m].token != Token::Str {
                        classes[m] = TokenClass::Attribute;
                    }
                }
                i = last;
            }
        }
        i += 1;
    }
    // In order, with the comments in the gaps between tokens (the lexer
    // skips them).
    let mut gap: usize = 0;
    for i in 0..n + 1 {
        let end = if i < n { toks[i].range.start } else { b.len() };
        comments(b, gap, end, out);
        if i < n {
            out.push(Classified { start: toks[i].range.start, end: toks[i].range.end, class: classes[i] });
            gap = toks[i].range.end;
        }
    }
}

/// The styles of each kind of token.
pub struct Palette {
    pub keyword: Style,
    /// Types (capitalized names and primitive types) and path segments.
    pub ty: Style,
    /// String, character and byte literals.
    pub string: Style,
    /// Numbers, `true` and `false`.
    pub number: Style,
    pub comment: Style,
    pub doc_comment: Style,
    /// Macro invocations (`name!`) and metavariables (`$x`).
    pub macro_name: Style,
    /// Attributes, `#[...]`.
    pub attribute: Style,
    /// Everything else.
    pub plain: Style,
}

impl Palette {
    pub fn new(): Palette {
        return Palette {
            keyword: Style::fg(Color::Fixed(176)),
            ty: Style::fg(Color::Fixed(180)),
            string: Style::fg(Color::Fixed(114)),
            number: Style::fg(Color::Fixed(173)),
            comment: Style::fg(Color::Fixed(244)).italic(),
            doc_comment: Style::fg(Color::Fixed(108)).italic(),
            macro_name: Style::fg(Color::Fixed(116)),
            attribute: Style::fg(Color::Fixed(109)),
            plain: Style::plain(),
        };
    }
}

/// Highlights Lunar source.
pub struct LunarHighlighter {
    pub palette: Palette,
}

impl LunarHighlighter {
    pub fn new(): LunarHighlighter {
        return LunarHighlighter { palette: Palette::new() };
    }
}

impl Highlighter for LunarHighlighter {
    fn highlight(&mut self, text: str, out: &mut +[Style; ..+]) {
        let p = self.palette;
        let mut styles: [Style; -..+] = [];
        for _ in 0..text.len() {
            styles.push(p.plain);
        }
        let mut cl: [Classified; ..+] = [];
        classify(text, &mut cl);
        for c in cl {
            let style = match c.class {
                TokenClass::Plain => p.plain,
                TokenClass::Keyword => p.keyword,
                TokenClass::Type => p.ty,
                TokenClass::Bool | TokenClass::Number => p.number,
                TokenClass::String => p.string,
                TokenClass::Comment => p.comment,
                TokenClass::DocComment => p.doc_comment,
                TokenClass::Macro => p.macro_name,
                TokenClass::Attribute => p.attribute,
            };
            fill(&mut styles, c.start, c.end, style);
        }
        out.extend(styles[..]);
    }
}

/// The comments in `b[start..end]`, a gap between tokens: `//` to the end
/// of the line, `/* */` (nesting) to its end or the gap's.
fn comments(b: [u8; &], start: usize, end: usize, out: &mut +[Classified; ..+]) {
    let mut i = start;
    while i + 1 < end {
        if b[i] == b'/' && b[i + 1] == b'/' {
            let mut j = i;
            while j < end && b[j] != b'\n' && b[j] != b'\r' {
                j += 1;
            }
            out.push(Classified { start: i, end: j, class: TokenClass::Comment });
            i = j;
        } else if b[i] == b'/' && b[i + 1] == b'*' {
            let mut depth: usize = 0;
            let mut j = i;
            while j < end {
                if j + 1 < end && b[j] == b'/' && b[j + 1] == b'*' {
                    depth += 1;
                    j += 2;
                } else if j + 1 < end && b[j] == b'*' && b[j + 1] == b'/' {
                    depth -= 1;
                    j += 2;
                    if depth == 0 {
                        break;
                    }
                } else {
                    j += 1;
                }
            }
            out.push(Classified { start: i, end: j, class: TokenClass::Comment });
            i = j;
        } else {
            i += 1;
        }
    }
}

fn fill(styles: &mut [Style; -..+], start: usize, end: usize, style: Style) {
    let e = if end < styles.len() { end } else { styles.len() };
    for k in start..e {
        styles[k] = style;
    }
}

/// The `!` of `name!(...)` (not of `name != x`, which lexes as `!=`).
fn is_macro_bang(toks: [Spanned; &], i: usize): bool {
    if i + 1 >= toks.len() {
        return false;
    }
    let next = toks[i + 1].token;
    return next == Token::LParen || next == Token::LBracket || next == Token::LBrace;
}

fn ident_class(text: str, toks: [Spanned; &], i: usize): TokenClass {
    let t = toks[i];
    if i + 1 < toks.len() {
        let next = toks[i + 1];
        if next.token == Token::Bang && next.range.start == t.range.end && is_macro_bang(toks, i + 1) {
            return TokenClass::Macro;
        }
        if next.token == Token::PathSep {
            return TokenClass::Type;
        }
    }
    let name = text[t.range.start..t.range.end];
    let c = name.as_bytes()[0];
    if c >= b'A' && c <= b'Z' {
        return TokenClass::Type;
    }
    if is_primitive(name) {
        return TokenClass::Type;
    }
    return TokenClass::Plain;
}

/// Whether `name` is a primitive type's.
pub fn is_primitive(name: str): bool {
    let prims = ["i8", "i16", "i32", "i64", "i128", "isize", "u8", "u16", "u32", "u64", "u128", "usize", "f32", "f64", "bool", "char", "str"];
    for q in prims {
        if q == name {
            return true;
        }
    }
    return false;
}

fn is_keyword(t: Token): bool {
    return match t {
        Token::As | Token::Break | Token::Const | Token::Continue | Token::Crater | Token::Dyn | Token::Else | Token::Enum | Token::Extern => true,
        Token::Fn | Token::For | Token::If | Token::Impl | Token::In | Token::Let | Token::Loop | Token::Macro | Token::Match => true,
        Token::Mod | Token::Move | Token::Mut | Token::Pub | Token::Return | Token::SelfValue | Token::Static | Token::Struct => true,
        Token::Super | Token::Trait | Token::Type | Token::Unsafe | Token::Use | Token::While => true,
        _ => false,
    };
}
