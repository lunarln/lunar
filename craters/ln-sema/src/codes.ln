// Every scoped diagnostic code the compiler can emit: a port of
// crates/ln-diag/src/codes.rs. Rendered as `err(scope::name)`. Each code
// is a function (`codes::ty::MISMATCH()`): constants cannot hold structs.

pub mod ty {
    use crater::diag::Code;
    fn c(name: str): Code { return Code { scope: "type", name }; }
    pub fn MISMATCH(): Code { return c("mismatch"); }
    pub fn ARRAY_OWNER_ITEMS(): Code { return c("array_owner_items"); }
    pub fn GROW_OUTSIDE_PARAM(): Code { return c("grow_outside_param"); }
    pub fn GROW_NO_OWNER(): Code { return c("grow_no_owner"); }
    pub fn GROW_WITHOUT_MUT(): Code { return c("grow_without_mut"); }
    pub fn FMTARGS_OUTSIDE_PARAM(): Code { return c("fmtargs_outside_param"); }
    pub fn ANNOTATIONS_NEEDED(): Code { return c("annotations_needed"); }
    pub fn NOT_CALLABLE(): Code { return c("not_callable"); }
    pub fn ARG_COUNT(): Code { return c("arg_count"); }
    pub fn GENERIC_COUNT(): Code { return c("generic_count"); }
    pub fn NO_FIELD(): Code { return c("no_field"); }
    pub fn NO_METHOD(): Code { return c("no_method"); }
    pub fn NOT_INDEXABLE(): Code { return c("not_indexable"); }
    pub fn BAD_OPERAND(): Code { return c("bad_operand"); }
    pub fn BAD_CAST(): Code { return c("bad_cast"); }
    pub fn UNSATISFIED_BOUND(): Code { return c("unsatisfied_bound"); }
    pub fn INFINITE_SIZE(): Code { return c("infinite_size"); }
    pub fn ARRAY_LEN(): Code { return c("array_len"); }
    pub fn NOT_A_PLACE(): Code { return c("not_a_place"); }
    pub fn IMMUTABLE(): Code { return c("immutable"); }
    pub fn MISSING_FIELD(): Code { return c("missing_field"); }
    pub fn DUPLICATE_FIELD(): Code { return c("duplicate_field"); }
    pub fn NON_EXHAUSTIVE(): Code { return c("non_exhaustive"); }
    pub fn BAD_PATTERN(): Code { return c("bad_pattern"); }
    pub fn RETURN_MISSING(): Code { return c("return_missing"); }
    pub fn BREAK_OUTSIDE_LOOP(): Code { return c("break_outside_loop"); }
    pub fn LITERAL_RANGE(): Code { return c("literal_range"); }
    pub fn NOT_ITERABLE(): Code { return c("not_iterable"); }
    pub fn FFI_TYPE(): Code { return c("ffi_type"); }
    pub fn BAD_MAIN(): Code { return c("bad_main"); }
    pub fn BAD_TEST(): Code { return c("bad_test"); }
    pub fn CONST_EVAL(): Code { return c("const_eval"); }
    pub fn VARIADIC_NOT_EXTERN(): Code { return c("variadic_not_extern"); }
    pub fn IMPL_TRAIT_POSITION(): Code { return c("impl_trait_position"); }
    pub fn OPAQUE_MISMATCH(): Code { return c("opaque_mismatch"); }
    pub fn LET_ELSE_FALLS_THROUGH(): Code { return c("let_else_falls_through"); }
    pub fn FROM_WITHOUT_VIEWS(): Code { return c("from_without_views"); }
    pub fn NOT_SEND(): Code { return c("not_send"); }
    pub fn NOT_SYNC(): Code { return c("not_sync"); }
    pub fn NOT_DETACHED(): Code { return c("not_detached"); }
}

