// Definition tables: a port of crates/ln-sema/src/defs.rs. Every item in
// every crater gets a `DefId`.
//
// Definitions live in one array (`Program::defs`), so everything in them is
// Light: lists are `List`s into the program's arenas (`Program::preds`,
// `Program::params`, ...), names are `Symbol`s. Module bindings and impl
// methods, which Rust keeps in per-definition maps, are program-wide maps
// (`Program::bindings`, `Program::impl_methods`).

use core::arena::List;
use core::intern::Symbol;
use crater::ty::{Ty, TraitRef};
use ln_ast::{Ident, ParamMode, Span};

#[derive(Eq, Hash, Debug, Ord)]
pub struct DefId {
    pub index: u32,
}

impl DefId {
    pub fn new(index: usize): DefId {
        return DefId { index: index as u32 };
    }

    pub fn index(self): usize {
        return self.index as usize;
    }
}

#[derive(Eq, Hash, Debug)]
pub enum DefKind {
    Mod,
    Fn,
    Struct,
    Enum,
    Variant,
    Trait,
    Impl,
    Const,
    Static,
    TypeAlias,
    Macro,
}

impl DefKind {
    pub fn describe(self): str {
        return match self {
            DefKind::Macro => "macro",
            DefKind::Mod => "module",
            DefKind::Fn => "function",
            DefKind::Struct => "struct",
            DefKind::Enum => "enum",
            DefKind::Variant => "enum variant",
            DefKind::Trait => "trait",
            DefKind::Impl => "impl",
            DefKind::Const => "constant",
            DefKind::Static => "static",
            DefKind::TypeAlias => "type alias",
        };
    }
}

/// A macro hygiene context: 0 is the root, code written by hand; each
/// expansion gets its own. Defined with the identifiers that carry it.
pub use ln_ast::SyntaxCtx;

/// Recognized item attributes.
pub struct ItemAttrs {
    pub lang: Option::<Symbol>,
    pub intrinsic: bool,
    pub test: bool,
    pub inline: bool,
    pub link_name: Option::<Symbol>,
    /// `#[derive(A, B)]`: derive macros to run on this struct or enum
    /// (in `Program::idents`).
    pub derive: List::<Ident>,
    /// `#[derive_macro]`: this macro is a derive.
    pub derive_macro: bool,
    /// `#[export]`: an item a macro defines is visible where it is invoked.
    pub export: bool,
}

impl ItemAttrs {
    pub fn none(): ItemAttrs {
        return ItemAttrs { lang: None, intrinsic: false, test: false, inline: false, link_name: None, derive: List::empty(), derive_macro: false, export: false };
    }
}

#[derive(Eq, Hash, Debug)]
pub enum Ns {
    Type,
    Value,
    /// Macros; a trait and its derive share a path.
    Macro,
}

/// A name bound in a module (an item or an import).
pub struct Binding {
    pub def: DefId,
    pub is_pub: bool,
    pub span: Span,
}

/// The key of `Program::bindings`: a name in one namespace of a module.
#[derive(Eq, Hash)]
pub struct BindKey {
    pub module: DefId,
    pub ns: Ns,
    pub name: Symbol,
}

/// `use path::*;` in `module`: names of `target` (a module or enum) are
/// visible there. Chained per module through `next` (index + 1, 0 = end).
pub struct Glob {
    pub module: DefId,
    pub target: DefId,
    pub is_pub: bool,
    pub next: u32,
}

pub struct ModData {
    /// Parent module (`super`); `None` for crater roots.
    pub parent: Option::<DefId>,
    /// The crater root this module belongs to.
    pub krate: DefId,
    /// Anonymous block scope inside a function body.
    pub is_block: bool,
    /// The first of this module's globs (index + 1 into `Program::globs`).
    pub first_glob: u32,
}

/// A trait bound on a type: `ty: trait_ref`.
#[derive(Eq, Hash)]
pub struct Pred {
    pub ty: Ty,
    pub trait_ref: TraitRef,
    pub span: Span,
}

pub struct Generics {
    /// Number of parameters inherited from the parent (impl or trait).
    pub parent_count: u32,
    /// Names of this item's own parameters.
    pub names: List::<Symbol>,
    /// Bounds on own parameters (parents' bounds live in the parent).
    pub preds: List::<Pred>,
    pub span: Span,
}

impl Generics {
    pub fn none(): Generics {
        return Generics { parent_count: 0, names: List::empty(), preds: List::empty(), span: Span::new(0, 0) };
    }

    pub fn count(self): usize {
        return self.parent_count as usize + self.names.len();
    }

    pub fn own_count(self): usize {
        return self.names.len();
    }
}

#[derive(Eq, Hash, Debug)]
pub enum Abi {
    Lunar,
    C,
}

pub struct Param {
    pub name: Symbol,
    /// The name's hygiene context (it may come from a macro's body).
    pub ctx: SyntaxCtx,
    pub ty: Ty,
    pub mode: ParamMode,
    /// `x: &mut T`: passed by reference (in-out). Same as `mode == InOut`.
    pub inout: bool,
    /// `mut x: T`: an owned parameter the function may change.
    pub mutable: bool,
    pub is_self: bool,
    /// `kept x: T`: views from this argument may be stored into the
    /// function's in-out arguments.
    pub kept: bool,
    pub span: Span,
}

/// Which parameters a function's result may point into, from its
/// signature: bit `i` of `set` for parameter `i` (parameters from the 64th
/// on always count). `span` covers the names of the `from` clause, and is
/// dummy when there is none and the set follows from the parameters.
pub struct RetFrom {
    pub set: u64,
    pub span: Span,
}

pub struct FnSig {
    pub params: List::<Param>,
    pub ret: Ty,
    pub ret_span: Span,
}

pub struct FnData {
    pub generics: Generics,
    pub sig: FnSig,
    pub is_unsafe: bool,
    pub abi: Abi,
    pub variadic: bool,
    pub has_body: bool,
    /// Enclosing impl or trait, for methods.
    pub owner: Option::<DefId>,
    pub has_self: bool,
}

#[derive(Eq, Hash, Debug)]
pub enum CtorKind {
    Unit,
    Tuple,
    Named,
}

pub struct FieldDef {
    pub name: Symbol,
    pub ty: Ty,
    pub is_pub: bool,
    /// The field's name (its type, for tuple fields).
    pub span: Span,
}

pub struct VariantDef {
    pub name: Symbol,
    /// The variant's own DefId (enums) or the struct's DefId.
    pub def: DefId,
    pub ctor: CtorKind,
    pub fields: List::<FieldDef>,
    pub span: Span,
}

pub struct AdtData {
    pub generics: Generics,
    pub variants: List::<VariantDef>,
    pub is_enum: bool,
}

pub struct TraitMethod {
    pub name: Symbol,
    pub def: DefId,
    pub has_default: bool,
}

pub struct TraitData {
    /// Param 0 is `Self`; the trait's own params follow.
    pub generics: Generics,
    pub supertraits: List::<TraitRef>,
    pub methods: List::<TraitMethod>,
    /// Auto traits (`Dull`, `Light`) are implemented by the compiler.
    pub auto: bool,
}

/// An impl. Its methods are in `Program::impl_methods`.
pub struct ImplData {
    pub generics: Generics,
    pub trait_ref: Option::<TraitRef>,
    pub self_ty: Ty,
    pub negative: bool,
}

/// An integer constant: Lunar has no 128-bit integers, so a magnitude and
/// a sign cover every `i64` and `u64` value.
#[derive(Eq, Hash, Debug)]
pub struct ConstInt {
    pub neg: bool,
    pub mag: u64,
}

impl ConstInt {
    pub fn of_u64(v: u64): ConstInt {
        return ConstInt { neg: false, mag: v };
    }

    pub fn of_i64(v: i64): ConstInt {
        if v < 0 {
            // `-v` would overflow for i64::MIN; the bit pattern is the
            // two's complement magnitude.
            return ConstInt { neg: true, mag: 0u64.wrapping_sub(v as u64) };
        }
        return ConstInt { neg: false, mag: v as u64 };
    }

    /// The value's bits, as stored in a 64-bit integer (two's complement).
    pub fn bits(self): u64 {
        if self.neg { 0u64.wrapping_sub(self.mag) } else { self.mag }
    }
}

/// A compile-time constant value. Nested values are in
/// `Program::consts`.
pub enum ConstVal {
    Int(ConstInt),
    Float(f64),
    Bool(bool),
    Char(char),
    Str(Symbol),
    Unit,
    Tuple(List::<ConstVal>),
    /// Struct / enum variant: (variant index, fields).
    Adt(u32, List::<ConstVal>),
    Array(List::<ConstVal>),
}

pub struct ConstData {
    pub ty: Ty,
    pub value: Option::<ConstVal>,
}

pub struct StaticData {
    pub ty: Ty,
    pub mutable: bool,
    pub value: Option::<ConstVal>,
}

pub struct AliasData {
    pub generics: Generics,
    pub ty: Option::<Ty>,
}

pub enum DefData {
    None,
    Mod(ModData),
    Fn(FnData),
    Adt(AdtData),
    Variant { enum_id: DefId, index: u32 },
    Trait(TraitData),
    Impl(ImplData),
    Const(ConstData),
    Static(StaticData),
    Alias(AliasData),
}

pub struct DefInfo {
    pub name: Symbol,
    pub kind: DefKind,
    /// Enclosing module (for privacy and name lookup).
    pub module: DefId,
    /// Enclosing impl/trait/enum for associated items and variants.
    pub parent: Option::<DefId>,
    pub is_pub: bool,
    pub span: Span,
    pub attrs: ItemAttrs,
    pub data: DefData,
}
