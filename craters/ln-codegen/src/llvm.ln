    pub fn LLVMBuildBr(b: BuilderRef, dest: BasicBlockRef): ValueRef;
    pub fn LLVMBuildCondBr(b: BuilderRef, c: ValueRef, then: BasicBlockRef, else_: BasicBlockRef): ValueRef;
    pub fn LLVMBuildSwitch(b: BuilderRef, v: ValueRef, else_: BasicBlockRef, num_cases: u32): ValueRef;
    pub fn LLVMAddCase(switch: ValueRef, on: ValueRef, dest: BasicBlockRef);
    pub fn LLVMBuildUnreachable(b: BuilderRef): ValueRef;

    // ----- arithmetic -----
    pub fn LLVMBuildAdd(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildSub(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildMul(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildUDiv(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildSDiv(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildURem(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildSRem(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildShl(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildLShr(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildAShr(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildAnd(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildOr(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildXor(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildNot(b: BuilderRef, v: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildFAdd(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildFSub(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildFMul(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildFDiv(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildFRem(b: BuilderRef, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildFNeg(b: BuilderRef, v: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildICmp(b: BuilderRef, pred: u32, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildFCmp(b: BuilderRef, pred: u32, l: ValueRef, r: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildSelect(b: BuilderRef, c: ValueRef, then: ValueRef, else_: ValueRef, name: *u8): ValueRef;

    // ----- memory -----
    pub fn LLVMBuildAlloca(b: BuilderRef, t: TypeRef, name: *u8): ValueRef;
    pub fn LLVMBuildLoad2(b: BuilderRef, t: TypeRef, p: ValueRef, name: *u8): ValueRef;
    pub fn LLVMBuildStore(b: BuilderRef, v: ValueRef, p: ValueRef): ValueRef;
    pub fn LLVMBuildGEP2(b: BuilderRef, t: TypeRef, p: ValueRef, indices: *ValueRef, n: u32, name: *u8): ValueRef;
    pub fn LLVMBuildStructGEP2(b: BuilderRef, t: TypeRef, p: ValueRef, idx: u32, name: *u8): ValueRef;
    pub fn LLVMBuildMemCpy(b: BuilderRef, dst: ValueRef, dst_align: u32, src: ValueRef, src_align: u32, size: ValueRef): ValueRef;
    pub fn LLVMBuildMemMove(b: BuilderRef, dst: ValueRef, dst_align: u32, src: ValueRef, src_align: u32, size: ValueRef): ValueRef;

    // ----- casts -----
    pub fn LLVMBuildPtrToInt(b: BuilderRef, v: ValueRef, t: TypeRef, name: *u8): ValueRef;
    pub fn LLVMBuildIntToPtr(b: BuilderRef, v: ValueRef, t: TypeRef, name: *u8): ValueRef;
    pub fn LLVMBuildIntCast2(b: BuilderRef, v: ValueRef, t: TypeRef, is_signed: i32, name: *u8): ValueRef;
    pub fn LLVMBuildSIToFP(b: BuilderRef, v: ValueRef, t: TypeRef, name: *u8): ValueRef;
    pub fn LLVMBuildUIToFP(b: BuilderRef, v: ValueRef, t: TypeRef, name: *u8): ValueRef;
    pub fn LLVMBuildFPCast(b: BuilderRef, v: ValueRef, t: TypeRef, name: *u8): ValueRef;

    // ----- aggregates, phis and calls -----
    pub fn LLVMBuildExtractValue(b: BuilderRef, agg: ValueRef, idx: u32, name: *u8): ValueRef;
    pub fn LLVMBuildInsertValue(b: BuilderRef, agg: ValueRef, v: ValueRef, idx: u32, name: *u8): ValueRef;
    pub fn LLVMBuildPhi(b: BuilderRef, t: TypeRef, name: *u8): ValueRef;
    pub fn LLVMAddIncoming(phi: ValueRef, vals: *ValueRef, blocks: *BasicBlockRef, n: u32);
    pub fn LLVMBuildCall2(b: BuilderRef, fn_ty: TypeRef, f: ValueRef, args: *ValueRef, n: u32, name: *u8): ValueRef;
}

/// The NUL-terminated literal `s` (which must end in `\0`) for C.
pub fn z(s: str): *u8 {
    let b = s.as_bytes();
    if b.len() == 0 || b[b.len() - 1] != 0 {
        panic("llvm::z: string is not NUL-terminated");
    }
    return b.as_ptr();
}

/// The empty name, for values LLVM numbers itself.
pub fn noname(): *u8 {
    return z("\0");
}

pub fn is_null(p: *mut u8): bool {
    return (p as usize) == 0;
}

pub fn null(): *mut u8 {
    return core::ptr::null_mut::<u8>();
}

/// The text of an LLVM message (`char*`), freed with `LLVMDisposeMessage`.
pub fn take_message(msg: *mut u8): String {
    if is_null(msg) {
        return String::new();
    }
    let s = unsafe { core::ffi::c_str(msg as *u8) }.to_string();
    unsafe { LLVMDisposeMessage(msg) };
    return s;
}

/// The text of an `LLVMErrorRef`, which this consumes.
pub fn take_error(e: ErrorRef): String {
    let msg = unsafe { LLVMGetErrorMessage(e) };
    let s = unsafe { core::ffi::c_str(msg as *u8) }.to_string();
    unsafe { LLVMDisposeErrorMessage(msg) };
    return s;
}
