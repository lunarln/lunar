    pub fn LLVMIsAConstantInt(v: ValueRef): ValueRef;
    pub fn LLVMConstIntGetZExtValue(v: ValueRef): u64;

    // ----- globals and functions -----
    pub fn LLVMAddGlobal(m: ModuleRef, t: TypeRef, name: *u8): ValueRef;
    pub fn LLVMSetInitializer(g: ValueRef, v: ValueRef);
    pub fn LLVMSetGlobalConstant(g: ValueRef, is_constant: i32);
    pub fn LLVMSetLinkage(g: ValueRef, linkage: u32);
    pub fn LLVMSetUnnamedAddress(g: ValueRef, addr: u32);
    pub fn LLVMAddFunction(m: ModuleRef, name: *u8, fn_ty: TypeRef): ValueRef;
    pub fn LLVMGetNamedFunction(m: ModuleRef, name: *u8): ValueRef;
    pub fn LLVMGetParam(f: ValueRef, i: u32): ValueRef;
    pub fn LLVMGetEnumAttributeKindForName(name: *u8, len: usize): u32;
    pub fn LLVMCreateEnumAttribute(c: ContextRef, kind: u32, v: u64): AttributeRef;
    pub fn LLVMAddAttributeAtIndex(f: ValueRef, idx: u32, a: AttributeRef);
    pub fn LLVMLookupIntrinsicID(name: *u8, len: usize): u32;
    pub fn LLVMGetIntrinsicDeclaration(m: ModuleRef, id: u32, tys: *TypeRef, n: usize): ValueRef;

    // ----- basic blocks and instructions -----
    pub fn LLVMAppendBasicBlockInContext(c: ContextRef, f: ValueRef, name: *u8): BasicBlockRef;
    pub fn LLVMGetFirstBasicBlock(f: ValueRef): BasicBlockRef;
    pub fn LLVMGetFirstInstruction(bb: BasicBlockRef): ValueRef;
    pub fn LLVMGetNextInstruction(i: ValueRef): ValueRef;
    pub fn LLVMGetBasicBlockTerminator(bb: BasicBlockRef): ValueRef;
    pub fn LLVMBasicBlockAsValue(bb: BasicBlockRef): ValueRef;
    pub fn LLVMGetFirstUse(v: ValueRef): UseRef;

    // ----- builders -----
    pub fn LLVMCreateBuilderInContext(c: ContextRef): BuilderRef;
    pub fn LLVMDisposeBuilder(b: BuilderRef);
    pub fn LLVMPositionBuilderAtEnd(b: BuilderRef, bb: BasicBlockRef);
    pub fn LLVMPositionBuilderBefore(b: BuilderRef, i: ValueRef);
    pub fn LLVMGetInsertBlock(b: BuilderRef): BasicBlockRef;

    // ----- terminators -----
    pub fn LLVMBuildRetVoid(b: BuilderRef): ValueRef;
