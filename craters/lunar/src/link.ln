// Linking object files into executables: a port of
// crates/ln-driver/src/link.rs.
//
// * Windows: `clang` (on `PATH`), else MSVC's `link.exe` if it is on
//   `PATH` (as in a developer prompt). (The Rust driver also finds an
//   installed MSVC through the registry.)
// * Linux / macOS: the system C compiler driver (`cc`).
//
// `$LUNAR_CC` overrides the linker driver on every platform (it is invoked
// like a C compiler: `$LUNAR_CC file.o -o out`). Native libraries named by
// `#[link(name = "...")]` are passed on as `-lname` (`name.lib` for
// `link.exe`), searched for in the directories in `$LUNAR_LIB_PATH`
// (separated like `PATH`) as well as the linker's defaults.
//
// With debug information, the debugger's files are made too:
//
// * Windows: the linker writes `<out>.pdb` (`/DEBUG`) next to the
//   executable, which names it without its directory (`/PDBALTPATH`), so
//   the executable is the same wherever it is built; the standard
//   library's `debugger/lunar.natvis` goes into the PDB (`/NATVIS`). With
//   `LUNAR_DEBUG_FORMAT=dwarf`, `lld` keeps DWARF in the executable
//   instead, for lldb.
// * macOS: the DWARF stays in the object file, which is deleted after
//   linking, so `dsymutil` first collects it into `<out>.dSYM`.
// * Linux: the DWARF is in the executable.

use std::env;
use std::fs;
use std::process;
use crater::paths::with_extension;
use crater::sysroot;

/// A failed link, as a `build::link` diagnostic: its message, a note
/// (the linker's output) and a help, each possibly empty.
pub struct LinkError {
    pub message: String,
    pub note: String,
    pub help: String,
}

/// Link `obj` and the native libraries `libs` into the executable `out`,
/// with its debug information if `debug` (on Windows, DWARF rather than a
/// PDB with `dwarf`).
pub fn link(obj: str, out: str, libs: [str; &], debug: bool, dwarf: bool): Result::<(), LinkError> {
    let search = lib_path();
    let mut b = Args::new();
    if let Some(cc) = env::var("LUNAR_CC") {
        b.add(obj);
        b.add("-o");
        b.add(out);
        if debug {
            b.add("-g");
        }
        gnu_args(&mut b, search.as_str(), libs, false);
        for l in system_libs() {
            b.add(l);
        }
        run(cc.as_str(), &b)?;
        return collect_debug(out, debug);
    }
    if is_windows() {
        return link_windows(obj, out, libs, search.as_str(), debug, dwarf);
    }
    b.add(obj);
    b.add("-o");
    b.add(out);
    gnu_args(&mut b, search.as_str(), libs, true);
    for l in system_libs() {
        b.add(l);
    }
    run("cc", &b)?;
    return collect_debug(out, debug);
}

/// The files besides executable `exe` that hold its debug information
/// (`.pdb`, `.dSYM`), which go with it.
pub fn remove_debug_files(exe: str) {
    if is_windows() {
        let _ = fs::remove_file(with_extension(exe, "pdb").as_str());
    } else if is_macos() {
        let mut d = String::from(exe);
        d.push_str(".dSYM");
        if fs::is_dir(d.as_str()) {
            let _ = fs::remove_dir_all(d.as_str());
        }
    }
}

/// On macOS, collect the debug information of `out` from its object file
/// into `out.dSYM` (before the object is deleted).
fn collect_debug(out: str, debug: bool): Result::<(), LinkError> {
    if !debug || !is_macos() {
        return Ok(());
    }
    let mut b = Args::new();
    b.add(out);
    return run("dsymutil", &b);
}

/// The arguments that make `link.exe` (directly, or through `clang` with
/// `-Wl,`) write the PDB: reproducibly, named without its directory, with
/// the standard library's natvis.
fn pdb_args(b: &mut +Args, prefix: str) {
    // (`/DEBUG` keeps unreferenced functions unless told otherwise.)
    for a in ["/DEBUG", "/INCREMENTAL:NO", "/OPT:REF", "/PDBALTPATH:%_PDB%"] {
        let mut s = String::from(prefix);
        s.push_str(a);
        b.add(s.as_str());
    }
    if let Some(std_dir) = sysroot::std_dir() {
        let mut natvis = String::from(std_dir.as_str());
        natvis.push_str("/debugger/lunar.natvis");
        if fs::is_file(natvis.as_str()) {
            let mut s = String::from(prefix);
            s.push_str("/NATVIS:");
            s.push_str(natvis.as_str());
            b.add(s.as_str());
        }
    }
}

/// The main thread's stack on Windows, in bytes (reserved, used as
/// needed). Windows' default, 1 MiB, is less than deeply recursive
/// programs need, such as this compiler on nested macro expansions (up to
/// 128 deep); Linux gives 8 MiB by default.
const MAIN_STACK: usize = 8388608;

fn link_windows(obj: str, out: str, libs: [str; &], search: str, debug: bool, dwarf: bool): Result::<(), LinkError> {
    let mut b = Args::new();
    if which("clang") {
        if debug && dwarf {
            // `link.exe` truncates the names of DWARF sections; `lld`
            // keeps them in the executable.
            b.add("-fuse-ld=lld");
        }
        b.add(obj);
        b.add("-o");
        b.add(out);
        gnu_args(&mut b, search, libs, false);
        // `/Brepro`: no link timestamp, so the same program links to the
        // same bytes (the bootstrap compares the compilers it builds).
        b.add("-llegacy_stdio_definitions");
        b.add("-lkernel32");
        b.add("-Wl,/Brepro");
        let mut stack = String::new();
        stack.write("-Wl,/STACK:{MAIN_STACK}");
        b.add(stack.as_str());
        if debug && dwarf {
            b.add("-Wl,/DEBUG:DWARF");
            b.add("-Wl,/INCREMENTAL:NO");
            b.add("-Wl,/OPT:REF");
        } else if debug {
            pdb_args(&mut b, "-Wl,");
        }
        return run("clang", &b);
    }
    if !which("link") {
        return Err(LinkError {
            message: String::from("no linker found: neither `clang` nor MSVC `link.exe` is on `PATH`"),
            note: String::new(),
            help: String::from("install the Visual Studio Build Tools (C++) and LLVM `clang`, or run from a Developer PowerShell for Visual Studio so that `link.exe` is on `PATH`, or set `LUNAR_CC`"),
        });
    }
    b.add("/NOLOGO");
    let mut o = String::from("/OUT:");
    o.push_str(out);
    b.add(o.as_str());
    b.add(obj);
    b.add("/SUBSYSTEM:CONSOLE");
    b.add("libcmt.lib");
    b.add("kernel32.lib");
    b.add("legacy_stdio_definitions.lib");
    b.add("/Brepro");
    let mut stack = String::new();
    stack.write("/STACK:{MAIN_STACK}");
    b.add(stack.as_str());
    if debug {
        pdb_args(&mut b, "");
    }
    for d in search.split(path_sep()) {
        if d.len() > 0 {
            let mut a = String::from("/LIBPATH:");
            a.push_str(d);
            b.add(a.as_str());
        }
    }
    for l in libs {
        let mut a = String::from(l);
        a.push_str(".lib");
        b.add(a.as_str());
    }
    return run("link", &b);
}

/// `-L` for each search directory, `-l` for each library, and with
/// `rpath`, `-rpath` for each search directory.
fn gnu_args(b: &mut +Args, search: str, libs: [str; &], rpath: bool) {
    for d in search.split(path_sep()) {
        if d.len() > 0 {
            let mut a = String::from("-L");
            a.push_str(d);
            b.add(a.as_str());
        }
    }
    for l in libs {
        let mut a = String::from("-l");
        a.push_str(l);
        b.add(a.as_str());
    }
    if rpath {
        for d in search.split(path_sep()) {
            if d.len() > 0 {
                // Shared libraries are found through the search path at run
                // time too.
                let mut r = String::from("-Wl,-rpath,");
                r.push_str(d);
                b.add(r.as_str());
            }
        }
    }
}

/// Arguments, end to end in one string that only grows.
struct Args {
    text: String,
    ranges: [(usize, usize); ..+],
}

impl Args {
    fn new(): Args {
        return Args { text: String::new(), ranges: [] };
    }

    fn add(&mut +self, a: str) {
        let s = self.text.len();
        self.text.push_str(a);
        self.ranges.push((s, self.text.len()));
    }
}

fn run(program: str, b: &Args): Result::<(), LinkError> {
    let text = b.text.as_str();
    let mut args: [str; ..+] = [];
    for r in b.ranges {
        let (s, e) = r;
        args.push(text[s..e]);
    }
    let o = match process::output(program, args[..]) {
        Ok(o) => o,
        Err(e) => {
            let mut m = String::new();
            m.write("could not run the linker `{program}`: {e}");
            let help = if program == "cc" { missing_cc_help() } else { "install a linker, or point `LUNAR_CC` at one" };
            return Err(LinkError { message: m, note: String::new(), help: String::from(help) });
        }
    };
    if o.status.success() {
        return Ok(());
    }
    let mut m = String::new();
    m.write("linking with `{program}` failed: {o.status}");
    let mut all = String::from(o.stdout.as_str());
    all.push_str(o.stderr.as_str());
    let mut note = String::new();
    if all.as_str().trim().len() > 0 {
        note.write("linker output:\n{trim_end(all.as_str())}");
    }
    return Err(LinkError { message: m, note, help: String::new() });
}

fn trim_end(s: str): str {
    let b = s.as_bytes();
    let mut end = b.len();
    while end > 0 && (b[end - 1] == b' ' || b[end - 1] == b'\n' || b[end - 1] == b'\r' || b[end - 1] == b'\t') {
        end -= 1;
    }
    return s[..end];
}

/// Whether `name` (with `.exe`, `.cmd` or `.bat` on Windows) is on `PATH`.
fn which(name: str): bool {
    let path = match env::var("PATH") {
        Some(p) => p,
        None => return false,
    };
    for dir in path.as_str().split(path_sep()) {
        if dir.len() == 0 {
            continue;
        }
        for ext in exe_exts() {
            let mut p = String::from(dir);
            p.push('/');
            p.push_str(name);
            p.push_str(ext);
            if fs::is_file(p.as_str()) {
                return true;
            }
        }
    }
    return false;
}

fn lib_path(): String {
    return match env::var("LUNAR_LIB_PATH") {
        Some(p) => p,
        None => String::new(),
    };
}

#[cfg(windows)]
fn exe_exts(): [str; 4] {
    return [".exe", ".cmd", ".bat", ""];
}

#[cfg(unix)]
fn exe_exts(): [str; 1] {
    return [""];
}

#[cfg(windows)]
fn is_windows(): bool {
    return true;
}

#[cfg(unix)]
fn is_windows(): bool {
    return false;
}

#[cfg(target_os = "macos")]
fn is_macos(): bool {
    return true;
}

#[cfg(not(target_os = "macos"))]
fn is_macos(): bool {
    return false;
}

#[cfg(windows)]
fn path_sep(): str {
    return ";";
}

#[cfg(unix)]
fn path_sep(): str {
    return ":";
}

#[cfg(target_os = "macos")]
fn missing_cc_help(): str {
    return "install the Xcode command line tools (`xcode-select --install`), which provide `cc`, or point `LUNAR_CC` at a linker";
}

#[cfg(not(target_os = "macos"))]
fn missing_cc_help(): str {
    return "install a C toolchain that provides `cc` (gcc or clang; on Debian and Ubuntu, the `build-essential` package), or point `LUNAR_CC` at a linker";
}

#[cfg(windows)]
fn system_libs(): [str; 2] {
    return ["-llegacy_stdio_definitions", "-lkernel32"];
}

#[cfg(target_os = "linux")]
fn system_libs(): [str; 1] {
    return ["-lm"];
}

#[cfg(target_os = "macos")]
fn system_libs(): [str; 0] {
    return [];
}
