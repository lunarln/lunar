// What an editor shows of a file as a whole: its outline (document
// symbols), the items of every loaded crater (workspace symbols), the
// meaning of every token (semantic tokens) and hints between the code
// (inlay hints). Protocol-independent; lsp.ln serves them.

use core::arena::{Id, List};
use ln_ast::{Ast, FieldDecl, Item, ItemKind, Span, VariantData};
use ln_ast::pretty;
use ln_sema::defs::{DefData, DefId, DefKind};
use ln_sema::diag::is_dummy;
use ln_sema::highlight;
use ln_sema::highlight::{Classified, TokenClass};
use ln_sema::loader::Craters;
use ln_sema::program::{Program, RefTarget};
use ln_sema::sema::Sema;
use ln_sema::thir;
use ln_sema::ty::TyKind;
use crater::ide;
use crater::refs;

// ===================================================================== document symbols

/// LSP symbol kinds.
pub const SK_MODULE: u32 = 2;
pub const SK_METHOD: u32 = 6;
pub const SK_FIELD: u32 = 8;
pub const SK_ENUM: u32 = 10;
pub const SK_INTERFACE: u32 = 11;
pub const SK_FUNCTION: u32 = 12;
pub const SK_VARIABLE: u32 = 13;
pub const SK_CONSTANT: u32 = 14;
pub const SK_OBJECT: u32 = 19;
pub const SK_ENUM_MEMBER: u32 = 22;
pub const SK_STRUCT: u32 = 23;
pub const SK_TYPE_PARAMETER: u32 = 26;

/// One entry of a file's outline. Its texts are in `Outline::text`.
pub struct Sym {
    name_lo: u32,
    name_hi: u32,
    detail_lo: u32,
    detail_hi: u32,
    pub kind: u32,
    /// The whole declaration.
    pub range: Span,
    /// Its name.
    pub sel: Span,
    /// The entry it is inside, plus one (0: none). Parents come first.
    pub parent: u32,
}

pub struct Outline {
    pub list: [Sym; ..+],
    pub text: String,
}

impl Outline {
    pub fn new(): Outline {
        return Outline { list: [], text: String::new() };
    }

    pub fn name(&self, i: usize): str {
        let s = self.list[i];
        return self.text.as_str()[s.name_lo as usize..s.name_hi as usize];
    }

    pub fn detail(&self, i: usize): str {
        let s = self.list[i];
        return self.text.as_str()[s.detail_lo as usize..s.detail_hi as usize];
    }

    /// Add an entry: its index plus one (for children's `parent`).
    fn add(&mut +self, name: str, detail: str, kind: u32, range: Span, sel: Span, parent: u32): u32 {
        let name_lo = self.text.len() as u32;
        self.text.push_str(name);
        let name_hi = self.text.len() as u32;
        self.text.push_str(detail);
        let detail_hi = self.text.len() as u32;
        let range = if range.lo <= sel.lo && sel.hi <= range.hi { range } else { sel };
        self.list.push(Sym { name_lo, name_hi, detail_lo: name_hi, detail_hi, kind, range, sel, parent });
        return self.list.len() as u32;
    }
}

/// The items of `file` (its module source), the outline of the file.
pub fn outline(cs: &Craters, p: &Program, file: u32, out: &mut +Outline) {
    for m in cs.mods.items() {
        if m.file == file {
            outline_items(&p.ast, p.sources.text.as_str(), m.items, 0, false, out);
            return;
        }
    }
}

fn outline_items(a: &Ast, src: str, items: List::<Id::<Item>>, parent: u32, in_impl: bool, out: &mut +Outline) {
    for id in a.item_ids.list(items) {
        outline_item(a, src, a.items.get(id), parent, in_impl, out);
    }
}

fn outline_item(a: &Ast, src: str, item: Item, parent: u32, in_impl: bool, out: &mut +Outline) {
    match item.kind {
        ItemKind::Fn(f) => {
            let kind = if in_impl { SK_METHOD } else { SK_FUNCTION };
            out.add(a.text(f.name.name), pretty::fn_sig(a, src, f).as_str(), kind, item.span, f.name.span, parent);
        }
        ItemKind::Struct(s) => {
            let me = out.add(a.text(s.name.name), "", SK_STRUCT, item.span, s.name.span, parent);
            outline_fields(a, src, s.kind, me, out);
        }
        ItemKind::Enum(e) => {
            let me = out.add(a.text(e.name.name), "", SK_ENUM, item.span, e.name.span, parent);
            for v in a.variants.list(e.variants) {
                let vi = out.add(a.text(v.name.name), "", SK_ENUM_MEMBER, v.span, v.name.span, me);
                outline_fields(a, src, v.data, vi, out);
            }
        }
        ItemKind::Trait(t) => {
            let me = out.add(a.text(t.name.name), "", SK_INTERFACE, item.span, t.name.span, parent);
            outline_items(a, src, t.items, me, true, out);
        }
        ItemKind::Impl(i) => {
            let mut name = String::from("impl ");
            if let Some(tr) = i.trait_ref {
                if i.negative {
                    name.push('!');
                }
                name.write("{pretty::path(a, src, tr)} for ");
            }
            name.push_str(pretty::ty(a, src, i.self_ty).as_str());
            let ty_span = a.tys.get(i.self_ty).span;
            let me = out.add(name.as_str(), "", SK_OBJECT, item.span, ty_span, parent);
            outline_items(a, src, i.items, me, true, out);
        }
        ItemKind::Mod(m) => {
            let me = out.add(a.text(m.name.name), "", SK_MODULE, item.span, m.name.span, parent);
            if let Some(inner) = m.items {
                outline_items(a, src, inner, me, false, out);
            }
        }
        ItemKind::Const(c) => {
            out.add(a.text(c.name.name), pretty::ty(a, src, c.ty).as_str(), SK_CONSTANT, item.span, c.name.span, parent);
        }
        ItemKind::Static(s) => {
            out.add(a.text(s.name.name), pretty::ty(a, src, s.ty).as_str(), SK_VARIABLE, item.span, s.name.span, parent);
        }
        ItemKind::TypeAlias(t) => {
            // An associated type in a trait may have no type (its bounds,
            // if any, describe it).
            let detail = match t.ty {
                Some(x) => pretty::ty(a, src, x),
                None => String::from("type"),
            };
            out.add(a.text(t.name.name), detail.as_str(), SK_TYPE_PARAMETER, item.span, t.name.span, parent);
        }
        ItemKind::Extern(b) => outline_items(a, src, b.items, parent, false, out),
        ItemKind::Macro(m) => {
            out.add(a.text(m.name.name), "macro", SK_FUNCTION, item.span, m.name.span, parent);
        }
        ItemKind::Use(_) => {}
        ItemKind::MacCall(_) => {}
    }
}

fn outline_fields(a: &Ast, src: str, data: VariantData, parent: u32, out: &mut +Outline) {
    if let VariantData::Named(fs) = data {
        for f in a.field_decls.list(fs) {
            out.add(a.text(f.name.name), pretty::ty(a, src, f.ty).as_str(), SK_FIELD, f.span, f.name.span, parent);
        }
    }
}

// ===================================================================== workspace symbols

/// A definition matching a workspace symbol query.
pub struct Found {
    pub def: DefId,
    pub kind: u32,
}

/// Whether `query` matches `name`: its characters appear in order,
/// ignoring case (an empty query matches everything).
pub fn fuzzy(query: str, name: str): bool {
    let q = query.as_bytes();
    let n = name.as_bytes();
    let mut i: usize = 0;
    for c in n {
        if i < q.len() && lower(c) == lower(q[i]) {
            i += 1;
        }
    }
    return i == q.len();
}

fn lower(c: u8): u8 {
    return if c >= b'A' && c <= b'Z' { c + 32 } else { c };
}

/// The symbol kind of a definition, if it is one to list.
pub fn def_symbol_kind(p: &Program, d: DefId): Option::<u32> {
    let info = p.def(d);
    return match info.kind {
        DefKind::Mod => if p.mod_data(d).is_block || info.span.lo == info.span.hi { None } else { Some(SK_MODULE) },
        DefKind::Fn => {
            let method = match info.parent {
                Some(par) => p.def(par).kind == DefKind::Impl || p.def(par).kind == DefKind::Trait,
                None => false,
            };
            if p.closures.get(d).is_some() {
                None
            } else if method {
                Some(SK_METHOD)
            } else {
                Some(SK_FUNCTION)
            }
        }
        DefKind::Struct => Some(SK_STRUCT),
        DefKind::Enum => Some(SK_ENUM),
        DefKind::Variant => Some(SK_ENUM_MEMBER),
        DefKind::Trait => Some(SK_INTERFACE),
        DefKind::Impl => None,
        DefKind::Const => Some(SK_CONSTANT),
        DefKind::Static => Some(SK_VARIABLE),
        DefKind::TypeAlias | DefKind::AssocTy => Some(SK_TYPE_PARAMETER),
        DefKind::Macro => Some(SK_FUNCTION),
    };
}

/// The definitions of `p` whose names match `query`, outside the
/// standard library (`std_key`, a path key prefix) and macro expansions,
/// at most `limit` of them in `out`.
pub fn workspace_symbols(p: &Program, std_key: str, query: str, limit: usize, out: &mut +[Found; ..+]) {
    for i in 0..p.defs.len() {
        if out.len() >= limit {
            return;
        }
        let d = p.defs[i];
        let name = p.text(d.name);
        if is_dummy(d.span) || name.starts_with("<") || name.contains("#") || !fuzzy(query, name) {
            continue;
        }
        let id = DefId::new(i);
        let kind = match def_symbol_kind(p, id) {
            Some(k) => k,
            None => continue,
        };
        let f = p.sources.files[p.sources.file_of(d.span.lo) as usize];
        if f.expansion_site.is_some() {
            continue;
        }
        if std_key.len() > 0 && ln_sema::loader::path_key(p.text(f.name)).as_str().starts_with(std_key) {
            continue;
        }
        out.push(Found { def: id, kind });
    }
}

// ===================================================================== semantic tokens

/// The token types, in the order of the legend (`TOKEN_TYPES`).
pub const T_NAMESPACE: u8 = 0;
pub const T_TYPE: u8 = 1;
pub const T_STRUCT: u8 = 2;
pub const T_ENUM: u8 = 3;
pub const T_INTERFACE: u8 = 4;
pub const T_TYPE_PARAMETER: u8 = 5;
pub const T_PARAMETER: u8 = 6;
pub const T_VARIABLE: u8 = 7;
pub const T_PROPERTY: u8 = 8;
pub const T_ENUM_MEMBER: u8 = 9;
pub const T_FUNCTION: u8 = 10;
pub const T_METHOD: u8 = 11;
pub const T_MACRO: u8 = 12;
pub const T_KEYWORD: u8 = 13;
pub const T_COMMENT: u8 = 14;
pub const T_STRING: u8 = 15;
pub const T_NUMBER: u8 = 16;
pub const T_DECORATOR: u8 = 17;
const T_NONE: u8 = 255;

/// The legend's token types.
pub fn token_types(): [str; ..+] {
    return ["namespace", "type", "struct", "enum", "interface", "typeParameter", "parameter", "variable", "property", "enumMember", "function", "method", "macro", "keyword", "comment", "string", "number", "decorator"];
}

/// Modifier bits, in the order of the legend (`token_modifiers`).
pub const M_DECLARATION: u8 = 1;
pub const M_MUTABLE: u8 = 2;
pub const M_DEFAULT_LIBRARY: u8 = 4;
pub const M_DOCUMENTATION: u8 = 8;
pub const M_READONLY: u8 = 16;

pub fn token_modifiers(): [str; ..+] {
    return ["declaration", "mutable", "defaultLibrary", "documentation", "readonly"];
}

/// One semantic token, in bytes of its file.
pub struct SemTok {
    pub start: u32,
    pub end: u32,
    pub ty: u8,
    pub mods: u8,
}

/// The semantic tokens of `file` (in order, not overlapping, none
/// spanning lines): what the lexer sees (keywords, literals, comments,
/// attributes, macro names), then the meaning of every name the analysis
/// resolved, over it.
pub fn semantic_tokens(p: &Program, file: u32, out: &mut +[SemTok; ..+]) {
    let text = p.sources.file_text(file);
    let start = p.sources.files[file as usize].start;
    let n = text.len();
    let b = text.as_bytes();
    // A type and modifiers per byte, and where tokens start.
    let mut ty: [u8; -..+] = [];
    let mut mods: [u8; -..+] = [];
    let mut first: [bool; -..+] = [];
    for _ in 0..n {
        ty.push(T_NONE);
        mods.push(0);
        first.push(false);
    }
    // What the lexer sees, as the diagnostics' highlighter sees it.
    let mut cl: [Classified; ..+] = [];
    highlight::classify(text, &mut cl);
    for c in cl {
        let (k, m) = match c.class {
            TokenClass::Plain => (T_NONE, 0),
            TokenClass::Keyword | TokenClass::Bool => (T_KEYWORD, 0),
            TokenClass::Type => if highlight::is_primitive(text[c.start..c.end]) || text[c.start..c.end] == "String" { (T_TYPE, M_DEFAULT_LIBRARY) } else { (T_TYPE, 0) },
            TokenClass::Number => (T_NUMBER, 0),
            TokenClass::String => (T_STRING, 0),
            TokenClass::Comment => (T_COMMENT, 0),
            TokenClass::DocComment => (T_COMMENT, M_DOCUMENTATION),
            TokenClass::Macro => (T_MACRO, 0),
            TokenClass::Attribute => (T_DECORATOR, 0),
        };
        if k != T_NONE {
            paint(&mut ty, &mut mods, &mut first, c.start, c.end, k, m);
        }
    }
    // What the analysis knows: every resolved name in this file.
    let std_roots = std_crates(p);
    for r in p.refs {
        let s = match p.origin(r.span) {
            Some(s) => s,
            None => continue,
        };
        if !ide::in_file(p, s, file) {
            continue;
        }
        let name = refs::target_name(p, r.target);
        let ns = p.name_span(s, name.as_str());
        if ns.hi - ns.lo != name.len() as u32 {
            continue;
        }
        let (k, m) = classify(p, r.target, std_roots[..]);
        if k == T_NONE {
            continue;
        }
        let decl = match refs::decl_span(p, r.target) {
            Some(d) => d == ns,
            None => false,
        };
        let m2 = if decl { m | M_DECLARATION } else { m };
        paint(&mut ty, &mut mods, &mut first, (ns.lo - start) as usize, (ns.hi - start) as usize, k, m2);
    }
    // Declarations, which are not uses.
    for i in 0..p.defs.len() {
        let d = p.defs[i];
        if !ide::in_file(p, d.span, file) || d.kind == DefKind::Impl || p.text(d.name).starts_with("<") || d.span.hi - d.span.lo != p.text(d.name).len() as u32 {
            continue;
        }
        let id = DefId::new(i);
        let (k, m) = classify(p, RefTarget::Def(id), std_roots[..]);
        if k != T_NONE {
            paint(&mut ty, &mut mods, &mut first, (d.span.lo - start) as usize, (d.span.hi - start) as usize, k, m | M_DECLARATION);
        }
        if let DefData::Adt(adt) = d.data {
            let vs = p.variants.list(adt.variants);
            for vi in 0..vs.len() {
                let fs = p.fields.list(vs[vi].fields);
                for fi in 0..fs.len() {
                    let f = fs[fi];
                    if ide::in_file(p, f.span, file) && f.span.hi - f.span.lo == p.text(f.name).len() as u32 {
                        paint(&mut ty, &mut mods, &mut first, (f.span.lo - start) as usize, (f.span.hi - start) as usize, T_PROPERTY, M_DECLARATION);
                    }
                }
            }
        }
    }
    // Runs of bytes of one kind, cut at line ends and token starts.
    let mut i: usize = 0;
    while i < n {
        let k = ty[i];
        if k == T_NONE || b[i] == b'\n' || b[i] == b'\r' {
            i += 1;
            continue;
        }
        let m = mods[i];
        let mut j = i + 1;
        while j < n && ty[j] == k && mods[j] == m && !first[j] && b[j] != b'\n' && b[j] != b'\r' {
            j += 1;
        }
        out.push(SemTok { start: i as u32, end: j as u32, ty: k, mods: m });
        i = j;
    }
}

/// The tokens of `text` between offsets `lo` and `hi` as LSP data: for
/// each, its line and start (relative to the token before), its length,
/// type and modifiers, in UTF-16 units.
pub fn encode_tokens(text: str, toks: [SemTok; &], lo: u32, hi: u32, out: &mut +[u32; -..+]) {
    let b = text.as_bytes();
    let mut line: u32 = 0;
    let mut col: u32 = 0;
    let mut pos: usize = 0;
    let mut prev_line: u32 = 0;
    let mut prev_col: u32 = 0;
    for t in toks {
        if t.end <= lo || t.start >= hi {
            continue;
        }
        while pos < t.start as usize && pos < b.len() {
            let c = b[pos];
            if c == b'\n' {
                line += 1;
                col = 0;
                pos += 1;
            } else {
                let (w, units) = char_width(c);
                col += units;
                pos += w;
            }
        }
        let mut len: u32 = 0;
        let mut k = t.start as usize;
        while k < t.end as usize && k < b.len() {
            let (w, units) = char_width(b[k]);
            len += units;
            k += w;
        }
        let dl = line - prev_line;
        let dc = if dl == 0 { col - prev_col } else { col };
        out.push(dl);
        out.push(dc);
        out.push(len);
        out.push(t.ty as u32);
        out.push(t.mods as u32);
        prev_line = line;
        prev_col = col;
    }
}

/// The bytes of the UTF-8 character starting with `c`, and its UTF-16
/// units.
fn char_width(c: u8): (usize, u32) {
    if c < 128 {
        return (1, 1);
    }
    if c < 224 {
        return (2, 1);
    }
    if c < 240 {
        return (3, 1);
    }
    return (4, 2);
}

/// The root modules of `core` and `std`.
fn std_crates(p: &Program): [DefId; ..+] {
    let mut out: [DefId; ..+] = [];
    for r in p.crate_roots {
        let n = p.text(r.name);
        if n == "core" || n == "std" {
            out.push(r.def);
        }
    }
    return out;
}

/// Whether definition `d` is in the standard library.
pub fn in_std(p: &Program, d: DefId, std_roots: [DefId; &]): bool {
    let m = p.def(d).module;
    if m.index() >= p.defs.len() {
        return false;
    }
    let krate = match p.def(m).data {
        DefData::Mod(md) => md.krate,
        _ => return false,
    };
    return std_roots.contains(krate);
}

/// The token type and modifiers of what a name refers to.
fn classify(p: &Program, t: RefTarget, std_roots: [DefId; &]): (u8, u8) {
    return match t {
        RefTarget::Def(d) => {
            let info = p.def(d);
            let lib = if in_std(p, d, std_roots) { M_DEFAULT_LIBRARY } else { 0 };
            let k = match info.kind {
                DefKind::Mod => T_NAMESPACE,
                DefKind::Fn => {
                    let method = match info.data {
                        DefData::Fn(f) => f.has_self,
                        _ => false,
                    };
                    if method { T_METHOD } else { T_FUNCTION }
                }
                DefKind::Struct => T_STRUCT,
                DefKind::Enum => T_ENUM,
                DefKind::Variant => T_ENUM_MEMBER,
                DefKind::Trait => T_INTERFACE,
                DefKind::Impl => T_NONE,
                DefKind::Const => T_VARIABLE,
                DefKind::Static => T_VARIABLE,
                DefKind::TypeAlias | DefKind::AssocTy => T_TYPE,
                DefKind::Macro => T_MACRO,
            };
            let mut m = lib;
            if info.kind == DefKind::Const {
                m = m | M_READONLY;
            }
            if let DefData::Static(s) = info.data {
                if s.mutable {
                    m = m | M_MUTABLE;
                } else {
                    m = m | M_READONLY;
                }
            }
            (k, m)
        }
        RefTarget::Field { adt, .. } => (T_PROPERTY, if in_std(p, adt, std_roots) { M_DEFAULT_LIBRARY } else { 0 }),
        RefTarget::Local { body, local } => match refs::local_of(p, body, local) {
            Some(l) => {
                if p.text(l.name) == "self" {
                    (T_KEYWORD, 0)
                } else {
                    let k = match l.kind {
                        thir::LocalKind::Param { .. } => T_PARAMETER,
                        _ => T_VARIABLE,
                    };
                    (k, if l.mutable { M_MUTABLE } else { 0 })
                }
            }
            None => (T_VARIABLE, 0),
        },
        RefTarget::TyParam(_) => (T_TYPE_PARAMETER, 0),
    };
}

fn paint(ty: &mut [u8; -..+], mods: &mut [u8; -..+], first: &mut [bool; -..+], start: usize, end: usize, k: u8, m: u8) {
    let e = if end < ty.len() { end } else { ty.len() };
    if start >= e {
        return;
    }
    for i in start..e {
        ty[i] = k;
        mods[i] = m;
        first[i] = false;
    }
    first[start] = true;
    if e < ty.len() {
        first[e] = true;
    }
}

// ===================================================================== inlay hints

/// An inlay hint: a type after a binding (`: i32`) or a parameter name
/// before an argument (`name:`).
pub struct Hint {
    /// Where it goes (global offset).
    pub at: u32,
    pub is_type: bool,
    lo: u32,
    hi: u32,
}

pub struct Hints {
    pub list: [Hint; ..+],
    pub text: String,
}

impl Hints {
    pub fn new(): Hints {
        return Hints { list: [], text: String::new() };
    }

    pub fn label(&self, i: usize): str {
        let h = self.list[i];
        return self.text.as_str()[h.lo as usize..h.hi as usize];
    }

    fn add(&mut +self, at: u32, is_type: bool, label: str) {
        let lo = self.text.len() as u32;
        self.text.push_str(label);
        self.list.push(Hint { at, is_type, lo, hi: self.text.len() as u32 });
    }
}

/// The hints for `file` between global offsets `lo` and `hi`: the types of
/// `let` bindings written without one, and the names of parameters at
/// call sites (unless the argument says it already).
pub fn inlay_hints(s: &mut +Sema, file: u32, lo: u32, hi: u32, out: &mut +Hints) {
    let mut bodies: [thir::Body; ..+] = [];
    for b in s.p.bodies.values() {
        if ide::in_file(&s.p, b.span, file) && b.span.hi >= lo && b.span.lo <= hi {
            bodies.push(b);
        }
    }
    let mut lets: [(Id::<thir::Pat>, Span); ..+] = [];
    let mut calls: [Id::<thir::Expr>; ..+] = [];
    for b in bodies {
        collect_block(&s.p, b.block, &mut lets, &mut calls);
    }
    for x in lets {
        let (pat, span) = x;
        if span.hi < lo || span.lo > hi || !ide::in_file(&s.p, span, file) {
            continue;
        }
        // Only `let`s written as such (not those `for` and `?` stand for).
        if !s.p.sources.snippet(span).starts_with("let") {
            continue;
        }
        let ps = s.p.thir.pat(pat).span;
        if !ide::in_file(&s.p, ps, file) || annotated(&s.p, ps.hi) {
            continue;
        }
        let mut binds: [(Span, ln_sema::ty::Ty); ..+] = [];
        pat_bindings(&s.p, pat, &mut binds);
        for bd in binds {
            let (bs, t) = bd;
            if !ide::in_file(&s.p, bs, file) {
                continue;
            }
            let shown = match s.p.types.kind(t) {
                TyKind::Error | TyKind::Infer(_) | TyKind::Closure(..) => false,
                _ => !s.p.types.has_error(t),
            };
            if !shown {
                continue;
            }
            let mut label = String::from(": ");
            label.push_str(s.p.ty_str(t).as_str());
            out.add(bs.hi, true, label.as_str());
        }
    }
    for c in calls {
        param_hints(&s.p, c, file, lo, hi, out);
    }
}

/// Whether the pattern ending at `at` is followed by a type (`: T`).
fn annotated(p: &Program, at: u32): bool {
    let b = p.sources.text.as_bytes();
    let mut i = at as usize;
    while i < b.len() && (b[i] == b' ' || b[i] == b'\t' || b[i] == b'\n' || b[i] == b'\r') {
        i += 1;
    }
    return i < b.len() && b[i] == b':';
}

/// The bindings of a pattern: the span of each name and its type.
fn pat_bindings(p: &Program, id: Id::<thir::Pat>, out: &mut +[(Span, ln_sema::ty::Ty); ..+]) {
    let pt = p.thir.pat(id);
    match pt.kind {
        thir::PatKind::Binding { sub, .. } => {
            out.push((pt.span, pt.ty));
            if let Some(x) = sub {
                pat_bindings(p, x, out);
            }
        }
        thir::PatKind::Tuple(ps) => {
            for q in p.thir.pat_ids.list(ps) {
                pat_bindings(p, q, out);
            }
        }
        thir::PatKind::Adt { fields, .. } => {
            for f in p.thir.field_pats.list(fields) {
                pat_bindings(p, f.pat, out);
            }
        }
        thir::PatKind::Or(ps) => {
            let l = p.thir.pat_ids.list(ps);
            if l.len() > 0 {
                pat_bindings(p, l[0], out);
            }
        }
        _ => {}
    }
}

/// Parameter name hints for the arguments of call `c`.
fn param_hints(p: &Program, c: Id::<thir::Expr>, file: u32, lo: u32, hi: u32, out: &mut +Hints) {
    let e = p.thir.expr(c);
    let (callee, args) = match e.kind {
        thir::ExprKind::Call { callee, args } => (callee, args),
        _ => return,
    };
    let def = match callee {
        thir::Callee::Fn { def, .. } => def,
        thir::Callee::Intrinsic { def, .. } => def,
        thir::Callee::Trait { trait_ref, method, .. } => {
            let td = p.trait_data(trait_ref.trait_id);
            let mut found: Option::<DefId> = None;
            for m in p.trait_methods.list(td.methods) {
                if m.name == method {
                    found = Some(m.def);
                }
            }
            match found {
                Some(d) => d,
                None => return,
            }
        }
        _ => return,
    };
    if p.def(def).kind != DefKind::Fn {
        return;
    }
    let fname = String::from(p.name(def));
    let params = p.fn_params(def);
    let al = p.thir.args.list(args);
    for i in 0..al.len() {
        if i >= params.len() {
            break;
        }
        let prm = params[i];
        if prm.is_self {
            continue;
        }
        let pname = p.text(prm.name);
        if pname.len() == 0 || pname.starts_with("_") {
            continue;
        }
        if let TyKind::FmtArgs = p.types.kind(prm.ty) {
            continue;
        }
        let ax = p.thir.expr(al[i].expr());
        let span = ax.span;
        if !ide::in_file(p, span, file) || span.hi < lo || span.lo > hi {
            continue;
        }
        // Before the `&` or `&mut` that lends it.
        let at = marker_start(p, span.lo);
        let arg_text = p.sources.snippet(Span::new(at, span.hi));
        if same_name(arg_text, pname) || fname.as_str().ends_with(pname) || (params.len() == 1 && fname.as_str().contains(pname)) {
            continue;
        }
        let mut label = String::from(pname);
        label.push(':');
        out.add(at, false, label.as_str());
    }
}

/// The start of a `&` or `&mut ` lending the argument that starts at `at`.
fn marker_start(p: &Program, at: u32): u32 {
    let b = p.sources.text.as_bytes();
    let mut i = at as usize;
    while i > 0 && (b[i - 1] == b' ' || b[i - 1] == b'\t') {
        i -= 1;
    }
    if i >= 3 && b[i - 3] == b'm' && b[i - 2] == b'u' && b[i - 1] == b't' {
        let mut k = i - 3;
        while k > 0 && (b[k - 1] == b' ' || b[k - 1] == b'\t') {
            k -= 1;
        }
        if k > 0 && b[k - 1] == b'&' {
            return (k - 1) as u32;
        }
    }
    if i > 0 && b[i - 1] == b'&' {
        return (i - 1) as u32;
    }
    return at;
}

/// Whether an argument already says the parameter's name: `x`, `&mut x`,
/// `self.x`, `a.b.x`.
fn same_name(arg: str, name: str): bool {
    let mut a = arg;
    if a.starts_with("&mut ") {
        a = a[5..];
    } else if a.starts_with("&") {
        a = a[1..];
    }
    let a = a.trim();
    if a == name {
        return true;
    }
    if a.ends_with(name) && a.len() > name.len() {
        let c = a.as_bytes()[a.len() - name.len() - 1];
        return c == b'.' || c == b'_';
    }
    return false;
}

fn collect_block(p: &Program, id: Id::<thir::Block>, lets: &mut +[(Id::<thir::Pat>, Span); ..+], calls: &mut +[Id::<thir::Expr>; ..+]) {
    let b = p.thir.block(id);
    for st in p.thir.stmts.list(b.stmts) {
        match st {
            thir::Stmt::Let { pat, init, span } => {
                lets.push((pat, span));
                if let Some(e) = init {
                    collect_expr(p, e, lets, calls);
                }
            }
            thir::Stmt::Expr(e) => collect_expr(p, e, lets, calls),
        }
    }
    if let Some(t) = b.tail {
        collect_expr(p, t, lets, calls);
    }
}

fn collect_exprs(p: &Program, l: List::<Id::<thir::Expr>>, lets: &mut +[(Id::<thir::Pat>, Span); ..+], calls: &mut +[Id::<thir::Expr>; ..+]) {
    for x in p.thir.expr_ids.list(l) {
        collect_expr(p, x, lets, calls);
    }
}

/// The `let`s and calls in an expression (closures' bodies are bodies of
/// their own).
fn collect_expr(p: &Program, id: Id::<thir::Expr>, lets: &mut +[(Id::<thir::Pat>, Span); ..+], calls: &mut +[Id::<thir::Expr>; ..+]) {
    let e = p.thir.expr(id);
    match e.kind {
        thir::ExprKind::Field { base, .. } => collect_expr(p, base, lets, calls),
        thir::ExprKind::Deref(x) => collect_expr(p, x, lets, calls),
        thir::ExprKind::Temp(x) => collect_expr(p, x, lets, calls),
        thir::ExprKind::Read { place, .. } => collect_expr(p, place, lets, calls),
        thir::ExprKind::Unary(_, x) => collect_expr(p, x, lets, calls),
        thir::ExprKind::Cast(x) => collect_expr(p, x, lets, calls),
        thir::ExprKind::Coerce { expr, .. } => collect_expr(p, expr, lets, calls),
        thir::ExprKind::Index { base, index } => {
            collect_expr(p, base, lets, calls);
            collect_expr(p, index, lets, calls);
        }
        thir::ExprKind::Call { callee, args } => {
            calls.push(id);
            match callee {
                thir::Callee::Indirect(c) => collect_expr(p, c, lets, calls),
                thir::Callee::Value { callee: c, .. } => collect_expr(p, c, lets, calls),
                _ => {}
            }
            for a in p.thir.args.list(args) {
                collect_expr(p, a.expr(), lets, calls);
            }
        }
        thir::ExprKind::Closure { captures, .. } => {
            for a in p.thir.args.list(captures) {
                collect_expr(p, a.expr(), lets, calls);
            }
        }
        thir::ExprKind::Binary(_, l, r) => {
            collect_expr(p, l, lets, calls);
            collect_expr(p, r, lets, calls);
        }
        thir::ExprKind::Logical { lhs, rhs, .. } => {
            collect_expr(p, lhs, lets, calls);
            collect_expr(p, rhs, lets, calls);
        }
        thir::ExprKind::Assign { place, value } => {
            collect_expr(p, place, lets, calls);
            collect_expr(p, value, lets, calls);
        }
        thir::ExprKind::AssignOp { place, value, .. } => {
            collect_expr(p, place, lets, calls);
            collect_expr(p, value, lets, calls);
        }
        thir::ExprKind::Tuple(xs) => collect_exprs(p, xs, lets, calls),
        thir::ExprKind::Array(xs) => collect_exprs(p, xs, lets, calls),
        thir::ExprKind::Adt { fields, .. } => {
            for f in p.thir.field_exprs.list(fields) {
                collect_expr(p, f.expr, lets, calls);
            }
        }
        thir::ExprKind::ArrayRepeat { value, count } => {
            collect_expr(p, value, lets, calls);
            collect_expr(p, count, lets, calls);
        }
        thir::ExprKind::Slice { base, start, end, .. } => {
            collect_expr(p, base, lets, calls);
            if let Some(x) = start {
                collect_expr(p, x, lets, calls);
            }
            if let Some(x) = end {
                collect_expr(p, x, lets, calls);
            }
        }
        thir::ExprKind::Block(b) => collect_block(p, b, lets, calls),
        thir::ExprKind::Loop { body, .. } => collect_block(p, body, lets, calls),
        thir::ExprKind::If { cond, then, else_ } => {
            collect_expr(p, cond, lets, calls);
            collect_expr(p, then, lets, calls);
            if let Some(x) = else_ {
                collect_expr(p, x, lets, calls);
            }
        }
        thir::ExprKind::Match { scrut, arms } => {
            collect_expr(p, scrut, lets, calls);
            for a in p.thir.arms.list(arms) {
                if let Some(g) = a.guard {
                    collect_expr(p, g, lets, calls);
                }
                collect_expr(p, a.body, lets, calls);
            }
        }
        thir::ExprKind::While { cond, body, .. } => {
            collect_expr(p, cond, lets, calls);
            collect_block(p, body, lets, calls);
        }
        thir::ExprKind::ForRange { start, end, body, .. } => {
            collect_expr(p, start, lets, calls);
            collect_expr(p, end, lets, calls);
            collect_block(p, body, lets, calls);
        }
        thir::ExprKind::ForArray { array, body, .. } => {
            collect_expr(p, array, lets, calls);
            collect_block(p, body, lets, calls);
        }
        thir::ExprKind::Break { value, .. } => {
            if let Some(v) = value {
                collect_expr(p, v, lets, calls);
            }
        }
        thir::ExprKind::Return(value) => {
            if let Some(v) = value {
                collect_expr(p, v, lets, calls);
            }
        }
        thir::ExprKind::FmtArgs(pieces) => {
            for piece in p.thir.fmt_pieces.list(pieces) {
                if let thir::FmtPiece::Arg(x, _) = piece {
                    collect_expr(p, x, lets, calls);
                }
            }
        }
        _ => {}
    }
}
