// `ln-driver lsp`: the language server (a port of
// crates/ln-driver/src/lsp.rs), speaking the Language Server Protocol over
// standard input and output.
//
// It serves diagnostics (on open and change), hover and go to definition.
// Every change re-analyzes the crate the file belongs to (the messages
// already waiting are read first, so a burst of changes is analyzed once).
// A file is analyzed as part of the crate of another file that loads it as
// a module (`mod foo;`), otherwise as its own root; files of a standard
// library source tree are analyzed as the standard library. Open documents
// are read from the editor's buffers, not the disk.
//
// The transport is `lsp-server`'s: `Content-Length` framed JSON-RPC,
// `initialize` then `initialized`, and `shutdown` then `exit`. Text
// documents are synchronized in full.
//
// The standard library is the one on disk (`sysroot::std_dir`), so definitions
// in it are `file:` locations of real files. The Rust server's virtual
// `lunar-std:` documents (`lunar/stdSource`) still work, read from there.
//
// The Rust server keeps every crate's analysis; this one keeps the four
// used last (`Slots`), and analyzes a crate again when a request needs one
// it dropped.

use core::collections::HashMap;
use core::intern::{Interner, Symbol};
use std::fs;
use std::io;
use ln_ast::Span;
use ln_json::{Json, Kind, Value};
use ln_sema::codes;
use ln_sema::defs::{DefData, DefId};
use ln_sema::diag::{Diag, Severity, is_dummy};
use ln_sema::loader::{CraterDep, Craters, Overlay, load_crate, path_key};
use ln_sema::program::{Program, RefTarget};
use ln_sema::sema::{Options, Sema, analyze};
use crater::complete;
use crater::git;
use crater::ide;
use crater::refs;
use crater::symbols;
use crater::paths::{absolute, canonical, join, normalize, parent};
use crater::project::{Project, ProjectError, Target, find_project};
use crater::sysroot;

/// Run the server on standard input and output until the client shuts it
/// down: the exit code.
pub fn serve(): i32 {
    // Absolute, so that its files have `file:` URIs.
    let std_dir = match sysroot::std_dir() {
        Some(d) => absolute(d.as_str()),
        None => {
            eprintln("lunar lsp: could not find the standard library: {sysroot::std_help()}");
            String::new()
        }
    };
    let mut inp = Input { buf: [], pos: 0, eof: false };
    let mut wire = Wire::stdout();
    let snippets = match initialize(&mut wire, &mut inp) {
        Ok(s) => s,
        Err(e) => {
            eprintln("error: language server failed: {e}");
            return 1;
        }
    };
    let mut server = Server::new(std_dir, wire, snippets);
    return match server.main_loop(&mut inp) {
        Ok(()) => 0,
        Err(e) => {
            eprintln("error: language server failed: {e}");
            1
        }
    };
}

/// Run a whole session in process (for tests): `input` is what the client
/// sends (framed messages), the result what the server answered, or why
/// it failed.
pub fn serve_script(input: str, std_dir: str): Result::<String, String> {
    let mut inp = Input { buf: [], pos: 0, eof: true };
    inp.buf.extend(input.as_bytes());
    let mut wire = Wire { capture: true, buf: String::new() };
    let snippets = initialize(&mut wire, &mut inp)?;
    let mut server = Server::new(String::from(std_dir), wire, snippets);
    let r = server.main_loop(&mut inp);
    let out = core::mem::replace(&mut server.st.wire.buf, String::new());
    r?;
    return Ok(out);
}

// ===================================================================== transport

/// Standard input, read in chunks.
struct Input {
    buf: [u8; -..+],
    pos: usize,
    eof: bool,
}

impl Input {
    /// Read more (waiting for it); false at the end of the input.
    fn fill(&mut self): bool {
        if self.eof {
            return false;
        }
        if self.pos > 0 && self.pos * 2 >= self.buf.len() {
            let mut rest: [u8; -..+] = [];
            rest.extend(self.buf[self.pos..]);
            self.buf = rest;
            self.pos = 0;
        }
        let mut chunk: [u8; 65536] = [0; 65536];
        let n = io::read(0, chunk[..]);
        if n <= 0 {
            self.eof = true;
            return false;
        }
        self.buf.extend(chunk[..n as usize]);
        return true;
    }

    /// Whether a whole message is already read.
    fn has_message(&self): bool {
        let b = self.buf[self.pos..];
        let mut i: usize = 0;
        let mut len: usize = 0;
        while i + 1 < b.len() {
            // A header line.
            let mut end = i;
            while end + 1 < b.len() && !(b[end] == b'\r' && b[end + 1] == b'\n') {
                end += 1;
            }
            if end + 1 >= b.len() {
                return false;
            }
            if end == i {
                return i + 2 + len <= b.len();
            }
            let line = unsafe { core::intrinsics::str_from_bytes(b[i..end]) };
            if let Some(n) = content_length(line) {
                len = n;
            }
            i = end + 2;
        }
        return false;
    }
}

/// The value of a `Content-Length` header line.
fn content_length(line: str): Option::<usize> {
    let colon = line.find(": ")?;
    if !eq_ignore_case(line[..colon], "content-length") {
        return None;
    }
    let v = line[colon + 2..];
    if v.len() == 0 || v.starts_with("-") || v.starts_with("+") {
        return None;
    }
    let n = v.parse_i64()?;
    return Some(n as usize);
}

fn eq_ignore_case(a: str, b: str): bool {
    let x = a.as_bytes();
    let y = b.as_bytes();
    if x.len() != y.len() {
        return false;
    }
    for i in 0..x.len() {
        let mut c = x[i];
        let mut d = y[i];
        if c >= b'A' && c <= b'Z' {
            c += 32;
        }
        if d >= b'A' && d <= b'Z' {
            d += 32;
        }
        if c != d {
            return false;
        }
    }
    return true;
}

/// What reading a message gave.
enum Got {
    Message,
    End,
}

/// Read the next message's text into `body` (as `lsp-server` does: header
/// lines ending in `\r\n`, an empty line, then `Content-Length` bytes).
fn read_message(inp: &mut Input, body: &mut String): Result::<Got, String> {
    let mut size: Option::<usize> = None;
    let mut first = true;
    loop {
        // One header line, through its `\n`.
        let mut k = inp.pos;
        loop {
            while k < inp.buf.len() && inp.buf[k] != b'\n' {
                k += 1;
            }
            if k < inp.buf.len() {
                break;
            }
            let scanned = k - inp.pos;
            if !inp.fill() {
                if first && inp.pos == inp.buf.len() {
                    return Ok(Got::End);
                }
                let rest = lossy(inp.buf[inp.pos..]);
                return Err(core::fmt::format("malformed header: {rest:?}"));
            }
            // Filling may have moved the unread bytes to the start.
            k = inp.pos + scanned;
        }
        let end = k;
        let line = lossy(inp.buf[inp.pos..end + 1]);
        inp.pos = end + 1;
        first = false;
        if !line.as_str().ends_with("\r\n") {
            return Err(core::fmt::format("malformed header: {line:?}"));
        }
        let text = line.as_str()[..line.len() - 2];
        if text.len() == 0 {
            break;
        }
        let colon = match text.find(": ") {
            Some(c) => c,
            None => return Err(core::fmt::format("malformed header: {text:?}")),
        };
        if eq_ignore_case(text[..colon], "content-length") {
            match content_length(text) {
                Some(n) => size = Some(n),
                None => return Err(core::fmt::format("invalid Content-Length: {text:?}")),
            }
        }
    }
    let n = match size {
        Some(n) => n,
        None => return Err(String::from("no Content-Length")),
    };
    while inp.buf.len() - inp.pos < n {
        if !inp.fill() {
            return Err(String::from("failed to fill whole buffer"));
        }
    }
    if !take_text(inp, n, body) {
        return Err(String::from("invalid UTF-8 in a message"));
    }
    return Ok(Got::Message);
}

/// Move the next `n` bytes of `inp` (read already) to `body`; false if
/// they are not UTF-8.
fn take_text(inp: &mut Input, n: usize, body: &mut String): bool {
    let start = inp.pos;
    inp.pos += n;
    return match str::from_utf8(inp.buf[start..start + n]) {
        Some(s) => {
            body.push_str(s);
            true
        }
        None => false,
    };
}

/// Bytes as text, with anything that is not UTF-8 as U+FFFD.
fn lossy(b: [u8; &]): String {
    let mut out = String::new();
    match str::from_utf8(b) {
        Some(s) => out.push_str(s),
        None => {
            for c in b {
                out.push(if c < 128 { c as char } else { '\u{FFFD}' });
            }
        }
    }
    return out;
}

/// Where messages go: standard output, or (for tests) a buffer.
pub struct Wire {
    pub capture: bool,
    pub buf: String,
}

impl Wire {
    pub fn stdout(): Wire {
        return Wire { capture: false, buf: String::new() };
    }
}

/// Write a message (`jsonrpc` first, then the members of `v`).
fn send(w: &mut +Wire, j: &Json, v: Value): Result::<(), String> {
    let mut body = String::from("{\"jsonrpc\":\"2.0\"");
    let mut m = j.first(v);
    while let Some(x) = m {
        body.push(',');
        ln_json::write_string(&mut body, j.key(x));
        body.push(':');
        j.write(x, &mut body);
        m = j.next(x);
    }
    body.push('}');
    let mut msg = String::new();
    msg.write("Content-Length: {body.len()}\r\n\r\n");
    msg.push_str(body.as_str());
    if w.capture {
        w.buf.push_str(msg.as_str());
        return Ok(());
    }
    if !io::write_bytes(1, msg.as_bytes()) {
        return Err(String::from("cannot write to standard output"));
    }
    return Ok(());
}

/// What a message is.
#[derive(Eq)]
enum MsgKind {
    Request,
    Response,
    Notification,
}

/// A message's kind (as `lsp-server`'s untagged `Message` reads it: an
/// `id` and a `method` make a request, an `id` alone a response, a
/// `method` alone a notification).
fn kind_of(j: &Json): Option::<MsgKind> {
    let r = j.root();
    if j.kind(r) != Kind::Object {
        return None;
    }
    let has_id = match j.get(r, "id") {
        Some(id) => valid_id(j, id),
        None => false,
    };
    let has_method = match j.get(r, "method") {
        Some(m) => j.as_str(m).is_some(),
        None => false,
    };
    if has_id && has_method {
        return Some(MsgKind::Request);
    }
    if has_id {
        return Some(MsgKind::Response);
    }
    if has_method {
        return Some(MsgKind::Notification);
    }
    return None;
}

/// A request id: an `i32` or a string.
fn valid_id(j: &Json, id: Value): bool {
    if j.as_str(id).is_some() {
        return true;
    }
    return match j.as_i64(id) {
        Some(n) => n >= -2147483648 && n <= 2147483647,
        None => false,
    };
}

fn method_of(j: &Json): str {
    return match j.get(j.root(), "method") {
        Some(m) => j.as_str(m).unwrap_or(""),
        None => "",
    };
}

/// The message parsed, or why it is not one.
fn parse_message(text: str): Result::<Json, String> {
    let j = match ln_json::parse(text) {
        Ok(j) => j,
        Err(e) => return Err(core::fmt::format("malformed LSP payload: {e}")),
    };
    if kind_of(&j).is_none() {
        return Err(String::from("malformed LSP payload: not a request, response or notification"));
    }
    return Ok(j);
}

/// Whether `j` is the `exit` notification.
fn is_exit(j: &Json): bool {
    return kind_of(j) == Some(MsgKind::Notification) && method_of(j) == "exit";
}

/// A response to the request `req`: its `result`, or an error.
fn respond(w: &mut +Wire, req: &Json, out: &mut Json, result: Option::<Value>, error_code: i64, error: str): Result::<(), String> {
    let m = out.object();
    let id = out.copy_from(req, req.get(req.root(), "id").unwrap());
    out.set(m, "id", id);
    match result {
        Some(r) => out.set(m, "result", r),
        None => {
            let e = out.object();
            let c = out.int(error_code);
            out.set(e, "code", c);
            let msg = out.string(error);
            out.set(e, "message", msg);
            out.set(m, "error", e);
        }
    }
    return send(w, out, m);
}

/// Wait for `initialize`, answer it with the server's capabilities, and
/// wait for `initialized` (`lsp-server`'s `Connection::initialize`).
/// Whether the client takes snippets in completions.
fn initialize(w: &mut +Wire, inp: &mut Input): Result::<bool, String> {
    let mut snippets = false;
    loop {
        let mut body = String::new();
        if let Got::End = read_message(inp, &mut body)? {
            return Err(String::from("disconnected channel"));
        }
        let req = parse_message(body.as_str())?;
        let kind = kind_of(&req).unwrap();
        let method = method_of(&req);
        if kind == MsgKind::Request && method == "initialize" {
            if let Some(v) = req.path(req.root(), ["params", "capabilities", "textDocument", "completion", "completionItem", "snippetSupport"][..]) {
                snippets = req.as_bool(v).unwrap_or(false);
            }
            let mut out = Json::new();
            let caps = capabilities(&mut out);
            let result = out.object();
            out.set(result, "capabilities", caps);
            let info = out.object();
            let name = out.string("lunar");
            out.set(info, "name", name);
            out.set(result, "serverInfo", info);
            respond(w, &req, &mut out, Some(result), 0, "")?;
            break;
        }
        if kind == MsgKind::Request {
            let mut out = Json::new();
            let msg = core::fmt::format("expected initialize request, got request `{method}`");
            respond(w, &req, &mut out, None, -32002, msg.as_str())?;
            continue;
        }
        if kind == MsgKind::Notification && method != "exit" {
            continue;
        }
        return Err(core::fmt::format("expected initialize request, got {body}"));
    }
    let mut body = String::new();
    if let Got::End = read_message(inp, &mut body)? {
        return Err(String::from("disconnected channel"));
    }
    let n = parse_message(body.as_str())?;
    if kind_of(&n) == Some(MsgKind::Notification) && method_of(&n) == "initialized" {
        return Ok(snippets);
    }
    return Err(core::fmt::format("expected initialized notification, got: {body}"));
}

/// What the server can do: full text synchronization, hover, go to
/// definition, completion, signature help, references, highlights,
/// renaming, semantic tokens, symbols, inlay hints and quick fixes.
fn capabilities(out: &mut +Json): Value {
    let caps = out.object();
    let t = out.bool(true);
    out.set(caps, "definitionProvider", t);
    let t = out.bool(true);
    out.set(caps, "hoverProvider", t);
    let full = out.int(1);
    out.set(caps, "textDocumentSync", full);
    // Completion, on `.` and `:` (the second of `::`) too.
    let comp = out.object();
    let triggers = out.array();
    let dot = out.string(".");
    out.push(triggers, dot);
    let colon = out.string(":");
    out.push(triggers, colon);
    out.set(comp, "triggerCharacters", triggers);
    let t = out.bool(true);
    out.set(comp, "resolveProvider", t);
    out.set(caps, "completionProvider", comp);
    let sig = out.object();
    let st = out.array();
    let open = out.string("(");
    out.push(st, open);
    let comma = out.string(",");
    out.push(st, comma);
    out.set(sig, "triggerCharacters", st);
    let rt = out.array();
    let comma = out.string(",");
    out.push(rt, comma);
    out.set(sig, "retriggerCharacters", rt);
    out.set(caps, "signatureHelpProvider", sig);
    let t = out.bool(true);
    out.set(caps, "referencesProvider", t);
    let t = out.bool(true);
    out.set(caps, "documentHighlightProvider", t);
    let rn = out.object();
    let t = out.bool(true);
    out.set(rn, "prepareProvider", t);
    out.set(caps, "renameProvider", rn);
    let t = out.bool(true);
    out.set(caps, "documentSymbolProvider", t);
    let t = out.bool(true);
    out.set(caps, "workspaceSymbolProvider", t);
    let t = out.bool(true);
    out.set(caps, "inlayHintProvider", t);
    let t = out.bool(true);
    out.set(caps, "documentFormattingProvider", t);
    let ca = out.object();
    let kinds = out.array();
    let qf = out.string("quickfix");
    out.push(kinds, qf);
    out.set(ca, "codeActionKinds", kinds);
    out.set(caps, "codeActionProvider", ca);
    // Semantic tokens: whole documents (with deltas) and ranges.
    let sem = out.object();
    let legend = out.object();
    let types = out.array();
    for t in symbols::token_types() {
        let v = out.string(t);
        out.push(types, v);
    }
    out.set(legend, "tokenTypes", types);
    let mods = out.array();
    for m in symbols::token_modifiers() {
        let v = out.string(m);
        out.push(mods, v);
    }
    out.set(legend, "tokenModifiers", mods);
    out.set(sem, "legend", legend);
    let fullo = out.object();
    let t = out.bool(true);
    out.set(fullo, "delta", t);
    out.set(sem, "full", fullo);
    let t = out.bool(true);
    out.set(sem, "range", t);
    out.set(caps, "semanticTokensProvider", sem);
    return caps;
}

/// Wait a few milliseconds.
#[cfg(windows)]
fn nap() {
    unsafe {
        Sleep(4);
    }
}

#[cfg(windows)]
extern "C" {
    fn Sleep(ms: u32);
}

#[cfg(not(windows))]
fn nap() {
    unsafe {
        usleep(4000);
    }
}

#[cfg(not(windows))]
extern "C" {
    fn usleep(us: u32): i32;
}

// ===================================================================== analyses

/// The analysis of a crate root.
struct Analysis {
    s: Sema,
    /// The files could be loaded and were analyzed (Rust's `program` is
    /// `Some`): queries can use it.
    ok: bool,
    /// It is a standard library source tree, whose files are the user's.
    std_tree: bool,
    /// Its declarations, indexed when completion first needs them.
    idx: ide::DeclIndex,
}

/// No analysis.
fn empty_analysis(): Analysis {
    return Analysis { s: Sema::new(Program::new(), Craters::new(), Options::host(false)), ok: false, std_tree: false, idx: ide::DeclIndex::new() };
}

/// Analyze `root` as the crater it is in its package (`src/main.ln`,
/// `src/lib.ln` or `tests/*.ln`, with its dependencies), or on its own
/// if it is not one, with the open documents `ov`. A manifest error is
/// reported on the file, which is then analyzed alone.
fn analyze_in_project(ov: Overlay, std_dir: String, root: String): Analysis {
    if let Some(tree) = std_tree_of(root.as_str()) {
        return analyze_std_tree(ov, tree);
    }
    let dir = match parent(root.as_str()) {
        Some(d) => d,
        None => return analyze_alone(ov, std_dir, root),
    };
    if find_project(dir.as_str()).is_none() {
        return analyze_alone(ov, std_dir, root);
    }
    let mut proj = Project::new();
    if let Err(e) = proj.find_workspace(dir.as_str()) {
        return with_project_error(analyze_alone(ov, std_dir, root), e);
    }
    if let Err(e) = proj.resolve(false) {
        return with_project_error(analyze_alone(ov, std_dir, root), e);
    }
    // The member package whose crater this file is. Members are canonical
    // paths, so compare against the canonical form (on Windows this also
    // turns 8.3 short names like `OCS12_~1` into long ones).
    let key = match canonical(root.as_str()) {
        Ok(c) => path_key(c.as_str()),
        Err(_) => path_key(root.as_str()),
    };
    let mut found: Option::<(usize, Target)> = None;
    for i in 0..proj.members {
        if same_key(proj.main_root(i), key.as_str()) {
            found = Some((i, Target::Main));
        } else if same_key(proj.lib_root(i), key.as_str()) {
            found = Some((i, Target::Lib));
        } else {
            let mut tests: [Symbol; ..+] = [];
            proj.test_files(i, &mut tests);
            for t in tests {
                if path_key(proj.text(t)).as_str() == key.as_str() {
                    found = Some((i, Target::TestFile(t)));
                }
            }
        }
        if found.is_some() {
            break;
        }
    }
    let (pkg, target) = match found {
        Some(f) => f,
        None => return analyze_alone(ov, std_dir, root),
    };
    if let Err(e) = proj.craters(pkg, target) {
        return with_project_error(analyze_alone(ov, std_dir, root), e);
    }
    let mut p = Program::new();
    let mut cs = Craters::new();
    cs.overlay = ov;
    for s in proj.specs {
        let r = proj.text(s.root);
        match load_crate(&mut p, &mut cs, proj.text(s.name), r, "") {
            Some(c) => {
                let mut deps: [CraterDep; ..+] = [];
                for d in proj.crater_deps.list(s.deps) {
                    deps.push(CraterDep { name: p.sym(proj.text(d.alias)), index: d.index });
                }
                let mut c = c;
                c.deps = cs.deps.add_list(deps[..]);
                cs.list.push(c);
            }
            None => return not_read(p, cs, String::from(r)),
        }
    }
    return finish_analysis(p, cs, std_dir, false);
}

/// `root` alone.
fn analyze_alone(ov: Overlay, std_dir: String, root: String): Analysis {
    let mut p = Program::new();
    let mut cs = Craters::new();
    cs.overlay = ov;
    let name = sanitize_stem(root.as_str());
    match load_crate(&mut p, &mut cs, name.as_str(), root.as_str(), "") {
        Some(c) => cs.list.push(c),
        None => return not_read(p, cs, root),
    }
    return finish_analysis(p, cs, std_dir, false);
}

/// `a` with the error of its package, where it is in `lunar.toml` (that
/// file joins the analysis, so the editor shows it there).
fn with_project_error(a: Analysis, e: ProjectError): Analysis {
    let mut a = a;
    let mut span = ln_sema::diag::dummy_span();
    if e.file.len() > 0 {
        if let Ok(text) = fs::read_to_string(e.file.as_str()) {
            let mut hi = e.hi as usize;
            if hi > text.len() {
                hi = text.len();
            }
            let mut lo = e.lo as usize;
            if lo > hi {
                lo = hi;
            }
            let name = a.s.p.sym(normalize(e.file.as_str()).as_str());
            let (_, start) = a.s.p.sources.add(name, text.as_str(), None);
            span = Span::new(start + lo as u32, start + hi as u32);
        }
    }
    let m = a.s.p.sym(e.message.as_str());
    a.s.p.diags.error(e.code, span, m);
    if e.label.len() > 0 {
        let l = a.s.p.sym(e.label.as_str());
        a.s.p.diags.label(l);
    }
    // Notes and helps, in order: a kind byte, the text, a NUL.
    let extra = e.extra.as_str();
    let b = extra.as_bytes();
    let mut start: usize = 0;
    for i in 0..b.len() {
        if b[i] == 0 {
            let s = a.s.p.sym(extra[start + 1..i]);
            if b[start] == b'n' {
                a.s.p.diags.note(s);
            } else {
                a.s.p.diags.help(s);
            }
            start = i + 1;
        }
    }
    a.s.p.diags.finish();
    return a;
}

/// Whether `path` (if any) has the key `key`.
fn same_key(path: Option::<String>, key: str): bool {
    return match path {
        Some(p) => path_key(p.as_str()).as_str() == key,
        None => false,
    };
}

/// The standard library tree at `dir` on its own, from disk and the open
/// buffers, for working on std itself.
fn analyze_std_tree(ov: Overlay, dir: String): Analysis {
    let p = Program::new();
    let mut cs = Craters::new();
    cs.overlay = ov;
    return finish_analysis(p, cs, dir, true);
}

/// Load `core` and `std` from `std_dir` and analyze, keeping going after
/// errors.
fn finish_analysis(p: Program, cs: Craters, std_dir: String, std_tree: bool): Analysis {
    let mut p = p;
    let mut cs = cs;
    // Unsaved buffers of std files count only when std is what is being
    // worked on.
    if !std_tree {
        cs.overlay = Overlay::new();
    }
    let names = ["core", "std"];
    for n in names {
        let mut root = String::new();
        root.write("{std_dir}/{n}/lib.ln");
        match load_crate(&mut p, &mut cs, n, root.as_str(), "") {
            Some(c) => cs.list.push(c),
            None => {
                let m = p.sym(core::fmt::format("standard library crater `{n}` not found at {root}").as_str());
                p.diags.error(codes::build::IO(), ln_sema::diag::dummy_span(), m);
                p.diags.finish();
                return Analysis { s: Sema::new(p, cs, Options::host(false)), ok: false, std_tree, idx: ide::DeclIndex::new() };
            }
        }
    }
    let mut opts = Options::host(false);
    opts.keep_going = true;
    let s = analyze(p, cs, opts);
    return Analysis { s, ok: true, std_tree, idx: ide::DeclIndex::new() };
}

/// An analysis of files that could not all be read.
fn not_read(p: Program, cs: Craters, path: String): Analysis {
    let mut p = p;
    let m = p.sym(core::fmt::format("could not read `{path}`").as_str());
    p.diags.error(codes::build::IO(), ln_sema::diag::dummy_span(), m);
    p.diags.finish();
    return Analysis { s: Sema::new(p, cs, Options::host(false)), ok: false, std_tree: false, idx: ide::DeclIndex::new() };
}

/// The file and offset of a position in `path`, if `a` has the file.
fn find_in(a: &Analysis, path: str, line: u32, character: u32): Option::<(u32, u32)> {
    if !a.ok {
        return None;
    }
    let file = ide::file_for_path(&a.s.p, path)?;
    let text = a.s.p.sources.file_text(file);
    let start = a.s.p.sources.files[file as usize].start;
    return Some((file, start + ide::offset_of(text, line, character)));
}

/// The hover at `offset` in `file`, or `null`.
fn hover_in(a: &mut Analysis, file: u32, offset: u32, out: &mut Json): Value {
    return match ide::hover(&mut a.s, file, offset) {
        Some((span, text)) => {
            let h = out.object();
            let contents = out.object();
            let kind = out.string("markdown");
            out.set(contents, "kind", kind);
            let value = out.string(text.as_str());
            out.set(contents, "value", value);
            out.set(h, "contents", contents);
            let r = range_json(out, &a.s.p, span);
            out.set(h, "range", r);
            h
        }
        None => out.null(),
    };
}

/// The definition of the name at `offset` in `file`, or `null`.
fn definition_in(a: &Analysis, st: &State, file: u32, offset: u32, out: &mut Json): Value {
    return match ide::definition(&a.s.p, file, offset) {
        Some(span) => match st.location(out, &a.s.p, span) {
            Some(l) => l,
            None => out.null(),
        },
        None => out.null(),
    };
}

/// Analyses kept in memory: the four used last. A crate whose analysis
/// was dropped is analyzed again when a request needs it.
struct Slots {
    a0: Analysis,
    a1: Analysis,
    a2: Analysis,
    a3: Analysis,
    /// The root (key) each slot holds.
    roots: [Option::<Symbol>; 4],
    used: [u64; 4],
    clock: u64,
}

impl Slots {
    fn slot_of(&self, root: Symbol): Option::<usize> {
        for i in 0..4 {
            if self.roots[i] == Some(root) {
                return Some(i);
            }
        }
        return None;
    }

    fn touch(&mut self, i: usize) {
        self.clock += 1;
        self.used[i] = self.clock;
    }

    fn set(&mut self, i: usize, kept a: Analysis) {
        match i {
            0 => self.a0 = a,
            1 => self.a1 = a,
            2 => self.a2 = a,
            _ => self.a3 = a,
        }
    }

    /// Drop the analysis of `root`, if it is kept.
    fn forget(&mut self, root: Symbol) {
        if let Some(i) = self.slot_of(root) {
            self.set(i, empty_analysis());
            self.roots[i] = None;
        }
    }

    /// Keep `a` as the analysis of `root`, in place of the least recently
    /// used one if every slot is taken: its slot.
    fn keep(&mut self, root: Symbol, kept a: Analysis): usize {
        let mut i = match self.slot_of(root) {
            Some(i) => i,
            None => 4,
        };
        if i == 4 {
            i = 0;
            for k in 0..4 {
                if self.roots[k].is_none() {
                    i = k;
                    break;
                }
                if self.used[k] < self.used[i] {
                    i = k;
                }
            }
        }
        self.set(i, a);
        self.roots[i] = Some(root);
        self.touch(i);
        return i;
    }

    fn ok(&self, i: usize): bool {
        return match i {
            0 => self.a0.ok,
            1 => self.a1.ok,
            2 => self.a2.ok,
            _ => self.a3.ok,
        };
    }

    fn find(&self, i: usize, path: str, line: u32, character: u32): Option::<(u32, u32)> {
        return match i {
            0 => find_in(&self.a0, path, line, character),
            1 => find_in(&self.a1, path, line, character),
            2 => find_in(&self.a2, path, line, character),
            _ => find_in(&self.a3, path, line, character),
        };
    }

    fn hover(&mut self, i: usize, file: u32, offset: u32, out: &mut Json): Value {
        return match i {
            0 => hover_in(&mut self.a0, file, offset, out),
            1 => hover_in(&mut self.a1, file, offset, out),
            2 => hover_in(&mut self.a2, file, offset, out),
            _ => hover_in(&mut self.a3, file, offset, out),
        };
    }

    fn definition(&self, i: usize, st: &State, file: u32, offset: u32, out: &mut Json): Value {
        return match i {
            0 => definition_in(&self.a0, st, file, offset, out),
            1 => definition_in(&self.a1, st, file, offset, out),
            2 => definition_in(&self.a2, st, file, offset, out),
            _ => definition_in(&self.a3, st, file, offset, out),
        };
    }

    /// `answer` with the analysis of slot `i`.
    fn answer(&mut self, i: usize, st: &mut State, req: &Json, method: str, path: str, into: Option::<Value>, out: &mut Json): Result::<Value, String> {
        return match i {
            0 => answer(&mut self.a0, st, req, method, path, into, out),
            1 => answer(&mut self.a1, st, req, method, path, into, out),
            2 => answer(&mut self.a2, st, req, method, path, into, out),
            _ => answer(&mut self.a3, st, req, method, path, into, out),
        };
    }
}

// ===================================================================== answers

/// Requests answered from one analysis without re-analyzing first (with
/// the document's current text).
fn is_lazy(method: str): bool {
    return method == "textDocument/completion" || method == "textDocument/signatureHelp";
}

fn is_document_request(method: str): bool {
    let ms = ["textDocument/completion", "textDocument/signatureHelp", "textDocument/references", "textDocument/documentHighlight", "textDocument/prepareRename", "textDocument/rename", "textDocument/semanticTokens/full", "textDocument/semanticTokens/full/delta", "textDocument/semanticTokens/range", "textDocument/documentSymbol", "textDocument/inlayHint", "textDocument/codeAction"];
    for m in ms {
        if m == method {
            return true;
        }
    }
    return false;
}

/// The `line` and `character` of the request's `position`.
fn request_position(req: &Json): Result::<(u32, u32), String> {
    let pos = match req.path(req.root(), ["params", "position"][..]) {
        Some(p) => p,
        None => return Err(String::from("missing field `position`")),
    };
    return position_numbers(req, pos);
}

fn position_numbers(req: &Json, pos: Value): Result::<(u32, u32), String> {
    let line = match req.get(pos, "line") {
        Some(l) => req.as_u64(l),
        None => None,
    };
    let character = match req.get(pos, "character") {
        Some(c) => req.as_u64(c),
        None => None,
    };
    if line.is_none() || character.is_none() || line.unwrap() > 4294967295 || character.unwrap() > 4294967295 {
        return Err(String::from("invalid `position`: expected `line` and `character` numbers"));
    }
    return Ok((line.unwrap() as u32, character.unwrap() as u32));
}

/// The offsets (in `text`) of the request's `range`, or the whole text.
fn request_range(req: &Json, text: str): Result::<(u32, u32), String> {
    let r = match req.path(req.root(), ["params", "range"][..]) {
        Some(r) => r,
        None => return Ok((0, text.len() as u32)),
    };
    let (l0, c0) = match req.get(r, "start") {
        Some(p) => position_numbers(req, p)?,
        None => return Err(String::from("missing field `range.start`")),
    };
    let (l1, c1) = match req.get(r, "end") {
        Some(p) => position_numbers(req, p)?,
        None => return Err(String::from("missing field `range.end`")),
    };
    return Ok((ide::offset_of(text, l0, c0), ide::offset_of(text, l1, c1)));
}

/// An LSP range in `text` (a document's current text) from offsets.
fn text_range(j: &mut Json, text: str, lo: u32, hi: u32): Value {
    let (l0, c0) = ide::position_of(text, lo);
    let (l1, c1) = ide::position_of(text, hi);
    return range_of(j, l0, c0, l1, c1);
}

/// Answer `method` for the document at `path` from analysis `a`. The
/// `lunar/...ByKey` methods add to `into` the uses, in this analysis, of
/// what `st.ref_key` names; `workspace/symbol` adds its symbols to
/// `into`; `completionItem/resolve` completes the item `into`.
fn answer(a: &mut Analysis, st: &mut State, req: &Json, method: str, path: str, into: Option::<Value>, out: &mut Json): Result::<Value, String> {
    if !a.ok {
        return Ok(out.null());
    }
    if method == "workspace/symbol" {
        let query = match req.path(req.root(), ["params", "query"][..]) {
            Some(q) => String::from(req.as_str(q).unwrap_or("")),
            None => String::new(),
        };
        let arr = into.unwrap();
        let std_key = path_key(st.std_dir.as_str());
        let mut found: [symbols::Found; ..+] = [];
        symbols::workspace_symbols(&a.s.p, if a.std_tree { "" } else { std_key.as_str() }, query.as_str(), 256, &mut found);
        for f in found {
            let d = a.s.p.def(f.def);
            if let Some(loc) = st.location(out, &a.s.p, d.span) {
                let o = out.object();
                let name = out.string(a.s.p.text(d.name));
                out.set(o, "name", name);
                let kind = out.uint(f.kind as u64);
                out.set(o, "kind", kind);
                out.set(o, "location", loc);
                let container = a.s.p.path_of(d.module);
                let c = out.string(container.as_str());
                out.set(o, "containerName", c);
                out.push(arr, o);
            }
        }
        return Ok(arr);
    }
    let file = match ide::file_for_path(&a.s.p, path) {
        Some(f) => f,
        None => return Ok(out.null()),
    };
    let start = a.s.p.sources.files[file as usize].start;
    if method == "completionItem/resolve" {
        let item = into.unwrap();
        let def = match out.path(item, ["data", "def"][..]) {
            Some(d) => out.as_u64(d),
            None => None,
        };
        let label = match out.get(item, "label") {
            Some(l) => String::from(out.as_str(l).unwrap_or("")),
            None => String::new(),
        };
        if let Some(d) = def {
            if (d as usize) < a.s.p.defs.len() {
                let id = DefId::new(d as usize);
                let name = String::from(a.s.p.name(id));
                if label.as_str() == name.as_str() || label.as_str().starts_with(name.as_str()) {
                    let doc = complete::docs_of(&mut a.s, id);
                    if doc.len() > 0 {
                        let md = markdown(out, doc.as_str());
                        out.set(item, "documentation", md);
                    }
                }
            }
        }
        return Ok(item);
    }
    if method == "textDocument/completion" || method == "textDocument/signatureHelp" {
        let (line, ch) = request_position(req)?;
        let key = st.key_of(path);
        let text = match st.docs.get(key) {
            Some(t) => String::from(t),
            None => String::from(a.s.p.sources.file_text(file)),
        };
        let cursor = ide::offset_of(text.as_str(), line, ch);
        let cx = complete::context(&mut a.s, file, text.as_str(), cursor, st.snippets);
        if method == "textDocument/signatureHelp" {
            let sig = match complete::signature_help(&mut a.s, cx, text.as_str()) {
                Some(s) => s,
                None => return Ok(out.null()),
            };
            let res = out.object();
            let sigs = out.array();
            let so = out.object();
            let l = out.string(sig.label.as_str());
            out.set(so, "label", l);
            if sig.doc.len() > 0 {
                let md = markdown(out, sig.doc.as_str());
                out.set(so, "documentation", md);
            }
            let ps = out.array();
            for x in sig.params {
                let (lo, hi) = x;
                let po = out.object();
                let lab = out.array();
                let a0 = out.uint(lo as u64);
                out.push(lab, a0);
                let a1 = out.uint(hi as u64);
                out.push(lab, a1);
                out.set(po, "label", lab);
                out.push(ps, po);
            }
            out.set(so, "parameters", ps);
            out.push(sigs, so);
            out.set(res, "signatures", sigs);
            let z = out.uint(0);
            out.set(res, "activeSignature", z);
            let ap = out.uint(sig.active as u64);
            out.set(res, "activeParameter", ap);
            return Ok(res);
        }
        let mut items = complete::Items::new();
        if a.idx.built {
            items.idx = core::mem::replace(&mut a.idx, ide::DeclIndex::new());
        } else {
            items.idx = ide::DeclIndex::of(&a.s.craters, &a.s.p);
        }
        complete::complete(&mut a.s, cx, text.as_str(), &mut items);
        a.idx = core::mem::replace(&mut items.idx, ide::DeclIndex::new());
        // The best (by group, then as found) if there are very many; long
        // lists leave documentation to `completionItem/resolve`.
        let mut order: [u64; -..+] = [];
        for i in 0..items.list.len() {
            order.push(((items.list[i].sort as u64) << 32) | i as u64);
        }
        order.sort();
        let limit: usize = 1000;
        let mut incomplete = items.incomplete;
        if order.len() > limit {
            order.truncate(limit);
            incomplete = true;
        }
        let with_docs = order.len() <= 200;
        let res = out.object();
        let inc = out.bool(incomplete);
        out.set(res, "isIncomplete", inc);
        let arr = out.array();
        let range = text_range(out, text.as_str(), items.replace_lo, items.replace_hi);
        let uri = st.uri_of(path);
        for oi in order {
            let i = (oi & 4294967295) as usize;
            let it = items.list[i];
            let o = out.object();
            let l = out.string(items.label(i));
            out.set(o, "label", l);
            let k = out.uint(it.kind as u64);
            out.set(o, "kind", k);
            if items.detail(i).len() > 0 {
                let d = out.string(items.detail(i));
                out.set(o, "detail", d);
            }
            if with_docs && items.doc(i).len() > 0 {
                let md = markdown(out, items.doc(i));
                out.set(o, "documentation", md);
            }
            let mut sort = String::new();
            sort.write("{it.sort}{items.label(i)}");
            let so = out.string(sort.as_str());
            out.set(o, "sortText", so);
            let te = out.object();
            let r = out.copy(range);
            out.set(te, "range", r);
            let nt = out.string(items.insert(i));
            out.set(te, "newText", nt);
            out.set(o, "textEdit", te);
            if it.snippet {
                let f = out.uint(2);
                out.set(o, "insertTextFormat", f);
            }
            if it.def > 0 {
                let data = out.object();
                let u = out.string(uri.as_str());
                out.set(data, "uri", u);
                let d = out.uint((it.def - 1) as u64);
                out.set(data, "def", d);
                out.set(o, "data", data);
            }
            out.push(arr, o);
        }
        out.set(res, "items", arr);
        return Ok(res);
    }
    let text = String::from(a.s.p.sources.file_text(file));
    if method == "lunar/refsByKey" || method == "lunar/renameByKey" {
        let into = into.unwrap();
        let t = match find_key(&a.s.p, &st.ref_key) {
            Some(t) => t,
            None => return Ok(into),
        };
        if method == "lunar/refsByKey" {
            let include = match req.path(req.root(), ["params", "context", "includeDeclaration"][..]) {
                Some(v) => req.as_bool(v).unwrap_or(true),
                None => true,
            };
            let mut fam: [RefTarget; ..+] = [];
            refs::family(&a.s.p, t, &mut fam);
            let mut us: [refs::Use; ..+] = [];
            refs::uses(&a.s.p, fam[..], &mut us);
            for u in us {
                if u.decl && !include {
                    continue;
                }
                if let Some(l) = st.location(out, &a.s.p, u.span) {
                    out.push(into, l);
                }
            }
        } else {
            let new_name = new_name_of(req)?;
            let mut edits = refs::Edits::new();
            refs::rename_edits(&a.s.p, t, new_name.as_str(), &mut edits);
            push_edits(st, &a.s.p, &edits, into, out);
        }
        return Ok(into);
    }
    if method == "textDocument/references" || method == "textDocument/documentHighlight" || method == "textDocument/prepareRename" || method == "textDocument/rename" {
        let (line, ch) = request_position(req)?;
        let offset = start + ide::offset_of(text.as_str(), line, ch);
        let (span, t) = match ide::ref_at(&a.s.p, file, offset) {
            Some(x) => x,
            None => {
                if method == "textDocument/prepareRename" || method == "textDocument/rename" {
                    return Err(String::from("no name to rename here"));
                }
                return Ok(if method == "textDocument/references" || method == "textDocument/documentHighlight" { out.array() } else { out.null() });
            }
        };
        let name = refs::target_name(&a.s.p, t);
        // What other analyses of the same files call it.
        st.ref_key = key_of_target(&a.s.p, t);
        if method == "textDocument/references" {
            let include = match req.path(req.root(), ["params", "context", "includeDeclaration"][..]) {
                Some(v) => req.as_bool(v).unwrap_or(true),
                None => true,
            };
            let arr = out.array();
            let mut fam: [RefTarget; ..+] = [];
            refs::family(&a.s.p, t, &mut fam);
            let mut us: [refs::Use; ..+] = [];
            refs::uses(&a.s.p, fam[..], &mut us);
            for u in us {
                if u.decl && !include {
                    continue;
                }
                if let Some(l) = st.location(out, &a.s.p, u.span) {
                    out.push(arr, l);
                }
            }
            return Ok(arr);
        }
        if method == "textDocument/documentHighlight" {
            let arr = out.array();
            let mut fam: [RefTarget; ..+] = [];
            refs::family(&a.s.p, t, &mut fam);
            let mut us: [refs::Use; ..+] = [];
            refs::uses(&a.s.p, fam[..], &mut us);
            for u in us {
                if !ide::in_file(&a.s.p, u.span, file) {
                    continue;
                }
                let o = out.object();
                let r = range_json(out, &a.s.p, u.span);
                out.set(o, "range", r);
                let k = out.uint(if u.decl { 3 } else { 2 });
                out.set(o, "kind", k);
                out.push(arr, o);
            }
            return Ok(arr);
        }
        let std_key = if a.std_tree { String::new() } else { path_key(st.std_dir.as_str()) };
        if let Some(why) = refs::rename_refusal(&a.s.p, std_key.as_str(), t, name.as_str()) {
            return Err(core::fmt::format("cannot rename `{name}`: {why}"));
        }
        if method == "textDocument/prepareRename" {
            let res = out.object();
            let ns = a.s.p.name_span(span, name.as_str());
            let r = range_json(out, &a.s.p, ns);
            out.set(res, "range", r);
            let ph = out.string(name.as_str());
            out.set(res, "placeholder", ph);
            return Ok(res);
        }
        let new_name = new_name_of(req)?;
        let arr = out.array();
        let mut edits = refs::Edits::new();
        refs::rename_edits(&a.s.p, t, new_name.as_str(), &mut edits);
        push_edits(st, &a.s.p, &edits, arr, out);
        return Ok(arr);
    }
    if method == "textDocument/semanticTokens/full" || method == "textDocument/semanticTokens/full/delta" || method == "textDocument/semanticTokens/range" {
        let mut toks: [symbols::SemTok; ..+] = [];
        symbols::semantic_tokens(&a.s.p, file, &mut toks);
        let (lo, hi) = if method == "textDocument/semanticTokens/range" { request_range(req, text.as_str())? } else { (0, text.len() as u32) };
        let mut data: [u32; -..+] = [];
        symbols::encode_tokens(text.as_str(), toks[..], lo, hi, &mut data);
        let res = out.object();
        if method == "textDocument/semanticTokens/range" {
            let arr = u32_array(out, data[..]);
            out.set(res, "data", arr);
            return Ok(res);
        }
        let key = st.key_of(path);
        // A delta against what the client has, if it is what was sent.
        let mut delta = false;
        if method == "textDocument/semanticTokens/full/delta" {
            let prev_id = match req.path(req.root(), ["params", "previousResultId"][..]) {
                Some(v) => String::from(req.as_str(v).unwrap_or("")),
                None => String::new(),
            };
            if let Some(i) = st.sem.find(key) {
                let e = st.sem.list[i];
                if core::fmt::format("{e.id}").as_str() == prev_id.as_str() {
                    let prev = st.sem.data[e.lo as usize..e.hi as usize];
                    let n0 = prev.len();
                    let n1 = data.len();
                    let mut p0: usize = 0;
                    while p0 < n0 && p0 < n1 && prev[p0] == data[p0] {
                        p0 += 1;
                    }
                    let mut s0: usize = 0;
                    while s0 < n0 - p0 && s0 < n1 - p0 && prev[n0 - 1 - s0] == data[n1 - 1 - s0] {
                        s0 += 1;
                    }
                    let edits = out.array();
                    if p0 < n0 - s0 || p0 < n1 - s0 {
                        let ed = out.object();
                        let st0 = out.uint(p0 as u64);
                        out.set(ed, "start", st0);
                        let dc = out.uint((n0 - s0 - p0) as u64);
                        out.set(ed, "deleteCount", dc);
                        let d = u32_array(out, data[p0..n1 - s0]);
                        out.set(ed, "data", d);
                        out.push(edits, ed);
                    }
                    out.set(res, "edits", edits);
                    delta = true;
                }
            }
        }
        if !delta {
            let arr = u32_array(out, data[..]);
            out.set(res, "data", arr);
        }
        let id = st.sem.put(key, data[..]);
        let ids = core::fmt::format("{id}");
        let idv = out.string(ids.as_str());
        out.set(res, "resultId", idv);
        return Ok(res);
    }
    if method == "textDocument/documentSymbol" {
        let mut ol = symbols::Outline::new();
        symbols::outline(&a.s.craters, &a.s.p, file, &mut ol);
        let arr = out.array();
        let mut objs: [Value; ..+] = [];
        let mut kids: [Option::<Value>; ..+] = [];
        for i in 0..ol.list.len() {
            let sy = ol.list[i];
            let o = out.object();
            let n = out.string(ol.name(i));
            out.set(o, "name", n);
            if ol.detail(i).len() > 0 {
                let d = out.string(ol.detail(i));
                out.set(o, "detail", d);
            }
            let k = out.uint(sy.kind as u64);
            out.set(o, "kind", k);
            let r = range_json(out, &a.s.p, sy.range);
            out.set(o, "range", r);
            let sr = range_json(out, &a.s.p, sy.sel);
            out.set(o, "selectionRange", sr);
            objs.push(o);
            kids.push(None);
            if sy.parent == 0 {
                out.push(arr, o);
            } else {
                let pi = (sy.parent - 1) as usize;
                let c = match kids[pi] {
                    Some(c) => c,
                    None => {
                        let c = out.array();
                        out.set(objs[pi], "children", c);
                        kids[pi] = Some(c);
                        c
                    }
                };
                out.push(c, o);
            }
        }
        return Ok(arr);
    }
    if method == "textDocument/inlayHint" {
        let (lo, hi) = request_range(req, text.as_str())?;
        let mut hs = symbols::Hints::new();
        symbols::inlay_hints(&mut a.s, file, start + lo, start + hi, &mut hs);
        let arr = out.array();
        for i in 0..hs.list.len() {
            let h = hs.list[i];
            let o = out.object();
            let (l, c) = ide::position_of(text.as_str(), h.at - start);
            let pos = position_json(out, l, c);
            out.set(o, "position", pos);
            let lab = out.string(hs.label(i));
            out.set(o, "label", lab);
            let k = out.uint(if h.is_type { 1 } else { 2 });
            out.set(o, "kind", k);
            if !h.is_type {
                let t = out.bool(true);
                out.set(o, "paddingRight", t);
            }
            out.push(arr, o);
        }
        return Ok(arr);
    }
    if method == "textDocument/codeAction" {
        let (lo, hi) = request_range(req, text.as_str())?;
        let arr = out.array();
        let uri = st.uri_of(path);
        for d in a.s.p.diags.list {
            if d.suggestions.len() == 0 || is_dummy(d.span) {
                continue;
            }
            let ds = a.s.p.source_span(d.span);
            if a.s.p.sources.file_of(ds.lo) != file || ds.hi < start + lo || ds.lo > start + hi {
                continue;
            }
            let sugs = a.s.p.diags.suggestions.list(d.suggestions).to_grow();
            for sg in sugs[..] {
                let sp = match a.s.p.origin(sg.span) {
                    Some(x) => x,
                    None => continue,
                };
                if !ide::in_file(&a.s.p, sp, file) && !(sp.lo == sp.hi && a.s.p.sources.file_of(sp.lo) == file) {
                    continue;
                }
                let o = out.object();
                let title = out.string(a.s.p.text(sg.title));
                out.set(o, "title", title);
                let kind = out.string("quickfix");
                out.set(o, "kind", kind);
                let diags = out.array();
                let dj = st.lsp_diag(out, &a.s.p, d);
                out.push(diags, dj);
                out.set(o, "diagnostics", diags);
                let pref = out.bool(sugs.len() == 1);
                out.set(o, "isPreferred", pref);
                // The fix may be in another file than the diagnostic.
                let loc = match st.location(out, &a.s.p, sp) {
                    Some(l) => l,
                    None => continue,
                };
                let fix_uri = match out.get(loc, "uri") {
                    Some(u) => String::from(out.as_str(u).unwrap_or(uri.as_str())),
                    None => String::from(uri.as_str()),
                };
                let edit = out.object();
                let changes = out.object();
                let list = out.array();
                let te = out.object();
                let r = range_json(out, &a.s.p, sp);
                out.set(te, "range", r);
                let nt = out.string(a.s.p.text(sg.text));
                out.set(te, "newText", nt);
                out.push(list, te);
                out.set(changes, fix_uri.as_str(), list);
                out.set(edit, "changes", changes);
                out.set(o, "edit", edit);
                out.push(arr, o);
            }
        }
        return Ok(arr);
    }
    return Ok(out.null());
}

/// `params.newName`, if it can name something.
fn new_name_of(req: &Json): Result::<String, String> {
    let n = match req.path(req.root(), ["params", "newName"][..]) {
        Some(v) => String::from(req.as_str(v).unwrap_or("")),
        None => return Err(String::from("missing field `newName`")),
    };
    if !refs::valid_name(n.as_str()) {
        return Err(core::fmt::format("`{n}` is not a valid name"));
    }
    return Ok(n);
}

/// Rename edits as `{ uri, range, newText }` objects, into `arr`.
fn push_edits(st: &State, p: &Program, edits: &refs::Edits, arr: Value, out: &mut Json) {
    for i in 0..edits.list.len() {
        let e = edits.list[i];
        if let Some(l) = st.location(out, p, e.span) {
            let o = out.object();
            if let Some(u) = out.get(l, "uri") {
                let uv = out.copy(u);
                out.set(o, "uri", uv);
            }
            if let Some(r) = out.get(l, "range") {
                let rv = out.copy(r);
                out.set(o, "range", rv);
            }
            let t = out.string(edits.text_of(i));
            out.set(o, "newText", t);
            out.push(arr, o);
        }
    }
}

/// Drop repeated entries of array `arr` (the same location, or the same
/// edit), keeping the first.
fn dedupe_by(out: &mut Json, arr: Value, _edits: bool) {
    let mut seen: [u32; ..+] = [];
    let mut texts = String::new();
    let mut ends: [u32; ..+] = [];
    let mut keep: [Value; ..+] = [];
    let mut m = out.first(arr);
    while let Some(x) = m {
        let s = out.to_string(x);
        let mut dup = false;
        let mut lo: u32 = 0;
        for k in 0..ends.len() {
            if texts.as_str()[lo as usize..ends[k] as usize] == s.as_str() {
                dup = true;
                break;
            }
            lo = ends[k];
        }
        if !dup {
            texts.push_str(s.as_str());
            ends.push(texts.len() as u32);
            keep.push(x);
            seen.push(0);
        }
        m = out.next(x);
    }
    out.clear(arr);
    for x in keep {
        out.push(arr, x);
    }
}

/// A `WorkspaceEdit` from `{ uri, range, newText }` objects.
fn workspace_edit(out: &mut Json, flat: Value): Value {
    let changes = out.object();
    let mut uris = String::new();
    let mut ends: [u32; ..+] = [];
    let mut lists: [Value; ..+] = [];
    let mut m = out.first(flat);
    while let Some(x) = m {
        m = out.next(x);
        let u = match out.get(x, "uri") {
            Some(u) => String::from(out.as_str(u).unwrap_or("")),
            None => continue,
        };
        let mut at: Option::<usize> = None;
        let mut lo: u32 = 0;
        for k in 0..ends.len() {
            if uris.as_str()[lo as usize..ends[k] as usize] == u.as_str() {
                at = Some(k);
                break;
            }
            lo = ends[k];
        }
        let list = match at {
            Some(k) => lists[k],
            None => {
                let l = out.array();
                out.set(changes, u.as_str(), l);
                uris.push_str(u.as_str());
                ends.push(uris.len() as u32);
                lists.push(l);
                l
            }
        };
        let te = out.object();
        if let Some(r) = out.get(x, "range") {
            let rv = out.copy(r);
            out.set(te, "range", rv);
        }
        if let Some(t) = out.get(x, "newText") {
            let tv = out.copy(t);
            out.set(te, "newText", tv);
        }
        out.push(list, te);
    }
    let edit = out.object();
    out.set(edit, "changes", changes);
    return edit;
}

fn u32_array(out: &mut Json, data: [u32; &]): Value {
    let arr = out.array();
    for x in data {
        let v = out.uint(x as u64);
        out.push(arr, v);
    }
    return arr;
}

/// Markdown content.
fn markdown(out: &mut Json, text: str): Value {
    let o = out.object();
    let k = out.string("markdown");
    out.set(o, "kind", k);
    let v = out.string(text);
    out.set(o, "value", v);
    return o;
}

/// How another analysis of the same files finds target `t`: by where its
/// name is declared (definitions and fields; locals stay in one crate).
fn key_of_target(p: &Program, t: RefTarget): RefKey {
    let (span, field) = match t {
        RefTarget::Def(d) => (p.def(d).span, false),
        RefTarget::Field { .. } => match refs::decl_span(p, t) {
            Some(s) => (s, true),
            None => return RefKey::none(),
        },
        _ => return RefKey::none(),
    };
    if is_dummy(span) || p.sources.files.len() == 0 {
        return RefKey::none();
    }
    let f = p.sources.files[p.sources.file_of(span.lo) as usize];
    if f.expansion_site.is_some() {
        return RefKey::none();
    }
    return RefKey { valid: true, field, path: path_key(p.text(f.name)), lo: span.lo - f.start, name: refs::target_name(p, t) };
}

/// What `key` names in `p`.
fn find_key(p: &Program, key: &RefKey): Option::<RefTarget> {
    if !key.valid {
        return None;
    }
    // The file first.
    let mut file: Option::<u32> = None;
    for i in 0..p.sources.files.len() {
        let f = p.sources.files[i];
        if f.expansion_site.is_none() && path_key(p.text(f.name)).as_str() == key.path.as_str() {
            file = Some(i as u32);
            break;
        }
    }
    let file = file?;
    let at = p.sources.files[file as usize].start + key.lo;
    for i in 0..p.defs.len() {
        let d = p.defs[i];
        if !key.field {
            if d.span.lo == at && p.text(d.name) == key.name.as_str() {
                return Some(RefTarget::Def(DefId::new(i)));
            }
            continue;
        }
        if let DefData::Adt(adt) = d.data {
            let vs = p.variants.list(adt.variants);
            for vi in 0..vs.len() {
                let fs = p.fields.list(vs[vi].fields);
                for fi in 0..fs.len() {
                    if fs[fi].span.lo == at && p.text(fs[fi].name) == key.name.as_str() {
                        return Some(RefTarget::Field { adt: DefId::new(i), variant: vi as u32, field: fi as u32 });
                    }
                }
            }
        }
    }
    return None;
}

/// The other crate roots of the package whose library is rooted at
/// `root`: its binary and test files (they depend on the library).
fn package_dependents(st: &mut State, root: str, out: &mut +[Symbol; ..+]) {
    let dir = match parent(root) {
        Some(d) => d,
        None => return,
    };
    if find_project(dir.as_str()).is_none() {
        return;
    }
    let mut proj = Project::new();
    if proj.find_workspace(dir.as_str()).is_err() || proj.resolve(false).is_err() {
        return;
    }
    let key = match canonical(root) {
        Ok(c) => path_key(c.as_str()),
        Err(_) => path_key(root),
    };
    for i in 0..proj.members {
        if !same_key(proj.lib_root(i), key.as_str()) {
            continue;
        }
        if let Some(m) = proj.main_root(i) {
            out.push(st.sym(m.as_str()));
        }
        let mut tests: [Symbol; ..+] = [];
        proj.test_files(i, &mut tests);
        for t in tests {
            out.push(st.sym(proj.text(t)));
        }
    }
}

// ===================================================================== the server

/// The open documents' texts, by path key.
struct Docs {
    text: String,
    list: [Doc; -..+],
    /// Bytes of `text` no document uses any more.
    dead: usize,
}

struct Doc {
    key: Symbol,
    lo: u32,
    hi: u32,
}

impl Docs {
    fn find(&self, key: Symbol): Option::<usize> {
        for i in 0..self.list.len() {
            if self.list[i].key == key {
                return Some(i);
            }
        }
        return None;
    }

    fn get(&self, key: Symbol): Option::<str> {
        let i = self.find(key)?;
        let d = self.list[i];
        return Some(self.text.as_str()[d.lo as usize..d.hi as usize]);
    }

    fn set(&mut self, key: Symbol, text: str) {
        self.remove(key);
        let lo = self.text.len() as u32;
        self.text.push_str(text);
        self.list.push(Doc { key, lo, hi: self.text.len() as u32 });
    }

    fn remove(&mut self, key: Symbol) {
        if let Some(i) = self.find(key) {
            let d = self.list[i];
            self.dead += (d.hi - d.lo) as usize;
            let last = self.list.len() - 1;
            self.list[i] = self.list[last];
            self.list.pop();
        }
        // Copy the live texts once most of the buffer is dead.
        if self.dead > 1048576 && self.dead * 2 > self.text.len() {
            let mut text = String::new();
            for i in 0..self.list.len() {
                let d = self.list[i];
                let lo = text.len() as u32;
                text.push_str(self.text.as_str()[d.lo as usize..d.hi as usize]);
                self.list[i] = Doc { key: d.key, lo, hi: text.len() as u32 };
            }
            self.text = text;
            self.dead = 0;
        }
    }
}

/// A URI with published diagnostics, and the crate root they are from.
struct Published {
    root: Symbol,
    uri: Symbol,
}

/// What the server knows besides the analyses.
struct State {
    std_dir: String,
    /// Paths, path keys and URIs.
    names: Interner,
    /// Open documents by path key.
    docs: Docs,
    /// Crate roots analyzed, by key: the root's path.
    crates: HashMap::<Symbol, Symbol>,
    /// Which crate root each user file was last analyzed under.
    file_root: HashMap::<Symbol, Symbol>,
    /// URIs with published diagnostics, per crate root (to clear them).
    published: [Published; -..+],
    /// The URI the client used for each file it opened, by path key:
    /// replies must use its spelling or it will not know the document.
    uris: HashMap::<Symbol, Symbol>,
    /// Where messages go.
    wire: Wire,
    /// The client takes snippets in completions.
    snippets: bool,
    /// The semantic tokens last sent for each document (for deltas).
    sem: SemCache,
    /// What the last references or rename request was about, to find it
    /// in the analyses of other crates.
    ref_key: RefKey,
}

/// A definition or field, as other analyses of the same files know it: the
/// path key of its file, the offset of its name there, and the name.
struct RefKey {
    valid: bool,
    field: bool,
    path: String,
    lo: u32,
    name: String,
}

impl RefKey {
    fn none(): RefKey {
        return RefKey { valid: false, field: false, path: String::new(), lo: 0, name: String::new() };
    }
}

/// The semantic tokens last sent per document: its key, the result id,
/// and the data (in `data`).
struct SemCache {
    list: [SemEntry; -..+],
    data: [u32; -..+],
    dead: usize,
    next_id: u32,
}

struct SemEntry {
    key: Symbol,
    id: u32,
    lo: u32,
    hi: u32,
}

impl SemCache {
    fn find(&self, key: Symbol): Option::<usize> {
        for i in 0..self.list.len() {
            if self.list[i].key == key {
                return Some(i);
            }
        }
        return None;
    }

    /// Keep `data` as the tokens of `key`: their result id.
    fn put(&mut self, key: Symbol, data: [u32; &]): u32 {
        if let Some(i) = self.find(key) {
            let e = self.list[i];
            self.dead += (e.hi - e.lo) as usize;
            let last = self.list.len() - 1;
            self.list[i] = self.list[last];
            self.list.pop();
        }
        if self.dead > 1048576 && self.dead * 2 > self.data.len() {
            let mut fresh: [u32; -..+] = [];
            for i in 0..self.list.len() {
                let e = self.list[i];
                let lo = fresh.len() as u32;
                fresh.extend(self.data[e.lo as usize..e.hi as usize]);
                self.list[i] = SemEntry { key: e.key, id: e.id, lo, hi: fresh.len() as u32 };
            }
            self.data = fresh;
            self.dead = 0;
        }
        self.next_id += 1;
        let lo = self.data.len() as u32;
        self.data.extend(data);
        self.list.push(SemEntry { key, id: self.next_id, lo, hi: self.data.len() as u32 });
        return self.next_id;
    }
}

impl State {
    /// A state with nothing in it (to stand in while the real one is lent).
    fn blank(): State {
        return State {
            std_dir: String::new(),
            names: Interner::new(),
            docs: Docs { text: String::new(), list: [], dead: 0 },
            crates: HashMap::new(),
            file_root: HashMap::new(),
            published: [],
            uris: HashMap::new(),
            wire: Wire::stdout(),
            snippets: false,
            sem: SemCache { list: [], data: [], dead: 0, next_id: 0 },
            ref_key: RefKey::none(),
        };
    }

    fn sym(&mut +self, s: str): Symbol {
        return self.names.intern(s);
    }

    fn text(&self, s: Symbol): str {
        return self.names.resolve(s);
    }

    fn key_of(&mut +self, path: str): Symbol {
        let k = path_key(path);
        return self.names.intern(k.as_str());
    }

    /// The open documents.
    fn overlay(&self): Overlay {
        let mut o = Overlay::new();
        for d in self.docs.list {
            o.add(self.text(d.key), self.docs.text.as_str()[d.lo as usize..d.hi as usize]);
        }
        return o;
    }

    /// The URI to send the client for `path`: the one it opened the file
    /// with, or one made from the path.
    fn uri_of(&self, path: str): String {
        let k = path_key(path);
        if let Some(ks) = self.names.get(k.as_str()) {
            if let Some(u) = self.uris.get(ks) {
                return String::from(self.text(u));
            }
        }
        return uri_from_path(path);
    }

    /// `span` as an LSP location.
    fn location(&self, j: &mut Json, p: &Program, span: Span): Option::<Value> {
        if is_dummy(span) || p.sources.files.len() == 0 {
            return None;
        }
        let f = p.sources.files[p.sources.file_of(span.lo) as usize];
        if f.expansion_site.is_some() {
            return None;
        }
        let uri = self.uri_of(p.text(f.name));
        let l = j.object();
        let r = range_json(j, p, span);
        j.set(l, "range", r);
        let u = j.string(uri.as_str());
        j.set(l, "uri", u);
        return Some(l);
    }

    /// A diagnostic as the LSP has it (keys in the order serde_json writes
    /// them).
    fn lsp_diag(&self, j: &mut Json, p: &Program, d: Diag): Value {
        let mut message = String::from(p.text(d.message));
        if let Some(l) = d.label {
            message.write(" ({p.text(l)})");
        }
        let span = if is_dummy(d.span) { d.span } else { p.source_span(d.span) };
        if span != d.span {
            let ef = p.sources.file_of(d.span.lo);
            message.write("\nnote: inside the expansion `{p.text(p.sources.files[ef as usize].name)}`:\n{p.sources.file_text(ef)}");
        }
        for n in p.diags.texts.list(d.notes) {
            message.write("\nnote: {p.text(n)}");
        }
        for h in p.diags.texts.list(d.helps) {
            message.write("\nhelp: {p.text(h)}");
        }
        let o = j.object();
        let mut code = String::new();
        code.write("{d.code.scope}::{d.code.name}");
        let c = j.string(code.as_str());
        j.set(o, "code", c);
        let m = j.string(message.as_str());
        j.set(o, "message", m);
        let r = if is_dummy(span) { range_of(j, 0, 0, 0, 0) } else { range_json(j, p, span) };
        j.set(o, "range", r);
        let related = j.array();
        for l in p.diags.labels.list(d.labels) {
            if is_dummy(l.span) {
                continue;
            }
            if let Some(loc) = self.location(j, p, p.source_span(l.span)) {
                let info = j.object();
                j.set(info, "location", loc);
                let lm = j.string(p.text(l.message));
                j.set(info, "message", lm);
                j.push(related, info);
            }
        }
        if j.len(related) > 0 {
            j.set(o, "relatedInformation", related);
        }
        let sev = j.int(if d.severity == Severity::Error { 1 } else { 2 });
        j.set(o, "severity", sev);
        let src = j.string("lunar");
        j.set(o, "source", src);
        return o;
    }

    /// Publish no diagnostics for the URIs `root`'s were published for,
    /// except `keep`; forget them.
    fn clear_published(&mut self, root: Symbol, keep: [Symbol; &]): Result::<(), String> {
        let mut i: usize = 0;
        while i < self.published.len() {
            let p = self.published[i];
            if p.root != root {
                i += 1;
                continue;
            }
            if !keep.contains(p.uri) {
                let mut j = Json::new();
                let empty = j.array();
                let uri = String::from(self.text(p.uri));
                publish(&mut self.wire, &mut j, uri.as_str(), empty)?;
            }
            let last = self.published.len() - 1;
            self.published[i] = self.published[last];
            self.published.pop();
        }
        return Ok(());
    }

    /// The text of `path`: the open document's, else the file's.
    fn read(&mut self, path: str): Option::<String> {
        let k = self.key_of(path);
        if let Some(t) = self.docs.get(k) {
            return Some(String::from(t));
        }
        return fs::read_to_string(path).ok();
    }

    /// The root of the crate that `file` belongs to. `dir/foo.ln` and
    /// `dir/foo/mod.ln` are module `foo`, declared by `mod foo;` in a file
    /// whose child modules live in `dir`: a root file or `mod.ln` in `dir`,
    /// or `dir.ln` next to `dir`. The declaring file may itself be a
    /// module, so the search repeats upwards. A file nobody declares is its
    /// own root.
    fn crate_root_of(&mut self, file: str): String {
        let mut cur = normalize(file);
        for _ in 0..32 {
            match self.declaring_file(cur.as_str()) {
                Some(parent) => {
                    if path_key(parent.as_str()).as_str() == path_key(cur.as_str()).as_str() {
                        break;
                    }
                    cur = parent;
                }
                None => break,
            }
        }
        return cur;
    }

    fn declaring_file(&mut self, file: str): Option::<String> {
        let is_mod_ln = file_name(file) == "mod.ln";
        let mut name = String::new();
        let mut dir = String::new();
        if is_mod_ln {
            let d = parent(file)?;
            name.push_str(file_name(d.as_str()));
            dir = parent(d.as_str())?;
        } else {
            name.push_str(file_stem(file));
            dir = parent(file)?;
        }
        // The candidates, end to end in `texts`.
        let mut texts = String::new();
        let mut ends: [usize; -..+] = [];
        // `dir.ln`, a file whose children live in `dir/`.
        if let Some(up) = parent(dir.as_str()) {
            texts.write("{up}/{file_name(dir.as_str())}.ln");
            ends.push(texts.len());
        }
        // Files in `dir` that own it: `mod.ln` and crate roots.
        // (`read_dir` sorts them by name, as Rust sorts the paths.)
        if let Ok(entries) = fs::read_dir(dir.as_str()) {
            for i in 0..entries.len() {
                let p = join(dir.as_str(), entries.name(i));
                if entries.name(i).ends_with(".ln") && fs::is_file(p.as_str()) {
                    texts.push_str(p.as_str());
                    ends.push(texts.len());
                }
            }
        }
        let file_key = path_key(file);
        let mut start: usize = 0;
        for e in ends {
            let c = String::from(texts.as_str()[start..e]);
            start = e;
            if path_key(c.as_str()).as_str() == file_key.as_str() {
                continue;
            }
            if let Some(text) = self.read(c.as_str()) {
                if declares_mod(text.as_str(), name.as_str()) {
                    return Some(c);
                }
            }
        }
        return None;
    }

    /// The file of the standard library module `module` (`core::string`).
    fn std_file_of(&self, module: str): Option::<String> {
        if module.len() == 0 || self.std_dir.len() == 0 {
            return None;
        }
        let mut parts = String::new();
        let mut first = true;
        for seg in module.split("::") {
            if !first {
                parts.push('/');
            }
            first = false;
            parts.push_str(seg);
        }
        let base = join(self.std_dir.as_str(), parts.as_str());
        if !module.contains("::") {
            let lib = join(base.as_str(), "lib.ln");
            if fs::is_file(lib.as_str()) {
                return Some(lib);
            }
            return None;
        }
        let mut flat = String::from(base.as_str());
        flat.push_str(".ln");
        if fs::is_file(flat.as_str()) {
            return Some(flat);
        }
        let nested = join(base.as_str(), "mod.ln");
        if fs::is_file(nested.as_str()) {
            return Some(nested);
        }
        return None;
    }
}

struct Server {
    st: State,
    slots: Slots,
}

/// A request's position: the analysis (slot) of the document, the file
/// in it, and the offset.
struct Located {
    slot: usize,
    file: u32,
    offset: u32,
}

impl Server {
    fn new(std_dir: String, kept wire: Wire, snippets: bool): Server {
        return Server {
            st: State {
                std_dir,
                names: Interner::new(),
                docs: Docs { text: String::new(), list: [], dead: 0 },
                crates: HashMap::new(),
                file_root: HashMap::new(),
                published: [],
                uris: HashMap::new(),
                wire,
                snippets,
                sem: SemCache { list: [], data: [], dead: 0, next_id: 0 },
                ref_key: RefKey::none(),
            },
            slots: Slots {
                a0: empty_analysis(),
                a1: empty_analysis(),
                a2: empty_analysis(),
                a3: empty_analysis(),
                roots: [None; 4],
                used: [0; 4],
                clock: 0,
            },
        };
    }

    fn main_loop(&mut self, inp: &mut Input): Result::<(), String> {
        // Files changed since their crates were last analyzed.
        let mut dirty: [Symbol; -..+] = [];
        loop {
            // Everything already waiting is handled before re-analyzing.
            let mut texts = String::new();
            let mut batch: [(u32, u32); -..+] = [];
            let mut failure = String::new();
            let mut failed = false;
            let mut ended = false;
            loop {
                let lo = texts.len() as u32;
                match read_message(inp, &mut texts) {
                    Ok(Got::Message) => batch.push((lo, texts.len() as u32)),
                    Ok(Got::End) => {
                        ended = true;
                        break;
                    }
                    Err(e) => {
                        failure = e;
                        failed = true;
                        break;
                    }
                }
                // The client sends nothing after `exit`.
                if let Ok(j) = parse_message(texts.as_str()[lo as usize..]) {
                    if is_exit(&j) {
                        ended = true;
                        break;
                    }
                }
                if !inp.has_message() && (inp.eof || !io::input_available(0)) {
                    break;
                }
            }
            let mut k: usize = 0;
            while k < batch.len() {
                let (lo, hi) = batch[k];
                k += 1;
                let msg = parse_message(texts.as_str()[lo as usize..hi as usize])?;
                let kind = kind_of(&msg).unwrap();
                if kind == MsgKind::Request {
                    if method_of(&msg) == "shutdown" {
                        let mut out = Json::new();
                        let null = out.null();
                        respond(&mut self.st.wire, &msg, &mut out, Some(null), 0, "")?;
                        // The next message must be `exit`.
                        let mut next = String::new();
                        if k < batch.len() {
                            let (a, b) = batch[k];
                            next.push_str(texts.as_str()[a as usize..b as usize]);
                        } else if failed {
                            return Err(failure);
                        } else if ended {
                            return Err(String::from("channel disconnected waiting for exit notification"));
                        } else {
                            if let Got::End = read_message(inp, &mut next)? {
                                return Err(String::from("channel disconnected waiting for exit notification"));
                            }
                        }
                        let n = parse_message(next.as_str())?;
                        if is_exit(&n) {
                            return Ok(());
                        }
                        return Err(core::fmt::format("unexpected message during shutdown: {next}"));
                    }
                    // Answer against up-to-date analyses; completion and
                    // signature help do with the last one of the crate (and
                    // the current text), so typing does not wait.
                    if !(is_lazy(method_of(&msg)) && self.analyzed(&msg)) {
                        self.reanalyze(dirty[..])?;
                        dirty.clear();
                    }
                    self.request(&msg)?;
                } else if kind == MsgKind::Notification {
                    if let Some(path) = self.notification(&msg)? {
                        if !dirty[..].contains(path) {
                            dirty.push(path);
                        }
                    }
                }
            }
            // While typing goes on (or a request about it is on its way),
            // wait with the analysis: a moment without input first.
            if dirty.len() > 0 && !inp.eof && !failed && !ended {
                let mut waited = 0;
                while waited < 8 && !inp.has_message() && !io::input_available(0) {
                    nap();
                    waited += 1;
                }
                if inp.has_message() || io::input_available(0) {
                    continue;
                }
            }
            self.reanalyze(dirty[..])?;
            dirty.clear();
            if failed {
                return Err(failure);
            }
            if ended {
                return Ok(());
            }
        }
    }

    // ----------------------------------------------------------- notifications

    /// Apply a document notification: the path of the file that changed.
    fn notification(&mut self, n: &Json): Result::<Option::<Symbol>, String> {
        let method = method_of(n);
        let params = match n.get(n.root(), "params") {
            Some(p) => p,
            None => return Ok(None),
        };
        let uri = match n.path(params, ["textDocument", "uri"][..]) {
            Some(u) => n.as_str(u).unwrap_or(""),
            None => "",
        };
        let path = match to_path(uri) {
            Some(p) => p,
            None => return Ok(None),
        };
        let path_sym = self.st.sym(path.as_str());
        let key = self.st.key_of(path.as_str());
        if method == "textDocument/didOpen" {
            let text = match n.path(params, ["textDocument", "text"][..]) {
                Some(t) => n.as_str(t).unwrap_or(""),
                None => return Ok(None),
            };
            let u = self.st.sym(uri);
            self.st.uris.insert(key, u);
            self.st.docs.set(key, text);
            return Ok(Some(path_sym));
        }
        if method == "textDocument/didChange" {
            // Full synchronization: the last change is the whole text.
            if let Some(changes) = n.get(params, "contentChanges") {
                let mut last: Option::<Value> = None;
                let mut c = n.first(changes);
                while let Some(x) = c {
                    last = Some(x);
                    c = n.next(x);
                }
                if let Some(x) = last {
                    if let Some(t) = n.get(x, "text") {
                        self.st.docs.set(key, n.as_str(t).unwrap_or(""));
                    }
                }
            }
            return Ok(Some(path_sym));
        }
        if method == "textDocument/didClose" {
            self.st.docs.remove(key);
            // Drop crates that no longer have any open file.
            let mut roots: [Symbol; -..+] = [];
            for r in self.st.crates.keys() {
                roots.push(r);
            }
            for root in roots {
                let mut open = false;
                for e in self.st.file_root.iter() {
                    let (f, r) = e;
                    if r == root && self.st.docs.find(f).is_some() {
                        open = true;
                        break;
                    }
                }
                if !open {
                    self.drop_crate(root)?;
                }
            }
            // Other open files of its crate still see the text on disk.
            if self.st.file_root.contains(key) {
                return Ok(Some(path_sym));
            }
            return Ok(None);
        }
        return Ok(None);
    }

    /// Forget crate `root`: its analysis, its files, and its diagnostics
    /// (cleared in the editor).
    fn drop_crate(&mut self, root: Symbol): Result::<(), String> {
        self.st.crates.remove(root);
        self.slots.forget(root);
        let mut gone: [Symbol; -..+] = [];
        for e in self.st.file_root.iter() {
            let (f, r) = e;
            if r == root {
                gone.push(f);
            }
        }
        for f in gone {
            self.st.file_root.remove(f);
        }
        return self.st.clear_published(root, [][..]);
    }

    // ----------------------------------------------------------- analysis

    /// Re-analyze the crates of the files that changed.
    fn reanalyze(&mut self, changed: [Symbol; &]): Result::<(), String> {
        let mut roots: [Symbol; -..+] = [];
        let mut keys: [Symbol; -..+] = [];
        for path in changed {
            let p = String::from(self.st.text(path));
            let key = self.st.key_of(p.as_str());
            let root = match self.st.file_root.get(key) {
                Some(r) => match self.st.crates.get(r) {
                    Some(rp) => String::from(self.st.text(rp)),
                    None => p,
                },
                // Not part of any analyzed crate yet: a module file opened
                // on its own belongs to the crate of the file that declares
                // it. Every file of a std source tree is analyzed under one
                // root.
                None => match std_tree_of(p.as_str()) {
                    Some(tree) => join(tree.as_str(), "std/lib.ln"),
                    None => self.st.crate_root_of(p.as_str()),
                },
            };
            let rs = self.st.sym(root.as_str());
            let rk = self.st.key_of(root.as_str());
            if !keys[..].contains(rk) {
                keys.push(rk);
                roots.push(rs);
            }
        }
        for r in roots {
            self.analyze_root(r)?;
        }
        return Ok(());
    }

    /// Analyze the crate rooted at `root` (a path), publish its
    /// diagnostics and keep the analysis: its slot.
    fn analyze_root(&mut self, root: Symbol): Result::<usize, String> {
        let root_path = String::from(self.st.text(root));
        let root_key = self.st.key_of(root_path.as_str());
        let ov = self.st.overlay();
        let a = analyze_in_project(ov, String::from(self.st.std_dir.as_str()), String::from(root_path.as_str()));
        // Record which user files belong to this crate. A file that was its
        // own root but is now a module of this crate stops being a root.
        let mut files: [(u32, Symbol, Symbol); -..+] = [];
        let std_key = path_key(self.st.std_dir.as_str());
        // Dependencies checked out from git are not the user's to fix.
        let home_key = path_key(normalize(git::home().as_str()).as_str());
        for i in 0..a.s.p.sources.files.len() {
            let f = a.s.p.sources.files[i];
            if f.expansion_site.is_some() {
                continue;
            }
            let name = String::from(a.s.p.text(f.name));
            if (!a.std_tree && under(std_key.as_str(), name.as_str())) || under(home_key.as_str(), name.as_str()) {
                continue;
            }
            let k = self.st.key_of(name.as_str());
            let ps = self.st.sym(name.as_str());
            files.push((i as u32, k, ps));
        }
        for x in files {
            let (_, k, _) = x;
            if k != root_key && self.st.crates.contains(k) {
                self.drop_crate(k)?;
            }
            self.st.file_root.insert(k, root_key);
        }
        // Diagnostics per file.
        let root_file = ide::file_for_path(&a.s.p, root_path.as_str());
        let mut now: [Symbol; -..+] = [];
        for x in files {
            let (file, _, path) = x;
            let uri = self.st.uri_of(self.st.text(path));
            let mut j = Json::new();
            let list = j.array();
            for d in a.s.p.diags.list {
                let in_file = if is_dummy(d.span) {
                    root_file == Some(file)
                } else {
                    a.s.p.sources.file_of(a.s.p.source_span(d.span).lo) == file
                };
                if in_file {
                    let v = self.st.lsp_diag(&mut j, &a.s.p, d);
                    j.push(list, v);
                }
            }
            publish(&mut self.st.wire, &mut j, uri.as_str(), list)?;
            let us = self.st.sym(uri.as_str());
            now.push(us);
        }
        self.st.clear_published(root_key, now[..])?;
        for u in now {
            self.st.published.push(Published { root: root_key, uri: u });
        }
        self.st.crates.insert(root_key, root);
        return Ok(self.slots.keep(root_key, a));
    }

    // ----------------------------------------------------------- requests

    fn request(&mut self, req: &Json): Result::<(), String> {
        let method = String::from(method_of(req));
        let m = method.as_str();
        let mut out = Json::new();
        let params = req.get(req.root(), "params");
        let r = if m == "textDocument/hover" {
            self.hover(req, params, &mut out)
        } else if m == "textDocument/definition" {
            self.definition(req, params, &mut out)
        } else if m == "lunar/stdSource" {
            self.st.std_source(req, params, &mut out)
        } else if m == "workspace/symbol" {
            self.workspace_symbol(req, &mut out)
        } else if m == "completionItem/resolve" {
            self.resolve_completion(req, &mut out)
        } else if m == "textDocument/formatting" {
            self.format(req, &mut out)
        } else if is_document_request(m) {
            self.document_request(req, m, &mut out)
        } else {
            let msg = core::fmt::format("unsupported request `{method}`");
            return respond(&mut self.st.wire, req, &mut out, None, -32601, msg.as_str());
        };
        return match r {
            Ok(v) => respond(&mut self.st.wire, req, &mut out, Some(v), 0, ""),
            Err(e) => respond(&mut self.st.wire, req, &mut out, None, -32602, e.as_str()),
        };
    }

    /// Whether the analysis of the document of `msg` (a request) is kept.
    fn analyzed(&mut self, msg: &Json): bool {
        let uri = match msg.path(msg.root(), ["params", "textDocument", "uri"][..]) {
            Some(u) => String::from(msg.as_str(u).unwrap_or("")),
            None => return false,
        };
        let path = match to_path(uri.as_str()) {
            Some(p) => p,
            None => return false,
        };
        let key = self.st.key_of(path.as_str());
        return match self.st.file_root.get(key) {
            Some(r) => self.slots.slot_of(r).is_some(),
            None => false,
        };
    }

    /// The analysis (slot) of a document and its path, analyzing its crate
    /// again if its analysis is not kept.
    fn locate_doc(&mut self, uri: str): Result::<Option::<(usize, String)>, String> {
        if uri.starts_with("lunar-std:") {
            let module = std_module_of(uri);
            let path = match self.st.std_file_of(module.as_str()) {
                Some(p) => p,
                None => return Ok(None),
            };
            for i in 0..4 {
                if self.slots.roots[i].is_none() || !self.slots.ok(i) {
                    continue;
                }
                if self.slots.find(i, path.as_str(), 0, 0).is_some() {
                    self.slots.touch(i);
                    return Ok(Some((i, path)));
                }
            }
            return Ok(None);
        }
        let path = match to_path(uri) {
            Some(p) => p,
            None => return Ok(None),
        };
        let key = self.st.key_of(path.as_str());
        let root = match self.st.file_root.get(key) {
            Some(r) => r,
            None => return Ok(None),
        };
        let slot = match self.slots.slot_of(root) {
            Some(i) => i,
            None => match self.st.crates.get(root) {
                Some(rp) => self.analyze_root(rp)?,
                None => return Ok(None),
            },
        };
        self.slots.touch(slot);
        return Ok(Some((slot, path)));
    }

    /// A request about a document (`textDocument/...`).
    fn document_request(&mut self, req: &Json, method: str, out: &mut Json): Result::<Value, String> {
        let uri = match req.path(req.root(), ["params", "textDocument", "uri"][..]) {
            Some(u) => match req.as_str(u) {
                Some(s) => String::from(s),
                None => return Err(String::from("invalid type: expected a string for `textDocument.uri`")),
            },
            None => return Err(String::from("missing field `textDocument`")),
        };
        let (slot, path) = match self.locate_doc(uri.as_str())? {
            Some(x) => x,
            None => {
                return Ok(if method == "textDocument/references" || method == "textDocument/documentHighlight" || method == "textDocument/documentSymbol" || method == "textDocument/inlayHint" || method == "textDocument/codeAction" {
                    out.array()
                } else {
                    out.null()
                });
            }
        };
        self.st.ref_key = RefKey::none();
        let v = self.ask(slot, req, method, path.as_str(), None, out)?;
        if method == "textDocument/references" || method == "textDocument/rename" {
            if self.st.ref_key.valid {
                self.dependents(slot, req, method, path.as_str(), v, out)?;
            }
            dedupe_by(out, v, method == "textDocument/rename");
            if method == "textDocument/rename" {
                return Ok(workspace_edit(out, v));
            }
        }
        return Ok(v);
    }

    /// For references and renaming: the uses in the other crates of the
    /// package that depend on the document's crate (its binary and tests,
    /// for a library), appended to `into`.
    fn dependents(&mut self, slot: usize, req: &Json, method: str, path: str, into: Value, out: &mut Json): Result::<(), String> {
        let root_key = match self.slots.roots[slot] {
            Some(k) => k,
            None => return Ok(()),
        };
        let root = match self.st.crates.get(root_key) {
            Some(r) => String::from(self.st.text(r)),
            None => return Ok(()),
        };
        let mut others: [Symbol; ..+] = [];
        package_dependents(&mut self.st, root.as_str(), &mut others);
        let extra = if method == "textDocument/references" { "lunar/refsByKey" } else { "lunar/renameByKey" };
        for r in others {
            let rk = self.st.key_of(self.st.text(r));
            if rk == root_key {
                continue;
            }
            match self.slots.slot_of(rk) {
                Some(i) => {
                    self.ask(i, req, extra, path, Some(into), out)?;
                }
                None => {
                    let ov = self.st.overlay();
                    let rp = String::from(self.st.text(r));
                    let mut a = analyze_in_project(ov, String::from(self.st.std_dir.as_str()), rp);
                    answer(&mut a, &mut self.st, req, extra, path, Some(into), out)?;
                }
            }
        }
        return Ok(());
    }

    /// `workspace/symbol`: matching definitions in every analysis kept.
    fn workspace_symbol(&mut self, req: &Json, out: &mut Json): Result::<Value, String> {
        let all = out.array();
        for i in 0..4 {
            if self.slots.roots[i].is_none() || !self.slots.ok(i) {
                continue;
            }
            self.ask(i, req, "workspace/symbol", "", Some(all), out)?;
        }
        dedupe_by(out, all, false);
        return Ok(all);
    }

    /// `completionItem/resolve`: the item, with its documentation.
    fn resolve_completion(&mut self, req: &Json, out: &mut Json): Result::<Value, String> {
        let item = match req.get(req.root(), "params") {
            Some(p) => out.copy_from(req, p),
            None => return Err(String::from("missing `params`")),
        };
        if out.get(item, "documentation").is_some() {
            return Ok(item);
        }
        let uri = match out.path(item, ["data", "uri"][..]) {
            Some(u) => String::from(out.as_str(u).unwrap_or("")),
            None => return Ok(item),
        };
        let path = match to_path(uri.as_str()) {
            Some(p) => p,
            None => return Ok(item),
        };
        let key = self.st.key_of(path.as_str());
        let slot = match self.st.file_root.get(key) {
            Some(r) => match self.slots.slot_of(r) {
                Some(i) => i,
                None => return Ok(item),
            },
            None => return Ok(item),
        };
        self.ask(slot, req, "completionItem/resolve", path.as_str(), Some(item), out)?;
        return Ok(item);
    }

    /// `answer` from the analysis of `slot` (the state is taken out of the
    /// server for the call, as both are lent in-out).
    fn ask(&mut self, slot: usize, req: &Json, method: str, path: str, into: Option::<Value>, out: &mut Json): Result::<Value, String> {
        let mut st = core::mem::replace(&mut self.st, State::blank());
        let r = self.slots.answer(slot, &mut st, req, method, path, into, out);
        self.st = st;
        return r;
    }

    fn hover(&mut self, req: &Json, params: Option::<Value>, out: &mut Json): Result::<Value, String> {
        let (uri, line, character) = position(req, params)?;
        return match self.locate(uri.as_str(), line, character)? {
            Some(loc) => Ok(self.slots.hover(loc.slot, loc.file, loc.offset, out)),
            None => Ok(out.null()),
        };
    }

    fn definition(&mut self, req: &Json, params: Option::<Value>, out: &mut Json): Result::<Value, String> {
        let (uri, line, character) = position(req, params)?;
        return match self.locate(uri.as_str(), line, character)? {
            Some(loc) => Ok(self.slots.definition(loc.slot, &self.st, loc.file, loc.offset, out)),
            None => Ok(out.null()),
        };
    }

    /// `textDocument/formatting`: the document as `lunar fmt` formats it,
    /// as one edit of the whole text (none if it is formatted already).
    /// A document with syntax errors is left alone: `null`, as is one the
    /// formatter cannot format without changing its meaning.
    fn format(&mut self, req: &Json, out: &mut Json): Result::<Value, String> {
        let uri = match req.path(req.root(), ["params", "textDocument", "uri"][..]) {
            Some(u) => match req.as_str(u) {
                Some(s) => String::from(s),
                None => return Err(String::from("invalid type: expected a string for `textDocument.uri`")),
            },
            None => return Err(String::from("missing field `textDocument`")),
        };
        let path = match to_path(uri.as_str()) {
            Some(p) => p,
            None => return Ok(out.null()),
        };
        let key = self.st.key_of(path.as_str());
        let text = match self.st.docs.get(key) {
            Some(t) => String::from(t),
            None => match std::fs::read_to_string(path.as_str()) {
                Ok(t) => t,
                Err(_) => return Ok(out.null()),
            },
        };
        let formatted = match ln_fmt::format_source(text.as_str()) {
            Ok(f) => f,
            Err(_) => return Ok(out.null()),
        };
        let edits = out.array();
        if formatted.as_str() != text.as_str() {
            let e = out.object();
            let r = text_range(out, text.as_str(), 0, text.len() as u32);
            out.set(e, "range", r);
            let nt = out.string(formatted.as_str());
            out.set(e, "newText", nt);
            out.push(edits, e);
        }
        return Ok(edits);
    }

    /// The analysis, file and offset of a document position, analyzing the
    /// document's crate again if its analysis is not kept.
    fn locate(&mut self, uri: str, line: u32, character: u32): Result::<Option::<Located>, String> {
        if uri.starts_with("lunar-std:") {
            // Any analysis has the same standard library.
            let module = std_module_of(uri);
            let path = match self.st.std_file_of(module.as_str()) {
                Some(p) => p,
                None => return Ok(None),
            };
            for i in 0..4 {
                if self.slots.roots[i].is_none() || !self.slots.ok(i) {
                    continue;
                }
                if let Some((file, offset)) = self.slots.find(i, path.as_str(), line, character) {
                    self.slots.touch(i);
                    return Ok(Some(Located { slot: i, file, offset }));
                }
            }
            return Ok(None);
        }
        let path = match to_path(uri) {
            Some(p) => p,
            None => return Ok(None),
        };
        let key = self.st.key_of(path.as_str());
        let root = match self.st.file_root.get(key) {
            Some(r) => r,
            None => return Ok(None),
        };
        let slot = match self.slots.slot_of(root) {
            Some(i) => i,
            None => match self.st.crates.get(root) {
                Some(rp) => self.analyze_root(rp)?,
                None => return Ok(None),
            },
        };
        self.slots.touch(slot);
        return match self.slots.find(slot, path.as_str(), line, character) {
            Some((file, offset)) => Ok(Some(Located { slot, file, offset })),
            None => Ok(None),
        };
    }
}

impl State {
    /// `lunar/stdSource`: the text of a `lunar-std:` document.
    fn std_source(&self, req: &Json, params: Option::<Value>, out: &mut Json): Result::<Value, String> {
        let uri = match params {
            Some(p) => match req.get(p, "uri") {
                Some(u) => req.as_str(u),
                None => None,
            },
            None => None,
        };
        let uri = match uri {
            Some(u) => u,
            None => return Err(String::from("missing `uri`")),
        };
        if !uri.starts_with("lunar-std:") {
            return Err(core::fmt::format("not a `lunar-std:` URI: {uri}"));
        }
        let module = std_module_of(uri);
        if let Some(path) = self.std_file_of(module.as_str()) {
            if let Ok(t) = fs::read_to_string(path.as_str()) {
                return Ok(out.string(t.as_str()));
            }
        }
        return Err(core::fmt::format("no standard library module `{module}`"));
    }
}

/// The `textDocument` URI and `position` of a request.
fn position(req: &Json, params: Option::<Value>): Result::<(String, u32, u32), String> {
    let params = match params {
        Some(p) => p,
        None => return Err(String::from("invalid type: null, expected struct TextDocumentPositionParams")),
    };
    let uri = match req.path(params, ["textDocument", "uri"][..]) {
        Some(u) => match req.as_str(u) {
            Some(s) => s,
            None => return Err(String::from("invalid type: expected a string for `textDocument.uri`")),
        },
        None => return Err(String::from("missing field `textDocument`")),
    };
    let pos = match req.get(params, "position") {
        Some(p) => p,
        None => return Err(String::from("missing field `position`")),
    };
    let line = match req.get(pos, "line") {
        Some(l) => req.as_u64(l),
        None => None,
    };
    let character = match req.get(pos, "character") {
        Some(c) => req.as_u64(c),
        None => None,
    };
    if line.is_none() || character.is_none() || line.unwrap() > 4294967295 || character.unwrap() > 4294967295 {
        return Err(String::from("invalid `position`: expected `line` and `character` numbers"));
    }
    return Ok((String::from(uri), line.unwrap() as u32, character.unwrap() as u32));
}

// ===================================================================== JSON

/// `textDocument/publishDiagnostics` for `uri`.
fn publish(w: &mut +Wire, j: &mut Json, uri: str, diagnostics: Value): Result::<(), String> {
    let m = j.object();
    let method = j.string("textDocument/publishDiagnostics");
    j.set(m, "method", method);
    let params = j.object();
    j.set(params, "diagnostics", diagnostics);
    let u = j.string(uri);
    j.set(params, "uri", u);
    j.set(m, "params", params);
    return send(w, j, m);
}

/// An LSP range for `span` (in its file).
fn range_json(j: &mut Json, p: &Program, span: Span): Value {
    let file = p.sources.file_of(span.lo);
    let text = p.sources.file_text(file);
    let start = p.sources.files[file as usize].start;
    let (l0, c0) = ide::position_of(text, span.lo - start);
    let (l1, c1) = ide::position_of(text, if span.hi >= start { span.hi - start } else { 0 });
    return range_of(j, l0, c0, l1, c1);
}

fn range_of(j: &mut Json, l0: u32, c0: u32, l1: u32, c1: u32): Value {
    let r = j.object();
    let end = position_json(j, l1, c1);
    j.set(r, "end", end);
    let start = position_json(j, l0, c0);
    j.set(r, "start", start);
    return r;
}

fn position_json(j: &mut Json, line: u32, character: u32): Value {
    let p = j.object();
    let c = j.uint(character as u64);
    j.set(p, "character", c);
    let l = j.uint(line as u64);
    j.set(p, "line", l);
    return p;
}

// ===================================================================== paths and URIs

/// The canonical path of a document, so that the same file always has the
/// same path (on Windows: long names instead of 8.3 short ones), matching
/// the canonical paths projects use.
fn to_path(uri: str): Option::<String> {
    let p = uri_path(uri)?;
    return match canonical(p.as_str()) {
        Ok(c) => Some(c),
        Err(_) => Some(p),
    };
}

/// The path of a `file:` URI.
fn uri_path(uri: str): Option::<String> {
    if !uri.starts_with("file://") {
        return None;
    }
    let rest = uri[7..];
    // `file://host/path`: only the local host.
    let slash = rest.find("/")?;
    let host = rest[..slash];
    if host.len() > 0 && host != "localhost" {
        return None;
    }
    let mut path = percent_decode(rest[slash..]);
    // `/C:/x` is `C:/x`.
    if is_drive_path(path.as_str()) {
        path = String::from(path.as_str()[1..]);
    }
    return Some(path);
}

/// Whether `p` is `/C:` and the rest of a Windows path.
fn is_drive_path(p: str): bool {
    let b = p.as_bytes();
    return b.len() >= 3 && b[0] == b'/' && b[2] == b':' && ((b[1] >= b'a' && b[1] <= b'z') || (b[1] >= b'A' && b[1] <= b'Z'));
}

fn percent_decode(s: str): String {
    let b = s.as_bytes();
    let mut out: [u8; -..+] = [];
    let mut i: usize = 0;
    while i < b.len() {
        if b[i] == b'%' && i + 2 < b.len() && hex_digit(b[i + 1]).is_some() && hex_digit(b[i + 2]).is_some() {
            out.push(hex_digit(b[i + 1]).unwrap() * 16 + hex_digit(b[i + 2]).unwrap());
            i += 3;
        } else {
            out.push(b[i]);
            i += 1;
        }
    }
    return lossy(out[..]);
}

fn hex_digit(c: u8): Option::<u8> {
    if c >= b'0' && c <= b'9' {
        return Some(c - b'0');
    }
    if c >= b'a' && c <= b'f' {
        return Some(c - b'a' + 10);
    }
    if c >= b'A' && c <= b'F' {
        return Some(c - b'A' + 10);
    }
    return None;
}

/// A `file:` URI for `path`, encoded as the `url` crate encodes paths.
pub fn uri_from_path(path: str): String {
    let mut out = String::from("file://");
    let norm = normalize(path);
    if !norm.as_str().starts_with("/") {
        out.push('/');
    }
    let hex = "0123456789ABCDEF".as_bytes();
    let b = norm.as_bytes();
    let mut start: usize = 0;
    for i in 0..b.len() {
        let c = b[i];
        let plain = c > 32 && c < 127 && c != b'"' && c != b'#' && c != b'<' && c != b'>' && c != b'?' && c != b'`' && c != b'{' && c != b'}' && c != b'%';
        if plain {
            continue;
        }
        out.push_str(norm.as_str()[start..i]);
        out.push('%');
        out.push(hex[(c >> 4) as usize] as char);
        out.push(hex[(c & 15) as usize] as char);
        start = i + 1;
    }
    out.push_str(norm.as_str()[start..]);
    return out;
}

/// The module path of a `lunar-std:` URI. Clients may percent-encode it
/// (VS Code sends `lunar-std:core%3A%3Aslice`).
fn std_module_of(uri: str): String {
    let decoded = percent_decode(uri[10..]);
    let mut t = decoded.as_str();
    while t.starts_with("/") {
        t = t[1..];
    }
    return String::from(t);
}

/// Whether `path` is under the directory whose key is `dir_key`.
fn under(dir_key: str, path: str): bool {
    if dir_key.len() == 0 {
        return false;
    }
    let k = path_key(path);
    return k.len() > dir_key.len() && k.as_str().starts_with(dir_key) && k.as_bytes()[dir_key.len()] == b'/';
}

/// The root of the standard library source tree that `path` belongs to:
/// an ancestor directory with `core/lib.ln` and `std/lib.ln`, with `path`
/// under its `core/` or `std/`. Such files are the standard library being
/// worked on, not programs.
fn std_tree_of(path: str): Option::<String> {
    let norm = normalize(path);
    let mut cur = parent(norm.as_str());
    while let Some(d) = cur {
        let core_dir = join(d.as_str(), "core");
        let std_dir = join(d.as_str(), "std");
        let inside = under(path_key(core_dir.as_str()).as_str(), norm.as_str()) || under(path_key(std_dir.as_str()).as_str(), norm.as_str());
        if inside && fs::is_file(join(core_dir.as_str(), "lib.ln").as_str()) && fs::is_file(join(std_dir.as_str(), "lib.ln").as_str()) {
            return Some(d);
        }
        cur = parent(d.as_str());
    }
    return None;
}

/// The last component of a path.
fn file_name(p: str): str {
    let b = p.as_bytes();
    let mut i = b.len();
    while i > 0 && b[i - 1] != b'/' && b[i - 1] != b'\\' {
        i -= 1;
    }
    return p[i..];
}

/// The file name without its extension.
fn file_stem(p: str): str {
    let name = file_name(p);
    let b = name.as_bytes();
    let mut i = b.len();
    while i > 0 {
        i -= 1;
        if b[i] == b'.' {
            if i == 0 {
                return name;
            }
            return name[..i];
        }
    }
    return name;
}

/// A crater name from a file name: letters, digits and `_` (as the Rust
/// driver's `sanitize`).
fn sanitize_stem(path: str): String {
    let mut out = String::new();
    for c in file_stem(path).chars() {
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        out.push(if ok { c } else { '_' });
    }
    if out.len() == 0 || (out.as_bytes()[0] >= b'0' && out.as_bytes()[0] <= b'9') {
        let mut s = String::from("_");
        s.push_str(out.as_str());
        return s;
    }
    return out;
}

/// Whether `text` has a `mod name;` declaration (possibly `pub`).
fn declares_mod(text: str, name: str): bool {
    for line in text.lines() {
        let mut t = line.trim();
        if t.starts_with("pub ") {
            t = trim_start(t[4..]);
        }
        if !t.starts_with("mod ") {
            continue;
        }
        let rest = trim_start(t[4..]);
        if !rest.starts_with(name) {
            continue;
        }
        if trim_start(rest[name.len()..]).starts_with(";") {
            return true;
        }
    }
    return false;
}

fn trim_start(s: str): str {
    let b = s.as_bytes();
    let mut i: usize = 0;
    while i < b.len() && (b[i] == b' ' || b[i] == b'\t' || b[i] == b'\r' || b[i] == b'\n') {
        i += 1;
    }
    return s[i..];
}
