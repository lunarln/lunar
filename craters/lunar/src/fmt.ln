// `lunar fmt`: format source files with `ln_fmt` (docs/style.md).
//
//     lunar fmt                  the current package's `.ln` files (at a
//                                workspace root, every member's; `-p`
//                                picks one)
//     lunar fmt FILE...          those files
//     lunar fmt --check ...      change nothing: list the files that would
//                                change, and exit with 1 if any would
//     lunar fmt -                standard input to standard output
//
// A file with syntax errors is left as it is, and its errors are shown as
// `lunar check` shows them. So is a file the formatter cannot format
// without changing its meaning (a bug in the formatter, which checks every
// result).

use std::fs;
use ln_fmt::{FmtErrorKind, format_source};
use ln_sema::codes::manifest;
use ln_sema::program::Program;
use ln_sema::render::render_all;
use crater::commands::report_project;
use crater::explain;
use crater::paths::{cwd, display, join, relative};
use crater::project::{Project, ProjectError};
use crater::ui::use_color;

/// What formatting printed, and its exit code.
pub struct Outcome {
    pub code: i32,
    pub out: String,
    pub err: String,
}

impl Outcome {
    fn new(): Outcome {
        return Outcome {
            code: 0,
            out: String::new(),
            err: String::new(),
        };
    }

    /// Print it; its exit code.
    fn finish(self): i32 {
        std::io::write_str(self.out.as_str());
        std::io::ewrite_str(self.err.as_str());
        return self.code;
    }
}

/// `lunar fmt [--check] [-p PACKAGE] [FILES]...`
pub fn command(files: [str; &], package: Option::<str>, check: bool): i32 {
    let color = use_color();
    let mut stdin = false;
    for f in files {
        if f == "-" {
            stdin = true;
        }
    }
    if stdin {
        if files.len() > 1 {
            eprintln("error: `-` (standard input) cannot be combined with files");
            return 2;
        }
        let text = match read_stdin() {
            Some(t) => t,
            None => {
                eprintln("error: standard input is not UTF-8 text");
                return 1;
            }
        };
        return format_text(text.as_str(), check, color).finish();
    }
    if files.len() > 0 {
        return format_files(files, check, color).finish();
    }
    let mut names = String::new();
    let mut ends: [usize; ..+] = [];
    if let Err(e) = project_files(package, &mut names, &mut ends) {
        report_project(&e);
        return 1;
    }
    let mut paths: [str; -..+] = [];
    let mut start: usize = 0;
    for e in ends {
        paths.push(names.as_str()[start..e]);
        start = e;
    }
    return format_files(paths[..], check, color).finish();
}

/// All of standard input, if it is UTF-8.
fn read_stdin(): Option::<String> {
    let mut bytes: [u8; -..+] = [];
    let mut buf: [u8; 4096] = [0; 4096];
    loop {
        // The end of the input (on Windows, a pipe's end is a failure).
        let n = std::io::read(0, buf[..]);
        if n <= 0 {
            break;
        }
        bytes.extend(buf[..n as usize]);
    }
    return match str::from_utf8(bytes[..]) {
        Some(s) => Some(String::from(s)),
        None => None,
    };
}

/// `lunar fmt -`: the text formatted on standard output (with `--check`,
/// nothing, and exit code 1 if it would change).
pub fn format_text(text: str, check: bool, color: bool): Outcome {
    let mut o = Outcome::new();
    match format_source(text) {
        Ok(f) => {
            if check {
                if f.as_str() != text {
                    o.out.push_str("<stdin>\n");
                    o.code = 1;
                }
            } else {
                o.out = f;
            }
        }
        Err(e) => {
            o.code = 1;
            if e.kind == FmtErrorKind::Syntax {
                syntax_errors("<stdin>", text, color, &mut o.err);
            } else {
                internal_error("<stdin>", e.message.as_str(), &mut o.err);
            }
        }
    }
    return o;
}

/// Format the files `paths` in place (with `--check`, list those that
/// would change instead).
pub fn format_files(paths: [str; &], check: bool, color: bool): Outcome {
    let mut o = Outcome::new();
    for path in paths {
        let shown = display(path);
        let text = match fs::read_to_string(path) {
            Ok(t) => t,
            Err(e) => {
                o.err.write("error: could not read `{shown}`: {e}\n");
                o.code = 1;
                continue;
            }
        };
        match format_source(text.as_str()) {
            Ok(f) => {
                if f.as_str() == text.as_str() {
                    continue;
                }
                if check {
                    o.out.write("{shown}\n");
                    o.code = 1;
                } else if let Err(e) = fs::write(path, f.as_bytes()) {
                    o.err.write("error: could not write `{shown}`: {e}\n");
                    o.code = 1;
                }
            }
            Err(e) => {
                o.code = 1;
                if e.kind == FmtErrorKind::Syntax {
                    syntax_errors(shown.as_str(), text.as_str(), color, &mut o.err);
                } else {
                    internal_error(shown.as_str(), e.message.as_str(), &mut o.err);
                }
            }
        }
    }
    return o;
}

/// The syntax errors of `text` (the file `name`), as `lunar check` shows
/// them.
fn syntax_errors(name: str, text: str, color: bool, out: &mut +String) {
    let mut p = Program::new();
    let n = p.sym(name);
    let (_, base) = p.sources.add(n, text, None);
    ln_sema::loader::parse_source(&mut p, text, base);
    render_all(&p, color, out);
    let errors = p.diags.error_count();
    out.write(
        "error: could not format `{name}` due to {errors} syntax error{if errors == 1 { "" } else { "s" }}; it was left as it is\n",
    );
    let hint = explain::hint(&p);
    if hint.len() > 0 {
        out.write("\n{hint}\n");
    }
}

fn internal_error(name: str, message: str, out: &mut +String) {
    out.write("error: could not format `{name}`: {message}\n");
    out.push_str("note: this is a bug in `lunar fmt`; the file was left as it is\n");
}

/// The `.ln` files of the packages `lunar fmt` works on: `-p <name>`, else
/// the package it started in, else (at a workspace root) every member.
fn project_files(
    package: Option::<str>,
    names: &mut +String,
    ends: &mut +[usize; ..+],
): Result::<(), ProjectError> from static {
    let mut proj = Project::new();
    let here = cwd();
    proj.find_workspace(here.as_str())?;
    let mut dirs: [usize; -..+] = [];
    match package {
        Some(name) => {
            let mut listed = String::new();
            for i in 0..proj.member_dirs.len() {
                let dir = String::from(proj.text(proj.member_dirs[i]));
                let pkg = proj.load_package_manifest(dir.as_str())?;
                if proj.text(pkg.name) == name {
                    dirs.push(i);
                }
                if i > 0 {
                    listed.push_str(", ");
                }
                listed.push_str(proj.text(pkg.name));
            }
            if dirs.len() == 0 {
                return Err(
                    ProjectError::new(
                        manifest::WORKSPACE(),
                        "no package `{name}` in this workspace",
                    )
                    .note("its packages are: {listed}"),
                );
            }
        }
        None => {
            for i in 0..proj.member_dirs.len() {
                let current = match proj.current {
                    Some(c) => c == proj.member_dirs[i],
                    None => true,
                };
                if current {
                    dirs.push(i);
                }
            }
        }
    }
    for i in dirs {
        let dir = String::from(proj.text(proj.member_dirs[i]));
        ln_files(dir.as_str(), here.as_str(), names, ends);
    }
    return Ok(());
}

/// The `.ln` files under the package directory `dir`, as paths relative to
/// `base` where they can be: not in `target`, hidden directories, or other
/// packages inside it.
fn ln_files(dir: str, base: str, names: &mut +String, ends: &mut +[usize; ..+]) {
    let entries = match fs::read_dir(dir) {
        Ok(e) => e,
        Err(_) => return,
    };
    for i in 0..entries.len() {
        let name = entries.name(i);
        if name == "target" || name.starts_with(".") {
            continue;
        }
        let path = join(dir, name);
        if fs::is_dir(path.as_str()) {
            if !fs::is_file(join(path.as_str(), "lunar.toml").as_str()) {
                ln_files(path.as_str(), base, names, ends);
            }
        } else if name.ends_with(".ln") {
            match relative(path.as_str(), base) {
                Some(r) => names.push_str(r.as_str()),
                None => names.push_str(path.as_str()),
            }
            ends.push(names.len());
        }
    }
}

// ===================================================================== tests

/// A file in the temporary directory with `text` in it, its path.
fn temp_file(name: str, text: str): String {
    let mut file = String::new();
    file.write("lunar-fmt-test-{std::process::id()}-{name}");
    let path = join(std::env::temp_dir().as_str(), file.as_str());
    fs::write(path.as_str(), text.as_bytes()).unwrap();
    return path;
}

#[test]
fn check_lists_the_files_that_would_change() {
    let messy = temp_file("messy.ln", "fn  main ( ) { }\n");
    let tidy = temp_file("tidy.ln", "fn main() {}\n");
    let paths = [messy.as_str(), tidy.as_str()];
    let o = format_files(paths[..], true, false);
    assert_eq!(o.code, 1);
    let mut expected = display(messy.as_str());
    expected.push('\n');
    assert_eq!(o.out.as_str(), expected.as_str());
    assert_eq!(o.err.as_str(), "");
    // Nothing was written.
    assert_eq!(
        fs::read_to_string(messy.as_str()).unwrap().as_str(),
        "fn  main ( ) { }\n"
    );
    // Formatted files pass.
    let only_tidy = [tidy.as_str()];
    assert_eq!(format_files(only_tidy[..], true, false).code, 0);
    let _ = fs::remove_file(messy.as_str());
    let _ = fs::remove_file(tidy.as_str());
}

#[test]
fn files_are_formatted_in_place() {
    let path = temp_file("in_place.ln", "fn  main ( ) {let x=1;}\n");
    let paths = [path.as_str()];
    let o = format_files(paths[..], false, false);
    assert_eq!(o.code, 0);
    assert_eq!(o.out.as_str(), "");
    assert_eq!(
        fs::read_to_string(path.as_str()).unwrap().as_str(),
        "fn main() {\n    let x = 1;\n}\n"
    );
    assert_eq!(format_files(paths[..], true, false).code, 0);
    let _ = fs::remove_file(path.as_str());
}

#[test]
fn files_with_syntax_errors_are_left_alone() {
    let path = temp_file("broken.ln", "fn main( {\n");
    let paths = [path.as_str()];
    let o = format_files(paths[..], false, false);
    assert_eq!(o.code, 1);
    assert!(o.err.as_str().contains("err(syntax::"));
    assert!(o.err.as_str().contains("it was left as it is"));
    assert_eq!(
        fs::read_to_string(path.as_str()).unwrap().as_str(),
        "fn main( {\n"
    );
    let _ = fs::remove_file(path.as_str());
}

#[test]
fn standard_input_goes_to_standard_output() {
    let o = format_text("fn  main(){println(\"{1 +1}\");}", false, false);
    assert_eq!(o.code, 0);
    assert_eq!(o.out.as_str(), "fn main() {\n    println(\"{1 +1}\");\n}\n");
    assert_eq!(o.err.as_str(), "");
    let c = format_text("fn main() {}\n", true, false);
    assert_eq!(c.code, 0);
    assert_eq!(c.out.as_str(), "");
    let d = format_text("fn main()  {}\n", true, false);
    assert_eq!(d.code, 1);
    assert_eq!(d.out.as_str(), "<stdin>\n");
    let e = format_text("fn main() {", false, false);
    assert_eq!(e.code, 1);
    assert_eq!(e.out.as_str(), "");
    assert!(e.err.as_str().contains("<stdin>"));
}
