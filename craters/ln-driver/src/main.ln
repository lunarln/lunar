// The driver of the Lunar-written compiler. For now it runs one stage over
// each file named on the command line and prints the result, which
// crates/ln-driver/tests/selfhost.rs compares with the Rust compiler's:
//
//     ln-driver FILE...           the tokens (`ln_lexer::dump`)
//     ln-driver --parse FILE...   the syntax tree and syntax errors
//                                 (`ln_ast::dump`, `ln_parser::dump_diags`)
//     ln-driver --check FILE      the front end of semantic analysis on
//                                 FILE with `core` and `std` (from
//                                 `$LUNAR_STD_DIR`): its diagnostics, one
//                                 per line, `err(scope::name) line:col
//                                 message`, then their labels, notes and
//                                 helps indented
//
// and it is the compiler:
//
//     ln-driver build [--release] [--test] [-o OUT] [--emit-llvm FILE] [PATH]
//                                 compile PATH (a `.ln` file, or a package
//                                 directory with a `lunar.toml`; default
//                                 `.`) and the craters it uses into an
//                                 executable, with `core` and `std` from
//                                 `$LUNAR_STD_DIR`. OUT defaults to the
//                                 crater's name in the current directory.

mod project;
mod link;

use std::env;
use std::fs;
use ln_sema::diag::is_dummy;
use ln_sema::loader::{CraterDep, Craters, load_crate};
use ln_sema::program::Program;
use ln_sema::render::render;
use ln_sema::sema::{Options, analyze};

fn main() {
    if env::arg_count() > 1 && env::arg(1).unwrap() == "build" {
        std::process::exit(build());
    }
    if env::arg_count() > 2 && env::arg(1).unwrap() == "--craters" {
        list_craters(env::arg(2).unwrap());
        return;
    }
    let mut i: usize = 1;
    let mut parse = false;
    if env::arg_count() > 1 && env::arg(1).unwrap() == "--parse" {
        parse = true;
        i = 2;
    }
    if env::arg_count() > 2 && env::arg(1).unwrap() == "--check" {
        std::process::exit(check(env::arg(2).unwrap()));
    }
    while i < env::arg_count() {
        let path = env::arg(i).unwrap();
        match fs::read_to_string(path) {
            Ok(text) => {
                let mut out = String::new();
                out.write("== {path}\n");
                if parse {
                    let parsed = ln_parser::parse_file(text.as_str());
                    ln_ast::dump(&parsed.ast, &mut out);
                    ln_parser::dump_diags(&parsed, &mut out);
                } else {
                    ln_lexer::dump(text.as_str(), &mut out);
                }
                std::io::write_str(out.as_str());
            }
            Err(e) => {
                eprintln("ln-driver: {path}: {e}");
                std::process::exit(1);
            }
        }
        i += 1;
    }
}

/// `build`: compile a file or a package into an executable. The exit code
/// is 1 if it has errors, 2 for bad usage.
fn build(): i32 {
    let mut release = false;
    let mut test = false;
    let mut out: Option::<String> = None;
    let mut emit_llvm: Option::<String> = None;
    let mut target = String::from(".");
    let mut i: usize = 2;
    while i < env::arg_count() {
        let a = env::arg(i).unwrap();
        if a == "--release" {
            release = true;
        } else if a == "--test" {
            test = true;
        } else if (a == "-o" || a == "--emit-llvm") && i + 1 < env::arg_count() {
            let v = String::from(env::arg(i + 1).unwrap());
            if a == "-o" {
                out = Some(v);
            } else {
                emit_llvm = Some(v);
            }
            i += 1;
        } else if a.starts_with("-") {
            eprintln("ln-driver: unknown option `{a}`");
            return 2;
        } else {
            target = String::from(a);
        }
        i += 1;
    }
    let std_dir = match env::var("LUNAR_STD_DIR") {
        Some(d) => d,
        None => {
            eprintln("ln-driver: build needs LUNAR_STD_DIR (the std directory)");
            return 2;
        }
    };

    // The craters: the one built first, then the libraries it uses.
    let mut p = Program::new();
    let mut cs = Craters::new();
    let mut name = String::new();
    if target.as_str().ends_with(".ln") {
        name = crater_name(target.as_str());
        match load_crate(&mut p, &mut cs, name.as_str(), target.as_str(), "") {
            Some(c) => cs.list.push(c),
            None => {
                eprintln("err(build::io): could not read `{target}`");
                return 1;
            }
        }
    } else {
        let mut proj = project::Project::new();
        let pkg = proj.load_package(target.as_str());
        for e in proj.errors {
            eprintln("err(manifest): {proj.text(e)}");
        }
        let pkg = match pkg {
            Some(k) => k,
            None => return 1,
        };
        proj.craters(pkg, test);
        if proj.errors.len() > 0 {
            for e in proj.errors {
                eprintln("err(manifest): {proj.text(e)}");
            }
            return 1;
        }
        name = String::from(proj.text(proj.specs[0].name));
        for s in proj.specs {
            let root = proj.text(s.root);
            match load_crate(&mut p, &mut cs, proj.text(s.name), root, "") {
                Some(c) => {
                    let mut deps: [CraterDep; ..+] = [];
                    for d in proj.crater_deps.list(s.deps) {
                        deps.push(CraterDep { name: p.sym(proj.text(d.alias)), index: d.index });
                    }
                    let mut c = c;
                    c.deps = cs.deps.add_list(deps[..]);
                    cs.list.push(c);
                }
                None => {
                    eprintln("err(build::io): could not read `{root}`");
                    return 1;
                }
            }
        }
    }
    if !load_std(&mut p, &mut cs, std_dir.as_str()) {
        return 1;
    }
    if p.diags.has_errors() {
        report(&p);
        return 1;
    }

    let mut s = analyze(p, cs, Options::host(test));
    report(&s.p);
    if s.p.diags.has_errors() {
        return 1;
    }
    if !test && s.p.main.is_none() {
        eprintln("err(build::no_main): `{target}` has no `main` function");
        return 1;
    }

    let out = match out {
        Some(o) => o,
        None => {
            let mut o = String::from(name.as_str());
            o.push_str(exe_suffix());
            o
        }
    };
    let mut obj = String::from(strip_exe(out.as_str()));
    obj.push_str(obj_suffix());
    let opts = ln_codegen::Options {
        opt_level: if release { 2 } else { 0 },
        test,
        overflow_checks: !release,
        emit_llvm,
    };
    match ln_codegen::compile(&mut s.p, opts, obj.as_str()) {
        Ok(()) => {}
        Err(e) => {
            eprintln("err(build::llvm): {e}");
            return 1;
        }
    }
    let mut libs: [str; ..+] = [];
    for l in s.p.link_libs {
        libs.push(s.p.text(l));
    }
    let linked = link::link(obj.as_str(), out.as_str(), libs[..]);
    let _ = fs::remove_file(obj.as_str());
    return match linked {
        Ok(()) => 0,
        Err(e) => {
            eprintln("err(build::link): {e}");
            1
        }
    };
}

/// Load `core` and `std` from `std_dir`; false (after reporting it) if
/// either is missing.
fn load_std(p: &mut Program, cs: &mut +Craters, std_dir: str): bool {
    let names = ["core", "std"];
    for n in names {
        let mut root = String::new();
        root.write("{std_dir}/{n}/lib.ln");
        match load_crate(p, cs, n, root.as_str(), "") {
            Some(c) => cs.list.push(c),
            None => {
                eprintln("err(build::io): standard library crater `{n}` not found at {root}");
                return false;
            }
        }
    }
    return true;
}

/// Print the diagnostics to stderr.
fn report(p: &Program) {
    let mut out = String::new();
    for d in p.diags.list {
        render(p, d, &mut out);
    }
    eprint("{out}");
}

/// `path` without a trailing `.exe`.
fn strip_exe(path: str): str {
    if path.ends_with(".exe") {
        return path[..path.len() - 4];
    }
    return path;
}

#[cfg(windows)]
fn exe_suffix(): str {
    return ".exe";
}

#[cfg(unix)]
fn exe_suffix(): str {
    return "";
}

#[cfg(windows)]
fn obj_suffix(): str {
    return ".obj";
}

#[cfg(unix)]
fn obj_suffix(): str {
    return ".o";
}

/// The craters a build of the package in `dir` analyzes (for checking the
/// project loader).
fn list_craters(dir: str) {
    let mut p = project::Project::new();
    match p.load_package(dir) {
        Some(pkg) => {
            p.craters(pkg, false);
            for s in p.specs {
                print("{p.text(s.name)} {p.text(s.root)}");
                for d in p.crater_deps.list(s.deps) {
                    print(" {p.text(d.alias)}={d.index}");
                }
                println("");
            }
        }
        None => {}
    }
    for e in p.errors {
        eprintln("error: {p.text(e)}");
    }
}

/// A crater name from a file name: letters, digits and `_` (as the Rust
/// driver's `sanitize`).
fn crater_name(path: str): String {
    let b = path.as_bytes();
    let mut start = b.len();
    while start > 0 && b[start - 1] != b'/' && b[start - 1] != b'\\' {
        start -= 1;
    }
    let mut end = b.len();
    let mut k = b.len();
    while k > start {
        k -= 1;
        if b[k] == b'.' {
            end = k;
            break;
        }
    }
    let mut out = String::new();
    for c in path[start..end].chars() {
        let ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        out.push(if ok { c } else { '_' });
    }
    if out.len() == 0 || (out.as_bytes()[0] >= b'0' && out.as_bytes()[0] <= b'9') {
        let mut s = String::from("_");
        s.push_str(out.as_str());
        return s;
    }
    return out;
}

/// `--check FILE`: load FILE, `core` and `std`, analyze them, and print
/// the diagnostics. The exit code is 1 if there were errors.
fn check(path: str): i32 {
    let std_dir = match env::var("LUNAR_STD_DIR") {
        Some(d) => d,
        None => {
            eprintln("ln-driver: --check needs LUNAR_STD_DIR (the std directory)");
            return 2;
        }
    };
    let mut p = Program::new();
    let mut cs = Craters::new();
    let name = crater_name(path);
    match load_crate(&mut p, &mut cs, name.as_str(), path, "") {
        Some(c) => cs.list.push(c),
        None => {
            println("err(build::io) 0:0 could not read `{path}`");
            return 1;
        }
    }
    let names = ["core", "std"];
    for n in names {
        let mut root = String::new();
        root.write("{std_dir}/{n}/lib.ln");
        match load_crate(&mut p, &mut cs, n, root.as_str(), "") {
            Some(c) => cs.list.push(c),
            None => {
                println("err(build::io) 0:0 standard library crater `{n}` not found at {root}");
                return 1;
            }
        }
    }
    if p.diags.has_errors() {
        print_diags(&p);
        return 1;
    }
    let s = analyze(p, cs, Options::host(false));
    print_diags(&s.p);
    // `LN_EXPANSIONS=1`: also print what each macro invocation expanded to.
    if env::var("LN_EXPANSIONS").is_some() {
        let mut out = String::new();
        let mut n_exp: usize = 0;
        for i in 0..s.p.sources.files.len() {
            let f = s.p.sources.files[i];
            if let Some(site) = f.expansion_site {
                n_exp += 1;
                out.write("== {s.p.text(f.name)} at {position(&s.p, site)}\n{s.p.sources.file_text(i as u32)}\n");
            }
        }
        out.write("-- {s.p.defs.len()} definitions, {s.p.impls.len()} impls, {n_exp} expansions\n");
        std::io::write_str(out.as_str());
    }
    if s.p.diags.has_errors() {
        return 1;
    }
    return 0;
}

fn print_diags(p: &Program) {
    let mut out = String::new();
    for d in p.diags.list {
        let sev = if d.is_error() { "err" } else { "warn" };
        out.write("{sev}({d.code.scope}::{d.code.name}) {position(p, d.span)} {p.text(d.message)}");
        if !is_dummy(d.span) && p.sources.files.len() > 0 && p.sources.file_of(d.span.lo) != 0 {
            let f = p.sources.files[p.sources.file_of(d.span.lo) as usize];
            out.write("  [in {p.text(f.name)}]");
        }
        out.push('\n');
        if let Some(l) = d.label {
            out.write("    label: {p.text(l)}\n");
        }
        for l in p.diags.labels.list(d.labels) {
            out.write("    {position(p, l.span)}: {p.text(l.message)}\n");
        }
        for n in p.diags.texts.list(d.notes) {
            out.write("    note: {p.text(n)}\n");
        }
        for h in p.diags.texts.list(d.helps) {
            out.write("    help: {p.text(h)}\n");
        }
    }
    std::io::write_str(out.as_str());
}

/// `line:col` of where a span is in code someone wrote (a span inside a
/// macro expansion is shown at the invocation).
fn position(p: &Program, span: ln_ast::Span): String {
    if is_dummy(span) || p.sources.files.len() == 0 {
        return String::from("0:0");
    }
    let s = p.source_span(span);
    let (line, col) = p.sources.line_col(s.lo);
    let mut out = String::new();
    out.write("{line}:{col}");
    return out;
}
