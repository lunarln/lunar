// The driver of the Lunar-written compiler. For now it runs one stage over
// each file named on the command line and prints the result, which
// crates/ln-driver/tests/selfhost.rs compares with the Rust compiler's:
//
//     ln-driver FILE...           the tokens (`ln_lexer::dump`)
//     ln-driver --parse FILE...   the syntax tree and syntax errors
//                                 (`ln_ast::dump`, `ln_parser::dump_diags`)

mod project;
mod link;

use std::env;
use std::fs;

fn main() {
    if env::arg_count() > 2 && env::arg(1).unwrap() == "--craters" {
        list_craters(env::arg(2).unwrap());
        return;
    }
    let mut i: usize = 1;
    let mut parse = false;
    if env::arg_count() > 1 && env::arg(1).unwrap() == "--parse" {
        parse = true;
        i = 2;
    }
    while i < env::arg_count() {
        let path = env::arg(i).unwrap();
        match fs::read_to_string(path) {
            Ok(text) => {
                let mut out = String::new();
                out.write("== {path}\n");
                if parse {
                    let parsed = ln_parser::parse_file(text.as_str());
                    ln_ast::dump(&parsed.ast, &mut out);
                    ln_parser::dump_diags(&parsed, &mut out);
                } else {
                    ln_lexer::dump(text.as_str(), &mut out);
                }
                std::io::write_str(out.as_str());
            }
            Err(e) => {
                eprintln("ln-driver: {path}: {e}");
                std::process::exit(1);
            }
        }
        i += 1;
    }
}

/// The craters a build of the package in `dir` analyzes (for checking the
/// project loader).
fn list_craters(dir: str) {
    let mut p = project::Project::new();
    match p.load_package(dir) {
        Some(pkg) => {
            p.craters(pkg, false);
            for s in p.specs {
                print("{p.text(s.name)} {p.text(s.root)}");
                for d in p.crater_deps.list(s.deps) {
                    print(" {p.text(d.alias)}={d.index}");
                }
                println("");
            }
        }
        None => {}
    }
    for e in p.errors {
        eprintln("error: {p.text(e)}");
    }
}
