// Linking object files into executables: a port of
// crates/ln-driver/src/link.rs.
//
// * Windows: `clang` (on `PATH`).
// * Linux / macOS: the system C compiler driver (`cc`).
//
// `$LUNAR_CC` overrides the linker driver on every platform (it is invoked
// like a C compiler: `$LUNAR_CC file.o -o out`). Native libraries named by
// `#[link(name = "...")]` are passed on as `-lname`, searched for in the
// directories in `$LUNAR_LIB_PATH` (separated like `PATH`) as well as the
// linker's defaults.

use std::env;
use std::process;

/// Link `obj` and the native libraries `libs` into the executable `out`.
/// An error message on failure.
pub fn link(obj: str, out: str, libs: [str; &]): Result::<(), String> {
    let search = lib_path();
    let mut args: [str; ..+] = [];
    let mut owned = String::new();
    // Every argument's text, end to end in `owned` (which never moves),
    // then views into it.
    let mut ranges: [(usize, usize); ..+] = [];
    push_arg(&mut owned, &mut ranges, obj);
    push_arg(&mut owned, &mut ranges, "-o");
    push_arg(&mut owned, &mut ranges, out);
    for d in search.as_str().split(path_sep()) {
        if d.len() > 0 {
            let mut a = String::from("-L");
            a.push_str(d);
            push_arg(&mut owned, &mut ranges, a.as_str());
            if !is_windows() {
                let mut r = String::from("-Wl,-rpath,");
                r.push_str(d);
                push_arg(&mut owned, &mut ranges, r.as_str());
            }
        }
    }
    for l in libs {
        let mut a = String::from("-l");
        a.push_str(l);
        push_arg(&mut owned, &mut ranges, a.as_str());
    }
    for l in system_libs() {
        push_arg(&mut owned, &mut ranges, l);
    }
    let cc = match env::var("LUNAR_CC") {
        Some(c) => c,
        None => {
            for a in default_cc_args() {
                push_arg(&mut owned, &mut ranges, a);
            }
            String::from(if is_windows() { "clang" } else { "cc" })
        }
    };
    let text = owned.as_str();
    for r in ranges {
        let (s, e) = r;
        args.push(text[s..e]);
    }
    return match process::run(cc.as_str(), args[..]) {
        Ok(0) => Ok(()),
        Ok(code) => {
            let mut m = String::new();
            m.write("linking with `{cc}` failed: exit code {code}");
            Err(m)
        }
        Err(e) => {
            let mut m = String::new();
            m.write("could not run the linker `{cc}`: {e}; install a linker, or point `LUNAR_CC` at one");
            Err(m)
        }
    };
}

fn push_arg(owned: &mut +String, ranges: &mut +[(usize, usize); ..+], a: str) {
    let s = owned.len();
    owned.push_str(a);
    ranges.push((s, owned.len()));
}

fn lib_path(): String {
    return match env::var("LUNAR_LIB_PATH") {
        Some(p) => p,
        None => String::new(),
    };
}

#[cfg(windows)]
fn is_windows(): bool {
    return true;
}

#[cfg(unix)]
fn is_windows(): bool {
    return false;
}

#[cfg(windows)]
fn path_sep(): str {
    return ";";
}

#[cfg(unix)]
fn path_sep(): str {
    return ":";
}

#[cfg(windows)]
fn system_libs(): [str; 2] {
    return ["-llegacy_stdio_definitions", "-lkernel32"];
}

/// Arguments for the default linker driver only. On Windows, `/Brepro`:
/// no link timestamp, so the same program links to the same bytes (the
/// bootstrap compares the compilers it builds).
#[cfg(windows)]
fn default_cc_args(): [str; 1] {
    return ["-Wl,/Brepro"];
}

#[cfg(unix)]
fn default_cc_args(): [str; 0] {
    return [];
}

#[cfg(target_os = "linux")]
fn system_libs(): [str; 1] {
    return ["-lm"];
}

#[cfg(target_os = "macos")]
fn system_libs(): [str; 0] {
    return [];
}
