// Packages and workspaces: the part of crates/ln-driver/src/project.rs that
// building needs. It reads `lunar.toml` manifests (the subset Lunar's own
// manifests use: tables, strings, arrays of strings, inline tables), follows
// path dependencies into a package graph, and lists the craters a build
// analyzes.

use core::arena::{Arena, List};
use core::intern::{Interner, Symbol};
use std::fs;

/// A crater to analyze: its name, the path of its root file, and the
/// craters it may name.
pub struct CraterSpec {
    pub name: Symbol,
    pub root: Symbol,
    pub deps: List::<CraterDep>,
}

/// A crater `index` (in `Project::specs`) visible under the name `alias`.
pub struct CraterDep {
    pub alias: Symbol,
    pub index: u32,
}

pub struct Package {
    pub name: Symbol,
    /// The package's directory, normalized.
    pub dir: Symbol,
    pub has_lib: bool,
    pub has_main: bool,
    pub deps: List::<PackageDep>,
}

pub struct PackageDep {
    pub alias: Symbol,
    pub package: u32,
}

pub struct Project {
    pub names: Interner,
    pub packages: [Package; ..+],
    pub package_deps: Arena::<PackageDep>,
    pub specs: [CraterSpec; -..+],
    pub crater_deps: Arena::<CraterDep>,
    /// Problems found, as messages.
    pub errors: [Symbol; ..+],
}

/// What a manifest says.
struct Manifest {
    name: Option::<Symbol>,
    is_workspace: bool,
    members: List::<Symbol>,
    deps: List::<ManifestDep>,
}

struct ManifestDep {
    alias: Symbol,
    path: Symbol,
}

impl Project {
    pub fn new(): Project {
        return Project { names: Interner::new(), packages: [], package_deps: Arena::new(), specs: [], crater_deps: Arena::new(), errors: [] };
    }

    pub fn text(&self, s: Symbol): str {
        return self.names.resolve(s);
    }

    fn error(&mut +self, args: FmtArgs) {
        let mut s = String::new();
        s.write(args);
        let m = self.names.intern(s.as_str());
        self.errors.push(m);
    }

    // ----------------------------------------------------------- packages

    /// Load the package in `dir` and, through path dependencies, every
    /// package it needs. Its index, or `None` after an error.
    pub fn load_package(&mut +self, dir: str): Option::<u32> {
        let norm = normalize(dir);
        let d = self.names.intern(norm.as_str());
        for i in 0..self.packages.len() {
            if self.packages[i].dir == d {
                return Some(i as u32);
            }
        }
        let mut symbols: Arena::<Symbol> = Arena::new();
        let mut deps: Arena::<ManifestDep> = Arena::new();
        let m = match self.read_manifest(norm.as_str(), &mut symbols, &mut deps) {
            Some(m) => m,
            None => return None,
        };
        let name = match m.name {
            Some(n) => n,
            None => {
                self.error("`{norm}/lunar.toml` has no `[package]` with a `name`");
                return None;
            }
        };
        let index = self.packages.len() as u32;
        let has_lib = exists(join(norm.as_str(), "src/lib.ln").as_str());
        let has_main = exists(join(norm.as_str(), "src/main.ln").as_str());
        self.packages.push(Package { name, dir: d, has_lib, has_main, deps: List::empty() });
        let mut pdeps: [PackageDep; ..+] = [];
        for dep in deps.list(m.deps) {
            let path = join(norm.as_str(), self.text(dep.path));
            match self.load_package(path.as_str()) {
                Some(j) => pdeps.push(PackageDep { alias: dep.alias, package: j }),
                None => return None,
            }
        }
        let l = self.package_deps.add_list(pdeps[..]);
        self.packages[index as usize].deps = l;
        return Some(index);
    }

    /// The directory of the workspace containing `dir` (the nearest
    /// ancestor whose `lunar.toml` has a `[workspace]`), if any.
    pub fn find_workspace(&mut +self, dir: str): Option::<String> {
        let mut d = normalize(dir);
        loop {
            let manifest = join(d.as_str(), "lunar.toml");
            if let Ok(text) = fs::read_to_string(manifest.as_str()) {
                if text.as_str().contains("[workspace]") {
                    return Some(d);
                }
            }
            match parent(d.as_str()) {
                Some(p) => d = p,
                None => return None,
            }
        }
    }

    /// The members of the workspace in `dir`.
    pub fn workspace_members(&mut +self, dir: str, out: &mut +[Symbol; ..+]) {
        let mut symbols: Arena::<Symbol> = Arena::new();
        let mut deps: Arena::<ManifestDep> = Arena::new();
        if let Some(m) = self.read_manifest(dir, &mut symbols, &mut deps) {
            for s in symbols.list(m.members) {
                let p = join(dir, self.text(s));
                out.push(self.names.intern(p.as_str()));
            }
        }
    }

    // ----------------------------------------------------------- craters

    /// The craters a build of package `pkg` analyzes: its program (or, for
    /// `lib`, its library) first, then the libraries it uses.
    pub fn craters(&mut self, pkg: u32, lib: bool) {
        self.specs.clear();
        let p = self.packages[pkg as usize];
        let own = crater_name(self.text(p.name));
        let own_sym = self.names.intern(own.as_str());
        let root = if lib { join(self.text(p.dir), "src/lib.ln") } else { join(self.text(p.dir), "src/main.ln") };
        let root_sym = self.names.intern(root.as_str());
        self.specs.push(CraterSpec { name: own_sym, root: root_sym, deps: List::empty() });
        // Package index -> index of its library crater in `specs`.
        let mut lib_of: [u32; ..+] = [];
        for _ in 0..self.packages.len() {
            lib_of.push(4294967295);
        }
        let mut deps: [CraterDep; ..+] = [];
        if !lib && p.has_lib {
            let i = self.lib_crater(pkg, &mut lib_of);
            deps.push(CraterDep { alias: own_sym, index: i });
        }
        for d in self.package_deps.list(p.deps) {
            let i = self.lib_crater(d.package, &mut lib_of);
            deps.push(CraterDep { alias: d.alias, index: i });
        }
        let l = self.crater_deps.add_list(deps[..]);
        self.specs[0].deps = l;
    }

    fn lib_crater(&mut self, pkg: u32, lib_of: &mut +[u32; ..+]): u32 {
        if lib_of[pkg as usize] != 4294967295 {
            return lib_of[pkg as usize];
        }
        let p = self.packages[pkg as usize];
        if !p.has_lib {
            self.error("package `{self.text(p.name)}` has no library (`src/lib.ln`) to depend on");
        }
        let name = crater_name(self.text(p.name));
        let name_sym = self.names.intern(name.as_str());
        let root = join(self.text(p.dir), "src/lib.ln");
        let root_sym = self.names.intern(root.as_str());
        let i = self.specs.len() as u32;
        self.specs.push(CraterSpec { name: name_sym, root: root_sym, deps: List::empty() });
        lib_of[pkg as usize] = i;
        let mut deps: [CraterDep; ..+] = [];
        for d in self.package_deps.list(p.deps) {
            let j = self.lib_crater(d.package, lib_of);
            deps.push(CraterDep { alias: d.alias, index: j });
        }
        let l = self.crater_deps.add_list(deps[..]);
        self.specs[i as usize].deps = l;
        return i;
    }

    // ----------------------------------------------------------- manifests

    /// Read `dir/lunar.toml`.
    fn read_manifest(&mut +self, dir: str, symbols: &mut +Arena::<Symbol>, deps: &mut +Arena::<ManifestDep>): Option::<Manifest> {
        let path = join(dir, "lunar.toml");
        let text = match fs::read_to_string(path.as_str()) {
            Ok(t) => t,
            Err(e) => {
                self.error("cannot read `{path}`: {e}");
                return None;
            }
        };
        let mut m = Manifest { name: None, is_workspace: false, members: List::empty(), deps: List::empty() };
        let mut table = "";
        let mut members: [Symbol; ..+] = [];
        let mut dep_list: [ManifestDep; ..+] = [];
        let mut lines = text.as_str().lines();
        let mut line_no: usize = 0;
        while let Some(raw) = lines.next() {
            line_no += 1;
            let line = strip_comment(raw).trim();
            if line.len() == 0 {
                continue;
            }
            if line.starts_with("[") {
                table = line;
                if line == "[workspace]" {
                    m.is_workspace = true;
                }
                continue;
            }
            let eq = match line.find("=") {
                Some(i) => i,
                None => {
                    self.error("{path}:{line_no}: expected `key = value`");
                    return None;
                }
            };
            let key = line[..eq].trim();
            let mut value = String::from(line[eq + 1..].trim());
            // An array may continue over several lines.
            if value.as_str().starts_with("[") {
                while !value.as_str().contains("]") {
                    match lines.next() {
                        Some(more) => {
                            line_no += 1;
                            value.push(' ');
                            value.push_str(strip_comment(more).trim());
                        }
                        None => break,
                    }
                }
            }
            if table == "[package]" && key == "name" {
                match unquote(value.as_str()) {
                    Some(s) => m.name = Some(self.names.intern(s)),
                    None => self.error("{path}:{line_no}: the package name must be a string"),
                }
            } else if table == "[workspace]" && key == "members" {
                for item in value.as_str().trim_matches_array().split(",") {
                    if let Some(s) = unquote(item.trim()) {
                        members.push(self.names.intern(s));
                    }
                }
            } else if table == "[dependencies]" {
                // `alias = { path = "../x" }`
                let v = value.as_str();
                match inline_value(v, "path") {
                    Some(p) => {
                        // Code names the dependency as a crater: `ln_ast`.
                        let a = self.names.intern(crater_name(key).as_str());
                        let ps = self.names.intern(p);
                        dep_list.push(ManifestDep { alias: a, path: ps });
                    }
                    None => self.error("{path}:{line_no}: dependency `{key}` needs a `path` (registry and git dependencies are not supported by this driver)"),
                }
            }
        }
        m.members = symbols.add_list(members[..]);
        m.deps = deps.add_list(dep_list[..]);
        return Some(m);
    }
}

// ===================================================================== paths and text

/// `-` becomes `_` in crater names (`ln-ast` is the crater `ln_ast`).
pub fn crater_name(package: str): String {
    let mut s = String::new();
    for c in package.chars() {
        s.push(if c == '-' { '_' } else { c });
    }
    return s;
}

pub fn exists(path: str): bool {
    return fs::read(path).is_ok();
}

/// `dir/rel`, or `rel` if it is absolute.
pub fn join(dir: str, rel: str): String {
    if is_absolute(rel) || dir.len() == 0 {
        return normalize(rel);
    }
    let mut s = String::from(dir);
    if !dir.ends_with("/") {
        s.push('/');
    }
    s.push_str(rel);
    return normalize(s.as_str());
}

pub fn is_absolute(p: str): bool {
    let b = p.as_bytes();
    return p.starts_with("/") || p.starts_with("\\") || (b.len() >= 2 && b[1] == b':');
}

/// `p` with `\` as `/`, and `.` and `name/..` segments removed.
pub fn normalize(p: str): String {
    let mut parts: [str; -..+] = [];
    let mut absolute = false;
    let mut s = String::new();
    for c in p.chars() {
        s.push(if c == '\\' { '/' } else { c });
    }
    let text = s.as_str();
    if text.starts_with("/") {
        absolute = true;
    }
    for seg in text.split("/") {
        if seg.len() == 0 || seg == "." {
            continue;
        }
        if seg == ".." && parts.len() > 0 && parts[parts.len() - 1] != ".." {
            parts.pop();
            continue;
        }
        parts.push(seg);
    }
    let mut out = String::new();
    if absolute {
        out.push('/');
    }
    for i in 0..parts.len() {
        if i > 0 {
            out.push('/');
        }
        out.push_str(parts[i]);
    }
    if out.len() == 0 {
        out.push('.');
    }
    return out;
}

/// The directory containing `p`, if it has one.
pub fn parent(p: str): Option::<String> {
    let b = p.as_bytes();
    let mut i = b.len();
    while i > 0 {
        i -= 1;
        if b[i] == b'/' {
            if i == 0 {
                return None;
            }
            // `C:/` has no parent.
            if i == 2 && b[1] == b':' && b.len() == 3 {
                return None;
            }
            return Some(String::from(p[..i]));
        }
    }
    return None;
}

fn strip_comment(line: str): str {
    // `#` outside a string starts a comment.
    let b = line.as_bytes();
    let mut in_str = false;
    for i in 0..b.len() {
        if b[i] == b'"' {
            in_str = !in_str;
        } else if b[i] == b'#' && !in_str {
            return line[..i];
        }
    }
    return line;
}

/// The text of a `"string"`.
fn unquote(v: str): Option::<str> {
    if v.len() >= 2 && v.starts_with("\"") && v.ends_with("\"") {
        return Some(v[1..v.len() - 1]);
    }
    return None;
}

/// The string value of `key` in an inline table `{ key = "value", ... }`.
fn inline_value(v: str, key: str): Option::<str> {
    if !v.starts_with("{") || !v.ends_with("}") {
        return None;
    }
    for part in v[1..v.len() - 1].split(",") {
        let p = part.trim();
        if let Some(eq) = p.find("=") {
            if p[..eq].trim() == key {
                return unquote(p[eq + 1..].trim());
            }
        }
    }
    return None;
}

trait ArrayText {
    fn trim_matches_array(self): str;
}

impl ArrayText for str {
    /// The inside of `[ ... ]`.
    fn trim_matches_array(self): str {
        let t = self.trim();
        if t.starts_with("[") && t.ends_with("]") {
            return t[1..t.len() - 1];
        }
        return t;
    }
}
