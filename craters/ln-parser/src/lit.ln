// Literal decoding: numbers, escapes, and format-string pieces.

use core::arena::{Id, List};
use core::intern::Symbol;
use ln_ast::*;
use ln_lexer::{NumKind, Token as T, hole_end};
use crater::{Parser, PResult, Code, Diag, tok_text};

/// The type suffixes, integer ones first.
fn suffix_at(i: usize): str {
    return match i {
        0 => "i8",
        1 => "i16",
        2 => "i32",
        3 => "i64",
        4 => "isize",
        5 => "u8",
        6 => "u16",
        7 => "u32",
        8 => "u64",
        9 => "usize",
        10 => "f32",
        _ => "f64",
    };
}

/// A numeric literal's digits and type suffix.
struct Split {
    body: str,
    suffix: str,
}

fn is_float_suffix(s: str): bool {
    return s == "f32" || s == "f64";
}

/// Split a numeric literal into its digits and an optional type suffix
/// (`suffix` is empty if there is none).
fn split_suffix(text: str, radix_prefixed: bool): Split {
    for k in 0..12 {
        let s = suffix_at(k);
        if text.ends_with(s) {
            // `0xff` must not lose an `f`-suffix-looking tail.
            if radix_prefixed && s.starts_with("f") {
                continue;
            }
            let body = text[..text.len() - s.len()];
            if body.len() > 0 {
                return Split { body, suffix: s };
            }
        }
    }
    return Split { body: text, suffix: "" };
}

/// The value of hex/decimal/octal/binary digit `c`, if it is one in `radix`.
fn digit(c: u8, radix: u64): Option::<u64> {
    let v: u64 = if c >= b'0' && c <= b'9' {
        (c - b'0') as u64
    } else if c >= b'a' && c <= b'z' {
        (c - b'a') as u64 + 10
    } else if c >= b'A' && c <= b'Z' {
        (c - b'A') as u64 + 10
    } else {
        99
    };
    if v < radix {
        return Some(v);
    }
    return None;
}

/// A parsed integer literal (its low and high 64 bits, and its suffix), or
/// why it is invalid.
pub enum IntLit {
    Value(u64, u64, str),
    Invalid(String),
}

/// Parse an integer literal: its value and suffix (empty if none).
pub fn parse_int_lit(text: str): IntLit {
    let b = text.as_bytes();
    let mut radix: u64 = 10;
    let mut digits_start: usize = 0;
    if b.len() >= 2 && b[0] == b'0' {
        if b[1] == b'x' {
            radix = 16;
            digits_start = 2;
        } else if b[1] == b'o' {
            radix = 8;
            digits_start = 2;
        } else if b[1] == b'b' {
            radix = 2;
            digits_start = 2;
        }
    }
    let sp = split_suffix(text[digits_start..], radix != 10);
    if is_float_suffix(sp.suffix) {
        let mut m = String::new();
        m.write("float suffix `{sp.suffix}` on an integer literal");
        return IntLit::Invalid(m);
    }
    let mut count: usize = 0;
    let mut bad = false;
    for c in sp.body.bytes() {
        if c == b'_' {
            continue;
        }
        count += 1;
        if digit(c, radix).is_none() {
            bad = true;
        }
    }
    if count == 0 {
        return IntLit::Invalid(String::from("integer literal has no digits"));
    }
    if bad {
        let mut m = String::new();
        m.write("invalid digit or suffix in `{text}`");
        return IntLit::Invalid(m);
    }
    // A 128-bit accumulator: `hi` and `lo` words, `lo` multiplied 32 bits
    // at a time so nothing overflows.
    let (mut hi, mut lo): (u64, u64) = (0, 0);
    let max: u64 = 0xffffffffffffffff;
    for c in sp.body.bytes() {
        if c == b'_' {
            continue;
        }
        let d = digit(c, radix).unwrap();
        let low = (lo & 0xffffffff) * radix + d;
        let high = (lo >> 32) * radix + (low >> 32);
        let carry = high >> 32;
        if hi > (max - carry) / radix {
            return IntLit::Invalid(String::from("integer literal is too large"));
        }
        hi = hi * radix + carry;
        lo = ((high & 0xffffffff) << 32) | (low & 0xffffffff);
    }
    return IntLit::Value(lo, hi, sp.suffix);
}

/// Whether `s` is a valid float: digits, an optional `.` and digits, an
/// optional exponent (`_` separators allowed in the digits).
fn valid_float(s: str): bool {
    let b = s.as_bytes();
    let mut i: usize = 0;
    let mut digits: usize = 0;
    while i < b.len() && ((b[i] >= b'0' && b[i] <= b'9') || b[i] == b'_') {
        if b[i] != b'_' {
            digits += 1;
        }
        i += 1;
    }
    if i < b.len() && b[i] == b'.' {
        i += 1;
        while i < b.len() && ((b[i] >= b'0' && b[i] <= b'9') || b[i] == b'_') {
            if b[i] != b'_' {
                digits += 1;
            }
            i += 1;
        }
    }
    if digits == 0 {
        return false;
    }
    if i < b.len() && (b[i] == b'e' || b[i] == b'E') {
        i += 1;
        if i < b.len() && (b[i] == b'+' || b[i] == b'-') {
            i += 1;
        }
        let mut exp: usize = 0;
        while i < b.len() && ((b[i] >= b'0' && b[i] <= b'9') || b[i] == b'_') {
            if b[i] != b'_' {
                exp += 1;
            }
            i += 1;
        }
        if exp == 0 {
            return false;
        }
    }
    return i == b.len();
}

/// Check a float literal; returns its suffix (empty if none) or an error.
pub fn parse_float_lit(text: str): Result::<str, String> {
    let sp = split_suffix(text, false);
    if sp.suffix.len() > 0 && !is_float_suffix(sp.suffix) {
        let mut m = String::new();
        m.write("integer suffix `{sp.suffix}` on a float literal");
        return Err(m);
    }
    if !valid_float(sp.body) {
        let mut m = String::new();
        m.write("invalid float literal `{text}`");
        return Err(m);
    }
    return Ok(sp.suffix);
}

/// An invalid escape: where in the literal's body, and why.
pub struct EscError {
    pub start: usize,
    pub end: usize,
    pub message: String,
}

/// The character starting at byte `i` of `s`, and its length.
fn char_at(s: str, i: usize): (char, usize) {
    let c = s[i..].chars().next().unwrap();
    return (c, c.len_utf8());
}

/// A number in hexadecimal (optionally after `+`), at most `max`.
fn parse_hex(s: str, max: u64): Option::<u64> {
    let b = s.as_bytes();
    let mut i: usize = 0;
    if b.len() > 0 && b[0] == b'+' {
        i = 1;
    }
    if i == b.len() {
        return None;
    }
    let mut v: u64 = 0;
    while i < b.len() {
        let d = digit(b[i], 16)?;
        v = v * 16 + d;
        if v > max {
            return None;
        }
        i += 1;
    }
    return Some(v);
}

fn esc_error(start: usize, end: usize, message: str): Result::<String, EscError> {
    return Err(EscError { start, end, message: String::from(message) });
}

/// Unescape the body of a string or char literal (without quotes).
pub fn unescape(raw: str): Result::<String, EscError> {
    let mut out = String::new();
    let n = raw.len();
    let mut i: usize = 0;
    while i < n {
        let (c, cl) = char_at(raw, i);
        if c != '\\' {
            out.push(c);
            i += cl;
            continue;
        }
        if i + 1 >= n {
            return esc_error(i, i + 1, "trailing backslash");
        }
        let (e, el) = char_at(raw, i + 1);
        let mut j = i + 1 + el;
        if e == 'n' {
            out.push('\n');
        } else if e == 't' {
            out.push('\t');
        } else if e == 'r' {
            out.push('\r');
        } else if e == '0' {
            out.push('\0');
        } else if e == '\\' || e == '"' || e == '\'' {
            out.push(e);
        } else if e == '\n' {
            // Line continuation: skip leading whitespace on the next line.
            while j < n {
                let (w, wl) = char_at(raw, j);
                if !w.is_whitespace() {
                    break;
                }
                j += wl;
            }
        } else if e == 'x' {
            let start = j;
            let mut k: usize = 0;
            while k < 2 && j < n {
                let (_, hl) = char_at(raw, j);
                j += hl;
                k += 1;
            }
            match parse_hex(raw[start..j], 255) {
                Some(b) if b < 0x80 => out.push(b as u8 as char),
                _ => return esc_error(i, i + 4, "`\\x` escapes must be two hex digits below 0x80"),
            }
        } else if e == 'u' {
            if j >= n || char_at(raw, j).0 != '{' {
                return esc_error(i, i + 2, "expected `{` after `\\u`");
            }
            j += 1;
            let hex_start = j;
            let mut hex_end = j;
            let mut end = i + 3;
            while j < n {
                let (h, hl) = char_at(raw, j);
                end = j + hl;
                j += hl;
                if h == '}' {
                    break;
                }
                hex_end = j;
            }
            let h = raw[hex_start..hex_end];
            let ch = match parse_hex(h, 0x10ffff) {
                Some(v) if v < 0xd800 || v > 0xdfff => char::from_u32(v as u32),
                _ => None,
            };
            match ch {
                Some(x) => out.push(x),
                None => {
                    let mut m = String::new();
                    m.write("invalid unicode escape `\\u{{{h}}}`");
                    return Err(EscError { start: i, end, message: m });
                }
            }
        } else {
            let mut m = String::new();
            m.write("unknown escape `\\{e}`");
            return Err(EscError { start: i, end: i + 1 + el, message: m });
        }
        i = j;
    }
    return Ok(out);
}

/// The value of a byte literal body (between `b'` and `'`): one ASCII
/// character, or an escape up to `\xFF`.
pub fn unescape_byte(raw: str): Result::<u8, String> {
    if raw.starts_with("\\x") {
        let hex = raw[2..];
        return match parse_hex(hex, 255) {
            Some(b) if hex.len() == 2 => Ok(b as u8),
            _ => Err(String::from("`\\x` escapes in byte literals must be two hex digits")),
        };
    }
    if raw.starts_with("\\u") {
        return Err(String::from("unicode escapes cannot be used in byte literals"));
    }
    let s = match unescape(raw) {
        Ok(s) => s,
        Err(e) => return Err(e.message),
    };
    let mut chars = s.as_str().chars();
    let first = chars.next();
    let second = chars.next();
    return match first {
        Some(c) if second.is_none() => {
            if (c as u32) < 128 {
                Ok(c as u32 as u8)
            } else {
                let mut m = String::new();
                m.write("non-ASCII character `{c}` in a byte literal");
                Err(m)
            }
        }
        _ => Err(String::from("byte literal must contain exactly one byte")),
    };
}

/// A format hole's expression length and spec.
struct SpecSplit {
    len: usize,
    spec: FmtSpec,
}

/// Split a format hole into its expression and format spec: `p:?` is `p`
/// with `Debug`. The spec starts at the first `:` outside brackets, strings
/// and character literals that is not part of `::`.
fn split_spec(inner: str): Result::<SpecSplit, String> {
    let b = inner.as_bytes();
    let mut depth: i32 = 0;
    let mut i: usize = 0;
    while i < b.len() {
        let c = b[i];
        if c == b'(' || c == b'[' || c == b'{' {
            depth += 1;
        } else if c == b')' || c == b']' || c == b'}' {
            depth -= 1;
        } else if c == b'"' || c == b'\'' {
            // Skip string and character literals (`':'`, `"a:b"`).
            i += 1;
            while i < b.len() && b[i] != c {
                i += if b[i] == b'\\' { 2 } else { 1 };
            }
        } else if c == b':' && depth == 0 {
            if i + 1 < b.len() && b[i + 1] == b':' {
                i += 2;
                continue;
            }
            let spec = inner[i + 1..].trim();
            if spec == "?" {
                return Ok(SpecSplit { len: i, spec: FmtSpec::Debugged });
            }
            if spec.len() == 0 {
                return Err(String::from("empty format spec after `:`; write `{x:?}` for `Debug`, or `{x}` for `Display`"));
            }
            let mut m = String::new();
            m.write("unknown format spec `{spec}`; the only one is `?` (`{{x:?}}` uses `Debug`)");
            return Err(m);
        }
        i += 1;
    }
    return Ok(SpecSplit { len: b.len(), spec: FmtSpec::Show });
}

impl Parser {
    /// Unescape `seg` (a piece of a literal body starting at `offset` in
    /// the file) onto `text`; on an error, the format string's error.
    fn flush_text(&mut self, text: &mut String, seg: str, offset: u32): Option::<FmtString> {
        return match unescape(seg) {
            Ok(s) => {
                text.push_str(s.as_str());
                None
            }
            Err(e) => {
                let m = self.intern(e.message.as_str());
                Some(FmtString::Invalid(m, Span::new(offset + e.start as u32, offset + e.end as u32)))
            }
        };
    }

    fn fmt_error(&mut self, message: str, lo: u32, hi: u32): FmtString {
        let m = self.intern(message);
        return FmtString::Invalid(m, Span::new(lo, hi));
    }

    /// Interpret a string literal body (`raw`, between the quotes, starting
    /// at `offset` in the file) as a format string: `{expr}` holes,
    /// `{{`/`}}` escapes.
    fn parse_format(&mut self, raw: str, offset: u32): FmtString {
        let mut pieces: [FmtPiece; ..+] = [];
        let mut text = String::new();
        let b = raw.as_bytes();
        let mut text_start: usize = 0;
        let mut i: usize = 0;
        while i < b.len() {
            let c = b[i];
            if c == b'\\' {
                // Skip the escaped character so `\{` is not seen as a hole.
                i += 2;
            } else if (c == b'{' || c == b'}') && i + 1 < b.len() && b[i + 1] == c {
                if let Some(e) = self.flush_text(&mut text, raw[text_start..i], offset + text_start as u32) {
                    return e;
                }
                text.push(c as char);
                i += 2;
                text_start = i;
            } else if c == b'}' {
                return self.fmt_error("unmatched `}` in format string (use `}}` for a literal brace)", offset + i as u32, offset + i as u32 + 1);
            } else if c == b'{' {
                if let Some(e) = self.flush_text(&mut text, raw[text_start..i], offset + text_start as u32) {
                    return e;
                }
                if text.len() > 0 {
                    let t = self.intern(text.as_str());
                    pieces.push(FmtPiece::Text(t));
                    text = String::new();
                }
                // The matching close brace, as the lexer found it.
                let open = i;
                let j = match hole_end(b, i + 1) {
                    Some(e) => e,
                    None => return self.fmt_error("unclosed `{` in format string (use `{{` for a literal brace)", offset + open as u32, offset + open as u32 + 1),
                };
                let inner = raw[open + 1..j - 1];
                if inner.trim().len() == 0 {
                    return self.fmt_error("empty `{}` in format string: put an expression inside, e.g. `{x}`", offset + open as u32, offset + j as u32);
                }
                let split = match split_spec(inner) {
                    Ok(s) => s,
                    Err(m) => return self.fmt_error(m.as_str(), offset + open as u32, offset + j as u32),
                };
                let lo = offset + open as u32 + 1;
                match self.parse_hole(raw[open + 1..open + 1 + split.len], lo) {
                    Ok(e) => pieces.push(FmtPiece::Hole(e, split.spec)),
                    Err(msg) => {
                        let mut m = String::new();
                        m.write("invalid expression in format string: {self.ast.text(msg)}");
                        return self.fmt_error(m.as_str(), offset + open as u32, offset + j as u32);
                    }
                }
                i = j;
                text_start = i;
            } else {
                i += 1;
            }
        }
        let rest_start = if text_start < raw.len() { text_start } else { raw.len() };
        if let Some(e) = self.flush_text(&mut text, raw[rest_start..], offset + text_start as u32) {
            return e;
        }
        if text.len() > 0 {
            let t = self.intern(text.as_str());
            pieces.push(FmtPiece::Text(t));
        }
        return FmtString::Pieces(self.ast.fmt_pieces.add_list(pieces[..]));
    }

    /// Parse the expression `text` of a format hole, which starts at `lo`
    /// in the file: lexed onto the end of the tokens and parsed with the
    /// cursor moved there. Its errors are not the file's: on failure,
    /// returns the first one's message.
    fn parse_hole(&mut self, text: str, lo: u32): Result::<Id::<Expr>, Symbol> {
        let (pos, limit, eof, fuel) = (self.pos, self.limit, self.eof, self.fuel);
        let diag_mark = self.diags.len();
        let cursor_mark = self.cursor_errors.len();
        let first = self.toks.len();
        self.lex_into(text, lo);
        let lex_end = self.diags.len();
        self.pos = first;
        self.limit = self.toks.len();
        self.eof = lo + text.len() as u32;
        self.n_expected = 0;
        let e = self.expr();
        if e.is_ok() && !self.at_eof() {
            self.error_expected();
        }
        // The first error: a lexical one, or else the earliest of the rest.
        let mut first_error: Option::<Diag> = None;
        if lex_end > diag_mark {
            first_error = Some(self.diags[diag_mark]);
        } else {
            let mut k = lex_end;
            while k < self.diags.len() {
                let d = self.diags[k];
                if first_error.is_none() || d.span.lo < first_error.unwrap().span.lo {
                    first_error = Some(d);
                }
                k += 1;
            }
            k = cursor_mark;
            while k < self.cursor_errors.len() {
                let d = self.cursor_errors[k];
                if first_error.is_none() || d.span.lo < first_error.unwrap().span.lo {
                    first_error = Some(d);
                }
                k += 1;
            }
        }
        let mut k = diag_mark;
        while k < self.diags.len() {
            self.diags[k].live = false;
            k += 1;
        }
        k = cursor_mark;
        while k < self.cursor_errors.len() {
            self.cursor_errors[k].live = false;
            k += 1;
        }
        self.pos = pos;
        self.limit = limit;
        self.eof = eof;
        self.fuel = fuel;
        self.n_expected = 0;
        if let Some(d) = first_error {
            return Err(d.message);
        }
        return match e {
            Ok(x) => Ok(x),
            Err(_) => Err(self.intern("")),
        };
    }

    /// A literal token (the current token).
    pub fn literal(&mut self): PResult::<Lit> {
        let t = self.bump();
        let text = tok_text(self.src, self.base, t);
        let sp = self.tok_span(t);
        let u8_suffix = self.intern("u8");
        let lit = match t.kind {
            T::True => Lit::Bool(true),
            T::False => Lit::Bool(false),
            T::Number(NumKind::Int) => match parse_int_lit(text) {
                IntLit::Value(value, high, suffix) => Lit::Int { value, high, suffix: self.suffix(suffix) },
                IntLit::Invalid(m) => {
                    self.diag(Code::BadNumber, sp, m.as_str());
                    Lit::Int { value: 0, high: 0, suffix: None }
                }
            },
            T::Number(NumKind::Float) => match parse_float_lit(text) {
                Ok(suffix) => Lit::Float { suffix: self.suffix(suffix) },
                Err(m) => {
                    self.diag(Code::BadNumber, sp, m.as_str());
                    Lit::Float { suffix: None }
                }
            },
            T::Char => self.char_lit(text, sp),
            T::Byte => {
                // A placeholder for an unclosed literal (already reported).
                if text.len() < 3 || !text.ends_with("'") {
                    Lit::Int { value: 0, high: 0, suffix: Some(u8_suffix) }
                } else {
                    // A byte literal is a `u8` integer literal.
                    let value = match unescape_byte(text[2..text.len() - 1]) {
                        Ok(b) => b as u64,
                        Err(m) => {
                            let code = if m.as_str().contains("escape") { Code::BadEscape } else { Code::BadChar };
                            self.diag(code, sp, m.as_str());
                            0
                        }
                    };
                    Lit::Int { value, high: 0, suffix: Some(u8_suffix) }
                }
            }
            T::Str => {
                let raw = text[1..text.len() - 1];
                let value = match unescape(raw) {
                    Ok(s) => s,
                    Err(e) => {
                        self.diag(Code::BadEscape, Span::new(t.start + 1 + e.start as u32, t.start + 1 + e.end as u32), e.message.as_str());
                        String::new()
                    }
                };
                let fmt = if raw.contains("{") || raw.contains("}") {
                    self.parse_format(raw, t.start + 1)
                } else if value.len() == 0 {
                    FmtString::Pieces(List::empty())
                } else {
                    let v = self.intern(value.as_str());
                    FmtString::Pieces(self.ast.fmt_pieces.add_list([FmtPiece::Text(v)][..]))
                };
                Lit::Str { value: self.intern(value.as_str()), fmt }
            }
            _ => panic("literal() called on a non-literal"),
        };
        return Ok(lit);
    }

    fn suffix(&mut self, s: str): Option::<Symbol> {
        if s.len() == 0 {
            return None;
        }
        return Some(self.intern(s));
    }

    fn char_lit(&mut self, text: str, sp: Span): Lit {
        // A placeholder for an unclosed literal (already reported).
        if text.len() < 2 || !text.ends_with("'") {
            return Lit::Char('\0');
        }
        let raw = text[1..text.len() - 1];
        return match unescape(raw) {
            Ok(s) => {
                let mut n: usize = 0;
                let mut only = '\0';
                for c in s.as_str().chars() {
                    if n == 0 {
                        only = c;
                    }
                    n += 1;
                }
                if n == 1 {
                    Lit::Char(only)
                } else {
                    self.diag(Code::BadChar, sp, "character literal must contain exactly one character");
                    Lit::Char('\0')
                }
            }
            Err(e) => {
                self.diag(Code::BadEscape, sp, e.message.as_str());
                Lit::Char('\0')
            }
        };
    }
}
