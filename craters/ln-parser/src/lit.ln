// Literal decoding: numbers, escapes, and format-string pieces.

use core::arena::{Id, List};
use core::intern::Symbol;
use ln_ast::*;
use ln_lexer::{NumKind, Token as T, hole_end};
use crater::{Parser, PResult, Code, Diag, tok_text};

/// The type suffixes, integer ones first.
fn suffix_at(i: usize): str {
    return match i {
        0 => "i8",
        1 => "i16",
        2 => "i32",
        3 => "i64",
        4 => "isize",
        5 => "u8",
        6 => "u16",
        7 => "u32",
        8 => "u64",
        9 => "usize",
        10 => "f32",
        _ => "f64",
    };
}

/// A numeric literal's digits and type suffix.
struct Split {
    body: str,
    suffix: str,
}

fn is_float_suffix(s: str): bool {
    return s == "f32" || s == "f64";
}

/// Split a numeric literal into its digits and an optional type suffix
/// (`suffix` is empty if there is none).
fn split_suffix(text: str, radix_prefixed: bool): Split {
    for k in 0..12 {
        let s = suffix_at(k);
        if text.ends_with(s) {
            // `0xff` must not lose an `f`-suffix-looking tail.
            if radix_prefixed && s.starts_with("f") {
                continue;
            }
            let body = text[..text.len() - s.len()];
            if body.len() > 0 {
                return Split { body, suffix: s };
            }
        }
    }
    return Split { body: text, suffix: "" };
}

/// The value of hex/decimal/octal/binary digit `c`, if it is one in `radix`.
fn digit(c: u8, radix: u64): Option::<u64> {
    let v: u64 = if c >= b'0' && c <= b'9' {
        (c - b'0') as u64
    } else if c >= b'a' && c <= b'z' {
        (c - b'a') as u64 + 10
    } else if c >= b'A' && c <= b'Z' {
        (c - b'A') as u64 + 10
    } else {
        99
    };
    if v < radix {
        return Some(v);
    }
    return None;
}

/// A parsed integer literal (its low and high 64 bits, and its suffix), or
/// why it is invalid.
pub enum IntLit {
    Value(u64, u64, str),
    Invalid(String),
}

/// Parse an integer literal: its value and suffix (empty if none).
pub fn parse_int_lit(text: str): IntLit {
    let b = text.as_bytes();
    let mut radix: u64 = 10;
    let mut digits_start: usize = 0;
    if b.len() >= 2 && b[0] == b'0' {
        if b[1] == b'x' {
            radix = 16;
            digits_start = 2;
        } else if b[1] == b'o' {
            radix = 8;
            digits_start = 2;
        } else if b[1] == b'b' {
            radix = 2;
            digits_start = 2;
        }
    }
    let sp = split_suffix(text[digits_start..], radix != 10);
    if is_float_suffix(sp.suffix) {
        let mut m = String::new();
        m.write("float suffix `{sp.suffix}` on an integer literal");
        return IntLit::Invalid(m);
    }
    let mut count: usize = 0;
    let mut bad = false;
    for c in sp.body.bytes() {
        if c == b'_' {
            continue;
        }
        count += 1;
        if digit(c, radix).is_none() {
            bad = true;
        }
    }
    if count == 0 {
        return IntLit::Invalid(String::from("integer literal has no digits"));
    }
    if bad {
        let mut m = String::new();
        m.write("invalid digit or suffix in `{text}`");
        return IntLit::Invalid(m);
    }
    // A 128-bit accumulator: `hi` and `lo` words, `lo` multiplied 32 bits
    // at a time so nothing overflows.
    let (mut hi, mut lo): (u64, u64) = (0, 0);
    let max: u64 = 0xffffffffffffffff;
    for c in sp.body.bytes() {
        if c == b'_' {
            continue;
        }
        let d = digit(c, radix).unwrap();
        let low = (lo & 0xffffffff) * radix + d;
        let high = (lo >> 32) * radix + (low >> 32);
        let carry = high >> 32;
        if hi > (max - carry) / radix {
            return IntLit::Invalid(String::from("integer literal is too large"));
        }
        hi = hi * radix + carry;
        lo = ((high & 0xffffffff) << 32) | (low & 0xffffffff);
    }
    return IntLit::Value(lo, hi, sp.suffix);
}

/// Whether `s` is a valid float: digits, an optional `.` and digits, an
/// optional exponent (`_` separators allowed in the digits).
fn valid_float(s: str): bool {
    let b = s.as_bytes();
    let mut i: usize = 0;
    let mut digits: usize = 0;
    while i < b.len() && ((b[i] >= b'0' && b[i] <= b'9') || b[i] == b'_') {
        if b[i] != b'_' {
            digits += 1;
        }
        i += 1;
    }
    if i < b.len() && b[i] == b'.' {
        i += 1;
        while i < b.len() && ((b[i] >= b'0' && b[i] <= b'9') || b[i] == b'_') {
            if b[i] != b'_' {
                digits += 1;
            }
            i += 1;
        }
    }
    if digits == 0 {
        return false;
    }
    if i < b.len() && (b[i] == b'e' || b[i] == b'E') {
        i += 1;
        if i < b.len() && (b[i] == b'+' || b[i] == b'-') {
            i += 1;
        }
        let mut exp: usize = 0;
        while i < b.len() && ((b[i] >= b'0' && b[i] <= b'9') || b[i] == b'_') {
            if b[i] != b'_' {
                exp += 1;
            }
            i += 1;
        }
        if exp == 0 {
            return false;
        }
    }
    return i == b.len();
}

/// Check a float literal; returns its suffix (empty if none) or an error.
pub fn parse_float_lit(text: str): Result::<str, String> {
    let sp = split_suffix(text, false);
    if sp.suffix.len() > 0 && !is_float_suffix(sp.suffix) {
        let mut m = String::new();
        m.write("integer suffix `{sp.suffix}` on a float literal");
        return Err(m);
    }
    if !valid_float(sp.body) {
        let mut m = String::new();
        m.write("invalid float literal `{text}`");
        return Err(m);
    }
    return Ok(sp.suffix);
}

/// An invalid escape: where in the literal's body, and why.
pub struct EscError {
    pub start: usize,
    pub end: usize,
    pub message: String,
}

/// The character starting at byte `i` of `s`, and its length.
fn char_at(s: str, i: usize): (char, usize) {
    let c = s[i..].chars().next().unwrap();
    return (c, c.len_utf8());
}

/// A number in hexadecimal (optionally after `+`), at most `max`.
fn parse_hex(s: str, max: u64): Option::<u64> {
    let b = s.as_bytes();
    let mut i: usize = 0;
    if b.len() > 0 && b[0] == b'+' {
        i = 1;
    }
    if i == b.len() {
        return None;
    }
    let mut v: u64 = 0;
    while i < b.len() {
        let d = digit(b[i], 16)?;
        v = v * 16 + d;
        if v > max {
            return None;
        }
        i += 1;
    }
    return Some(v);
}

fn esc_error(start: usize, end: usize, message: str): Result::<String, EscError> {
    return Err(EscError { start, end, message: String::from(message) });
}

/// Unescape the body of a string or char literal (without quotes).
pub fn unescape(raw: str): Result::<String, EscError> {
    let mut out = String::new();
    let n = raw.len();
    let mut i: usize = 0;
    while i < n {
        let (c, cl) = char_at(raw, i);
        if c != '\\' {
            out.push(c);
            i += cl;
            continue;
        }
        if i + 1 >= n {
            return esc_error(i, i + 1, "trailing backslash");
        }
        let (e, el) = char_at(raw, i + 1);
        let mut j = i + 1 + el;
        if e == 'n' {
            out.push('\n');
        } else if e == 't' {
            out.push('\t');
        } else if e == 'r' {
            out.push('\r');
        } else if e == '0' {
            out.push('\0');
        } else if e == '\\' || e == '"' || e == '\'' {
            out.push(e);
        } else if e == '\n' {
            // Line continuation: skip leading whitespace on the next line.
            while j < n {
                let (w, wl) = char_at(raw, j);
                if !w.is_whitespace() {
                    break;
                }
                j += wl;
            }
        } else if e == 'x' {
            let start = j;
            let mut k: usize = 0;
            while k < 2 && j < n {
                let (_, hl) = char_at(raw, j);
                j += hl;
                k += 1;
            }
            match parse_hex(raw[start..j], 255) {
                Some(b) if b < 0x80 => out.push(b as u8 as char),
                _ => return esc_error(i, i + 4, "`\\x` escapes must be two hex digits below 0x80"),
            }
        } else if e == 'u' {
            if j >= n || char_at(raw, j).0 != '{' {
                return esc_error(i, i + 2, "expected `{` after `\\u`");
            }
            j += 1;
            let hex_start = j;
            let mut hex_end = j;
            let mut end = i + 3;
            while j < n {
                let (h, hl) = char_at(raw, j);
                end = j + hl;
                j += hl;
                if h == '}' {
                    break;
                }
                hex_end = j;
            }
            let h = raw[hex_start..hex_end];
            let ch = match parse_hex(h, 0x10ffff) {
                Some(v) if v < 0xd800 || v > 0xdfff => char::from_u32(v as u32),
                _ => None,
            };
            match ch {
                Some(x) => out.push(x),
                None => {
                    let mut m = String::new();
                    m.write("invalid unicode escape `\\u{{{h}}}`");
                    return Err(EscError { start: i, end, message: m });
                }
            }
        } else {
            let mut m = String::new();
            m.write("unknown escape `\\{e}`");
            return Err(EscError { start: i, end: i + 1 + el, message: m });
        }
        i = j;
    }
    return Ok(out);
}

/// The value of a byte literal body (between `b'` and `'`): one ASCII
/// character, or an escape up to `\xFF`.
pub fn unescape_byte(raw: str): Result::<u8, String> {
    if raw.starts_with("\\x") {
        let hex = raw[2..];
        return match parse_hex(hex, 255) {
            Some(b) if hex.len() == 2 => Ok(b as u8),
            _ => Err(String::from("`\\x` escapes in byte literals must be two hex digits")),
        };
    }
    if raw.starts_with("\\u") {
        return Err(String::from("unicode escapes cannot be used in byte literals"));
    }
    let s = match unescape(raw) {
        Ok(s) => s,
        Err(e) => return Err(e.message),
    };
    let mut chars = s.as_str().chars();
    let first = chars.next();
    let second = chars.next();
    return match first {
        Some(c) if second.is_none() => {
            if (c as u32) < 128 {
                Ok(c as u32 as u8)
            } else {
                let mut m = String::new();
                m.write("non-ASCII character `{c}` in a byte literal");
                Err(m)
            }
        }
        _ => Err(String::from("byte literal must contain exactly one byte")),
    };
}

/// The help for a byte literal body that `unescape_byte` rejects, if
/// there is one.
pub fn unescape_byte_help(raw: str): Option::<String> {
    if raw.starts_with("\\x") {
        return None;
    }
    if raw.starts_with("\\u") {
        return Some(String::from("a byte is a single `\\x00`..`\\xFF` value"));
    }
    let s = match unescape(raw) {
        Ok(s) => s,
        Err(_) => return None,
    };
    let mut chars = s.as_str().chars();
    let first = chars.next();
    let second = chars.next();
    return match first {
        Some(c) if second.is_none() && (c as u32) >= 128 => {
            let mut m = String::new();
            m.write("its UTF-8 encoding is {c.len_utf8()} bytes; write one byte as `\\xNN`, or use the `char` literal `'{c}'`");
            Some(m)
        }
        None => Some(String::from("for the zero byte write `b'\\0'`")),
        _ => None,
    };
}

/// Where a format hole's spec starts: the index of its `:`, the first one
/// outside brackets, strings and character literals that is not part of
/// `::` (`p:?` is `p` with `Debug`); `None` if it has no spec.
fn spec_colon(inner: str): Option::<usize> {
    let b = inner.as_bytes();
    let mut depth: i32 = 0;
    let mut i: usize = 0;
    while i < b.len() {
        let c = b[i];
        if c == b'(' || c == b'[' || c == b'{' {
            depth += 1;
        } else if c == b')' || c == b']' || c == b'}' {
            depth -= 1;
        } else if c == b'"' || c == b'\'' {
            // Skip string and character literals (`':'`, `"a:b"`).
            i += 1;
            while i < b.len() && b[i] != c {
                i += if b[i] == b'\\' { 2 } else { 1 };
            }
        } else if c == b':' {
            if i + 1 < b.len() && b[i + 1] == b':' {
                i += 2;
                continue;
            }
            if depth == 0 {
                return Some(i);
            }
        }
        i += 1;
    }
    return None;
}

fn is_align(c: u8): bool {
    return c == b'<' || c == b'^' || c == b'>';
}

/// The first character of spec `s` (not empty) and its length in `s`,
/// with the escapes a fill may be written with (`\"`, `\\`, `\'`, `\n`,
/// `\t`, `\r`, `\0`, `\x41`); length 0 for another escape.
fn spec_fill(s: str): (char, usize) {
    let b = s.as_bytes();
    if b[0] != b'\\' {
        return match s.chars().next() {
            Some(c) => (c, c.len_utf8()),
            None => (' ', 0),
        };
    }
    if b.len() < 2 {
        return (' ', 0);
    }
    let e = b[1];
    if e == b'x' && b.len() >= 4 && b[2] < 0x80 && b[3] < 0x80 {
        return match unescape(s[..4]) {
            Ok(u) => match u.as_str().chars().next() {
                Some(c) => (c, 4),
                None => (' ', 0),
            },
            Err(_) => (' ', 0),
        };
    }
    let c = if e == b'n' {
        '\n'
    } else if e == b't' {
        '\t'
    } else if e == b'r' {
        '\r'
    } else if e == b'0' {
        '\0'
    } else if e == b'\\' || e == b'\'' || e == b'"' {
        e as char
    } else {
        return (' ', 0);
    };
    return (c, 2);
}

fn align_of(c: u8): FmtAlign {
    return if c == b'<' { FmtAlign::Left } else if c == b'^' { FmtAlign::Center } else { FmtAlign::Right };
}

fn is_spec_ident_start(c: u8): bool {
    return (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || c == b'_' || c >= 0x80;
}

fn is_spec_ident(c: u8): bool {
    return is_spec_ident_start(c) || (c >= b'0' && c <= b'9');
}

/// The format type `t` names, if any.
fn fmt_kind(t: str): Option::<FmtKind> {
    return if t == "" {
        Some(FmtKind::Display)
    } else if t == "?" {
        Some(FmtKind::Debug)
    } else if t == "x" {
        Some(FmtKind::LowerHex)
    } else if t == "X" {
        Some(FmtKind::UpperHex)
    } else if t == "o" {
        Some(FmtKind::Octal)
    } else if t == "b" {
        Some(FmtKind::Binary)
    } else if t == "e" {
        Some(FmtKind::LowerExp)
    } else if t == "E" {
        Some(FmtKind::UpperExp)
    } else {
        None
    };
}

/// The largest width or precision written as a number (as in Rust).
const MAX_SPEC_COUNT: u64 = 65535;

/// A width or precision in a spec: `5` or `name$`, at `b[i..]`.
struct SpecCount {
    count: FmtCount,
    /// Just after it (`i` if there is none).
    end: usize,
}

impl Parser {
    /// Unescape `seg` (a piece of a literal body starting at `offset` in
    /// the file) onto `text`; on an error, the format string's error.
    fn flush_text(&mut self, text: &mut String, seg: str, offset: u32): Option::<FmtString> {
        return match unescape(seg) {
            Ok(s) => {
                text.push_str(s.as_str());
                None
            }
            Err(e) => {
                let m = self.intern(e.message.as_str());
                Some(FmtString::Invalid(m, Span::new(offset + e.start as u32, offset + e.end as u32)))
            }
        };
    }

    fn fmt_error(&mut self, message: str, lo: u32, hi: u32): FmtString {
        let m = self.intern(message);
        return FmtString::Invalid(m, Span::new(lo, hi));
    }

    /// Parse the format spec `spec` (the text after a hole's `:`, at `lo`
    /// in the file): `[[fill]align][sign]['#']['0'][width]['.' precision]
    /// [type]`, as in Rust. On an error, the format string's error, at the
    /// part of the spec that is wrong.
    fn parse_spec(&mut self, spec: str, lo: u32): Result::<FmtSpec, FmtString> {
        let trimmed = spec.trim();
        if trimmed.len() == 0 {
            return Ok(FmtSpec::Show);
        }
        if trimmed == "?" {
            return Ok(FmtSpec::Debugged);
        }
        // Trailing spaces are not part of the spec; a leading one may be
        // the fill.
        let sb = spec.as_bytes();
        let mut n = sb.len();
        while n > 0 && (sb[n - 1] == b' ' || sb[n - 1] == b'\t') {
            n -= 1;
        }
        let s = spec[..n];
        let b = s.as_bytes();
        let end = lo + n as u32;
        let none = Span::new(end, end);
        let mut f = FmtFormat {
            kind: FmtKind::Display,
            fill: ' ',
            align: FmtAlign::Auto,
            plus: false,
            alt: false,
            zero: false,
            width: FmtCount::None,
            precision: FmtCount::None,
            span: Span::new(lo, end),
            kind_span: none,
            prec_span: none,
            plus_span: none,
            zero_span: none,
        };
        let mut i: usize = 0;
        // [[fill]align]: the fill is any character before `<`, `^` or `>`,
        // perhaps escaped (`\"`).
        let (c, cl) = spec_fill(s);
        if cl > 0 && cl < b.len() && is_align(b[cl]) {
            f.fill = c;
            f.align = align_of(b[cl]);
            i = cl + 1;
        } else if b[0] == b'\\' {
            return Err(self.fmt_error("an escape in a format spec can only be the fill, before `<`, `^` or `>`", lo, lo + 1));
        } else if is_align(b[0]) {
            f.align = align_of(b[0]);
            i = 1;
        }
        // [sign]: `-` is accepted and means nothing, as in Rust.
        if i < b.len() && (b[i] == b'+' || b[i] == b'-') {
            if b[i] == b'+' {
                f.plus = true;
                f.plus_span = Span::new(lo + i as u32, lo + i as u32 + 1);
            }
            i += 1;
        }
        let mut alt_at: usize = 0;
        if i < b.len() && b[i] == b'#' {
            f.alt = true;
            alt_at = i;
            i += 1;
        }
        // `0` is the flag unless it is the positional width `0$`.
        if i < b.len() && b[i] == b'0' && !(i + 1 < b.len() && b[i + 1] == b'$') {
            f.zero = true;
            f.zero_span = Span::new(lo + i as u32, lo + i as u32 + 1);
            i += 1;
        }
        let w = self.spec_count(s, lo, i, "width")?;
        f.width = w.count;
        i = w.end;
        if i < b.len() && b[i] == b'.' {
            let dot = i;
            if i + 1 < b.len() && b[i + 1] == b'*' {
                return Err(self.fmt_error("`.*` takes the precision from a positional argument, and format strings have none; write `.name$` with a `usize` variable `name`", lo + dot as u32, lo + dot as u32 + 2));
            }
            let p = self.spec_count(s, lo, i + 1, "precision")?;
            if p.count.is_none() {
                return Err(self.fmt_error("expected a precision after `.`: a number, or `name$` for a `usize` variable `name`", lo + dot as u32, lo + dot as u32 + 1));
            }
            f.precision = p.count;
            f.prec_span = Span::new(lo + dot as u32, lo + p.end as u32);
            i = p.end;
        }
        let rest = s[i..];
        f.kind_span = Span::new(lo + i as u32, end);
        f.kind = match fmt_kind(rest) {
            Some(k) => k,
            None => {
                let mut m = String::new();
                if rest == "x?" || rest == "X?" {
                    m.write("`{rest}` (`Debug` with hexadecimal integers) is not supported; format the integer itself with `x` or `X`");
                } else if is_spec_ident_start(b[i]) {
                    m.write("unknown format type `{rest}`: expected `?`, `x`, `X`, `o`, `b`, `e` or `E`, or none for `Display`");
                } else {
                    m.write("unexpected `{rest}` in format spec; a spec is `[[fill]align][sign]['#']['0'][width]['.' precision][type]`");
                }
                return Err(self.fmt_error(m.as_str(), lo + i as u32, end));
            }
        };
        if f.alt && f.kind.radix() == 0 {
            let m = if f.kind == FmtKind::Debug {
                "`#?` (pretty-printed `Debug`) is not supported: `Debug` writes one line"
            } else {
                "`#` only applies to `x`, `X`, `o` and `b`, where it adds the `0x`, `0o` or `0b` prefix"
            };
            return Err(self.fmt_error(m, lo + alt_at as u32, lo + alt_at as u32 + 1));
        }
        // A fill and alignment without a width do nothing: a spec that
        // only picks the trait is a plain hole.
        if !f.plus && !f.zero && f.width.is_none() && f.precision.is_none() {
            if f.kind == FmtKind::Display {
                return Ok(FmtSpec::Show);
            }
            if f.kind == FmtKind::Debug {
                return Ok(FmtSpec::Debugged);
            }
        }
        return Ok(FmtSpec::Full(self.ast.fmt_formats.add(f)));
    }

    /// The width or precision at `s[i..]` (`s` is a spec at `lo` in the
    /// file): a number, `name$`, or none.
    fn spec_count(&mut self, s: str, lo: u32, i: usize, what: str): Result::<SpecCount, FmtString> {
        let b = s.as_bytes();
        let mut j = i;
        if j < b.len() && b[j] >= b'0' && b[j] <= b'9' {
            let mut v: u64 = 0;
            while j < b.len() && b[j] >= b'0' && b[j] <= b'9' {
                if v <= MAX_SPEC_COUNT {
                    v = v * 10 + (b[j] - b'0') as u64;
                }
                j += 1;
            }
            if j < b.len() && b[j] == b'$' {
                let mut m = String::new();
                m.write("`{s[i..j + 1]}` takes the {what} from a positional argument, and format strings have none; write `name$` with a `usize` variable `name`");
                return Err(self.fmt_error(m.as_str(), lo + i as u32, lo + j as u32 + 1));
            }
            if v > MAX_SPEC_COUNT {
                let mut m = String::new();
                m.write("the {what} `{s[i..j]}` is too large: it is at most {MAX_SPEC_COUNT}");
                return Err(self.fmt_error(m.as_str(), lo + i as u32, lo + j as u32));
            }
            return Ok(SpecCount { count: FmtCount::Lit(v), end: j });
        }
        if j < b.len() && is_spec_ident_start(b[j]) {
            while j < b.len() && is_spec_ident(b[j]) {
                j += 1;
            }
            if j < b.len() && b[j] == b'$' {
                let name = s[i..j];
                return match self.parse_hole(name, lo + i as u32) {
                    Ok(e) => Ok(SpecCount { count: FmtCount::Arg(e), end: j + 1 }),
                    Err(_) => {
                        let mut m = String::new();
                        m.write("expected a variable before `$` in the {what}, found `{name}`");
                        Err(self.fmt_error(m.as_str(), lo + i as u32, lo + j as u32))
                    }
                };
            }
        }
        return Ok(SpecCount { count: FmtCount::None, end: i });
    }

    /// Interpret a string literal body (`raw`, between the quotes, starting
    /// at `offset` in the file) as a format string: `{expr}` holes,
    /// `{{`/`}}` escapes.
    fn parse_format(&mut self, raw: str, offset: u32): FmtString {
        let mut pieces: [FmtPiece; ..+] = [];
        let mut text = String::new();
        let b = raw.as_bytes();
        let mut text_start: usize = 0;
        let mut i: usize = 0;
        while i < b.len() {
            let c = b[i];
            if c == b'\\' {
                // Skip the escaped character so `\{` is not seen as a hole.
                i += 2;
            } else if (c == b'{' || c == b'}') && i + 1 < b.len() && b[i + 1] == c {
                if let Some(e) = self.flush_text(&mut text, raw[text_start..i], offset + text_start as u32) {
                    return e;
                }
                text.push(c as char);
                i += 2;
                text_start = i;
            } else if c == b'}' {
                return self.fmt_error("unmatched `}` in format string (use `}}` for a literal brace)", offset + i as u32, offset + i as u32 + 1);
            } else if c == b'{' {
                if let Some(e) = self.flush_text(&mut text, raw[text_start..i], offset + text_start as u32) {
                    return e;
                }
                if text.len() > 0 {
                    let t = self.intern(text.as_str());
                    pieces.push(FmtPiece::Text(t));
                    text = String::new();
                }
                // The matching close brace, as the lexer found it.
                let open = i;
                let j = match hole_end(b, i + 1) {
                    Some(e) => e,
                    None => return self.fmt_error("unclosed `{` in format string (use `{{` for a literal brace)", offset + open as u32, offset + open as u32 + 1),
                };
                let inner = raw[open + 1..j - 1];
                if inner.trim().len() == 0 {
                    return self.fmt_error("empty `{}` in format string: put an expression inside, e.g. `{x}`", offset + open as u32, offset + j as u32);
                }
                let colon = spec_colon(inner);
                let len = match colon {
                    Some(c) => c,
                    None => inner.len(),
                };
                if inner[..len].trim().len() == 0 {
                    return self.fmt_error("missing value before `:` in format string: a hole names what it shows, as in `{x:>8}`", offset + open as u32, offset + j as u32);
                }
                let lo = offset + open as u32 + 1;
                let e = match self.parse_hole(raw[open + 1..open + 1 + len], lo) {
                    Ok(e) => e,
                    Err(msg) => {
                        let mut m = String::new();
                        m.write("invalid expression in format string: {self.ast.text(msg)}");
                        return self.fmt_error(m.as_str(), offset + open as u32, offset + j as u32);
                    }
                };
                let spec = match colon {
                    Some(c) => match self.parse_spec(inner[c + 1..], lo + c as u32 + 1) {
                        Ok(s) => s,
                        Err(err) => return err,
                    },
                    None => FmtSpec::Show,
                };
                pieces.push(FmtPiece::Hole(e, spec));
                i = j;
                text_start = i;
            } else {
                i += 1;
            }
        }
        let rest_start = if text_start < raw.len() { text_start } else { raw.len() };
        if let Some(e) = self.flush_text(&mut text, raw[rest_start..], offset + text_start as u32) {
            return e;
        }
        if text.len() > 0 {
            let t = self.intern(text.as_str());
            pieces.push(FmtPiece::Text(t));
        }
        return FmtString::Pieces(self.ast.fmt_pieces.add_list(pieces[..]));
    }

    /// Parse the expression `text` of a format hole, which starts at `lo`
    /// in the file: lexed onto the end of the tokens and parsed with the
    /// cursor moved there. Its errors are not the file's: on failure,
    /// returns the first one's message.
    fn parse_hole(&mut self, text: str, lo: u32): Result::<Id::<Expr>, Symbol> {
        let (pos, limit, eof, fuel) = (self.pos, self.limit, self.eof, self.fuel);
        let diag_mark = self.diags.len();
        let cursor_mark = self.cursor_errors.len();
        let first = self.toks.len();
        self.lex_into(text, lo);
        let lex_end = self.diags.len();
        self.pos = first;
        self.limit = self.toks.len();
        self.eof = lo + text.len() as u32;
        self.n_expected = 0;
        let e = self.expr();
        if e.is_ok() && !self.at_eof() {
            self.error_expected();
        }
        // The first error: a lexical one, or else the earliest of the rest.
        let mut first_error: Option::<Diag> = None;
        if lex_end > diag_mark {
            first_error = Some(self.diags[diag_mark]);
        } else {
            let mut k = lex_end;
            while k < self.diags.len() {
                let d = self.diags[k];
                if first_error.is_none() || d.span.lo < first_error.unwrap().span.lo {
                    first_error = Some(d);
                }
                k += 1;
            }
            k = cursor_mark;
            while k < self.cursor_errors.len() {
                let d = self.cursor_errors[k];
                if first_error.is_none() || d.span.lo < first_error.unwrap().span.lo {
                    first_error = Some(d);
                }
                k += 1;
            }
        }
        let mut k = diag_mark;
        while k < self.diags.len() {
            self.diags[k].live = false;
            k += 1;
        }
        k = cursor_mark;
        while k < self.cursor_errors.len() {
            self.cursor_errors[k].live = false;
            k += 1;
        }
        self.pos = pos;
        self.limit = limit;
        self.eof = eof;
        self.fuel = fuel;
        self.n_expected = 0;
        if let Some(d) = first_error {
            return Err(d.message);
        }
        return match e {
            Ok(x) => Ok(x),
            Err(_) => Err(self.intern("")),
        };
    }

    /// A literal token (the current token).
    pub fn literal(&mut self): PResult::<Lit> {
        let t = self.bump();
        let text = tok_text(self.src, self.base, t);
        let sp = self.tok_span(t);
        let u8_suffix = self.intern("u8");
        let lit = match t.kind {
            T::True => Lit::Bool(true),
            T::False => Lit::Bool(false),
            T::Number(NumKind::Int) => match parse_int_lit(text) {
                IntLit::Value(value, high, suffix) => Lit::Int { value, high, suffix: self.suffix(suffix) },
                IntLit::Invalid(m) => {
                    self.diag(Code::BadNumber, sp, m.as_str());
                    Lit::Int { value: 0, high: 0, suffix: None }
                }
            },
            T::Number(NumKind::Float) => match parse_float_lit(text) {
                Ok(suffix) => Lit::Float { suffix: self.suffix(suffix) },
                Err(m) => {
                    self.diag(Code::BadNumber, sp, m.as_str());
                    Lit::Float { suffix: None }
                }
            },
            T::Char => self.char_lit(text, sp),
            T::Byte => {
                // A placeholder for an unclosed literal (already reported).
                if text.len() < 3 || !text.ends_with("'") {
                    Lit::Int { value: 0, high: 0, suffix: Some(u8_suffix) }
                } else {
                    // A byte literal is a `u8` integer literal.
                    let raw = text[2..text.len() - 1];
                    let value = match unescape_byte(raw) {
                        Ok(b) => b as u64,
                        Err(m) => {
                            let code = if m.as_str().contains("escape") { Code::BadEscape } else { Code::BadChar };
                            match unescape_byte_help(raw) {
                                Some(h) => self.diag_with(code, sp, m.as_str(), None, Some(h.as_str())),
                                None => self.diag(code, sp, m.as_str()),
                            }
                            0
                        }
                    };
                    Lit::Int { value, high: 0, suffix: Some(u8_suffix) }
                }
            }
            T::Str => {
                let raw = text[1..text.len() - 1];
                let value = match unescape(raw) {
                    Ok(s) => s,
                    Err(e) => {
                        self.diag(Code::BadEscape, Span::new(t.start + 1 + e.start as u32, t.start + 1 + e.end as u32), e.message.as_str());
                        String::new()
                    }
                };
                let fmt = if raw.contains("{") || raw.contains("}") {
                    self.parse_format(raw, t.start + 1)
                } else if value.len() == 0 {
                    FmtString::Pieces(List::empty())
                } else {
                    let v = self.intern(value.as_str());
                    FmtString::Pieces(self.ast.fmt_pieces.add_list([FmtPiece::Text(v)][..]))
                };
                Lit::Str { value: self.intern(value.as_str()), fmt }
            }
            _ => panic("literal() called on a non-literal"),
        };
        return Ok(lit);
    }

    fn suffix(&mut self, s: str): Option::<Symbol> {
        if s.len() == 0 {
            return None;
        }
        return Some(self.intern(s));
    }

    fn char_lit(&mut self, text: str, sp: Span): Lit {
        // A placeholder for an unclosed literal (already reported).
        if text.len() < 2 || !text.ends_with("'") {
            return Lit::Char('\0');
        }
        let raw = text[1..text.len() - 1];
        return match unescape(raw) {
            Ok(s) => {
                let mut n: usize = 0;
                let mut only = '\0';
                for c in s.as_str().chars() {
                    if n == 0 {
                        only = c;
                    }
                    n += 1;
                }
                if n == 1 {
                    Lit::Char(only)
                } else {
                    let msg = "character literal must contain exactly one character";
                    if n == 0 {
                        self.diag_with(Code::BadChar, sp, msg, Some("this literal is empty"), Some("for a space write `' '`; for the NUL character write `'\\0'`"));
                    } else {
                        let mut label = String::new();
                        label.write("this literal contains {n} characters");
                        if raw.contains("\"") {
                            self.diag_with(Code::BadChar, sp, msg, Some(label.as_str()), None);
                        } else {
                            let mut help = String::new();
                            help.write("for text, use a string literal: `\"{raw}\"`");
                            self.diag_with(Code::BadChar, sp, msg, Some(label.as_str()), Some(help.as_str()));
                        }
                    }
                    Lit::Char('\0')
                }
            }
            Err(e) => {
                self.diag(Code::BadEscape, sp, e.message.as_str());
                Lit::Char('\0')
            }
        };
    }
}
